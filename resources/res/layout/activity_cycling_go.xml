<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/activity_cycling_go_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.libpag.PAGImageView
        android:id="@+id/pag_dashboard_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <org.libpag.PAGImageView
        android:id="@+id/pag_dashboard_bg1"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_start_navi"
        app:layout_constraintTop_toTopOf="@+id/iv_settings"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_back"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_45"
        android:src="@mipmap/ic_back"
        android:paddingStart="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_242942_white"
        android:gravity="center"
        android:id="@+id/tv_orientation_angle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/icon_dashboard_north"
        app:layout_constraintTop_toBottomOf="@+id/iv_back"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/iv_settings"
        android:layout_width="@dimen/dp_32"
        android:layout_height="@dimen/dp_32"
        android:src="@mipmap/ic_setting"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_back"/>
    <com.yadea.vehicle.view.widget.dashboard.YadeaDashboardSpeedView1
        android:id="@+id/yd_dashboard_speed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_start_navi"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_back"/>
    <androidx.constraintlayout.widget.Group
        android:id="@+id/gp_map_model"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="iv_map_location,yd_map_speed_view"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_map_location"
        android:background="@mipmap/icon_dashboard_location"
        android:layout_width="@dimen/dp_68"
        android:layout_height="@dimen/dp_68"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/cl_start_navi"
        app:layout_constraintEnd_toEndOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_start_navi"
        android:background="@drawable/corners_solid_block_color_main_top_radius_14"
        android:paddingLeft="@dimen/dp_24"
        android:paddingRight="@dimen/dp_24"
        android:paddingBottom="34dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.Group
            android:id="@+id/gp_dashboard_model"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:constraint_referenced_ids="ll_cycling_average_speed,ll_cycling_distance,ll_cycling_max_speed,ll_cycling_time"/>
        <com.yadea.vehicle.view.widget.dashboard.DashboardBatteryView
            android:id="@+id/db_battery_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_28"
            android:layout_marginTop="@dimen/dp_24"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_cycling_distance"
            android:background="@drawable/corners_solid_gradient_color_f7f8fb_121212_radius_12"
            android:layout_width="0dp"
            android:layout_height="83dp"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_4"
            app:layout_constraintEnd_toStartOf="@+id/ll_cycling_time"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/db_battery_view">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_24"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_distance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_distance_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:layout_marginStart="@dimen/dp_2"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_color_999999"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/icon_dashboard_mileage"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_cycling_time"
            android:background="@drawable/corners_solid_gradient_color_f7f8fb_121212_radius_12"
            android:layout_width="0dp"
            android:layout_height="83dp"
            android:layout_marginStart="@dimen/dp_4"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ll_cycling_distance"
            app:layout_constraintTop_toTopOf="@+id/ll_cycling_distance">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_24"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:layout_gravity="center"
                android:id="@+id/tv_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00:00"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_color_999999"
                android:layout_gravity="center"
                android:id="@+id/tv_time_tip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/icon_dashboard_duration"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_cycling_average_speed"
            android:background="@drawable/corners_solid_gradient_color_f7f8fb_121212_radius_12"
            android:layout_width="0dp"
            android:layout_height="83dp"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_4"
            app:layout_constraintEnd_toStartOf="@+id/ll_cycling_max_speed"
            app:layout_constraintStart_toStartOf="@+id/ll_cycling_distance"
            app:layout_constraintTop_toBottomOf="@+id/ll_cycling_distance">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_24"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_av_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_avg_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:layout_marginStart="@dimen/dp_2"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_color_999999"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/icon_dashboard_average_speed"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_cycling_max_speed"
            android:background="@drawable/corners_solid_gradient_color_f7f8fb_121212_radius_12"
            android:layout_width="0dp"
            android:layout_height="83dp"
            android:layout_marginStart="@dimen/dp_4"
            app:layout_constraintEnd_toEndOf="@+id/ll_cycling_time"
            app:layout_constraintStart_toEndOf="@+id/ll_cycling_average_speed"
            app:layout_constraintTop_toTopOf="@+id/ll_cycling_average_speed">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_24"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_max_speed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_max_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_3"
                    android:text="@string/vehicle_speed_km_h"
                    android:layout_marginStart="@dimen/dp_2"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_color_999999"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/icon_dashboard_max_speed"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/ll_cycling_average_speed">
            <com.yadea.vehicle.view.widget.dashboard.YadeaNavigationSlideView1
                android:layout_gravity="center"
                android:id="@+id/nsv_slide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/iv_mode"
                android:visibility="gone"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:src="@drawable/cycling_go_shape_selector"
                android:layout_marginStart="@dimen/dp_16"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

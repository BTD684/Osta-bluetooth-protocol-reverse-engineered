<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_scooter_0"
    android:background="@color/block_color_background"
    android:scrollbars="none"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginBottom="100dp"
    android:fillViewport="true"
    android:overScrollMode="never">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/action_bluetooth_connect"
            android:background="@drawable/corners_solid_block_color_main"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginTop="@dimen/dp_10"
            android:text="@string/home_vehicle_bluetooth_disconnected"
            android:drawablePadding="4dp"
            android:drawableStart="@mipmap/home_ic_bluetooth_disconnected"
            android:paddingStart="@dimen/dp_10"
            android:paddingEnd="16dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/fl_scooter_bg"
            android:layout_width="match_parent"
            android:layout_height="312dp"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintTop_toBottomOf="@+id/ll_no_network">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_scooter_bg"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <View
                    android:background="@mipmap/ic_x1_bg"
                    android:layout_width="117dp"
                    android:layout_height="187dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="12sp"
                    android:textColor="@color/text_line_color_main"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/tv_accumulated_mileage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/total_text"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/iv_accumulated_mileage"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/iv_accumulated_mileage"
                    android:background="@mipmap/help_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginLeft="4dp"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_accumulated_mileage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_accumulated_mileage"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_mileage"
                    android:tag="binding_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_mileage_tag"
                    app:layout_constraintTop_toBottomOf="@+id/tv_accumulated_mileage"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:layout_gravity="bottom"
                    android:id="@+id/tv_mileage_tag"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    app:layout_constraintBaseline_toBaselineOf="@+id/tv_mileage"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_mileage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_mileage"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_scooter_bg"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/ll_remaining_mileage"
            android:background="@drawable/shape_dialog_bg_14"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/fl_scooter_bg">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/estimate_mileage"
                android:drawablePadding="4dp"
                android:drawableStart="@mipmap/ic_ll_remaining_mileage"
                android:layout_marginStart="16dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:id="@+id/txt_remaining_mileage"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="：--km"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/color_8C8C8E_333333"
                android:gravity="center"
                android:id="@+id/txt_remaining_mileage_time"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.yadea.home.vehicle.ScooterBatteryLayout
            android:id="@+id/view_electricity_bg"
            android:tag="binding_5"
            android:background="@drawable/corners_solid_block_color_main_14"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/scooter_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_remaining_mileage"/>
        <com.yadea.widget.switchLayout.YedeaVehicleControlSwitch
            android:id="@+id/scooter_switch"
            android:background="@drawable/corners_solid_block_color_main_14"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/view_electricity_bg"
            app:layout_constraintTop_toBottomOf="@+id/ll_remaining_mileage"
            app:scooter_lock_loading_tips="@string/home_scooter_loading_lock_tips"
            app:scooter_lock_tips="@string/home_batter_left_slide_lock"
            app:scooter_unlock_loading_tips="@string/home_scooter_loading_unlock_tips"
            app:scooter_unlock_tips="@string/home_batter_swipe_right_unlock"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/scooter_shortcuts_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/home_scooter_quick_control_car"
            app:layout_constraintStart_toStartOf="@+id/view_electricity_bg"
            app:layout_constraintTop_toBottomOf="@+id/view_electricity_bg"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view"
            android:tag="binding_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="18dp"
            android:layout_marginRight="14dp"
            android:overScrollMode="never"
            android:layout_marginHorizontal="14dp"
            app:layout_constraintTop_toBottomOf="@+id/scooter_shortcuts_title"/>
        <com.yadea.vehicle.view.widget.dashboard.VehicleDashboardView
            android:id="@+id/actionAppDashboard"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintStart_toStartOf="@+id/scooter_shortcuts_title"
            app:layout_constraintTop_toBottomOf="@+id/recycler_view"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_22"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/txt_vehicle_service"
            android:tag="binding_7"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/vehicle_services"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="@+id/scooter_shortcuts_title"
            app:layout_constraintTop_toBottomOf="@+id/actionAppDashboard"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_vehicle_service"
            android:background="@drawable/corners_solid_block_color_main_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_vehicle_service">
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/x1_control"
                android:tag="binding_8"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_72"
                app:itemLayoutBg="@color/transparent"
                app:itemLeftIcon="@mipmap/icon_vehicle_setting"
                app:itemLeftIconAppearance="@style/itemLeftIcon"
                app:itemName="@string/home_dialog_vehicle_setting"
                app:itemNameAppearance="@style/txt14_text_line_color_main"
                app:itemRightIcon="@mipmap/ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:itemRightSubIconAppearance="@style/itemRightSubIcon_14dp"/>
            <View
                android:id="@+id/view_line_family_account"
                android:tag="binding_9"
                android:background="@color/color_f5f6fa_333333"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/x1_control"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_family_account"
                android:tag="binding_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_72"
                app:itemLayoutBg="@color/transparent"
                app:itemLeftIcon="@mipmap/home_ic_family_account"
                app:itemLeftIconAppearance="@style/itemLeftIcon"
                app:itemName="@string/family_account"
                app:itemNameAppearance="@style/txt14_text_line_color_main"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/view_line_family_account"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_nearby_stores"
                android:tag="binding_11"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_72"
                app:itemLeftIcon="@mipmap/ic_nearby_stores"
                app:itemLeftIconAppearance="@style/itemLeftIcon"
                app:itemName="@string/near_shops"
                app:itemNameAppearance="@style/txt14_text_line_color_main"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/ll_vehicle_settings"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_10"
            app:layout_constraintTop_toBottomOf="@+id/ll_vehicle_service"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:id="@+id/ll_no_network"
            android:background="@drawable/corners_solid_radius_14_ff6b00_26_ff6b00"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_40"
            android:layout_marginLeft="@dimen/dp_18"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginRight="@dimen/dp_18"
            android:layout_marginHorizontal="@dimen/dp_18"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/action_bluetooth_connect">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="@dimen/dp_28"
                android:layout_height="@dimen/dp_28"
                android:src="@mipmap/vehicle_no_network"
                android:layout_marginStart="@dimen/dp_18"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bike_no_network_tips"
                android:layout_marginStart="9dp"
                android:layout_marginEnd="@dimen/dp_18"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/activity_electric_bicycle_location_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.gms.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/map_bike_location"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:orientation="vertical"
        android:id="@+id/iv_map_car_position"
        android:background="@drawable/selector_car_location"
        android:layout_width="@dimen/dp_68"
        android:layout_height="@dimen/dp_68"
        android:layout_marginBottom="@dimen/dp_30"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:orientation="vertical"
        android:id="@+id/iv_map_location"
        android:background="@drawable/selector_my_location"
        android:layout_width="@dimen/dp_68"
        android:layout_height="@dimen/dp_68"
        android:layout_marginTop="-12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_map_car_position"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bike_info"
        android:background="@drawable/corners_solid_block_color_main_radius_top_14"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_gsm"
            android:background="@drawable/corners_solid_color_background_radius_14"
            android:layout_width="@dimen/dp_70"
            android:layout_height="@dimen/dp_22"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_8c8c8e"
                android:gravity="center"
                android:id="@+id/tv_gsm"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/home_batter_gsm"
                android:drawablePadding="4dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_gsm"
                android:tag="binding_1"
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_4"
                android:layout_marginStart="@dimen/dp_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_gsm"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_gps"
            android:background="@drawable/corners_solid_color_background_radius_14"
            android:layout_width="@dimen/dp_70"
            android:layout_height="@dimen/dp_22"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintStart_toEndOf="@+id/cl_gsm"
            app:layout_constraintTop_toTopOf="parent">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_8c8c8e"
                android:gravity="center"
                android:id="@+id/tv_gps"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/home_batter_gps"
                android:drawablePadding="4dp"
                android:layout_marginStart="12dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_gps"
                android:tag="binding_2"
                android:layout_width="@dimen/dp_22"
                android:layout_height="@dimen/dp_4"
                android:layout_marginStart="@dimen/dp_5"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_gps"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/state_color_red"
            android:ellipsize="end"
            android:id="@+id/tv_gps_loss"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_24"
            android:maxLines="2"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintTop_toBottomOf="@+id/cl_gps"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_location"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_24"
            android:maxLines="2"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintTop_toBottomOf="@+id/tv_gps_loss"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/action_approximate_location"
            android:background="@drawable/corners_stroke_vehicle_approximate_location_bg"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_30"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="@+id/tv_gps_loss"
            app:layout_constraintTop_toBottomOf="@+id/tv_location">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@mipmap/ic_vehicle_approximate_location"
                android:layout_marginStart="@dimen/dp_12"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="#5d8aff"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_30"
                android:text="@string/map_view_general_location"
                android:layout_marginStart="@dimen/dp_4"
                android:layout_marginEnd="@dimen/dp_16"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/text_line_color_deputy_dark"
            android:id="@+id/tv_update_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintTop_toBottomOf="@+id/action_approximate_location"/>
        <View
            android:orientation="horizontal"
            android:id="@+id/view_navi_bike"
            android:background="@drawable/corners_stroke_text_line_color_main_14"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_24"
            android:layout_marginEnd="@dimen/dp_8"
            app:layout_constraintEnd_toStartOf="@+id/view_find_bike"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_update_time"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_navi_bike"
            app:layout_constraintEnd_toEndOf="@+id/view_navi_bike"
            app:layout_constraintStart_toStartOf="@+id/view_navi_bike"
            app:layout_constraintTop_toTopOf="@+id/view_navi_bike">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_navigation_to_bike"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@mipmap/icon_navigation_to_bike"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/map_navi_to_bike"
                android:layout_marginStart="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <View
            android:orientation="horizontal"
            android:id="@+id/view_find_bike"
            android:background="@drawable/corners_solid_text_line_color_main_14"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_44"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_40"
            android:layout_marginStart="@dimen/dp_8"
            android:layout_marginEnd="@dimen/dp_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view_navi_bike"
            app:layout_constraintTop_toBottomOf="@+id/tv_update_time"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_find_bike"
            app:layout_constraintEnd_toEndOf="@+id/view_find_bike"
            app:layout_constraintStart_toStartOf="@+id/view_find_bike"
            app:layout_constraintTop_toTopOf="@+id/view_find_bike">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center_vertical"
                android:id="@+id/iv_find_bike"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@mipmap/icon_find_bike"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/block_color_main"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_find_bike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/home_batter_flash_horns"
                android:layout_marginStart="@dimen/dp_10"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

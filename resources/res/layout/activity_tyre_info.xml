<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_tyre_info_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        app:layout_constraintTop_toTopOf="parent"
        app:rightIcon="@mipmap/vehicle_right_icon_help"
        app:title="@string/bike_tire_info"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/smart_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_vehicle"
                    android:tag="binding_1"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_front"
                    android:background="@drawable/corners_solid_block_color_main_14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/iv_vehicle">
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="14sp"
                        android:textColor="@color/text_line_color_deputy_dark"
                        android:id="@+id/tv_front_pressure_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/bike_tire_front"
                        android:layout_marginStart="16dp"
                        app:layout_constraintEnd_toStartOf="@+id/tv_front_temperature_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_front_pressure"
                        android:tag="binding_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="@+id/tv_front_pressure_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_front_pressure_title"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="14sp"
                        android:textColor="@color/text_line_color_deputy_dark"
                        android:id="@+id/tv_front_temperature_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/bike_front_temp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_front_pressure_title"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_front_temperature"
                        android:tag="binding_3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="@+id/tv_front_temperature_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_front_temperature_title"/>
                    <View
                        android:id="@+id/v_front_line"
                        android:tag="binding_4"
                        android:background="@color/text_line_color_deputy_light"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_front_pressure"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_front_update_time_title"
                        android:tag="binding_5"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bike_update_time"
                        android:layout_marginStart="16dp"
                        android:paddingVertical="12dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_front_error"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/v_front_line"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_front_update_time"
                        android:tag="binding_6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_front_update_time_title"
                        app:layout_constraintStart_toEndOf="@+id/tv_front_update_time_title"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_front_error"
                        android:tag="binding_7"
                        android:background="@drawable/corners_solid_state_color_red_6_bottom_14"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:paddingStart="16dp"
                        android:paddingVertical="8dp"
                        app:drawableStartCompat="@mipmap/icon_tyre_status_error"
                        app:layout_constraintTop_toBottomOf="@+id/tv_front_update_time_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_rear"
                    android:background="@drawable/corners_solid_block_color_main_14"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    app:layout_constraintTop_toBottomOf="@+id/cl_front">
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="14sp"
                        android:textColor="@color/text_line_color_deputy_dark"
                        android:id="@+id/tv_rear_pressure_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/bike_tire_rear"
                        android:layout_marginStart="16dp"
                        app:layout_constraintEnd_toStartOf="@+id/tv_rear_temperature_title"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_rear_pressure"
                        android:tag="binding_8"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="@+id/tv_rear_pressure_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_rear_pressure_title"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="14sp"
                        android:textColor="@color/text_line_color_deputy_dark"
                        android:id="@+id/tv_rear_temperature_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/bike_rear_temp"
                        android:layout_marginStart="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_rear_pressure_title"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_rear_temperature"
                        android:tag="binding_9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:layout_constraintStart_toStartOf="@+id/tv_rear_temperature_title"
                        app:layout_constraintTop_toBottomOf="@+id/tv_rear_temperature_title"/>
                    <View
                        android:id="@+id/v_rear_line"
                        android:tag="binding_10"
                        android:background="@color/text_line_color_deputy_light"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginHorizontal="16dp"
                        app:layout_constraintTop_toBottomOf="@+id/tv_rear_pressure"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_rear_update_time_title"
                        android:tag="binding_11"
                        android:paddingTop="12dp"
                        android:paddingBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/bike_update_time"
                        android:layout_marginStart="16dp"
                        android:paddingVertical="12dp"
                        app:layout_constraintBottom_toTopOf="@+id/tv_rear_error"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/v_rear_line"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_rear_update_time"
                        android:tag="binding_12"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_rear_update_time_title"
                        app:layout_constraintStart_toEndOf="@+id/tv_rear_update_time_title"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_rear_error"
                        android:tag="binding_13"
                        android:background="@drawable/corners_solid_state_color_red_6_bottom_14"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="4dp"
                        android:paddingStart="16dp"
                        android:paddingVertical="8dp"
                        app:drawableStartCompat="@mipmap/icon_tyre_status_error"
                        app:layout_constraintTop_toBottomOf="@+id/tv_rear_update_time_title"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

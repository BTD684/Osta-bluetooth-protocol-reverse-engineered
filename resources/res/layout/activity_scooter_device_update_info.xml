<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_scooter_device_update_info_0"
    android:background="@color/block_color_background"
    android:paddingBottom="18dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/home_dialog_firmware_update"/>
    <com.yadea.widget.textItem.YadeaTextItemLayout
        android:id="@+id/til_version"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:itemName="@string/vehicle_update_version"
        app:itemNameAppearance="@style/itemNameSize_14"
        app:itemValueAppearance="@style/itemValueTextColor_14"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="164dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/til_version">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_image"
            android:layout_width="124dp"
            android:layout_height="124dp"
            android:src="@mipmap/home_ic_scooter_test_bg"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_result"
            android:tag="binding_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="41dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toEndOf="@+id/iv_image"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_result_desc"
            android:tag="binding_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toEndOf="@+id/iv_image"
            app:layout_constraintTop_toBottomOf="@+id/tv_result"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_version_title"
            android:tag="binding_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toEndOf="@+id/iv_image"
            app:layout_constraintTop_toBottomOf="@+id/tv_result_desc"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_title"
            android:tag="binding_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_update_version_newest"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toEndOf="@+id/iv_image"
            app:layout_constraintTop_toTopOf="@+id/iv_image"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_version"
            android:tag="binding_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            app:layout_constraintStart_toEndOf="@+id/iv_image"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_version_content"
            android:tag="binding_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_image"
            app:layout_constraintTop_toBottomOf="@+id/tv_version"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_times"
        android:tag="binding_7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_content"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/text_line_color_deputy_light"
        android:gravity="center"
        android:id="@+id/tv_update"
        android:tag="binding_8"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:layout_width="195dp"
        android:layout_height="46dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:tag="binding_9"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="195dp"
        android:layout_height="46dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:tag="binding_10"
        android:background="@color/block_color_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <ProgressBar
            android:layout_gravity="center_horizontal"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="109dp"
            android:indeterminateDrawable="@drawable/update_progress_background"
            android:indeterminateBehavior="repeat"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/vehicle_update_file_down_tips"
            android:lineSpacingExtra="5dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

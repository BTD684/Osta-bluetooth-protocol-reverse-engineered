<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_custom_dirving_modes_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_22">
            <com.yadea.vehicle.view.widget.CoverConstraintLayout
                android:id="@+id/view_sensitivity"
                android:tag="binding_1"
                android:background="@drawable/corners_solid_white_black_radius_12"
                android:paddingBottom="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:gravity="center"
                    android:id="@+id/tv_sensitivity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/power_curve_change"
                    android:drawablePadding="@dimen/dp_8"
                    android:drawableStart="@mipmap/icon_alarm_sensitivity_customize"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="@+id/view_sensitivity"
                    app:layout_constraintTop_toTopOf="@+id/view_sensitivity"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="12sp"
                    android:textColor="@color/color_FD8E50"
                    android:id="@+id/tv_level"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="17dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_sensitivity"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_sensitivity"/>
                <com.yadea.vehicle.view.widget.MyContainer
                    android:id="@+id/container"
                    android:layout_width="300dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_sensitivity">
                    <com.yadea.vehicle.view.widget.DrivingModeView
                        android:id="@+id/drivingModeView"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </com.yadea.vehicle.view.widget.MyContainer>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_8C8C8E_999999"
                    android:gravity="center_horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/power_curve_setting_tip"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/container"/>
            </com.yadea.vehicle.view.widget.CoverConstraintLayout>
            <FrameLayout
                android:id="@+id/fl_body_stability"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/view_sensitivity">
                <com.yadea.widget.switchItem.YadeaSwitchItemLayout
                    android:id="@+id/action_body_stability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:switchLeftIconAppearance="@style/itemLeftIconMargin_8dp"
                    app:switch_left_icon="@mipmap/icon_tcs_body_stability"/>
                <com.yadea.widget.switchItem.YadeaIconView
                    android:id="@+id/action_body_stability_tip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:child_id="@+id/id_switch_item_title"
                    app:icon_margin_start="8dp"
                    app:parent_id="@+id/action_body_stability"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/fl_energy_recovery"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@+id/fl_body_stability">
                <com.yadea.widget.switchItem.YadeaSwitchItemLayout
                    android:id="@+id/action_energy_recovery"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:switchBottomLeftValueAppearance="@style/switch_bottom_left_value_text_color_dark"
                    app:switchLeftIconAppearance="@style/itemLeftIconMargin_8dp"
                    app:switch_bottom_radio_button_size="3"
                    app:switch_bottom_radio_group="true"
                    app:switch_bottom_radio_visible="true"
                    app:switch_left_icon="@mipmap/icon_energy_recovery"/>
                <com.yadea.widget.switchItem.YadeaIconView
                    android:id="@+id/action_energy_recovery_tip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:child_id="@+id/id_switch_item_title"
                    app:icon_margin_start="8dp"
                    app:parent_id="@+id/action_energy_recovery"/>
            </FrameLayout>
            <com.yadea.widget.font.YadeaTextView
                android:id="@+id/tv_cannon"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_tip"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/CarSettingMask"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:id="@+id/tv_tip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_16"
                android:text="@string/custom_driving_tip"
                android:layout_marginHorizontal="@dimen/dp_16"
                android:layout_marginVertical="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/fl_energy_recovery"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:background="@color/colorCustomLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_white_1b1c20"
        android:gravity="center"
        android:id="@+id/action_save_setting"
        android:background="@drawable/corners_solid_radius_14_000000_ffffff"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="@dimen/dp_32"
        android:text="@string/custom_driving_save_setting"
        android:layout_marginHorizontal="24dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_permission_common_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/linearLayoutCompat"
        android:background="@drawable/shape_dialog_dark_bg_14"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="74dp"
        android:layout_marginRight="24dp">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textColor="@color/block_color_main"
            android:id="@+id/top_tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:text="@string/needs_notification_permissions_full"
            android:layout_marginHorizontal="24dp"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="36dp"
        android:layout_marginRight="36dp"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="36dp">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/top_notification_title"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_weight="1"
            android:paddingHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/top_notification_info"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:paddingHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_notification_title"/>
        <View
            android:id="@+id/view_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/top_notification_info"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/top_btn_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
            app:layout_constraintEnd_toEndOf="@+id/view_center_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
        <View
            android:id="@+id/view_center_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="1dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/top_btn_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/view_center_line"
            app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/top_txt_confirm"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="@+id/view_line"
            app:layout_constraintStart_toStartOf="@+id/view_line"
            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>

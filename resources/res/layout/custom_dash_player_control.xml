<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageButton
        android:id="@+id/exo_play_pause"
        android:background="@drawable/bg_play_pause_button"
        android:padding="12dp"
        android:clickable="true"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="fitCenter"
        android:tint="@android:color/white"
        android:layout_centerInParent="true"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/bottom_controls"
        android:background="#80000000"
        android:padding="8dp"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/exo_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="0dp"
            android:layout_height="26dp"
            android:layout_weight="1"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            app:bar_height="3dp"
            app:buffered_color="#80ffffff"
            app:played_color="#ffffff"
            app:scrubber_color="#ffffff"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="16dp"
            app:scrubber_enabled_size="12dp"
            app:touch_target_height="26dp"
            app:unplayed_color="#33ffffff"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:id="@+id/exo_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:includeFontPadding="false"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"/>
        <ImageButton
            android:enabled="true"
            android:id="@+id/fullscreen_button"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:focusable="true"
            android:visibility="visible"
            android:clickable="true"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_fullscreen_enter"
            android:scaleType="fitCenter"
            android:contentDescription="全屏"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</RelativeLayout>

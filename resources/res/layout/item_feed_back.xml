<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corners_solid_block_color_dialog_14"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_marginTop="16dp">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_vehicle_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_email"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ydsh@yadea.com.cn"
        app:layout_constraintStart_toStartOf="@+id/txt_vehicle_name"
        app:layout_constraintTop_toBottomOf="@+id/txt_vehicle_name"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/action_copy"
        android:background="@drawable/corners_stroke_text_line_color_main"
        android:layout_width="80dp"
        android:layout_height="25dp"
        android:text="@string/user_feedback_copy"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/action_send"
        app:layout_constraintTop_toBottomOf="@+id/txt_email"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/block_color_main"
        android:gravity="center"
        android:id="@+id/action_send"
        android:background="@drawable/corners_solid_text_line_color_main"
        android:layout_width="80dp"
        android:layout_height="25dp"
        android:text="@string/user_dialog_verify_code_send"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_email"/>
</androidx.constraintlayout.widget.ConstraintLayout>

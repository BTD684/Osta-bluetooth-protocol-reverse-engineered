<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_user_info_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/home_profile"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_head"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="32dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/item_txt_name"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="32dp"
                android:layout_marginRight="23dp"
                android:layout_marginHorizontal="23dp"
                app:itemName="@string/vehicle_name_nickname"
                app:itemNameAppearance="@style/itemName"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/img_head"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/item_txt_email"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="23dp"
                android:layout_marginHorizontal="23dp"
                app:itemName="@string/user_personal_mail"
                app:itemNameAppearance="@style/itemName"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/item_txt_name"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/item_txt_tel"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="23dp"
                android:layout_marginHorizontal="23dp"
                app:itemName="@string/phone"
                app:itemNameAppearance="@style/itemName"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/item_txt_email"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/item_txt_password"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="23dp"
                android:layout_marginHorizontal="23dp"
                app:itemName="@string/login_password"
                app:itemNameAppearance="@style/itemName"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/item_txt_tel"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/item_txt_area"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="23dp"
                android:layout_marginHorizontal="23dp"
                app:itemName="@string/user_personal_area"
                app:itemNameAppearance="@style/itemName"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp_visible"
                app:layout_constraintTop_toBottomOf="@+id/item_txt_password"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/item_txt_face_book"
                android:tag="binding_5"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="23dp"
                android:layout_marginHorizontal="23dp"
                app:itemLeftIcon="@mipmap/user_info_facebook"
                app:itemLeftIconAppearance="@style/itemLeftIcon24_margin_16"
                app:itemName="@string/user_personal_face_book"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/item_txt_area"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/item_txt_google"
                android:tag="binding_6"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="23dp"
                android:layout_marginHorizontal="23dp"
                app:itemLeftIcon="@drawable/login_google"
                app:itemLeftIconAppearance="@style/itemLeftIcon24_margin_16"
                app:itemName="@string/google"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/item_txt_face_book"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/item_txt_delete_account"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:layout_marginLeft="23dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="23dp"
                android:layout_marginHorizontal="23dp"
                app:itemName="@string/user_personal_delete_account"
                app:itemNameAppearance="@style/itemName"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/item_txt_google"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

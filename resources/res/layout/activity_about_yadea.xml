<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_about_yadea_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/home_profile_about_yadea"/>
    <ImageView
        android:id="@+id/about_icon"
        android:layout_width="@dimen/dp_72"
        android:layout_height="@dimen/dp_72"
        android:layout_marginTop="114dp"
        android:src="@mipmap/about_yadea_icon"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_22"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/about_yadea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="Yadea"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/about_icon"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/about_version"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/about_yadea"/>
    <ImageView
        android:id="@+id/version_red"
        android:background="@drawable/shape_corners_red_e11_3"
        android:visibility="invisible"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_alignTop="@+id/about_version"
        android:layout_toEndOf="@+id/about_version"
        app:layout_constraintStart_toEndOf="@+id/about_version"
        app:layout_constraintTop_toTopOf="@+id/about_version"/>
    <com.yadea.widget.textItem.YadeaTextItemLayout
        android:id="@+id/about_privacy_policy"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_22"
        android:layout_marginHorizontal="@dimen/dp_22"
        app:itemName="@string/user_about_yadea_privacy_policy"
        app:itemNameAppearance="@style/itemName"
        app:itemRightIcon="@mipmap/widget_ic_right_next"
        app:itemRightIconAppearance="@style/itemRightIcon_14dp"
        app:layout_constraintTop_toBottomOf="@+id/about_version"/>
    <com.yadea.widget.textItem.YadeaTextItemLayout
        android:id="@+id/about_user_agreement"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_22"
        android:layout_marginHorizontal="@dimen/dp_22"
        app:itemName="@string/user_about_yadea_user_agreement"
        app:itemNameAppearance="@style/itemName"
        app:itemRightIcon="@mipmap/widget_ic_right_next"
        app:itemRightIconAppearance="@style/itemRightIcon_14dp"
        app:layout_constraintTop_toBottomOf="@+id/about_privacy_policy"/>
    <com.yadea.widget.textItem.YadeaTextItemLayout
        android:id="@+id/about_privacy_set"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_22"
        android:layout_marginHorizontal="@dimen/dp_22"
        app:itemName="@string/user_about_yadea_privacy_set"
        app:itemNameAppearance="@style/itemName"
        app:itemRightIcon="@mipmap/widget_ic_right_next"
        app:itemRightIconAppearance="@style/itemRightIcon_14dp"
        app:layout_constraintTop_toBottomOf="@+id/about_user_agreement"/>
</androidx.constraintlayout.widget.ConstraintLayout>

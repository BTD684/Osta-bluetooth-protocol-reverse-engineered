<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ct_root"
    android:background="@color/c_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.base.mirror.LayerStandardTitleView
        android:id="@+id/lt_title"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/sv_root"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lt_title">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ct_child_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ct_top"
                android:background="@color/c_list_bg"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:textSize="@dimen/t_1"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:gravity="start"
                    android:id="@+id/tv_app_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:text="爱奇艺"
                    android:maxLines="2"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="wrap"
                    app:layout_constraintWidth_percent="0.3"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ct_kill_app"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_clear_data"
                    app:layout_constraintStart_toEndOf="@+id/tv_app_name">
                    <TextView
                        android:textSize="@dimen/t_3"
                        android:textColor="@color/c_t3"
                        android:ellipsize="end"
                        android:gravity="center"
                        android:id="@+id/tv_kill_app"
                        android:background="@drawable/theme_safe_driver_sure_button"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:text="@string/vm_app_kill"
                        android:maxLines="2"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:layout_marginEnd="20dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintHorizontal_bias="1"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="wrap"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <TextView
                    android:textSize="@dimen/t_3"
                    android:textColor="@color/c_t3"
                    android:ellipsize="end"
                    android:gravity="center"
                    android:id="@+id/tv_clear_data"
                    android:background="@drawable/theme_safe_driver_sure_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:text="@string/vm_app_clear"
                    android:maxLines="2"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/ct_kill_app"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="wrap"
                    app:layout_constraintWidth_percent="0.3"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ct_add_space"
                android:background="@color/c_list_bg"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_marginTop="4dp"
                app:layout_constraintEnd_toEndOf="@+id/ct_top"
                app:layout_constraintStart_toStartOf="@+id/ct_top"
                app:layout_constraintTop_toBottomOf="@+id/ct_top">
                <TextView
                    android:textSize="@dimen/t_1"
                    android:textColor="@color/c_t1"
                    android:gravity="center"
                    android:id="@+id/tv_luncher_space"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vm2_setting_luncher"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/t_3"
                    android:textColor="@color/c_t3"
                    android:gravity="center"
                    android:id="@+id/tv_add_data"
                    android:background="@drawable/theme_safe_driver_sure_button"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:minHeight="32dp"
                    android:text="@string/vm2_setting_add"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintStart_toEndOf="@+id/tv_luncher_space"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintWidth_max="wrap"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ct_bottom"
                android:background="@color/c_list_bg"
                android:paddingBottom="20dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="@+id/ct_top"
                app:layout_constraintStart_toStartOf="@+id/ct_top"
                app:layout_constraintTop_toBottomOf="@+id/ct_add_space">
                <TextView
                    android:textSize="@dimen/t_1"
                    android:textColor="@color/c_t1"
                    android:gravity="center"
                    android:id="@+id/tv_dis_setting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/vm_app_show_setting"
                    android:layout_marginStart="16dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/t_3"
                    android:textColor="@color/c_t2"
                    android:id="@+id/tv_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/vm_app_setting_desc"
                    android:layout_marginStart="2dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_dis_setting"
                    app:layout_constraintStart_toEndOf="@+id/tv_dis_setting"/>
                <TextView
                    android:enabled="false"
                    android:textSize="@dimen/t_1"
                    android:textColor="@color/select_enable_color"
                    android:gravity="center"
                    android:id="@+id/tv_save"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:text="@string/text_save"
                    android:layout_marginEnd="20dp"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_dis_setting"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_dis_setting"/>
                <View
                    android:id="@+id/v_line"
                    android:layout_width="1sp"
                    android:layout_height="1sp"
                    app:layout_constraintEnd_toStartOf="@+id/ct_dpi"
                    app:layout_constraintStart_toEndOf="@+id/im_pro"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/im_pro"
                    android:background="@color/c_b2_d"
                    android:layout_width="228dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_dis_setting"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ct_dpi"
                    android:background="@color/c_b2_d"
                    android:layout_width="228dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="30dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/ct_pro">
                    <net.easyconn.carman.view.Vm2ProImageView
                        android:id="@+id/vm_pro"
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:layout_marginStart="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/tv_text"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textSize="@dimen/t_6"
                        android:textColor="@color/c_t1"
                        android:id="@+id/tv_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vm_app_text"
                        android:layout_marginStart="10dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/vm_pro"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ct_pro"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginTop="16dp"
                    app:layout_constraintBottom_toTopOf="@+id/ct_dpi"
                    app:layout_constraintEnd_toEndOf="@+id/im_pro"
                    app:layout_constraintStart_toStartOf="@+id/im_pro"
                    app:layout_constraintTop_toBottomOf="@+id/im_pro">
                    <TextView
                        android:textSize="14sp"
                        android:textColor="@color/C_Text_Main"
                        android:gravity="center"
                        android:id="@+id/tv_full_screen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/vm_app_full_view"
                        android:maxLines="2"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="10sp"
                        android:autoSizeMaxTextSize="14sp"
                        app:layout_constraintEnd_toStartOf="@+id/tv_2_1_screen"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintVertical_chainStyle="packed"/>
                    <TextView
                        android:textColor="@color/C_Text_Main"
                        android:gravity="center"
                        android:id="@+id/tv_2_1_screen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/vm_app_2_1_view"
                        app:layout_constraintEnd_toStartOf="@+id/tv_16_9_screen"
                        app:layout_constraintStart_toEndOf="@+id/tv_full_screen"/>
                    <TextView
                        android:textColor="@color/C_Text_Main"
                        android:gravity="center"
                        android:id="@+id/tv_16_9_screen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/vm_app_16_9_view"
                        app:layout_constraintEnd_toStartOf="@+id/tv_4_3_screen"
                        app:layout_constraintStart_toEndOf="@+id/tv_2_1_screen"/>
                    <TextView
                        android:textColor="@color/C_Text_Main"
                        android:gravity="center"
                        android:id="@+id/tv_4_3_screen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/vm_app_4_3_view"
                        app:layout_constraintEnd_toStartOf="@+id/tv_3_4_screen"
                        app:layout_constraintStart_toEndOf="@+id/tv_16_9_screen"/>
                    <TextView
                        android:textColor="@color/C_Text_Main"
                        android:gravity="center"
                        android:id="@+id/tv_3_4_screen"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="@string/vm_app_3_4_view"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_4_3_screen"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.jaygoo.widget.RangeSeekBar
                    android:id="@+id/sb_progress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp"
                    app:layout_constraintEnd_toStartOf="@+id/tv_max"
                    app:layout_constraintStart_toEndOf="@+id/tv_min"
                    app:layout_constraintTop_toBottomOf="@+id/ct_dpi"
                    app:rsb_gravity="bottom"
                    app:rsb_indicator_show_mode="alwaysHide"
                    app:rsb_max="2"
                    app:rsb_min="0.5"
                    app:rsb_mode="single"
                    app:rsb_progress_height="4dp"
                    app:rsb_step_auto_bonding="false"
                    app:rsb_step_height="15dp"
                    app:rsb_step_width="2dp"
                    app:rsb_steps="3"
                    app:rsb_thumb_drawable="@drawable/theme_ivi_virhome_img_drag"
                    app:rsb_thumb_height="20dp"
                    app:rsb_thumb_width="20dp"
                    app:rsb_tick_mark_layout_gravity="bottom"
                    app:rsb_tick_mark_mode="number"
                    app:rsb_tick_mark_text_array="@array/vm_text_size_array"
                    app:rsb_tick_mark_text_margin="12dp"
                    app:rsb_tick_mark_text_size="@dimen/t_4"/>
                <TextView
                    android:textSize="@dimen/t_4"
                    android:textColor="@color/c_t2"
                    android:id="@+id/tv_min"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    app:layout_constraintBottom_toBottomOf="@+id/sb_progress"
                    app:layout_constraintStart_toStartOf="@+id/ct_dpi"
                    app:layout_constraintTop_toTopOf="@+id/sb_progress"/>
                <TextView
                    android:textSize="@dimen/t_1"
                    android:textColor="@color/c_t2"
                    android:id="@+id/tv_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A"
                    app:layout_constraintBottom_toBottomOf="@+id/sb_progress"
                    app:layout_constraintEnd_toEndOf="@+id/ct_dpi"
                    app:layout_constraintTop_toTopOf="@+id/sb_progress"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_music_new"
    android:clickable="true"
    android:layout_width="@dimen/x600"
    android:layout_height="@dimen/x440">
    <RelativeLayout
        android:id="@+id/rl_cover"
        android:background="@drawable/home_view_base_land_part1_bg"
        android:layout_width="@dimen/x438"
        android:layout_height="@dimen/x440">
        <RelativeLayout
            android:id="@+id/rl_cover_album"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RelativeLayout
                android:id="@+id/rl_cover_blur"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <RelativeLayout
                android:id="@+id/rl_cover_blur_cover"
                android:background="@color/black_0.5"
                android:visibility="invisible"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
            <ImageView
                android:id="@+id/iv_cover"
                android:layout_width="@dimen/x288"
                android:layout_height="@dimen/x288"
                android:layout_marginTop="@dimen/x30"
                android:layout_marginBottom="@dimen/x30"
                android:scaleType="centerCrop"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/x48"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:id="@+id/tv_audio_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/x378"
                android:text=""
                android:lines="1"
                android:layout_below="@+id/iv_cover"
                android:layout_marginStart="@dimen/x30"
                android:layout_marginEnd="@dimen/x30"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_cover_default"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_cover_default"
                android:layout_width="@dimen/x120"
                android:layout_height="@dimen/x120"
                android:layout_marginTop="@dimen/x72"
                android:layout_marginBottom="@dimen/x30"
                android:layout_marginStart="@dimen/x48"/>
            <TextView
                android:textSize="@dimen/x72"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="left"
                android:id="@+id/tv_music_name_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/x360"
                android:text="@string/music_home_title_default"
                android:lines="1"
                android:includeFontPadding="false"
                android:layout_below="@+id/iv_cover_default"
                android:layout_marginStart="@dimen/x48"
                android:layout_marginEnd="@dimen/x30"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_splitter1"
            android:background="@color/divide_view"
            android:visibility="visible"
            android:layout_width="@dimen/x2"
            android:layout_height="match_parent"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_play"
        android:background="@drawable/home_view_base_land_part2_bg"
        android:layout_width="@dimen/x162"
        android:layout_height="@dimen/x220"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:id="@+id/iv_music_play_pause"
            android:layout_width="@dimen/x96"
            android:layout_height="@dimen/x96"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/iv_music_play_loading"
            android:visibility="invisible"
            android:layout_width="@dimen/x120"
            android:layout_height="@dimen/x120"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:id="@+id/rl_splitter2"
            android:background="#000000"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x2"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_next"
        android:background="@drawable/home_view_base_land_part3_bg"
        android:layout_width="@dimen/x210"
        android:layout_height="@dimen/x220"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>

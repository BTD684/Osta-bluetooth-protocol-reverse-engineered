<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <GridView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/gv_recommend_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@color/transparent"
        android:horizontalSpacing="@dimen/x24"
        android:verticalSpacing="@dimen/x24"/>
    <RelativeLayout
        android:id="@+id/rl_null"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_request_content_failed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="@dimen/font_size_48"
            android:textColor="@color/white"
            android:id="@+id/tv_description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/y200"
            android:text=""
            android:layout_below="@+id/iv_request_content_failed"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>

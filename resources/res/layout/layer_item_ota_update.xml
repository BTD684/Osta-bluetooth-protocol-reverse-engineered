<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/Theme.MaterialComponents"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:backgroundTint="@color/c_list_bg"
    app:cardCornerRadius="@dimen/r_2">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.google.android.material.imageview.ShapeableImageView
            android:theme="@style/Theme.MaterialComponents"
            android:id="@+id/iv_icon"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:layout_marginTop="@dimen/t_s4"
            android:scaleType="fitXY"
            android:layout_marginStart="@dimen/t_s4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearance="@style/mirror_navigation_bar_icon_round"/>
        <TextView
            android:textSize="@dimen/t_2"
            android:textColor="@color/c_t1"
            android:id="@+id/tv_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:layout_marginStart="@dimen/t_s5"
            android:layout_marginEnd="@dimen/t_s5"
            app:layout_constraintEnd_toStartOf="@+id/view_download"
            app:layout_constraintStart_toEndOf="@+id/iv_icon"
            app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2"
            android:id="@+id/tv_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/t_s1"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="@+id/tv_name"
            app:layout_constraintStart_toStartOf="@+id/tv_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_name"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2"
            android:id="@+id/tv_size"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/t_s1"
            android:singleLine="true"
            app:layout_constraintEnd_toEndOf="@+id/tv_name"
            app:layout_constraintStart_toStartOf="@+id/tv_name"
            app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
        <net.easyconn.carman.system.ota.LayerOtaDownloadView
            android:id="@+id/view_download"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="@dimen/t_s5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2"
            android:id="@+id/tv_versionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/t_s4"
            android:text="@string/ota_title_version_name"
            app:layout_constraintStart_toStartOf="@+id/iv_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_size"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2"
            android:id="@+id/tv_versionContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_versionName"
            app:layout_constraintEnd_toEndOf="@+id/view_download"
            app:layout_constraintStart_toEndOf="@+id/tv_versionName"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2"
            android:id="@+id/tv_updateName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/t_s1"
            android:text="@string/ota_title_update_name"
            app:layout_constraintStart_toStartOf="@+id/iv_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_versionName"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2"
            android:id="@+id/tv_updateContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/t_s5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/view_download"
            app:layout_constraintStart_toEndOf="@+id/tv_updateName"
            app:layout_constraintTop_toTopOf="@+id/tv_updateName"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

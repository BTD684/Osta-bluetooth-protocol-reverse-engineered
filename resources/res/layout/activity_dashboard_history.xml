<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/activity_dashboard_history_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.gms.maps.MapView
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dp_200"/>
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_40"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/map_route_detail"/>
    <com.yadea.vehicle.view.widget.NestedTouchScrollingLayout
        android:id="@+id/nestll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_bot"
            android:background="@drawable/corners_solid_block_color_f5f6fa_bg_topleft_radius_12"
            android:paddingLeft="@dimen/dp_24"
            android:paddingRight="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/dp_24">
            <RelativeLayout
                android:id="@+id/rl_top_line"
                android:paddingTop="@dimen/dp_8"
                android:paddingBottom="@dimen/dp_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/dp_16"
                android:paddingEnd="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <View
                    android:background="@drawable/corners_solid_block_color_history_gray_65dp"
                    android:layout_width="@dimen/dp_30"
                    android:layout_height="@dimen/dp_3"/>
            </RelativeLayout>
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/riv_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="@dimen/dp_24"
                android:src="@mipmap/icon_default"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_reocrd"
                android:layout_marginStart="@dimen/dp_8"
                app:layout_constraintBottom_toBottomOf="@+id/riv_avatar"
                app:layout_constraintStart_toEndOf="@+id/riv_avatar"
                app:layout_constraintTop_toTopOf="@+id/riv_avatar"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_car_info"
                android:background="@drawable/corners_solid_radius_14_ffffff_1e1e1e"
                android:padding="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                app:layout_constraintTop_toBottomOf="@+id/riv_avatar">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="81dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/ll_distance"
                        android:background="@drawable/corners_solid_gradient_color_f7f8fb_121212_radius_12"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.yadea.widget.font.YadeaTextView
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_line_color_main"
                                android:id="@+id/tv_distance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"/>
                            <com.yadea.widget.font.YadeaTextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_line_color_main"
                                android:id="@+id/tv_distance_km"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/km"
                                android:layout_marginStart="@dimen/dp_2"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_8c8c8e"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="@string/icon_dashboard_mileage"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@drawable/corners_solid_gradient_color_f7f8fb_121212_radius_12"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp">
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_line_color_main"
                            android:id="@+id/tv_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00:00"/>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_8C"
                            android:id="@+id/tv_time_tips"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="@string/icon_dashboard_duration"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </LinearLayout>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="81dp"
                    android:layout_marginTop="8dp">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/ll_avg_speed"
                        android:background="@drawable/corners_solid_gradient_color_f7f8fb_121212_radius_12"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.yadea.widget.font.YadeaTextView
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_line_color_main"
                                android:id="@+id/tv_avg_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"/>
                            <com.yadea.widget.font.YadeaTextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_line_color_main"
                                android:id="@+id/tv_avg_speed_km"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/icon_dashboard_average_speed"
                                android:layout_marginStart="@dimen/dp_2"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_8c8c8e"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="@string/icon_dashboard_average_speed"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="vertical"
                        android:id="@+id/cl_max_speed"
                        android:background="@drawable/corners_solid_gradient_color_f7f8fb_121212_radius_12"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_4">
                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <com.yadea.widget.font.YadeaTextView
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_line_color_main"
                                android:id="@+id/tv_max_speed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"/>
                            <com.yadea.widget.font.YadeaTextView
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_line_color_main"
                                android:id="@+id/tv_max_speed_unit"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/vehicle_speed_km_h"
                                android:layout_marginStart="@dimen/dp_2"/>
                        </androidx.appcompat.widget.LinearLayoutCompat>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_8c8c8e"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/dp_4"
                            android:text="@string/icon_dashboard_max_speed"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                </LinearLayout>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_co2"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold"
                            android:textColor="@color/text_line_color_main"
                            android:id="@+id/tv_co2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_16"
                            android:textStyle="bold"
                            android:textColor="@color/text_line_color_main"
                            android:id="@+id/tv_co2_kg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/carbon_reduction_kg"
                            android:layout_marginStart="@dimen/dp_2"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_8c8c8e"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/carbon_reduction"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_car_info"
                android:background="@drawable/corners_solid_radius_14_ffffff_1e1e1e"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_16"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintBottom_toTopOf="@+id/cl_velocity_curve"
                app:layout_constraintTop_toBottomOf="@+id/ll_car_info">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_model"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_motorcycle_type_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4"
                    app:layout_constraintStart_toStartOf="@+id/v_model_line"
                    app:layout_constraintTop_toBottomOf="@+id/tv_model"/>
                <View
                    android:id="@+id/v_model_line"
                    android:background="@color/color_black_5"
                    android:layout_width="match_parent"
                    android:layout_height="0.5dp"
                    android:layout_marginTop="@dimen/dp_12"
                    app:layout_constraintTop_toBottomOf="@+id/tv_motorcycle_type_time"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_top_round"
                    android:background="@mipmap/icon_blue_white_round"
                    android:layout_width="@dimen/dp_8"
                    android:layout_height="@dimen/dp_8"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_start_address"
                    app:layout_constraintStart_toStartOf="@+id/v_model_line"
                    app:layout_constraintTop_toTopOf="@+id/tv_start_address"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_8c8c8e"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_start_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginStart="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_top_round"
                    app:layout_constraintTop_toBottomOf="@+id/v_model_line"/>
                <View
                    android:id="@+id/v_center_line"
                    android:background="@color/text_line_color_deputy_light"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="0dp"
                    android:layout_marginTop="@dimen/dp_4"
                    android:layout_marginBottom="@dimen/dp_4"
                    app:layout_constraintBottom_toTopOf="@+id/iv_bot_round"
                    app:layout_constraintEnd_toEndOf="@+id/iv_top_round"
                    app:layout_constraintStart_toStartOf="@+id/iv_top_round"
                    app:layout_constraintTop_toBottomOf="@+id/iv_top_round"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_bot_round"
                    android:background="@mipmap/icon_orange_white_round"
                    android:layout_width="@dimen/dp_8"
                    android:layout_height="@dimen/dp_8"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_end_address"
                    app:layout_constraintStart_toStartOf="@+id/v_model_line"
                    app:layout_constraintTop_toTopOf="@+id/tv_end_address"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_8c8c8e"
                    android:id="@+id/tv_end_address"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:layout_marginStart="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_8"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_bot_round"
                    app:layout_constraintTop_toBottomOf="@+id/tv_start_address"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_velocity_curve"
                android:background="@drawable/corners_solid_radius_14_ffffff_1e1e1e"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_12"
                app:layout_constraintBottom_toBottomOf="parent">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_16"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_velocity_curve"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/speed_trend_chart"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/color_8C"
                    android:id="@+id/tv_speed_km"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/speed_km_h"
                    app:layout_constraintStart_toStartOf="@+id/tv_velocity_curve"
                    app:layout_constraintTop_toBottomOf="@+id/tv_velocity_curve"/>
                <com.yadea.common.charts.LineChart
                    android:id="@+id/line_chart"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_speed_km"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/color_8C"
                    android:id="@+id/tv_line_chart_time"
                    android:paddingBottom="@dimen/dp_16"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-4dp"
                    android:text="00:00:00"
                    app:layout_constraintEnd_toEndOf="@+id/line_chart"
                    app:layout_constraintTop_toBottomOf="@+id/line_chart"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.yadea.vehicle.view.widget.NestedTouchScrollingLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

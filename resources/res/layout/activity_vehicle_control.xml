<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_vehicle_control_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/vehicle_control_more_functions"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_control_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/home_scooter_quick_control_car"
        android:layout_marginStart="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_control_count"
        android:tag="binding_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_control_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_control_bg_list"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="17dp"
        android:minHeight="145dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="17dp"
        app:layout_constraintTop_toBottomOf="@+id/txt_control_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_control_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="14dp"
        android:layout_marginRight="17dp"
        android:minHeight="145dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="17dp"
        app:layout_constraintTop_toBottomOf="@+id/txt_control_title"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_more_control_title"
        android:tag="binding_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vehicle_control_more_control"
        android:layout_marginStart="17dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv_control_list"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_more_control_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="17dp"
        android:layout_marginTop="25dp"
        android:layout_marginRight="17dp"
        android:layout_marginBottom="22dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="17dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_more_control_title"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/block_color_main"
        android:gravity="center"
        android:id="@+id/action_edit_setting"
        android:tag="binding_4"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:layout_width="200dp"
        android:layout_height="46dp"
        android:layout_marginBottom="34dp"
        android:text="@string/vehicle_control_editing_shortcut_function"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/block_color_main"
        android:gravity="center"
        android:id="@+id/action_edit_confirm"
        android:tag="binding_5"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:layout_width="200dp"
        android:layout_height="46dp"
        android:layout_marginBottom="16dp"
        android:text="@string/vehicle_control_finish"
        app:layout_constraintBottom_toTopOf="@+id/action_edit_cancel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/action_edit_cancel"
        android:tag="binding_6"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="200dp"
        android:layout_height="46dp"
        android:layout_marginBottom="34dp"
        android:text="@string/Cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

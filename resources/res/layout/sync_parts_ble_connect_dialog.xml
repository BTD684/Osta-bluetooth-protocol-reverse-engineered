<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/sync_parts_ble_connect_dialog_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/corners_solid_white_14"
        android:layout_width="303dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hint"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_8C"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:text="@string/ble_key_async_ble_tips"
            android:layout_marginHorizontal="24dp"/>
        <View
            android:background="@color/text_line_color_deputy_light_alpha"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_8C"
            android:gravity="center"
            android:id="@+id/cancel_action"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_56"
            android:text="@string/ble_key_i_see"/>
    </LinearLayout>
</RelativeLayout>

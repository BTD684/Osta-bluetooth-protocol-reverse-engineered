<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/c_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <include
        android:id="@+id/rl_top_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/all_layout_title_height"
        layout="@layout/layout_gallery_title"/>
    <ScrollView
        android:id="@+id/sv_main_login"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:id="@+id/ll_login_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_phone_login"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/c_t1"
                        android:textColorHint="@color/theme_C_Text_Second"
                        android:id="@+id/et_memo"
                        android:background="@drawable/fragment_system_user_login_input_bg"
                        android:paddingLeft="@dimen/card_left_right_margin_54"
                        android:layout_width="350dp"
                        android:layout_height="@dimen/x144"
                        android:layout_marginTop="8dp"
                        android:hint="@string/system_easyconn_active_hint_text_input_memo"
                        android:maxLength="30"
                        android:layout_weight="0.5"/>
                    <EditText
                        android:textSize="18sp"
                        android:textColor="@color/c_t1"
                        android:textColorHint="@color/theme_C_Text_Second"
                        android:id="@+id/et_phone"
                        android:background="@drawable/fragment_system_user_login_input_bg"
                        android:paddingLeft="@dimen/card_left_right_margin_54"
                        android:layout_width="350dp"
                        android:layout_height="@dimen/x144"
                        android:layout_marginTop="8dp"
                        android:hint="@string/system_user_login_hint_text_input_phone"
                        android:maxLength="11"
                        android:inputType="numberDecimal"
                        android:imeOptions="flagNoExtractUi"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:id="@+id/ll_verification_code"
                        android:background="@drawable/fragment_system_user_login_input_bg"
                        android:focusable="false"
                        android:layout_width="350dp"
                        android:layout_height="@dimen/x144"
                        android:layout_marginTop="8dp">
                        <EditText
                            android:textSize="18sp"
                            android:textColor="@color/c_t1"
                            android:textColorHint="@color/theme_C_Text_Second"
                            android:id="@+id/et_verification_code"
                            android:background="@color/transparent"
                            android:paddingLeft="@dimen/card_left_right_margin_54"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="@string/system_user_login_hint_text_verification_code"
                            android:maxLength="6"
                            android:layout_weight="1"
                            android:inputType="numberDecimal"
                            android:imeOptions="flagNoExtractUi"/>
                        <View
                            android:background="#55ffffff"
                            android:layout_width="@dimen/x1"
                            android:layout_height="match_parent"
                            android:layout_marginTop="@dimen/x20"
                            android:layout_marginBottom="@dimen/x20"/>
                        <TextView
                            android:textSize="@dimen/text_size_middle54"
                            android:textColor="@color/c_t1"
                            android:gravity="center"
                            android:id="@+id/btn_get"
                            android:background="@drawable/selector_join_button_bg"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="@string/system_user_login_text_get"
                            android:paddingStart="15dp"
                            android:paddingEnd="15dp"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="18sp"
                        android:textColor="@color/white"
                        android:gravity="center"
                        android:id="@+id/btn_login"
                        android:background="@drawable/selector_join_button_bg"
                        android:layout_width="350dp"
                        android:layout_height="@dimen/x150"
                        android:layout_marginTop="30dp"
                        android:text="@string/system_user_login_text"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_active_success"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="18dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/c_t1"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机号:"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/c_t1"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_success_phone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="18dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/c_t1"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="备注:"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/c_t1"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_success_memo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="18dp">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/c_t1"
                android:layout_gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="授权剩余时长:"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/c_t1"
                android:layout_gravity="center_vertical"
                android:id="@+id/tv_success_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:text=""/>
        </LinearLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="18dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="18dp">
            <LinearLayout
                android:gravity="top"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/c_t1"
                    android:layout_gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="注意事项:"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="top"
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="5dp">
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/c_t1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1.授权过期后请重新登录"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="@color/c_t1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="2.请勿卸载或清除APP数据"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

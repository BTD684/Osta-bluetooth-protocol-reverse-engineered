<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/dialog_add_emergency_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_dialog_bg_14"
        android:layout_width="303dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textColor="@color/text_line_color_main"
            android:id="@+id/txt_name_tip"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/common_add_user_name"
            android:layout_marginHorizontal="16dp"
            style="@style/CarSettingTxt"/>
        <EditText
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_line_color_main"
            android:textColorHint="@color/text_line_color_deputy_dark"
            android:id="@+id/et_name"
            android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:layout_width="match_parent"
            android:layout_height="53dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:maxLines="1"
            android:ems="5"
            android:singleLine="true"
            android:maxLength="5"
            android:layout_marginHorizontal="16dp"
            android:paddingHorizontal="8dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textColor="@color/text_line_color_main"
            android:id="@+id/txt_phone_tip"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="16dp"
            android:text="@string/common_add_you_phone"
            android:layout_marginHorizontal="16dp"
            style="@style/CarSettingTxt"/>
        <LinearLayout
            android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp">
            <com.yadea.widget.font.YadeaTextView
                android:textColor="@color/text_line_color_main"
                android:text="+86"
                android:layout_marginStart="16dp"
                style="@style/CarSettingTxt"/>
            <ImageView
                android:layout_gravity="center_vertical"
                android:background="@color/text_line_color_main"
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginLeft="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"/>
            <EditText
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_line_color_main"
                android:textColorHint="@color/text_line_color_deputy_dark"
                android:id="@+id/et_phone"
                android:background="@null"
                android:paddingRight="8dp"
                android:layout_width="match_parent"
                android:layout_height="53dp"
                android:maxLines="1"
                android:ems="11"
                android:maxLength="11"
                android:inputType="number"/>
        </LinearLayout>
        <ImageView
            android:background="@color/text_line_color_deputy_light_alpha"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_deputy_dark"
                android:gravity="center"
                android:id="@+id/btn_left"
                android:tag="binding_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/Cancel"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/img_line"
                android:background="@color/text_line_color_deputy_light_alpha"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:id="@+id/btn_right"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/sure"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_ble_base_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="#4f4f4f"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_left_right_margin_54"
            android:layout_marginRight="@dimen/card_left_right_margin_54"
            android:text="@string/open_bluetooth_title"/>
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="#4f4f4f"
            android:layout_gravity="center"
            android:id="@+id/tv_content"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_left_right_margin_54"
            android:layout_marginRight="@dimen/card_left_right_margin_54"
            android:text="@string/open_bluetooth_content"/>
    </LinearLayout>
    <View
        android:id="@+id/line_content"
        android:background="@color/one_pixel_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_two_button_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prompt_dialog_title_height">
        <TextView
            android:id="@+id/tv_cancel"
            android:background="@drawable/dialog_ble_base_cancel_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/auto_dialog_cancel"
            android:layout_weight="1"
            style="@style/dialog_ble_base_cancel_action"/>
        <View
            android:background="@color/one_pixel_divider"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <TextView
            android:id="@+id/tv_enter"
            android:background="@drawable/dialog_ble_base_ensure_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/open_bluetooth_on_phone"
            android:layout_weight="1"
            style="@style/dialog_ble_base_action"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_change_rotation"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_float_ic_horver"/>
    <ImageView
        android:id="@+id/iv_switch_position"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_float_ic_adjust"/>
    <ImageView
        android:id="@+id/iv_to_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_float_ic_home"/>
    <ImageView
        android:id="@+id/iv_to_home_split"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_float_ic_homepage"/>
</merge>

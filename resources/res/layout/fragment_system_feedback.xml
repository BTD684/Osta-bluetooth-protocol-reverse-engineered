<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/main_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.view.CommonTitleView
        android:id="@+id/ctv_title_feecback"
        android:layout_width="match_parent"
        android:layout_height="@dimen/all_layout_title_height"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="@dimen/x24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/card_left_right_margin_54"
            android:layout_marginTop="@dimen/x24"
            android:layout_marginRight="@dimen/card_left_right_margin_54"
            android:layout_marginBottom="@dimen/x24">
            <EditText
                android:textSize="16dp"
                android:textColor="@color/color_333"
                android:textColorHint="@color/color_999"
                android:gravity="top"
                android:id="@+id/et_feed_content"
                android:background="@drawable/fragment_system_user_login_input_bg"
                android:padding="@dimen/y40"
                android:paddingTop="@dimen/x45"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x320"
                android:hint="@string/feedback_content_hint"
                android:imeOptions="flagNoExtractUi"/>
            <EditText
                android:textSize="16dp"
                android:textColor="@color/color_333"
                android:textColorHint="@color/color_999"
                android:id="@+id/et_contact"
                android:background="@drawable/fragment_system_user_login_input_bg"
                android:paddingLeft="@dimen/y40"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x130"
                android:layout_marginTop="@dimen/x24"
                android:hint="@string/feedback_contacts_hint"
                android:imeOptions="flagNoExtractUi"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333"
                android:gravity="left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/feedback_country_label"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333"
                android:textColorHint="@color/color_999"
                android:gravity="center_vertical"
                android:id="@+id/tv_country"
                android:background="@drawable/fragment_system_user_login_input_bg"
                android:paddingLeft="@dimen/y40"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x130"
                android:layout_marginTop="10dp"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333"
                android:gravity="left"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="@string/feedback_city_label"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333"
                android:textColorHint="@color/color_999"
                android:gravity="center_vertical"
                android:id="@+id/tv_city"
                android:background="@drawable/fragment_system_user_login_input_bg"
                android:paddingLeft="@dimen/y40"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x130"
                android:layout_marginTop="10dp"/>
            <Button
                android:textSize="16dp"
                android:textColor="@color/white"
                android:id="@+id/btn_submit"
                android:background="@drawable/system_blue_button_selector"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x150"
                android:layout_marginTop="20dp"
                android:text="@string/feedback_submit"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

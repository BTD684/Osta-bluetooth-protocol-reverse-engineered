<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/root_dialog_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_top"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/v_bottom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/t_4"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:text="@string/notice"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:theme="@style/Theme.MaterialComponents"
            android:textSize="@dimen/t_4"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_bottom"
        android:layout_width="0dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_top"/>
    <TextView
        android:textSize="@dimen/t_4"
        android:textColor="@color/all_text_blue"
        android:gravity="center"
        android:id="@+id/tv_center_enter"
        android:background="@drawable/theme_c_popup_btn_selector"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/dialog_enter"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toEndOf="@+id/v_bottom"
        app:layout_constraintStart_toStartOf="@+id/v_bottom"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
    <View
        android:id="@+id/v_center_line"
        android:background="@color/c_l"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_center_enter"/>
    <TextView
        android:textSize="@dimen/t_4"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/theme_c_popup_btn_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/ec_usb_cancel"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toStartOf="@+id/line_divider"
        app:layout_constraintStart_toStartOf="@+id/v_bottom"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
    <View
        android:id="@+id/line_divider"
        android:layout_width="1dp"
        android:layout_height="30dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toStartOf="@+id/tv_enter"
        app:layout_constraintStart_toEndOf="@+id/tv_cancel"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
    <TextView
        android:textSize="@dimen/t_4"
        android:gravity="center"
        android:id="@+id/tv_enter"
        android:background="@drawable/theme_c_popup_btn_selector"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/dialog_enter"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toEndOf="@+id/v_bottom"
        app:layout_constraintStart_toEndOf="@+id/line_divider"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>

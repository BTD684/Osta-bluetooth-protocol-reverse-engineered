<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_debug_app_reviews_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="APP评价"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_app_launch_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:text="剩余启动次数："
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_app_launch_count1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:text="剩余启动次数："
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_app_running_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:text="设置运行时间："
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_app_running_date1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:text="设置运行时间："
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_app_interval_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:text="不在弹出时间："
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_app_interval_date1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:text="不在弹出时间："
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/txt_app_reviews_dialog"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:text="是否显示弹窗："
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <EditText
        android:id="@+id/edit_launch_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:hint="设置启动次数"
        android:inputType="number"
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <EditText
        android:id="@+id/edit_app_running_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:hint="设置APP运行时间s"
        android:inputType="number"
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <EditText
        android:id="@+id/edit_app_interval_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:hint="设置不在弹出间隔时间s"
        android:inputType="number"
        android:layout_marginHorizontal="@dimen/dp_16"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/action_save_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:text="保存配置"
            android:layout_marginHorizontal="@dimen/dp_16"/>
        <Button
            android:id="@+id/action_reset_setting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="重置配置"/>
    </LinearLayout>
</androidx.appcompat.widget.LinearLayoutCompat>

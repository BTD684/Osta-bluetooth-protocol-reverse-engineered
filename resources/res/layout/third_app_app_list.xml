<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/c_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/all_layout_title_height">
        <ImageView
            android:id="@+id/iv_back"
            android:background="@drawable/common_back_selector"
            android:layout_width="@dimen/x120"
            android:layout_height="@dimen/x120"
            android:layout_marginLeft="@dimen/x30"
            android:layout_centerVertical="true"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerHorizontal="true">
            <RadioGroup
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:id="@+id/rg_app_list"
                android:layout_width="@dimen/x500"
                android:layout_height="match_parent"
                android:layout_centerHorizontal="true">
                <RadioButton
                    android:textSize="@dimen/text_size_normal"
                    android:textColor="@drawable/app_list_tab_color"
                    android:gravity="center"
                    android:id="@+id/rb_app_exist"
                    android:paddingBottom="@dimen/x10"
                    android:layout_width="@dimen/x250"
                    android:layout_height="match_parent"
                    android:checked="true"
                    android:button="@null"
                    android:text="@string/third_app_common"
                    android:drawableBottom="@drawable/app_list_tab_drawable"/>
                <RadioButton
                    android:textSize="@dimen/text_size_normal"
                    android:textColor="@drawable/app_list_tab_color"
                    android:gravity="center"
                    android:id="@+id/rb_app_recommend"
                    android:paddingBottom="@dimen/x10"
                    android:layout_width="@dimen/x250"
                    android:layout_height="match_parent"
                    android:button="@null"
                    android:text="@string/third_app_recommend"
                    android:drawableBottom="@drawable/app_list_tab_drawable"/>
            </RadioGroup>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:layout_alignParentBottom="true"
        style="@style/general_land_line_1px"/>
    <RelativeLayout
        android:id="@+id/rl_app_list"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/x22">
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/vp_app_showing"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </RelativeLayout>
</LinearLayout>

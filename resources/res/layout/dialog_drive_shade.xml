<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/c_bg3"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_shade"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/theme_ivi_common_img_warn"
        app:layout_constraintBottom_toTopOf="@+id/tv_shade"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/t_1"
        android:textColor="@color/c_t14"
        android:gravity="center_horizontal"
        android:id="@+id/tv_shade"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/drive_shade_tips"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toTopOf="@+id/bt_shade_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_shade"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/t_2"
        android:textColor="@color/c_t3"
        android:gravity="center"
        android:id="@+id/bt_shade_back"
        android:background="@drawable/selector_dialog_button_blue"
        android:layout_width="160dp"
        android:layout_height="40dp"
        android:layout_marginTop="40dp"
        android:text="@string/title_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/bt_shade_cancel"
        app:layout_constraintTop_toBottomOf="@+id/tv_shade"/>
    <androidx.appcompat.widget.AppCompatButton
        android:textSize="@dimen/t_2"
        android:textColor="@color/c_t3"
        android:gravity="center"
        android:id="@+id/bt_shade_cancel"
        android:background="@drawable/selector_dialog_button_normal"
        android:layout_width="160dp"
        android:layout_height="40dp"
        android:text="@string/bt_drive_shade_tips"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/bt_shade_back"
        app:layout_constraintEnd_toStartOf="@+id/bt_shade_back"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bt_shade_back"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/main_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_phone_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/all_layout_title_height"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_back"
            android:layout_width="@dimen/y200"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/common_back_selector"
                android:layout_centerVertical="true"/>
        </LinearLayout>
        <TextView
            android:textSize="18dp"
            android:textColor="@color/color_333"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/phonename"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/img_dial"
            android:visibility="visible"
            android:layout_width="@dimen/y200"
            android:layout_height="match_parent"
            android:scaleType="centerInside"
            android:layout_centerInParent="true"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/ll_phone_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rl_phone_title">
        <RelativeLayout
            android:id="@+id/rl_phone_vip"
            android:background="@color/white"
            android:visibility="gone"
            android:layout_width="@dimen/x906"
            android:layout_height="@dimen/x510"
            android:layout_margin="@dimen/x20"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:elevation="10dp"/>
        <RelativeLayout
            android:id="@+id/rl_phone_calllog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/rl_phone_vip"
            android:layout_centerInParent="true"
            android:elevation="1dp"/>
    </RelativeLayout>
    <RelativeLayout
        android:gravity="center"
        android:orientation="vertical"
        android:id="@+id/rl_wrc_guide"
        android:background="@color/black_0.6"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_wrc_guide"
            android:background="@drawable/wrc_phone_bg_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/card_left_right_margin_54"
            android:layout_marginEnd="@dimen/card_left_right_margin_54">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x72"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/black_0.8"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/x60"
                android:layout_marginBottom="@dimen/x60"
                android:layout_marginStart="@dimen/x48"
                android:layout_marginEnd="@dimen/x48"/>
            <View
                android:background="@color/black_0.5"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"/>
            <Button
                android:textSize="@dimen/text_size_normal"
                android:textColor="@color/all_text_blue"
                android:gravity="center"
                android:id="@+id/tv_know"
                android:background="@drawable/wrc_phone_ok_selector"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x144"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>

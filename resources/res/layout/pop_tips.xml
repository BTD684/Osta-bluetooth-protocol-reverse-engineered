<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/pop_tips_0"
    android:background="@drawable/corners_solid_stroke_color_white_1b1c20_radius_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/color_242942_white"
        android:gravity="center"
        android:id="@+id/txt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/EMTitle_18_Bold"/>
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/txt_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/txt_title"
        style="@style/Text_14_Regular"/>
    <View
        android:id="@+id/v_line1"
        android:background="@color/color_0D000000_0DFFFFFF"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/txt_content"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/ll_double_container"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64"
        app:layout_constraintTop_toBottomOf="@+id/v_line1">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_8C8C8E_999999"
            android:gravity="center"
            android:id="@+id/txt_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
        <View
            android:id="@+id/v_line"
            android:background="@color/color_0D000000_0DFFFFFF"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/color_242942_white"
            android:gravity="center"
            android:id="@+id/txt_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

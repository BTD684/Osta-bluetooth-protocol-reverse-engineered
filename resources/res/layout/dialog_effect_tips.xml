<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_effect_tips_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_effect_tips"
        android:background="@drawable/shape_effect_tips_bg"
        android:layout_width="303dp"
        android:layout_height="156dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:id="@+id/tv_tips_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/home_dialog_tips_title"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_tips"
        app:layout_constraintRight_toRightOf="@+id/view_effect_tips"
        app:layout_constraintTop_toTopOf="@+id/view_effect_tips"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorCustomRight"
        android:id="@+id/tv_tips_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="@string/custom_max_count_title"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_tips"
        app:layout_constraintRight_toRightOf="@+id/view_effect_tips"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips_title"/>
    <View
        android:id="@+id/view_tips_line"
        android:background="#0d000000"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/dp_20"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_tips"
        app:layout_constraintRight_toRightOf="@+id/view_effect_tips"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips_count"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:id="@+id/tv_tips_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user_dialog_i_see"
        app:layout_constraintBottom_toBottomOf="@+id/view_effect_tips"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_tips"
        app:layout_constraintRight_toRightOf="@+id/view_effect_tips"
        app:layout_constraintTop_toBottomOf="@+id/view_tips_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>

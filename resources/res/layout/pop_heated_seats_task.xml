<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/pop_heated_seats_task_0"
    android:background="@drawable/shape_radio_button_unit_uncheck"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/color_242942_white"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/set_up_a_scheduled_task"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.loper7.date_time_picker.DateTimePicker
        android:id="@+id/dt_picker"
        android:background="@drawable/corners_solid_block_color_white_1b1c20_main_radius_12"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="146dp"
        android:layout_marginLeft="@dimen/dp_32"
        android:layout_marginTop="16dp"
        android:layout_marginRight="@dimen/dp_32"
        android:layout_marginHorizontal="@dimen/dp_32"
        android:paddingHorizontal="@dimen/dp_16"
        app:dt_dividerColor="@color/color_black_3_white_3"
        app:dt_layout="@layout/layout_date_picker_segmentation"
        app:dt_selectTextSize="@dimen/sp_18"
        app:dt_selectedTextBold="true"
        app:dt_showLabel="false"
        app:dt_textColor="@color/color_8C8C8E_999999"
        app:dt_themeColor="@color/color_242942_white"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_32"
        android:layout_marginHorizontal="@dimen/dp_32"
        app:layout_constraintTop_toBottomOf="@+id/dt_picker">
        <com.yadea.widget.font.YadeaRadioButton
            android:textColor="@color/color_select_heated_seats_task"
            android:gravity="center"
            android:id="@+id/rb_1"
            android:background="@drawable/select_heated_seats_task"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_45"
            android:button="@null"
            android:text="@string/heat_only_once"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_8"/>
        <com.yadea.widget.font.YadeaRadioButton
            android:textColor="@color/color_select_heated_seats_task"
            android:gravity="center"
            android:id="@+id/rb_2"
            android:background="@drawable/select_heated_seats_task"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_45"
            android:button="@null"
            android:text="@string/custom_periods"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_8"/>
    </RadioGroup>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_date"
        android:background="@drawable/community_shape_corners_white_1b1c20_12dp"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_32"
        android:layout_marginHorizontal="@dimen/dp_32"
        app:layout_constraintTop_toBottomOf="@+id/rg_group">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_242942_white"
            android:id="@+id/tv_heated_title_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/heat_repeat_the_date"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_4075FF_4A7BF6"
            android:ellipsize="end"
            android:gravity="end"
            android:id="@+id/tv_heated_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:lines="1"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/tv_heated_title_desc"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_heated_title_desc"
            app:layout_constraintTop_toTopOf="@+id/tv_heated_title_desc"/>
        <androidx.recyclerview.widget.RecyclerView
            android:orientation="horizontal"
            android:id="@+id/rv_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintTop_toBottomOf="@+id/tv_heated_title_desc"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/view"
        android:background="@color/color_0D000000_0DFFFFFF"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/dp_24"
        app:layout_constraintTop_toBottomOf="@+id/cl_date"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_32"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/color_8C8C8E_999999"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/corners_stroke_8c8c8e_radius_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/Cancel"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/dp_8"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_white_1b1c20"
            android:gravity="center"
            android:id="@+id/tv_sure"
            android:background="@drawable/corners_gradient_solid_color_2f2f2f_4b4b4b_12"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/vehicle_control_finish"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_8"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

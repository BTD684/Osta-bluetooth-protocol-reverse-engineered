<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/main_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/system_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/all_layout_title_height">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_back"
                android:layout_width="@dimen/y200"
                android:layout_height="match_parent"
                android:layout_alignParentStart="true">
                <ImageView
                    android:id="@+id/iv_system_back"
                    android:background="@drawable/common_back_selector"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <TextView
                android:textSize="18dp"
                android:textColor="@color/color_333"
                android:gravity="center_vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/personal_info"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
        <RelativeLayout
            android:background="@color/main_bg"
            style="@style/system_item_layout">
            <TextView
                android:layout_height="wrap_content"
                android:text="@string/user_name"
                android:layout_centerVertical="true"
                style="@style/system_item_tv"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/color_666"
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/x24"
                android:layout_alignParentEnd="true"/>
            <View
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/card_left_right_margin_54"
                android:layout_marginEnd="@dimen/card_left_right_margin_54"
                style="@style/general_land_line_1px"/>
        </RelativeLayout>
        <RelativeLayout
            android:visibility="gone"
            style="@style/system_item_layout">
            <TextView
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                style="@style/system_item_tv"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/color_666"
                android:id="@+id/tv_mail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/x24"
                android:layout_alignParentEnd="true"/>
            <View
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/card_left_right_margin_54"
                android:layout_marginEnd="@dimen/card_left_right_margin_54"
                style="@style/general_land_line_1px"/>
        </RelativeLayout>
        <RelativeLayout
            android:id="@+id/rl_vip"
            android:background="@color/main_bg"
            style="@style/system_item_layout">
            <TextView
                android:layout_height="wrap_content"
                android:text="@string/mapbox_vip_label"
                android:layout_centerVertical="true"
                style="@style/system_item_tv"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/color_666"
                android:id="@+id/tv_vip_status"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/mapbox_not_pay"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/x24"
                android:layout_alignParentEnd="true"/>
            <View
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/card_left_right_margin_54"
                android:layout_marginEnd="@dimen/card_left_right_margin_54"
                style="@style/general_land_line_1px"/>
        </RelativeLayout>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/x54"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_logout"
                android:background="@drawable/system_blue_button_selector"
                android:layout_width="200dp"
                android:layout_height="45dp"
                android:text="@string/logout"/>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>

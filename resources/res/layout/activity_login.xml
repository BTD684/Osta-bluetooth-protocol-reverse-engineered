<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_login_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:rightTitle="@string/login_register_sign_up"
        app:rightTitleAppearance="@style/loginRightTitleSize18"
        app:subTitle="@string/login_welcome_to_yadea"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_switch_login_type"
        android:background="@drawable/corners_login_switch_background_radius_50"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_32"
        android:layout_marginLeft="40dp"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="40dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <com.yadea.widget.font.YadeaRadioButton
            android:textColor="@color/color_rb_text"
            android:gravity="center"
            android:id="@+id/rb_mobile_login"
            android:background="@drawable/corners_login_switch_radius_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/login_tel"
            android:layout_weight="1"/>
        <com.yadea.widget.font.YadeaRadioButton
            android:textColor="@color/color_rb_text"
            android:gravity="center"
            android:id="@+id/rb_email_login"
            android:background="@drawable/corners_login_switch_radius_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/login_email"
            android:layout_weight="1"/>
    </RadioGroup>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/mobile_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/rg_switch_login_type">
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:area_code_text="+84"
            app:area_code_text_color="@color/color_login_orange"
            app:area_code_text_size="@dimen/sp_14"
            app:hint_text="@string/cell_phone_number"
            app:input_edit_clear="true"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_phone"
            app:layout_constraintTop_toTopOf="parent"
            app:name_text="@string/phone_number"
            app:name_text_bold="true"
            app:right_name_text="@string/switch_password_login"
            app:right_name_text_color="@color/color_forget_password"
            app:right_name_text_size="@dimen/sp_14"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_verify_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_gravity="hint_center"
            app:hint_text="@string/user_dialog_enter_verification_code"
            app:input_edit_max_length="4"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_size="14sp"
            app:input_text_type="text_verify_code"
            app:name_text="@string/login_register_verify_code"
            app:name_text_bold="true"
            app:send_text="@string/user_dialog_verify_code_send"
            app:send_text_bold="true"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/block_color_main"
            android:gravity="center"
            android:id="@+id/tel_login"
            android:background="@drawable/corners_text_line_color_main_radius_14"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="22dp"
            android:text="@string/login"
            android:layout_marginHorizontal="22dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/email_container"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/mobile_container">
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/email_account"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/login_enter_email"
            app:input_edit_clear="true"
            app:input_edit_max_length="50"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_email"
            app:layout_constraintTop_toTopOf="parent"
            app:name_text="@string/user_personal_mail"
            app:name_text_bold="true"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/email_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/login_enter_password"
            app:input_edit_clear="true"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_password"
            app:layout_constraintTop_toBottomOf="@+id/email_account"
            app:name_text="@string/login_password"
            app:name_text_bold="true"
            app:right_name_text="@string/login_forgot_password"
            app:right_name_text_color="@color/color_login_orange"
            app:right_name_text_size="@dimen/sp_12"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/block_color_main"
            android:gravity="center"
            android:id="@+id/email_login"
            android:background="@drawable/corners_text_line_color_main_radius_14"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginTop="48dp"
            android:text="@string/login"
            app:layout_constraintEnd_toEndOf="@+id/email_account"
            app:layout_constraintStart_toStartOf="@+id/email_account"
            app:layout_constraintTop_toBottomOf="@+id/email_password"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.yadea.widget.protocol.YadeaProtocolLayout
        android:gravity="start"
        android:id="@+id/protocol_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_22"
        android:layout_marginHorizontal="@dimen/dp_22"
        app:layout_constraintTop_toBottomOf="@+id/email_container"
        app:protocol_check_size="0dp"
        app:protocol_content="@string/login_protocol_continue"/>
    <View
        android:background="@color/text_line_color_deputy_light"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="22dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/worth_mentioning"
        app:layout_constraintEnd_toStartOf="@+id/worth_mentioning"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/worth_mentioning"/>
    <View
        android:background="@color/text_line_color_deputy_light"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/worth_mentioning"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/worth_mentioning"
        app:layout_constraintTop_toTopOf="@+id/worth_mentioning"/>
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/color_8C8C8E_999999"
        android:id="@+id/worth_mentioning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="120dp"
        android:text="@string/login_three_login"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/last_login_facebook"
        android:background="@mipmap/last_login_bg"
        android:paddingLeft="@dimen/dp_4"
        android:paddingRight="@dimen/dp_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_4"
        android:text="@string/last_login"
        android:paddingHorizontal="@dimen/dp_4"
        app:layout_constraintBottom_toTopOf="@+id/action_face_book"
        app:layout_constraintEnd_toEndOf="@+id/action_face_book"
        app:layout_constraintStart_toStartOf="@+id/action_face_book"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/action_face_book"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:src="@mipmap/login_face_book"
        android:layout_marginStart="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/action_google_login"
        app:layout_constraintTop_toBottomOf="@+id/worth_mentioning"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/white"
        android:id="@+id/last_login_google"
        android:background="@mipmap/last_login_bg"
        android:paddingLeft="@dimen/dp_4"
        android:paddingRight="@dimen/dp_4"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_4"
        android:text="@string/last_login"
        android:paddingHorizontal="@dimen/dp_4"
        app:layout_constraintBottom_toTopOf="@+id/action_google_login"
        app:layout_constraintEnd_toEndOf="@+id/action_google_login"
        app:layout_constraintStart_toStartOf="@+id/action_google_login"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/action_google_login"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="40dp"
        android:src="@drawable/login_google"
        android:layout_marginEnd="18dp"
        app:layout_constraintEnd_toStartOf="@+id/action_face_book"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/worth_mentioning"/>
</androidx.constraintlayout.widget.ConstraintLayout>

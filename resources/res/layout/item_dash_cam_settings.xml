<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_dash_cam_settings_0"
    android:paddingLeft="@dimen/dp_16"
    android:paddingTop="@dimen/dp_16"
    android:paddingRight="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/color_242942_white"
        android:id="@+id/txt_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_icon"
        app:layout_constraintStart_toEndOf="@+id/img_icon"
        app:layout_constraintTop_toTopOf="@+id/img_icon"
        style="@style/Text_14_Regular"/>
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/color_8C8C8E_999999"
        android:id="@+id/txt_options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toStartOf="@+id/img_right_arrow"
        app:layout_constraintTop_toTopOf="@+id/txt_name"
        style="@style/Text_14_Regular"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_right_arrow"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@mipmap/ic_right_next"
        app:layout_constraintBottom_toBottomOf="@+id/txt_options"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_options"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/color_black_3_white_3"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_icon"/>
</androidx.constraintlayout.widget.ConstraintLayout>

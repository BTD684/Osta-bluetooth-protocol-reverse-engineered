<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.input.YadeaInputEditLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:hint_text="Enter phone"
        app:hint_text_bold="true"
        app:input_text_margin_right="0dp"
        app:input_text_size="14sp"
        app:input_text_type="text_phone"
        app:name_text="Phone"
        app:name_text_bold="true"/>
    <com.yadea.widget.input.YadeaInputEditLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:hint_text="Enter email"
        app:hint_text_bold="true"
        app:input_text_margin_right="0dp"
        app:input_text_size="14sp"
        app:input_text_type="text_email"
        app:name_text="Email"
        app:name_text_bold="true"/>
    <com.yadea.widget.input.YadeaInputEditLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:hint_text="Enter password(6-18 characters)"
        app:hint_text_bold="true"
        app:input_edit_clear="true"
        app:input_text_margin_right="0dp"
        app:input_text_size="14sp"
        app:input_text_type="text_password"
        app:name_text="Password"
        app:name_text_bold="true"/>
    <com.yadea.widget.input.YadeaInputEditLayout
        android:id="@+id/edit_verify"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:hint_text="Enter Verification code"
        app:hint_text_bold="true"
        app:input_text_margin_right="0dp"
        app:input_text_size="14sp"
        app:input_text_type="text_verify_code"
        app:name_text="Verify Code"
        app:name_text_bold="true"
        app:send_text="SEND"/>
</androidx.appcompat.widget.LinearLayoutCompat>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="#99000000"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:id="@+id/iv_front_action"
            android:layout_width="@dimen/x144"
            android:layout_height="@dimen/x144"/>
        <TextView
            android:textSize="@dimen/x104"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/y36"/>
        <TextView
            android:textSize="@dimen/x56"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="后"/>
        <TextView
            android:textSize="@dimen/x96"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:id="@+id/tv_next_road"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/y96"/>
    </LinearLayout>
</RelativeLayout>

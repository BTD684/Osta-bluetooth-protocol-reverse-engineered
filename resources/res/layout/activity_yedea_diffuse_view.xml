<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.circleView.YedeaDiffuseView
        android:id="@+id/diffuse_view"
        android:layout_width="320dp"
        android:layout_height="320dp"
        app:diffuse_color="@color/brand_color_deputy"
        app:diffuse_core_circle_size="90"
        app:diffuse_core_color="@color/brand_color_deputy"
        app:diffuse_count="3"
        app:diffuse_speed="2"
        app:diffuse_stroke_width="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

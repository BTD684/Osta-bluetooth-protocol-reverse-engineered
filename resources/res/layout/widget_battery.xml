<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/battery_root"
    android:background="@drawable/bg_app_widget"
    android:layout_width="135dp"
    android:layout_height="135dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_no_car"
        android:padding="12dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@mipmap/ic_logo_widget"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:ellipsize="end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:maxLines="1"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#8c8c8e"
            android:id="@+id/tv_no_car_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_car_normal"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:ellipsize="end"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:maxLines="1"/>
        <TextView
            android:textSize="10sp"
            android:textColor="#8c8c8e"
            android:id="@+id/tv_name_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="更多详情"
            android:drawablePadding="8dp"
            android:drawableEnd="@mipmap/ic_detail"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_battery"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="雅迪 VFLY L100"
            android:maxLines="1"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_battery_single"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <FrameLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="35dp"
                    android:layout_marginEnd="16dp">
                    <ProgressBar
                        android:id="@+id/progress"
                        android:background="@mipmap/ic_battery_stroke"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        android:paddingStart="4dp"
                        android:paddingEnd="8dp"
                        android:paddingVertical="4dp"
                        style="@style/BatteryProgressBarWidget"/>
                    <ImageView
                        android:id="@+id/iv_battery_zero"
                        android:background="@mipmap/ic_battery_zero_stroke"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                    <ImageView
                        android:id="@+id/iv_battery_null"
                        android:background="@mipmap/ic_single_battery_null"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
                <TextView
                    android:textSize="12sp"
                    android:id="@+id/tv_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textFontWeight="400"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_battery_double"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#8c8c8e"
                        android:id="@+id/txt_home_batter_battery_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#8c8c8e"
                        android:id="@+id/tv_battery_a"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="2dp">
                    <ProgressBar
                        android:id="@+id/progress_a"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progress="0"
                        style="@style/DoubleBatteryProgressBarWidget"/>
                    <ImageView
                        android:id="@+id/iv_battery_zero_a"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@mipmap/ic_double_battery_zero"/>
                </FrameLayout>
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">
                    <TextView
                        android:textSize="10sp"
                        android:textColor="#8c8c8e"
                        android:id="@+id/txt_home_batter_battery_b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="#8c8c8e"
                        android:id="@+id/tv_battery_b"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--%"
                        android:layout_alignParentEnd="true"/>
                </RelativeLayout>
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="2dp">
                    <ProgressBar
                        android:id="@+id/progress_b"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:max="100"
                        android:progress="0"
                        style="@style/DoubleBatteryProgressBarWidget"/>
                    <ImageView
                        android:id="@+id/iv_battery_zero_b"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@mipmap/ic_double_battery_zero"/>
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="#8c8c8e"
                android:id="@+id/tv_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● "/>
            <TextView
                android:textSize="12sp"
                android:textColor="#8c8c8e"
                android:ellipsize="end"
                android:id="@+id/tv_status_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/c_bg2"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_back"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_width="48dp"
        android:layout_height="50dp"
        android:src="@drawable/theme_ivi_common_title_ic_back"
        android:scaleType="centerInside"
        android:paddingStart="16dp"
        android:paddingEnd="0dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_verify_fail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_invalid"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/theme_ivi_common_img_pay"/>
        <TextView
            android:textSize="@dimen/t_2"
            android:textColor="@color/c_t2"
            android:gravity="center_horizontal"
            android:layout_gravity="center_horizontal"
            android:id="@+id/tv_invalid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/moto_key_check_fail"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/root_dialog_loading_view"
        android:background="@drawable/theme_bg_dialog_progress"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/view_loading_progress"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:indeterminateDrawable="@drawable/theme_ivi_common_loading_ic_cartoon"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="@dimen/t_2"
            android:layout_gravity="center"
            android:id="@+id/tv_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_loading"
            android:maxLines="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/csl_net_error"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_back">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/gl_1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.2"/>
        <ImageView
            android:id="@+id/iv_net_error"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/theme_ivi_common_img_wifi"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/gl_1"/>
        <TextView
            android:textSize="@dimen/t_2"
            android:textColor="@color/c_t2"
            android:gravity="center"
            android:id="@+id/tv_net_error"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/please_check_net_work"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_net_error"
            app:layout_constraintWidth_percent="0.8"/>
        <TextView
            android:textSize="@dimen/t_2"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:id="@+id/tv_retry"
            android:background="@drawable/theme_key_invalid_bg"
            android:layout_width="0dp"
            android:layout_height="@dimen/b_2"
            android:layout_marginBottom="72dp"
            android:text="@string/easyconn_retry"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="4:1"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

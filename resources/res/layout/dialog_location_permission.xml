<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_location_permission_0"
    android:background="@drawable/corners_solid_block_color_main_14"
    android:paddingTop="8dp"
    android:layout_width="303dp"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/txt_title"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/location_permissions"
        android:maxLines="1"
        android:lines="1"
        android:singleLine="true"
        android:layout_weight="1"
        android:paddingHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/text_line_color_deputy_dark"
        android:id="@+id/txt_info"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:scrollbars="vertical"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxHeight="@dimen/dp_200"
        android:text="@string/location_permissions_content"
        android:layout_weight="1"
        android:paddingHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_title"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_info"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_deputy_dark"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/Cancel"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
        app:layout_constraintEnd_toEndOf="@+id/view_center_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
    <View
        android:id="@+id/view_center_line"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="1dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/sure"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view_center_line"
        app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>

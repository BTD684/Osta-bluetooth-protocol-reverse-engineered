<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_privacy_set_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/user_about_yadea_privacy_set"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/vehicle_notification_scroll"
        android:visibility="visible"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/block_color_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.yadea.widget.textItem.YadeaTextItemLayout
                    android:id="@+id/privacy_set_privacy_permission"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64"
                    android:layout_marginLeft="@dimen/dp_22"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_marginRight="@dimen/dp_22"
                    android:layout_marginHorizontal="@dimen/dp_22"
                    app:itemName="@string/user_about_yadea_privacy_policy_permission"
                    app:itemNameAppearance="@style/itemName"
                    app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.switchItem.YedeaOldSwitch
                    android:id="@+id/privacy_permission_switch"
                    android:layout_marginRight="@dimen/dp_40"
                    android:checked="false"
                    app:layout_constraintBottom_toBottomOf="@+id/privacy_set_privacy_permission"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintLeft_toLeftOf="@+id/privacy_set_privacy_permission"
                    app:layout_constraintRight_toRightOf="@+id/privacy_set_privacy_permission"
                    app:layout_constraintTop_toTopOf="@+id/privacy_set_privacy_permission"
                    style="@style/CarSettingSwitch"/>
                <com.yadea.widget.textItem.YadeaTextItemLayout
                    android:id="@+id/privacy_set_user_info_list"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64"
                    android:layout_marginLeft="@dimen/dp_22"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_22"
                    android:layout_marginHorizontal="@dimen/dp_22"
                    app:itemName="@string/user_about_yadea_user_info_list"
                    app:itemNameAppearance="@style/itemName"
                    app:itemRightIcon="@mipmap/widget_ic_right_next"
                    app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                    app:layout_constraintTop_toBottomOf="@+id/privacy_set_privacy_permission"/>
                <com.yadea.widget.textItem.YadeaTextItemLayout
                    android:id="@+id/privacy_set_mail_subscription"
                    android:tag="binding_1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64"
                    android:layout_marginLeft="@dimen/dp_22"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_22"
                    android:layout_marginHorizontal="@dimen/dp_22"
                    app:itemName="@string/user_about_yadea_mail_subscription"
                    app:itemNameAppearance="@style/itemName"
                    app:itemRightIcon="@mipmap/widget_ic_right_next"
                    app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                    app:layout_constraintTop_toBottomOf="@+id/privacy_set_user_info_list"/>
                <com.yadea.widget.textItem.YadeaTextItemLayout
                    android:id="@+id/privacy_set_vehicle_location"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64"
                    android:layout_marginLeft="@dimen/dp_22"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_22"
                    android:layout_marginHorizontal="@dimen/dp_22"
                    app:itemName="@string/user_about_yadea_vehicle_location"
                    app:itemNameAppearance="@style/itemName"
                    app:itemRightIcon="@mipmap/widget_ic_right_next"
                    app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                    app:layout_constraintTop_toBottomOf="@+id/privacy_set_mail_subscription"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>

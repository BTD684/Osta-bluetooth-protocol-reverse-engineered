<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_bind_email_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:rightTitle="  "
        app:rightTitleAppearance="@style/rightTitleSize18"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/login_bind_email"
        android:layout_marginStart="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <com.yadea.widget.input.YadeaInputEditLayout
        android:id="@+id/edit_email"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="54dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:hint_text="@string/login_enter_email"
        app:input_edit_clear="true"
        app:input_edit_max_length="50"
        app:input_line_background="@color/color_8C8C8E_333333"
        app:input_text_margin_right="@dimen/dp_0"
        app:input_text_size="14sp"
        app:input_text_type="text_email"
        app:layout_constraintStart_toStartOf="@+id/txt_label"
        app:layout_constraintTop_toBottomOf="@+id/txt_label"
        app:name_text="@string/user_personal_mail"
        app:name_text_bold="true"/>
    <com.yadea.widget.input.YadeaInputEditLayout
        android:id="@+id/edit_verify_code"
        android:tag="binding_2"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:hint_text="@string/login_register_enter_verification_code"
        app:input_line_background="@color/color_8C8C8E_333333"
        app:input_text_margin_right="@dimen/dp_0"
        app:input_text_size="14sp"
        app:input_text_type="text_verify_code"
        app:layout_constraintTop_toBottomOf="@+id/edit_email"
        app:name_text="@string/login_register_verify_code"
        app:name_text_bold="true"
        app:send_text="@string/user_dialog_verify_code_send"/>
    <com.yadea.widget.input.YadeaInputEditLayout
        android:id="@+id/edit_password"
        android:tag="binding_3"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:hint_text="@string/login_enter_password"
        app:input_line_background="@color/color_8C8C8E_333333"
        app:input_text_margin_right="@dimen/dp_0"
        app:input_text_size="14sp"
        app:input_text_type="text_password"
        app:layout_constraintTop_toBottomOf="@+id/edit_verify_code"
        app:name_text="@string/login_password"
        app:name_text_bold="true"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/block_color_main"
        android:gravity="center"
        android:id="@+id/action_login"
        android:tag="binding_4"
        android:background="@drawable/corners_text_line_color_main_radius_14"
        android:layout_width="0dp"
        android:layout_height="46dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="30dp"
        android:layout_marginRight="22dp"
        android:text="@string/login_bind_email_next"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_password"/>
</androidx.constraintlayout.widget.ConstraintLayout>

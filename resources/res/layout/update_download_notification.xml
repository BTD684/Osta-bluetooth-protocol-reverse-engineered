<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:background="@android:color/transparent"
    android:padding="@dimen/x20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/iv_icon"
        android:background="@drawable/icon"
        android:layout_width="@dimen/x150"
        android:layout_height="@dimen/x150"
        android:layout_centerVertical="true"/>
    <ProgressBar
        android:id="@+id/pb"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/x42"
        android:max="100"
        android:progress="10"
        android:progressDrawable="@drawable/update_progress_noitify_layer"
        android:layout_toRightOf="@+id/iv_icon"
        android:layout_centerVertical="true"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent.Title"
        android:textSize="@dimen/x42"
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x42"
        android:text="@string/app_name_icon"
        android:layout_toRightOf="@+id/iv_icon"/>
    <TextView
        android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent"
        android:textSize="@dimen/x30"
        android:id="@+id/tv_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x42"
        android:layout_marginBottom="@dimen/x10"
        android:text="@string/update_download_progress"
        android:layout_toRightOf="@+id/iv_icon"
        android:layout_alignBottom="@+id/iv_icon"/>
    <TextView
        android:textAppearance="@android:style/TextAppearance.StatusBar.EventContent"
        android:textSize="@dimen/x30"
        android:id="@+id/tv_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/update_download_total"
        android:layout_alignBottom="@+id/iv_icon"
        android:layout_alignParentRight="true"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:tag="layout/bottom_vehicle_menu_layout_0"
    android:background="@drawable/corners_solid_top_block_color_background_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/txt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/guide_device_manager"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_head"
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_vehicle_next"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:src="@mipmap/widget_ic_right_next"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_head"
        app:layout_constraintEnd_toEndOf="@+id/view_head"
        app:layout_constraintTop_toTopOf="@+id/view_head"/>
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_vehicle_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@mipmap/home_ic_vehicle"
        android:layout_marginStart="43dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_head"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_head"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:ellipsize="end"
        android:id="@+id/txt_vehicle_name"
        android:layout_width="0dp"
        android:layout_height="22dp"
        android:lines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/txt_vehicle_desc"
        app:layout_constraintEnd_toStartOf="@+id/img_vehicle_next"
        app:layout_constraintStart_toEndOf="@+id/img_vehicle_icon"
        app:layout_constraintTop_toTopOf="@+id/view_head"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_deputy_dark"
        android:id="@+id/txt_vehicle_desc"
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_head"
        app:layout_constraintStart_toStartOf="@+id/txt_vehicle_name"
        app:layout_constraintTop_toBottomOf="@+id/txt_vehicle_name"
        app:layout_constraintVertical_chainStyle="packed"/>
    <com.yadea.widget.textItem.YadeaTextItemLayout
        android:id="@+id/action_vehicle_setting"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:isItemTop="true"
        app:itemBottomLineAppearance="@style/itemLine"
        app:itemLeftIcon="@mipmap/home_ic_vehicle_setting"
        app:itemName="@string/home_dialog_vehicle_setting"
        app:itemRightIcon="@mipmap/widget_ic_right_next"
        app:itemRightIconAppearance="@style/itemRightIcon_14dp"
        app:layout_constraintTop_toBottomOf="@+id/view_head"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/ll_menus"
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintTop_toBottomOf="@+id/view_head">
        <com.yadea.widget.textItem.YadeaTextItemLayout
            android:id="@+id/action_devices_info"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:itemBottomLineAppearance="@style/itemLine"
            app:itemLeftIcon="@mipmap/home_ic_scooter_device_info"
            app:itemName="@string/vehicle_scooter_device_info"
            app:itemRightIcon="@mipmap/widget_ic_right_next"
            app:itemRightIconAppearance="@style/itemRightIcon_14dp"/>
        <com.yadea.widget.textItem.YadeaTextItemLayout
            android:id="@+id/action_iot_service"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:itemBottomLineAppearance="@style/itemLine"
            app:itemLeftIcon="@mipmap/home_ic_vehicle_iot_service"
            app:itemName="@string/iot_service"
            app:itemRightIcon="@mipmap/widget_ic_right_next"
            app:itemRightIconAppearance="@style/itemRightIcon_14dp"
            app:itemRightSubIconAppearance="@style/itemRightSubIcon_8dp"/>
        <com.yadea.widget.textItem.YadeaTextItemLayout
            android:id="@+id/action_firmware_update"
            android:tag="binding_2"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:itemBottomLineAppearance="@style/itemLine"
            app:itemLeftIcon="@mipmap/home_ic_scooter_device_update"
            app:itemName="@string/home_dialog_firmware_update"
            app:itemRightIcon="@mipmap/widget_ic_right_next"
            app:itemRightIconAppearance="@style/itemRightIcon_14dp"
            app:itemRightSubIcon="@drawable/corners_solid_state_color_red"
            app:itemRightSubIconAppearance="@style/itemRightSubIcon_8dp"/>
        <com.yadea.widget.textItem.YadeaTextItemLayout
            android:id="@+id/action_vehicle_firmware_update"
            android:tag="binding_3"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:itemLeftIcon="@mipmap/home_ic_vehicle_device_update"
            app:itemName="@string/home_dialog_firmware_update"
            app:itemRightIcon="@mipmap/widget_ic_right_next"
            app:itemRightIconAppearance="@style/itemRightIcon_14dp"
            app:itemRightSubIcon="@drawable/corners_solid_state_color_red"
            app:itemRightSubIconAppearance="@style/itemRightSubIcon_8dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/action_switch_device"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="23dp"
        android:text="@string/home_dialog_switch_device"
        android:layout_marginHorizontal="23dp"
        app:layout_constraintTop_toBottomOf="@+id/ll_menus"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/action_bind_parts"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="23dp"
        android:text="@string/ble_key_bind_parts"
        android:layout_marginHorizontal="23dp"
        app:layout_constraintTop_toBottomOf="@+id/action_switch_device"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/action_bind_vehicle"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="23dp"
        android:text="@string/home_dialog_bind_scooter"
        android:layout_marginHorizontal="23dp"
        app:layout_constraintTop_toBottomOf="@+id/action_bind_parts"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/state_color_red"
        android:gravity="center"
        android:id="@+id/action_unbind_vehicle"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="23dp"
        android:layout_marginBottom="34dp"
        android:text="@string/home_dialog_unbind_scooter"
        android:layout_marginHorizontal="23dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bind_vehicle"/>
</androidx.constraintlayout.widget.ConstraintLayout>

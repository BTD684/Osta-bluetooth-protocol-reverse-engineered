<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/c_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.04"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.96"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_card"
        android:background="@drawable/selector_list_item_bg"
        android:layout_width="0dp"
        android:layout_height="68dp"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/guideline2"
        app:layout_constraintStart_toStartOf="@+id/guideline"
        app:layout_constraintTop_toTopOf="parent">
        <View
            android:background="@drawable/theme_ivi_toc_img_member_texture"
            android:layout_width="0dp"
            android:layout_height="37dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/t_1"
            android:textColor="@color/c_t1"
            android:id="@+id/tv_user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:layout_width="96dp"
            android:layout_height="68dp"
            android:src="@drawable/theme_ivi_toc_img_member_vip"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t2"
        android:gravity="center"
        android:id="@+id/tv_plan"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/current_plan"
        app:layout_constraintStart_toStartOf="@+id/cl_card"
        app:layout_constraintTop_toBottomOf="@+id/cl_card"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/cl_card"
        app:layout_constraintStart_toStartOf="@+id/cl_card"
        app:layout_constraintTop_toBottomOf="@+id/tv_plan"/>
</androidx.constraintlayout.widget.ConstraintLayout>

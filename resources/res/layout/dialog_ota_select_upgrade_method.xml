<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_ota_select_upgrade_method_0"
    android:background="@drawable/corners_solid_block_color_main_radius_14"
    android:layout_width="303dp"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/ota_please_choose_method"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <RelativeLayout
        android:id="@+id/rl_iot_upgrade"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/dialog_title">
        <CheckBox
            android:id="@+id/check_iot_upgrade"
            android:background="@drawable/ota_upgrade_check_box_style"
            android:clickable="false"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:checked="true"
            android:button="@null"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_18"
            android:layout_alignParentEnd="true"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:ellipsize="end"
            android:id="@+id/txt_iot_upgrade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/ota_upgrade_network"
            android:lines="1"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_44"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/txt_iot_upgrade_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_marginBottom="@dimen/sp_16"
            android:layout_below="@+id/txt_iot_upgrade"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_44"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_ble_upgrade"
        android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/rl_iot_upgrade">
        <CheckBox
            android:id="@+id/check_ble_upgrade"
            android:background="@drawable/ota_upgrade_check_box_style"
            android:clickable="false"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:checked="false"
            android:button="@null"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/dp_18"
            android:layout_alignParentEnd="true"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:ellipsize="end"
            android:id="@+id/txt_iot_upgrade1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/ota_upgrade_ble"
            android:lines="1"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_44"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/txt_ble_upgrade_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            android:layout_marginBottom="@dimen/sp_16"
            android:layout_below="@+id/txt_iot_upgrade1"
            android:layout_marginStart="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_44"/>
    </RelativeLayout>
    <View
        android:id="@+id/view_line"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_ble_upgrade"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:text="@string/ota_not_yet"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
        app:layout_constraintEnd_toEndOf="@+id/view_center_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
    <View
        android:id="@+id/view_center_line"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="@dimen/dp_1"
        android:layout_height="@dimen/dp_64"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:text="@string/login_bind_email_next"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view_center_line"
        app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>

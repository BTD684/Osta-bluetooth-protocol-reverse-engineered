<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_add_effect_0"
    android:background="@color/colorSoundBg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/custom_add_record_audio_title"/>
    <com.shuyu.waveview.AudioWaveView
        android:id="@+id/soundAudioWave"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_100"
        android:layout_marginTop="68dp"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"
        app:gsyWaveColor="@color/color_4075ff"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <ImageView
        android:id="@+id/ivPointer"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@mipmap/record_point"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="@+id/soundAudioWave"
        app:layout_constraintLeft_toLeftOf="@+id/soundAudioWave"
        app:layout_constraintTop_toTopOf="@+id/soundAudioWave"/>
    <SeekBar
        android:id="@+id/seekBar_sound"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_4"
        android:layout_marginTop="@dimen/dp_20"
        android:max="400"
        android:progressDrawable="@drawable/shape_progressbar_bg"
        android:thumb="@null"
        android:thumbOffset="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_24"
        android:splitTrack="false"
        app:layout_constraintBottom_toTopOf="@+id/tv_sound_total_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/soundAudioWave"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorCustomRight"
        android:gravity="center"
        android:id="@+id/tv_sound_start_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="0S"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar_sound"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorCustomRight"
        android:gravity="center"
        android:id="@+id/tv_sound_end_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:text="4S"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar_sound"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="28sp"
        android:textColor="@color/color_000000_ffffff"
        android:gravity="center"
        android:id="@+id/tv_sound_total_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_60"
        android:text="0.0S"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/seekBar_sound"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colorCustomRight"
        android:id="@+id/tv_record_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/recordings_can_be_uploaded_for_up_to_4_seconds"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_sound_total_time"/>
    <org.libpag.PAGImageView
        android:id="@+id/iv_pag_record"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_marginBottom="78dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_effect_next"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_record"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:src="@mipmap/icon_effect_start_record"
        app:layout_constraintBottom_toBottomOf="@+id/iv_pag_record"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_pag_record"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_000000_ffffff"
        android:id="@+id/tv_record_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="104dp"
        android:text="@string/custom_long_press_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_record"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colorCustomRight"
        android:gravity="center"
        android:id="@+id/tv_record_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_2"
        android:text="@string/custom_clear_title"
        android:drawableTop="@mipmap/icon_effect_record_delete"
        android:drawablePadding="@dimen/dp_16"
        android:layout_marginEnd="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_record_status"
        app:layout_constraintRight_toLeftOf="@+id/iv_record"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/colorCustomRight"
        android:gravity="center"
        android:id="@+id/tv_record_audition"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_2"
        android:text="@string/custom_audition_title"
        android:drawableTop="@mipmap/icon_effect_play"
        android:drawablePadding="@dimen/dp_16"
        android:layout_marginStart="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_record_status"
        app:layout_constraintStart_toEndOf="@+id/iv_record"/>
    <View
        android:id="@+id/view_custom_line"
        android:background="@color/colorCustomLine"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_effect_next"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/colorNext"
        android:gravity="center"
        android:id="@+id/btn_effect_next"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:layout_width="0dp"
        android:layout_height="51dp"
        android:layout_marginBottom="@dimen/dp_40"
        android:text="@string/login_bind_email_next"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_phone_function_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/phone_number"/>
    <com.yadea.widget.textItem.YadeaTextItemLayout
        android:id="@+id/item_txt_change"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="23dp"
        android:layout_marginHorizontal="23dp"
        app:itemName="@string/change_phone"
        app:itemNameAppearance="@style/itemName"
        app:itemRightIcon="@mipmap/widget_ic_right_next"
        app:itemRightIconAppearance="@style/itemRightIcon_14dp"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <com.yadea.widget.textItem.YadeaTextItemLayout
        android:id="@+id/item_txt_setting"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="23dp"
        android:layout_marginHorizontal="23dp"
        app:itemName="@string/setting_login_password"
        app:itemNameAppearance="@style/itemName"
        app:itemRightIcon="@mipmap/widget_ic_right_next"
        app:itemRightIconAppearance="@style/itemRightIcon_14dp"
        app:layout_constraintTop_toBottomOf="@+id/item_txt_change"/>
</androidx.constraintlayout.widget.ConstraintLayout>

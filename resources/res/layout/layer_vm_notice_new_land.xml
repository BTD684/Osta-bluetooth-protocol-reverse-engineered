<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vg_dialog"
        android:background="@color/c_popup_bg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.73">
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:lines="1"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <net.easyconn.carman.common.view.NormalWebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toTopOf="@+id/lineout_line"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/lineout_line"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/web_view">
            <CheckBox
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:id="@+id/cb_agree"
                android:background="@drawable/theme_ivi_third_ic_checkbox"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:button="@null"/>
            <TextView
                android:textSize="@dimen/t_4"
                android:id="@+id/tv_agree"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_navy"
            android:id="@+id/tv_notice"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/vm_notice_for_use"
            app:layout_constraintBottom_toBottomOf="@+id/lineout_line"
            app:layout_constraintStart_toEndOf="@+id/lineout_line"
            app:layout_constraintTop_toTopOf="@+id/lineout_line"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t1"
            android:gravity="center"
            android:id="@+id/tv_close"
            android:background="@drawable/theme_bg_dialog_button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/close"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_ok"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t_popup"
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:background="@drawable/theme_bg_dialog_button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/try_now_new"
            android:alpha="0.2"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_close"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

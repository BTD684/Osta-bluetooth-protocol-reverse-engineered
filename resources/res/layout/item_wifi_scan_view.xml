<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/t_2"
        android:textColor="@color/c_t2"
        android:id="@+id/tv_scan_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scan_by_hand"
        android:layout_marginStart="40dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_scan_desc"
        android:background="@drawable/shape_usb_connect_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_scan_desc"
        app:layout_constraintWidth_percent="0.94">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_scan_desc"
            android:layout_width="290dp"
            android:layout_height="160dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/theme_ivi_connect_img_wireless_pair"/>
        <TextView
            android:textSize="@dimen/t_1"
            android:textColor="@color/c_t3"
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/tv_scan"
            android:background="@drawable/selector_scan_connected"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:text="@string/start_scan"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

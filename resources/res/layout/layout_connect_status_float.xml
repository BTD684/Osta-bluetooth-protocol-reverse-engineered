<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guide_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.45"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/cl_status_click"
        android:background="@drawable/theme_ivi_connect_bt_bg"
        android:layout_width="wrap_content"
        android:layout_height="76dp"
        app:layout_constraintBottom_toBottomOf="@+id/guide_line"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:id="@+id/iv_status_icon"
            android:visibility="gone"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/theme_ivi_navhome_ic_notconnect"
            android:layout_marginStart="16dp"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:ellipsize="end"
            android:id="@+id/tv_status"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/connect_car"
            android:maxLines="2"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="10dp"/>
        <View
            android:id="@+id/v_collapse_line"
            android:visibility="gone"
            android:layout_width="4dp"
            android:layout_height="32dp"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_ble_base_bg"
    android:layout_width="@dimen/x1014"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_middle54"
        android:textColor="#4f4f4f"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/x88"
        android:layout_marginRight="@dimen/x88"
        android:text="@string/c2p_bluetooth_no_link_title"
        android:layout_weight="1"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:id="@+id/ll_checkbox"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x88"
        android:layout_marginRight="@dimen/x88"
        android:layout_marginBottom="@dimen/x66">
        <ImageView
            android:id="@+id/iv_check"
            android:layout_width="@dimen/x40"
            android:layout_height="@dimen/x40"
            android:src="@drawable/all_checkbox_button_selector"/>
        <TextView
            android:textSize="@dimen/font_size_36"
            android:textColor="#828282"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x24"
            android:text="@string/easyconn_syms_edit"/>
    </LinearLayout>
    <View
        android:background="@color/one_pixel_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x150">
        <TextView
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/dialog_ble_base_cancel_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/auto_dialog_cancel"
            android:layout_weight="1"
            style="@style/dialog_ble_base_cancel_action"/>
        <TextView
            android:gravity="center"
            android:id="@+id/tv_ok"
            android:background="@drawable/one_button_sure_selector"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/auto_dialog_ok"
            android:layout_weight="1"
            style="@style/dialog_ble_base_action"/>
    </LinearLayout>
</LinearLayout>

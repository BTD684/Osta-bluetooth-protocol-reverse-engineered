<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/c_bg"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.base.mirror.LayerStandardTitleView
        android:id="@+id/title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleName="调试"/>
    <ScrollView
        android:padding="8dp"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_view">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@drawable/debug_item_divider"
            android:dividerHeight="8dp"
            android:showDividers="middle">
            <net.easyconn.carman.system.view.DebugAppInfoItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugDeviceInfoItem
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_app_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <Button
                android:textSize="14sp"
                android:id="@+id/select_environment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="环境切换"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_aoa_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_vm2_full_app"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_support_google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_save_h264"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_show_encode_fps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_simulation_navi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_save_navigation_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_open_time_ingoogle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_show_hud_icon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_show_split_mirror"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugCheckedItem
                android:id="@+id/item_bluetooth_pair"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugVMItem
                android:id="@+id/item_pxsj_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <net.easyconn.carman.system.view.DebugAppDpiItem
                android:id="@+id/item_debug_app_dpi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@drawable/theme_ivi_virhome_img_horizontalbg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.base.mirror.LayerStandardTitleView
        android:id="@+id/title_view"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toTopOf="@+id/v_top"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_top"
        android:layout_width="30dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_introduce_img"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_view"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_introduce_img"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/v_blank"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_top"
        app:layout_constraintWidth_percent="0.75">
        <ImageView
            android:id="@+id/iv_vm_image_bg"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:src="@drawable/theme_ivi_virhome_download_img_application"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_vm_image_bg"
            app:layout_constraintEnd_toEndOf="@+id/iv_vm_image_bg"
            app:layout_constraintStart_toStartOf="@+id/iv_vm_image_bg"
            app:layout_constraintTop_toTopOf="@+id/iv_vm_image_bg">
            <View
                android:id="@+id/view_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.viewpager.widget.ViewPager>
        <net.easyconn.carman.view.DarkIndicatorView
            android:gravity="center_horizontal"
            android:id="@+id/indicator_view"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginBottom="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/view_pager"
            app:layout_constraintEnd_toEndOf="@+id/view_pager"
            app:layout_constraintStart_toStartOf="@+id/view_pager"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_blank"
        android:layout_width="30dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_introduce_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_introduce_img"/>
    <RelativeLayout
        android:gravity="center_horizontal"
        android:id="@+id/cl_introduce_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/v_blank_tv"
        app:layout_constraintEnd_toEndOf="@+id/cl_introduce_img"
        app:layout_constraintStart_toStartOf="@+id/cl_introduce_img"
        app:layout_constraintTop_toBottomOf="@+id/v_blank">
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/iv_introduce_step1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/theme_ivi_virhome_download_ic_step1"
                android:layout_marginEnd="14dp"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:gravity="center_vertical"
                android:id="@+id/tv_introduce_step1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vm_introduce_step1"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/iv_introduce_step2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/iv_introduce_step1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/theme_ivi_virhome_download_ic_step2"
                android:layout_marginEnd="14dp"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:gravity="center_vertical"
                android:id="@+id/tv_introduce_step2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vm_introduce_step2"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:id="@+id/iv_introduce_step3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_below="@+id/iv_introduce_step2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/theme_ivi_virhome_download_ic_step3"
                android:layout_marginEnd="14dp"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:gravity="center_vertical"
                android:id="@+id/tv_introduce_step3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vm_introduce_step3"/>
        </LinearLayout>
    </RelativeLayout>
    <View
        android:id="@+id/v_blank_tv"
        android:layout_width="30dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_button"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_introduce_text"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:foregroundGravity="center_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/v_blank_btn"
        app:layout_constraintEnd_toEndOf="@+id/cl_introduce_img"
        app:layout_constraintStart_toStartOf="@+id/cl_introduce_img"
        app:layout_constraintTop_toBottomOf="@+id/v_blank_tv">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/cl_download_button"
            android:background="@color/c_b2"
            android:layout_width="160dp"
            android:layout_height="@dimen/b_2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:id="@+id/iv_download_icon"
                android:padding="3dp"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/theme_ivi_music_player_ic_pause"
                android:layout_marginEnd="4dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_download"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/t_4"
                android:textColor="@color/c_t3"
                android:gravity="center"
                android:id="@+id/tv_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_download_icon"
                app:layout_constraintTop_toTopOf="parent"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t3"
            android:gravity="center"
            android:id="@+id/tv_loading"
            android:background="@color/c_b2_d"
            android:visibility="invisible"
            android:layout_width="160dp"
            android:layout_height="@dimen/b_2"
            android:text="@string/vm_start_ing"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/t_s4"
            android:textColor="@color/c_t5"
            android:gravity="center"
            android:id="@+id/tv_use_wifi"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_download_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_blank_btn"
        android:layout_width="30dp"
        android:layout_height="0dp"
        android:layout_marginBottom="43dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_button"/>
    <View
        android:id="@+id/cl_state_top"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        app:layout_constraintBottom_toTopOf="@+id/cl_state"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_state"
        android:background="@color/C_Progress_Fg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:textSize="@dimen/t_6"
            android:textColor="@color/c_t5"
            android:gravity="center_vertical"
            android:id="@+id/tv_state"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            app:layout_constraintStart_toStartOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_progress"
        android:background="#0000"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cl_state_top">
        <View
            android:id="@+id/view_progress_background"
            android:background="@color/C_Progress_Fg"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_progress_foreground"
            android:background="@color/c_b2"
            android:layout_width="41dp"
            android:layout_height="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_progress"
            android:layout_width="50dp"
            android:layout_height="match_parent"
            android:src="@drawable/theme_ivi_virtual_img_loading"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

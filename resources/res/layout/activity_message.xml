<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_message_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:rightIcon="@mipmap/user_ic_message_delete"
        app:title="@string/user_message"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <RadioGroup
                android:orientation="horizontal"
                android:id="@+id/radio_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent">
                <com.yadea.widget.font.YadeaRadioButton
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@drawable/user_text_color_corners_solid_text_line_color_main"
                    android:gravity="center"
                    android:id="@+id/tab_vehicle"
                    android:tag="binding_1"
                    android:background="@drawable/user_check_box_corners_solid_text_line_color_main"
                    android:paddingLeft="16dp"
                    android:paddingTop="8dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:button="@null"
                    android:text="@string/user_message_vehicle_message"
                    android:layout_marginStart="22dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
                <com.yadea.widget.font.YadeaRadioButton
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@drawable/user_text_color_corners_solid_text_line_color_main"
                    android:gravity="center"
                    android:id="@+id/tab_system_message"
                    android:tag="binding_2"
                    android:background="@drawable/user_check_box_corners_solid_text_line_color_main"
                    android:paddingLeft="16dp"
                    android:paddingTop="8dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:button="@null"
                    android:text="@string/user_message_system_message"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp"
                    app:layout_constraintStart_toEndOf="@+id/tab_vehicle"
                    app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
            </RadioGroup>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vehicle_message_view"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:overScrollMode="never"
                android:layout_marginVertical="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/radio_group"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/system_message_view"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:overScrollMode="never"
                android:layout_marginVertical="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/radio_group"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/general_main_item_size_1"
    android:layout_height="@dimen/general_main_item_size_2">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_main"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:id="@+id/rl_action_normal"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_normal"
                    android:paddingTop="@dimen/x72"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/x48">
                    <ImageView
                        android:id="@+id/iv_navi_icon"
                        android:layout_width="@dimen/general_main_big_icon_size"
                        android:layout_height="@dimen/general_main_big_icon_size"/>
                    <TextView
                        android:text="@string/navigation"
                        style="@style/general_main_normal_text_style"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/ll_loading"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ProgressBar
                        android:layout_gravity="center"
                        android:layout_width="@dimen/x135"
                        android:layout_height="@dimen/x135"
                        style="@style/navigation_home_wait_gps_style"/>
                    <TextView
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:id="@+id/tv_loading_hint"
                        android:paddingTop="@dimen/common_view_middle_margin"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="true"/>
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>
        <View
            android:background="@color/divide_view"
            android:visibility="gone"
            android:layout_width="@dimen/general_main_line_size"
            android:layout_height="match_parent"/>
        <RelativeLayout
            android:visibility="gone"
            android:layout_width="@dimen/general_main_small_child_size"
            android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_plan_action"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/iv_back_home"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/general_main_small_child_item_size"
                    android:scaleType="center"/>
                <ImageView
                    android:id="@+id/iv_go_company"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/general_main_small_child_item_size"
                    android:scaleType="center"/>
            </LinearLayout>
            <ImageView
                android:id="@+id/iv_stop_navigation"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="center"/>
        </RelativeLayout>
    </LinearLayout>
</FrameLayout>

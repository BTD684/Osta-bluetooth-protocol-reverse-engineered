<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_root"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RadioGroup
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/layer_phone_rg"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="92dp"
        android:showDividers="end|middle|beginning"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RadioButton
            android:textSize="@dimen/t_2"
            android:textColor="@color/theme_color_phone_text"
            android:gravity="bottom|center_horizontal"
            android:id="@+id/layer_phone_rb_history"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/callLog"
            android:singleLine="true"
            android:drawableTop="@drawable/theme_ivi_tel_tab_ic_history"
            android:layout_weight="1"/>
        <RadioButton
            android:textSize="@dimen/t_2"
            android:textColor="@color/theme_color_phone_text"
            android:gravity="center_horizontal"
            android:id="@+id/layer_phone_rb_dial"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:button="@null"
            android:text="@string/dial"
            android:singleLine="true"
            android:drawableTop="@drawable/theme_ivi_tel_tab_ic_keyboard"
            android:drawablePadding="1dp"
            android:layout_weight="1"/>
        <RadioButton
            android:textSize="@dimen/t_2"
            android:textColor="@color/theme_color_phone_text"
            android:gravity="center_horizontal"
            android:id="@+id/layer_phone_rb_contact"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:button="@null"
            android:text="@string/contact"
            android:singleLine="true"
            android:drawableTop="@drawable/theme_ivi_tel_tab_ic_contacts"
            android:drawablePadding="1dp"
            android:layout_weight="1"/>
    </RadioGroup>
    <ViewAnimator
        android:id="@+id/view_animator_phone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layer_phone_rg"
        app:layout_goneMarginTop="92dp">
        <ListView
            android:id="@+id/layer_lv_call_log"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/transparent"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <ListView
            android:id="@+id/layer_lv_call_contact"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/transparent"
            android:dividerHeight="4dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <net.easyconn.carman.view.MirrorCommonEmptyView
            android:id="@+id/ll_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <net.easyconn.carman.view.MirrorLoadingView
            android:id="@+id/loading_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </ViewAnimator>
    <EditText
        android:textSize="@dimen/t_8"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/et_input"
        android:background="@drawable/shape_phone_input_bg"
        android:paddingLeft="16dp"
        android:paddingRight="56dp"
        android:longClickable="false"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:lines="1"
        android:singleLine="true"
        android:textCursorDrawable="@drawable/theme_edittext_cursor"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layer_phone_rg"/>
    <ImageView
        android:id="@+id/iv_delete"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_tel_title_ic_backspace"
        android:scaleType="centerInside"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintRight_toRightOf="@+id/et_input"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
    <ListView
        android:id="@+id/layer_lv_search_contact"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:divider="@color/transparent"
        android:dividerHeight="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/layer_rl_dail_layout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_input"/>
    <net.easyconn.carman.phone.layer.DialView
        android:id="@+id/layer_rl_dail_layout"
        android:focusable="true"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.4"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

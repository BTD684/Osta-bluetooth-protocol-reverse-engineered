<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/c_bg"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.base.mirror.LayerStandardTitleView
        android:id="@+id/system_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/L_t"
        app:layout_constraintTop_toTopOf="parent"
        app:titleName="@string/logoff_account_title"/>
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:src="@drawable/cancleaccount_icon"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        android:layout_weight="1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:focusable="true"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp">
            <TextView
                android:textSize="@dimen/t_4"
                android:textColor="@color/c_t1"
                android:id="@+id/logoff_content_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logoff_content_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/t_4"
                android:textColor="@color/c_t1"
                android:id="@+id/logoff_content_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/logoff_content_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/logoff_content_1"/>
            <TextView
                android:textSize="@dimen/t_6"
                android:textColor="@color/c_t1"
                android:id="@+id/logoff_text_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/logoff_text_1"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/shape_logoff_dot"
                app:layout_constraintEnd_toEndOf="@+id/logoff_text_2"
                app:layout_constraintStart_toStartOf="@+id/logoff_text_2"
                app:layout_constraintTop_toBottomOf="@+id/logoff_content_2"/>
            <TextView
                android:textSize="@dimen/t_6"
                android:textColor="@color/c_t1"
                android:id="@+id/logoff_text_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logoff_text_2"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/shape_logoff_dot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/logoff_text_1"/>
            <TextView
                android:textSize="@dimen/t_6"
                android:textColor="@color/c_t1"
                android:id="@+id/logoff_text_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/logoff_text_3"
                android:drawablePadding="5dp"
                android:drawableStart="@drawable/shape_logoff_dot"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/logoff_text_2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_w_r"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_logoff"
        android:background="@drawable/system_logout_selector"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp"
        android:text="@string/logoff"
        android:singleLine="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"/>
</LinearLayout>

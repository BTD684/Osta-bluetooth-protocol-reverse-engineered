<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_child0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_home"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <ImageView
            android:id="@+id/iv_recent"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <ImageView
            android:id="@+id/iv_settings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/theme_vm2_setting"/>
        <ImageView
            android:id="@+id/iv_upload"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/theme_ivi_float_ic_report"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:id="@+id/tv_dpi_first"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:id="@+id/tv_resolution"
            android:visibility="gone"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_child1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/iv_dpi_enlarge"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="3dp"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:id="@+id/tv_dpi"
            android:layout_width="40dp"
            android:layout_height="40dp"/>
        <ImageView
            android:id="@+id/iv_dpi_reduce"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="3dp"/>
        <ImageView
            android:id="@+id/iv_dpi_confirm"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="3dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_child2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:id="@+id/tv_resolution_fullscreen"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="3dp"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:id="@+id/tv_resolution_2x1"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="3dp"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:id="@+id/tv_resolution_16x9"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="3dp"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:id="@+id/tv_resolution_4x3"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="3dp"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:id="@+id/tv_resolution_3x4"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_margin="3dp"/>
    </LinearLayout>
</merge>

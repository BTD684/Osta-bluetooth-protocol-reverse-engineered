<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_one"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"/>
    <View
        android:id="@+id/view2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_one"
        app:layout_constraintStart_toEndOf="@+id/view1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"/>
    <View
        android:id="@+id/view3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_one"
        app:layout_constraintStart_toEndOf="@+id/view2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"/>
    <View
        android:id="@+id/view4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_one"
        app:layout_constraintStart_toEndOf="@+id/view3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.25"/>
    <View
        android:id="@+id/bg_one"
        android:background="@drawable/corners_solid_green_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_one"
        app:layout_constraintStart_toStartOf="@+id/tv_one"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_one"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_one"
        app:layout_constraintEnd_toEndOf="@+id/bg_one"
        app:layout_constraintStart_toStartOf="@+id/bg_one"
        app:layout_constraintTop_toTopOf="@+id/bg_one"/>
    <org.libpag.PAGImageView
        android:id="@+id/iv_pag_one"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="@+id/iv_one"
        app:layout_constraintTop_toTopOf="@+id/iv_one"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/tv_one"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bg_one"/>
    <View
        android:id="@+id/bg_two"
        android:background="@drawable/corners_solid_orange_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_two"
        app:layout_constraintStart_toStartOf="@+id/tv_two"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_two"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_two"
        app:layout_constraintEnd_toEndOf="@+id/bg_two"
        app:layout_constraintStart_toStartOf="@+id/bg_two"
        app:layout_constraintTop_toTopOf="@+id/bg_two"/>
    <org.libpag.PAGImageView
        android:id="@+id/iv_pag_two"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="@+id/iv_two"
        app:layout_constraintTop_toTopOf="@+id/iv_two"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/tv_two"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_three"
        app:layout_constraintStart_toEndOf="@+id/tv_one"
        app:layout_constraintTop_toBottomOf="@+id/bg_two"/>
    <View
        android:id="@+id/bg_three"
        android:background="@drawable/corners_solid_blue_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_three"
        app:layout_constraintStart_toStartOf="@+id/tv_three"
        app:layout_constraintTop_toTopOf="@+id/view3"/>
    <ImageView
        android:id="@+id/iv_three"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_three"
        app:layout_constraintEnd_toEndOf="@+id/bg_three"
        app:layout_constraintStart_toStartOf="@+id/bg_three"
        app:layout_constraintTop_toTopOf="@+id/bg_three"/>
    <org.libpag.PAGImageView
        android:id="@+id/iv_pag_three"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="@+id/iv_three"
        app:layout_constraintTop_toTopOf="@+id/iv_three"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/tv_three"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toStartOf="@+id/tv_four"
        app:layout_constraintStart_toEndOf="@+id/tv_two"
        app:layout_constraintTop_toBottomOf="@+id/bg_three"/>
    <View
        android:id="@+id/bg_four"
        android:background="@drawable/corners_solid_red_bg"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_four"
        app:layout_constraintStart_toStartOf="@+id/tv_four"
        app:layout_constraintTop_toTopOf="@+id/view4"/>
    <ImageView
        android:id="@+id/iv_four"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_four"
        app:layout_constraintEnd_toEndOf="@+id/bg_four"
        app:layout_constraintStart_toStartOf="@+id/bg_four"
        app:layout_constraintTop_toTopOf="@+id/bg_four"/>
    <org.libpag.PAGImageView
        android:id="@+id/iv_pag_four"
        android:visibility="gone"
        android:layout_width="32dp"
        android:layout_height="32dp"
        app:layout_constraintStart_toStartOf="@+id/iv_four"
        app:layout_constraintTop_toTopOf="@+id/iv_four"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/tv_four"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bg_four"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/optConstraint"
    android:background="@color/bg_ffffff_121212"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">
    <com.yadea.widget.font.YadeaTextView
        android:gravity="center"
        android:id="@+id/txt_select_all"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:text="@string/dash_cam_select_all"
        android:layout_weight="1"
        app:drawableTopCompat="@mipmap/icon_select_all"/>
    <com.yadea.widget.font.YadeaTextView
        android:gravity="center"
        android:id="@+id/txt_download"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:text="@string/dash_cam_download"
        android:layout_weight="1"
        app:drawableTopCompat="@mipmap/icon_download"/>
    <com.yadea.widget.font.YadeaTextView
        android:gravity="center"
        android:id="@+id/txt_delete"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:text="@string/nfc_delete"
        android:layout_weight="1"
        app:drawableTopCompat="@mipmap/icon_delete"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/slide_up_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:layout_gravity="end"
        android:id="@+id/tv_skip"
        android:background="@drawable/corners_solid_black_20_percent_corner"
        android:paddingLeft="16dp"
        android:paddingTop="@dimen/dp_4"
        android:paddingRight="16dp"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/guide_skip"
        android:layout_marginEnd="24dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <org.libpag.PAGImageView
        android:id="@+id/pag_img_view"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/tv_slide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/white"
        android:id="@+id/tv_slide"
        android:background="@drawable/guide_slide_up_bg"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="@dimen/dp_4"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_100"
        android:text="@string/guide_slide"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

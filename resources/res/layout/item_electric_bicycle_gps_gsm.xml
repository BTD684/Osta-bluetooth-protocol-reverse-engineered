<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/corners_solid_color_background_radius_14"
    android:layout_width="70dp"
    android:layout_height="22dp">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_8c8c8e"
        android:gravity="center"
        android:id="@+id/tv_signal"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:drawablePadding="4dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_signal"
        android:background="@mipmap/icon_gps_4"
        android:layout_width="@dimen/dp_22"
        android:layout_height="@dimen/dp_4"
        android:layout_marginStart="@dimen/dp_5"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_signal"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

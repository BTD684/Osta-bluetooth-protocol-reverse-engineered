<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_root"
    android:background="@color/c_bg4_google"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="26dp"
        android:textColor="@color/qu_black_alpha_87"
        android:id="@+id/text_confirm"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/iv_direction"
            android:background="@drawable/theme_icon_bg"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="20dp"
            android:src="@drawable/theme_ivi_googlemap_ic_northup"
            android:layout_marginEnd="16dp"
            android:elevation="8dp"
            android:outlineProvider="background"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="76dp"
            android:layout_height="26dp"
            android:layout_marginBottom="4dp"
            android:src="@drawable/theme_ivi_googlemap_ic_logo"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

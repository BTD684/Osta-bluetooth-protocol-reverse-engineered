<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:id="@+id/ll_center"
    android:background="@drawable/spotify_list_bg"
    android:layout_width="match_parent"
    android:layout_height="84dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="24dp">
    <net.easyconn.carman.common.view.RoundImageView
        android:id="@+id/cover"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_marginStart="9dp"
        app:radius="@dimen/r_2"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginStart="10dp">
        <TextView
            android:textSize="@dimen/t_1"
            android:textColor="@color/c_t1"
            android:ellipsize="marquee"
            android:gravity="center_vertical"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="10dp"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/sub_title"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_marginStart="10dp"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center"
        android:id="@+id/hasSub"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:src="@drawable/theme_ivi_common_list_ic_enter"
        android:layout_marginEnd="16dp"/>
</LinearLayout>

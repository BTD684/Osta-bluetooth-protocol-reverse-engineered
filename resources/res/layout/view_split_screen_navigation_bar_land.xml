<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.view.TimeView
        android:textSize="@dimen/t_2"
        android:textColor="@color/c_t1"
        android:gravity="center"
        android:id="@+id/time_view"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.common.view.BatteryView
        android:id="@+id/battery_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:batteryColor="@color/c_t1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/time_view"
        app:scale="0.62"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:id="@+id/iv_speech"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/theme_ivi_common_dock_ic_voice_normal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/battery_view"
        app:radius="@dimen/r_3"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/iv_speech_vip"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="-5dp"
        android:src="@drawable/theme_ivi_home_ic_vip_subscript"
        android:layout_marginEnd="-5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_speech"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/iv_speech"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:id="@+id/iv_mirror"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_speech"
        app:radius="@dimen/r_3"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:id="@+id/iv_twin_space"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/theme_ivi_home_ic_virhome"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_mirror"
        app:radius="@dimen/r_3"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/iv_twin_space_vip"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="-5dp"
        android:src="@drawable/theme_ivi_home_ic_vip_subscript"
        android:layout_marginEnd="-5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_twin_space"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/iv_twin_space"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:id="@+id/iv_menu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginBottom="14dp"
        android:src="@drawable/theme_ivi_home_ic_back_home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:radius="@dimen/r_3"/>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_add_family_account_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/add_subaccount"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/corners_solid_radius_14_ffffff_1e1e1e"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_email"
            android:tag="binding_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:hint_text="@string/hint_input_subaccount_email_tel"
            app:input_background_drawable="@drawable/corners_solid_stroke_e6e6e6_radius_14"
            app:input_edit_clear="true"
            app:input_edit_max_length="50"
            app:input_line_enable="false"
            app:input_text_height="@dimen/dp_48"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_margin_top="@dimen/dp_10"
            app:input_text_size="@dimen/sp_16"
            app:input_text_type="text_email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:name_text="@string/family_sub_account"
            app:name_text_bold="true"/>
        <View
            android:id="@+id/view_bg"
            android:background="@drawable/corners_solid_radius_14_f5f6fa_121212"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/space"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_email"/>
        <com.makeramen.roundedimageview.RoundedImageView
            android:id="@+id/riv_vehicle"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_165"
            android:layout_margin="@dimen/dp_8"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="@+id/view_bg"
            app:layout_constraintStart_toStartOf="@+id/view_bg"
            app:layout_constraintTop_toTopOf="@+id/view_bg"
            app:riv_corner_radius="@dimen/dp_14"/>
        <Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_8"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/riv_vehicle"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/view_bg">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_attention"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@mipmap/ic_grey_attention"
                android:layout_marginEnd="@dimen/dp_5"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_8C8C8E_999999"
                android:id="@+id/tv_tips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tips_subaccount_car_permission"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.yadea.widget.font.YadeaTextView
            android:enabled="false"
            android:textSize="14sp"
            android:textColor="@color/color_F5F6FA_121212"
            android:gravity="center"
            android:id="@+id/tv_add_confirm"
            android:background="@drawable/selector_add_subaccount_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_46"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/confirm_add"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_tips"/>
        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_add_confirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

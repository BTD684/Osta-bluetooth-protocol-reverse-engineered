<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="0.45"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.8">
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_dialog_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="@string/dialog_pay_title"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="50dp">
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/color_333"
                    android:gravity="center"
                    android:id="@+id/tv_cancel"
                    android:background="@drawable/selector_dialog_button_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/ec_usb_cancel"
                    android:layout_weight="1"/>
                <View
                    android:background="@color/dialog_line"
                    android:layout_width="1dp"
                    android:layout_height="30dp"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="@color/dialog_confirm_text"
                    android:gravity="center"
                    android:id="@+id/tv_confirm"
                    android:background="@drawable/selector_dialog_button_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:text="@string/dialog_pay_button"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

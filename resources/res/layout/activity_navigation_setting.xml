<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_navigation_setting_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/screen_navigation_settings"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_bar">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/fl_navigation_tips"
                android:layout_height="wrap_content"
                style="@style/SettingCard">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="12sp"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/txt_navigation_tips"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:paddingVertical="12dp"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_gravity="end|center_vertical"
                    android:id="@+id/img_navigation_tips_close"
                    android:padding="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@mipmap/ic_navigation_setting_close"
                    android:layout_marginEnd="6dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <LinearLayout
                android:id="@+id/ll_navi_mode"
                style="@style/SettingCard">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:ellipsize="end"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:text="@string/screen_icm_navigation"
                    android:maxLines="1"
                    android:layout_marginHorizontal="16dp"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp">
                    <FrameLayout
                        android:id="@+id/fl_easy"
                        android:background="@drawable/corners_stroke_color_8c8c8e_999999_12"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="match_parent"
                                android:layout_height="105dp"
                                android:layout_margin="0.5dp"
                                android:src="@mipmap/ic_easy_navigation_bg"
                                android:scaleType="fitXY"
                                app:shapeAppearanceOverlay="@style/TopRound12dp"/>
                            <com.yadea.widget.font.YadeaTextView
                                android:textSize="14sp"
                                android:textColor="@color/text_line_color_main"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="@string/screen_simple_navigation"
                                android:maxLines="1"/>
                        </LinearLayout>
                        <RadioButton
                            android:layout_gravity="end|top"
                            android:id="@+id/rb_easy_mode"
                            android:clickable="false"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_margin="4dp"
                            android:button="@drawable/check_tel_style"/>
                    </FrameLayout>
                    <Space
                        android:layout_width="16dp"
                        android:layout_height="match_parent"/>
                    <FrameLayout
                        android:id="@+id/fl_panoramic"
                        android:background="@drawable/corners_stroke_color_e6e6e6_333333_12"
                        android:layout_width="0dp"
                        android:layout_height="150dp"
                        android:layout_weight="1">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">
                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="match_parent"
                                android:layout_height="105dp"
                                android:layout_margin="0.5dp"
                                android:src="@mipmap/ic_panoramic_navigation_bg"
                                android:scaleType="fitXY"
                                app:shapeAppearanceOverlay="@style/TopRound12dp"/>
                            <com.yadea.widget.font.YadeaTextView
                                android:textSize="14sp"
                                android:textColor="@color/text_line_color_main"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:text="@string/screen_full_navigation"
                                android:maxLines="1"/>
                        </LinearLayout>
                        <RadioButton
                            android:layout_gravity="end|top"
                            android:id="@+id/rb_panoramic_mode"
                            android:clickable="false"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_margin="4dp"
                            android:button="@drawable/check_tel_style"/>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_adaptive_navigation"
                android:visibility="gone"
                style="@style/SettingCard">
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp">
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_line_color_main"
                        android:layout_gravity="center"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/screen_adaptive_navigation"
                        android:layout_weight="1"/>
                    <com.yadea.widget.switchItem.YedeaOldSwitch
                        android:id="@+id/switch_adaptive_navigation"
                        style="@style/CarSettingSwitch"/>
                </LinearLayout>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="12sp"
                    android:textColor="@color/color_8C8C8E_333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/screen_adaptive_navigation_tip"
                    android:layout_marginHorizontal="16dp"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_color_mode"
                android:tag="binding_1"
                android:visibility="gone"
                style="@style/SettingCard">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="@string/screen_color_pattern"/>
                <include
                    android:id="@+id/group_color_mode"
                    layout="@layout/item_radio_group_three"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ll_voice_broadcast"
                android:tag="binding_2"
                android:visibility="gone"
                style="@style/SettingCard">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:text="@string/navigation_setting_voice_broadcast_title"/>
                <include
                    android:id="@+id/group_voice_broadcast"
                    layout="@layout/item_radio_group_two"/>
            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_music_mode"
                android:layout_marginBottom="16dp"
                style="@style/SettingCard">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/ll_music"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_line_color_main"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="16dp"
                        android:text="@string/screen_bt_media"
                        android:maxLines="1"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="14sp"
                        android:textColor="@color/text_line_color_deputy_dark"
                        android:id="@+id/txt_music_rules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginRight="16dp"
                        android:text="@string/screen_bt_media_tip"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginHorizontal="16dp"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="14sp"
                        android:textColor="@color/text_line_color_main"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:background="@drawable/corners_stroke_circle_8c8c8e"
                        android:paddingLeft="40dp"
                        android:paddingTop="12dp"
                        android:paddingRight="40dp"
                        android:paddingBottom="12dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_marginTop="24dp"
                        android:layout_marginRight="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/dashboard_connect_instantly"
                        android:lines="1"
                        android:layout_marginHorizontal="16dp"
                        android:paddingHorizontal="40dp"
                        android:paddingVertical="12dp"/>
                </LinearLayout>
                <View
                    android:id="@+id/view_music_mask"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/ll_music"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/ll_music"
                    style="@style/CarSettingMask"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

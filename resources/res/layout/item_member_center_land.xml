<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/c_list_bg"
    android:layout_width="match_parent"
    android:layout_height="@dimen/L_2"
    android:layout_marginBottom="4dp">
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_icon"
        android:layout_width="66dp"
        android:layout_height="66dp"
        android:layout_marginStart="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="W,1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearance="@style/mirror_card_icon_round"/>
    <TextView
        android:textSize="@dimen/t_1"
        android:textColor="@color/c_t1"
        android:id="@+id/tv_product"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_time"
        app:layout_constraintStart_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t2"
        android:id="@+id/tv_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintEnd_toStartOf="@+id/tv_buy"
        app:layout_constraintStart_toStartOf="@+id/tv_product"
        app:layout_constraintTop_toBottomOf="@+id/tv_product"/>
    <TextView
        android:textSize="@dimen/t_4"
        android:textColor="@color/c_t3"
        android:gravity="center"
        android:id="@+id/tv_buy"
        android:background="@drawable/selector_join_button_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginRight="12dp"
        android:text="@string/member_center_join"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.26"/>
</androidx.constraintlayout.widget.ConstraintLayout>

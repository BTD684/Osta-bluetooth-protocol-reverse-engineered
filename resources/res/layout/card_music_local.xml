<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp">
    <include layout="@layout/include_neutral_home_card_port_guide"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toLeftOf="@+id/view_card_bg"
        app:layout_constraintRight_toLeftOf="@+id/line_port_title_begin"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/black"
        android:id="@+id/tv_music"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/music_home_title_default"
        android:singleLine="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_audio_name"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_begin"
        app:layout_constraintRight_toLeftOf="@+id/line_port_title_end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/black"
        android:id="@+id/tv_audio_name"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_begin"
        app:layout_constraintRight_toLeftOf="@+id/line_port_title_end"
        app:layout_constraintTop_toBottomOf="@+id/tv_music"/>
    <ImageView
        android:id="@+id/iv_music_play_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_end"
        app:layout_constraintRight_toLeftOf="@+id/view_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_suspend"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_end"
        app:layout_constraintRight_toLeftOf="@+id/view_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/c_t3"
        android:layout_width="1px"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/iv_music_play_pause"
        app:layout_constraintRight_toLeftOf="@+id/iv_music_next"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_music_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/view_line"
        app:layout_constraintRight_toRightOf="@+id/view_card_bg"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/root_dialog_view"
    android:background="@color/c_popup_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:paddingTop="18dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/lv_select"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ListView
        android:id="@+id/lv_select"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:divider="@color/transparent"
        android:dividerHeight="0dp"
        android:fadeScrollbars="false"
        android:showDividers="none"
        app:layout_constraintBottom_toTopOf="@+id/v_bottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <View
        android:id="@+id/v_bottom"
        android:layout_width="0dp"
        android:layout_height="@dimen/mirror_dialog_title_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lv_select"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/theme_bg_dialog_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/ota_transfer_next_time"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toStartOf="@+id/tv_enter"
        app:layout_constraintStart_toStartOf="@+id/v_bottom"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t_popup"
        android:gravity="center"
        android:id="@+id/tv_enter"
        android:background="@drawable/theme_bg_dialog_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/dialog_sure"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toEndOf="@+id/v_bottom"
        app:layout_constraintStart_toEndOf="@+id/tv_cancel"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>

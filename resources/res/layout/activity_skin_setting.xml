<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_skin_setting_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/theme_bg_top"
        android:background="@mipmap/bg_theme_top"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/space"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/hv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/space"
        app:title="@string/app_theme_mode"/>
    <View
        android:id="@+id/view"
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/linear"
        app:layout_constraintTop_toBottomOf="@+id/hv"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_theme"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/mine_appearance_dark_light_mode"
        android:drawablePadding="8dp"
        android:drawableStart="@mipmap/ic_theme_mode"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/view"
        app:layout_constraintTop_toTopOf="@+id/view"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="top"
        android:orientation="horizontal"
        android:id="@+id/linear"
        android:padding="@dimen/dp_16"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/view"
        app:layout_constraintStart_toStartOf="@+id/view"
        app:layout_constraintTop_toBottomOf="@+id/tv_theme">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/ll_white"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/iv_white"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:src="@mipmap/icon_white_skin"
                android:scaleType="fitCenter"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16">
                <ImageView
                    android:id="@+id/img_white"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@mipmap/icon_txt_unselect_white"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="12sp"
                    android:textColor="@color/color_8C8C8E_999999"
                    android:id="@+id/txt_white"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_light_mode"
                    android:layout_marginStart="@dimen/dp_4"/>
            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/ll_black"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/iv_black"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:src="@mipmap/icon_black_skin"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16">
                <ImageView
                    android:id="@+id/img_black"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@mipmap/icon_txt_unselect_black"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="12sp"
                    android:textColor="@color/color_8C8C8E_999999"
                    android:id="@+id/txt_black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_dark_mode"
                    android:layout_marginStart="@dimen/dp_4"/>
            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/ll_system"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/dp_16">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_gravity="center"
                android:id="@+id/iv_system"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:src="@mipmap/icon_system_skin"/>
            <LinearLayout
                android:gravity="center"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16">
                <ImageView
                    android:id="@+id/img_system"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:src="@mipmap/icon_txt_unselect_system"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/dp_12"
                    android:textColor="@color/color_8C8C8E_999999"
                    android:id="@+id/txt_system"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/theme_follow_system"
                    android:layout_marginStart="@dimen/dp_4"/>
            </LinearLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/view1"
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="@+id/rg_theme"
        app:layout_constraintTop_toBottomOf="@+id/view"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/mine_appearance_theme_style"
        android:drawablePadding="8dp"
        android:drawableStart="@mipmap/ic_theme_style"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="@+id/view1"
        app:layout_constraintTop_toTopOf="@+id/view1"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_theme"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toEndOf="@+id/view1"
        app:layout_constraintStart_toStartOf="@+id/view1"
        app:layout_constraintTop_toBottomOf="@+id/tv_style">
        <com.yadea.widget.font.YadeaRadioButton
            android:textSize="14sp"
            android:textColor="@drawable/selector_radio_button"
            android:gravity="center"
            android:id="@+id/rb_simple"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:button="@null"
            android:text="@string/mine_appearance_simple_style"
            android:drawableTop="@drawable/selector_theme_simple"
            android:drawablePadding="@dimen/dp_16"
            android:layout_weight="1"
            android:paddingStart="16dp"
            android:paddingEnd="8dp"/>
        <com.yadea.widget.font.YadeaRadioButton
            android:textSize="14sp"
            android:textColor="@drawable/selector_radio_button"
            android:gravity="center"
            android:id="@+id/rb_color"
            android:background="@color/transparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@null"
            android:text="@string/mine_appearance_colors_style"
            android:drawableTop="@drawable/selector_theme_color"
            android:drawablePadding="@dimen/dp_16"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingEnd="16dp"/>
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>

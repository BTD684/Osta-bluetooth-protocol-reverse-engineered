<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_container"
    android:tag="layout/google_set_view_0"
    android:background="@color/c_bg4_google"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/im_back"
        android:padding="12dp"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/theme_ivi_driver_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1_google"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/map_settings"
        app:layout_constraintBottom_toBottomOf="@+id/im_back"
        app:layout_constraintStart_toEndOf="@+id/im_back"
        app:layout_constraintTop_toTopOf="@+id/im_back"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/c_l_google"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/im_back"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1_google"
        android:id="@+id/tv_display"
        android:tag="binding_1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/skin_mode_label"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_line"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_display_mode"
        android:tag="binding_2"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_display">
        <RadioButton
            android:textSize="@dimen/t_4"
            android:textColor="@drawable/theme_set_btn_text"
            android:gravity="center"
            android:id="@+id/rg_display_1"
            android:background="@drawable/theme_set_btn_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/skin_automatic"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <RadioButton
            android:textSize="@dimen/t_4"
            android:textColor="@drawable/theme_set_btn_text"
            android:gravity="center"
            android:id="@+id/rg_display_2"
            android:background="@drawable/theme_set_btn_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/skin_day"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <RadioButton
            android:textSize="@dimen/t_4"
            android:textColor="@drawable/theme_set_btn_text"
            android:gravity="center"
            android:id="@+id/rg_display_3"
            android:background="@drawable/theme_set_btn_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:button="@null"
            android:text="@string/skin_night"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
    </RadioGroup>
    <View
        android:id="@+id/v_line_display"
        android:tag="binding_3"
        android:background="@color/c_l_google"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rg_display_mode"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_home"
        android:tag="binding_4"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_line_display">
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t1_google"
            android:gravity="center"
            android:id="@+id/tv_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/set_map_home"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_display"/>
        <ImageView
            android:id="@+id/iv_delete_home"
            android:tag="binding_5"
            android:padding="15dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/theme_ivi_googlemap_ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_display"/>
        <ImageView
            android:tag="binding_6"
            android:padding="15dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/theme_ivi_googlemap_ic_into"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_display"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t2_google"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:tag="binding_7"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_delete_home"
            app:layout_constraintTop_toBottomOf="@+id/v_line_display"
            app:layout_constraintWidth_percent="0.38"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_line_home"
        android:tag="binding_8"
        android:background="@color/c_l_google"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_home"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_work"
        android:tag="binding_9"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_line_home">
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t1_google"
            android:gravity="center"
            android:id="@+id/tv_work"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/set_map_work"
            android:layout_marginStart="16dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_home"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t2_google"
            android:ellipsize="end"
            android:gravity="end|center_vertical"
            android:tag="binding_10"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:singleLine="true"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_delete_work"
            app:layout_constraintTop_toBottomOf="@+id/v_line_home"
            app:layout_constraintWidth_percent="0.38"/>
        <ImageView
            android:id="@+id/iv_delete_work"
            android:tag="binding_11"
            android:padding="15dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/theme_ivi_googlemap_ic_delete"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_home"/>
        <ImageView
            android:tag="binding_12"
            android:padding="15dp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/theme_ivi_googlemap_ic_into"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/v_line_home"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_line_work"
        android:tag="binding_13"
        android:background="@color/c_l_google"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_work"/>
</androidx.constraintlayout.widget.ConstraintLayout>

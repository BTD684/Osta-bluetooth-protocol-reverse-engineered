<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/main_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="@dimen/all_layout_title_height">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/y200"
        android:layout_height="match_parent"
        android:src="@drawable/common_back_selector"
        android:scaleType="centerInside"/>
    <ImageView
        android:id="@+id/iv_close"
        android:visibility="gone"
        android:layout_width="@dimen/x60"
        android:layout_height="@dimen/x60"
        android:src="@drawable/h5_exit"
        android:layout_toRightOf="@+id/iv_back"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <TextView
            android:textSize="@dimen/text_size_middle54"
            android:textColor="@color/color_333"
            android:ellipsize="end"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_help"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="@dimen/y40"
        android:layout_alignParentEnd="true">
        <TextView
            android:textSize="@dimen/text_size_small"
            android:textColor="@color/all_text_blue"
            android:id="@+id/tv_help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</RelativeLayout>

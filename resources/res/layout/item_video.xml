<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_video_0"
    android:background="@drawable/corners_solid_stroke_color_white_1b1c20_radius_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp">
    <com.yadea.widget.img.EasyImageView
        android:id="@+id/img_thumbnail"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:src="@mipmap/icon_dash_cam_default_1"
        android:scaleType="centerCrop"
        app:ev_top_radius="12dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_selected"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_16"
        android:layout_marginTop="8dp"
        android:src="@mipmap/icon_video_unselect"
        android:layout_marginEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/color_000000_ffffff"
        android:id="@+id/txt_time"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:paddingVertical="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_thumbnail"
        style="@style/Footnote_12_Regular"/>
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/color_000000_ffffff"
        android:id="@+id/txt_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/txt_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_time"
        style="@style/Footnote_12_Regular"/>
</androidx.constraintlayout.widget.ConstraintLayout>

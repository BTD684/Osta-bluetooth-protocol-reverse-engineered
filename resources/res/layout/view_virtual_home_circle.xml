<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/v_circle_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/virtual_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_circle_content"
        app:layout_constraintEnd_toEndOf="@+id/v_circle_content"
        app:layout_constraintStart_toStartOf="@+id/v_circle_content"
        app:layout_constraintTop_toTopOf="@+id/v_circle_content"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/line_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.18"/>
    <RelativeLayout
        android:id="@+id/music_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_circle_content"
        app:layout_constraintEnd_toEndOf="@+id/v_circle_content"
        app:layout_constraintStart_toStartOf="@+id/v_circle_content"
        app:layout_constraintTop_toTopOf="@+id/line_top">
        <net.easyconn.carman.view.VirtualMusicNotice
            android:id="@+id/music_notice"
            android:background="@drawable/bg_virtual_music"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="208dp"
            android:layout_height="58dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/message_container"
        android:layout_width="0dp"
        android:layout_height="@dimen/x276"
        android:animateLayoutChanges="true"
        app:layout_constraintEnd_toEndOf="@+id/v_circle_content"
        app:layout_constraintTop_toTopOf="@+id/line_top"
        app:layout_constraintWidth_percent="0.6">
        <net.easyconn.carman.view.VirtualMessageNotice
            android:id="@+id/message_notice"
            android:background="@drawable/bg_virtual_music"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="60dp"
            android:minWidth="180dp"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/phone_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:animateLayoutChanges="true"
        app:layout_constraintBottom_toBottomOf="@+id/v_circle_content"
        app:layout_constraintEnd_toEndOf="@+id/v_circle_content"
        app:layout_constraintStart_toStartOf="@+id/v_circle_content"
        app:layout_constraintTop_toTopOf="@+id/line_top">
        <net.easyconn.carman.view.VirtualPhoneNotice
            android:id="@+id/phone_notice"
            android:background="@drawable/bg_virtual_phone"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="208dp"
            android:layout_height="58dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="8dp"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_track_finish"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/theme_ivi_offmap_tab_ic_finish"
        android:layout_marginStart="13dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.common.dialog.VirtualToastLayer
        android:id="@+id/virtual_toast_layer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_circle_content"
        app:layout_constraintEnd_toEndOf="@+id/v_circle_content"
        app:layout_constraintStart_toStartOf="@+id/v_circle_content"
        app:layout_constraintTop_toTopOf="@+id/v_circle_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>

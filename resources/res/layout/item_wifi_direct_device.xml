<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp">
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/cls_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.94">
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t1"
            android:ellipsize="end"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_device_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:layout_weight="1"
            android:layout_marginStart="20dp"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t2"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_status"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wifi_direct_is_connected"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="16dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/theme_ivi_connect_ic_wifi"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <View
        android:id="@+id/v_divider"
        android:background="@color/c_l"
        android:layout_width="0dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.94"/>
</androidx.constraintlayout.widget.ConstraintLayout>

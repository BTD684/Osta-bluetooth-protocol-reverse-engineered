<?xml version="1.0" encoding="utf-8"?>
<com.mcxtzhang.swipemenulib.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_marginLeft="22dp"
    android:layout_marginTop="16dp"
    android:layout_marginRight="22dp"
    android:layout_marginHorizontal="22dp"
    app:ios="false"
    app:swipeEnable="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_vehicle_container"
        android:background="@drawable/corners_solid_block_color_dialog_14"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatCheckBox
            android:enabled="false"
            android:id="@+id/checkbox_vehicle"
            android:background="@drawable/check_box_style"
            android:clickable="false"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_margin="8dp"
            android:button="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/check_box_select"
            android:background="@null"
            android:layout_width="30dp"
            android:layout_height="30dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_vehicle"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <FrameLayout
            android:id="@+id/ll_vehicle_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_vehicle"
            app:layout_constraintTop_toTopOf="@+id/img_vehicle">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="12sp"
                    android:textColor="@color/text_line_color_main"
                    android:ellipsize="end"
                    android:id="@+id/txt_vehicle_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/dp_12"
                    android:layout_weight="1"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/txt_identity_type"
                    android:background="@drawable/stoke_round_ff5f00_fa7a2e"
                    android:paddingLeft="@dimen/dp_8"
                    android:paddingRight="@dimen/dp_8"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:paddingHorizontal="@dimen/dp_8"/>
            </LinearLayout>
        </FrameLayout>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:ellipsize="end"
            android:id="@+id/txt_vehicle_desc"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="@+id/ll_vehicle_info"
            app:layout_constraintStart_toStartOf="@+id/ll_vehicle_info"
            app:layout_constraintTop_toBottomOf="@+id/ll_vehicle_info"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/text_line_color_main"
            android:ellipsize="end"
            android:id="@+id/txt_vehicle_vin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="@+id/ll_vehicle_info"
            app:layout_constraintStart_toStartOf="@+id/ll_vehicle_info"
            app:layout_constraintTop_toBottomOf="@+id/txt_vehicle_desc"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/text_line_color_main"
            android:ellipsize="end"
            android:id="@+id/txt_vehicle_mac"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="@+id/ll_vehicle_info"
            app:layout_constraintStart_toStartOf="@+id/ll_vehicle_info"
            app:layout_constraintTop_toBottomOf="@+id/txt_vehicle_vin"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Space
        android:layout_width="16dp"
        android:layout_height="0dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/state_color_red"
        android:gravity="center"
        android:id="@+id/action_unbind_vehicle"
        android:background="@drawable/corners_stroke_state_color_red_14"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="45dp"
        android:text="@string/user_devices_unbind"
        android:paddingHorizontal="16dp"/>
</com.mcxtzhang.swipemenulib.SwipeMenuLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/vp_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_music_icon"
        android:layout_width="@dimen/general_main_big_icon_size"
        android:layout_height="@dimen/general_main_big_icon_size"
        app:layout_constraintBottom_toTopOf="@+id/tv_music"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:id="@+id/tv_music"
        android:text="@string/music_home_title_default"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_music_icon"
        style="@style/general_main_normal_text_style"/>
    <ImageView
        android:id="@+id/iv_music_play_next"
        android:layout_width="@dimen/x96"
        android:layout_height="@dimen/x96"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/iv_music_play_pause"
        app:layout_constraintRight_toRightOf="parent"/>
    <ImageView
        android:id="@+id/iv_music_play_pause"
        android:layout_width="@dimen/x96"
        android:layout_height="@dimen/x96"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/iv_music_play_next"/>
</androidx.constraintlayout.widget.ConstraintLayout>

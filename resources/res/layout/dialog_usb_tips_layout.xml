<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_ble_base_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:id="@+id/update_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x144"
        android:text="@string/ec_usb_title"
        style="@style/prompt_dialog_title_font"/>
    <ImageView
        android:layout_gravity="center"
        android:layout_width="@dimen/x424"
        android:layout_height="@dimen/x276"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/x48"
            android:textColor="@color/black_0.8"
            android:gravity="center_vertical"
            android:id="@+id/update_content"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/x96"
            android:text="@string/ec_usb_tips"/>
        <CheckBox
            android:textSize="@dimen/x42"
            android:textColor="#cc000000"
            android:gravity="center_vertical"
            android:id="@+id/cb_not_show"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/easyconn_syms_edit"/>
    </LinearLayout>
    <View
        android:id="@+id/update_seperator"
        android:background="@color/one_pixel_divider"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"
        android:layout_below="@+id/ll_top"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_sure"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x144">
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="#000000"
            android:gravity="center"
            android:id="@+id/update_cancel"
            android:background="@drawable/dialog_ble_base_cancel_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ec_usb_cancel"
            android:layout_weight="1"/>
        <View
            android:id="@+id/sure_sperator"
            android:background="@color/one_pixel_divider"
            android:layout_width="@dimen/x1"
            android:layout_height="match_parent"/>
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="#1ea0ff"
            android:gravity="center"
            android:id="@+id/update_enter"
            android:background="@drawable/dialog_ble_base_ensure_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ec_usb_set"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>

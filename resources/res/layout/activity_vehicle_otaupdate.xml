<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_vehicle_otaupdate_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:rightIcon="@mipmap/vehicle_ic_ble_ota_record"
        app:title="@string/home_dialog_firmware_update"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="@dimen/dp_80">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="@dimen/dp_16">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="vertical"
                    android:id="@+id/ll_ota_new_version"
                    android:background="@drawable/corners_solid_block_color_main_14"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_marginRight="@dimen/dp_24"
                    android:layout_marginHorizontal="@dimen/dp_24">
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center"
                        android:id="@+id/img_update_icon"
                        android:layout_width="@dimen/dp_72"
                        android:layout_height="@dimen/dp_72"
                        android:layout_marginTop="@dimen/dp_24"
                        android:src="@mipmap/vehicle_ic_ota_update"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/text_line_color_main"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/txt_update_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_24"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginRight="@dimen/dp_24"
                        android:text="@string/ota_new_version_upgraded"
                        android:layout_marginHorizontal="@dimen/dp_24"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/text_line_color_deputy_dark"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/txt_update_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_24"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginRight="@dimen/dp_24"
                        android:layout_marginHorizontal="@dimen/dp_24"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_ffffff_000000"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/btn_go_to_upgrades"
                        android:background="@drawable/corners_solid_radius_14_000000_ffffff"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_48"
                        android:layout_marginLeft="@dimen/dp_20"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginRight="@dimen/dp_20"
                        android:layout_marginBottom="@dimen/dp_32"
                        android:text="@string/ota_immediately_update"
                        android:textAllCaps="false"
                        android:layout_marginHorizontal="@dimen/dp_20"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_16"
                        android:textStyle="bold"
                        android:textColor="@color/color_000000_ffffff"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:id="@+id/btn_look_upgrade"
                        android:background="@drawable/corners_solid_radius_14_000000_05"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_48"
                        android:layout_marginLeft="@dimen/dp_20"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginRight="@dimen/dp_20"
                        android:layout_marginBottom="@dimen/dp_32"
                        android:text="@string/ota_view_upgrade_status"
                        android:textAllCaps="false"
                        android:layout_marginHorizontal="@dimen/dp_20"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/txt_ota_new_version"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_marginRight="@dimen/dp_24"
                    android:text="@string/ota_find_new_firmware_version"
                    android:layout_marginHorizontal="@dimen/dp_24"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_ota_version_list"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginRight="@dimen/dp_24"
                    android:layout_marginHorizontal="@dimen/dp_24"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_22"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_marginRight="@dimen/dp_24"
                    android:text="@string/vehicle_scooter_device_info"
                    android:layout_marginHorizontal="@dimen/dp_24"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_ota_firmware_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:overScrollMode="never"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_line_color_deputy_dark"
                    android:gravity="center"
                    android:id="@+id/txt_current_latest_version"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/ota_latest_version"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:tag="layout/item_recycler_bottom_multiple_0"
    android:layout_width="match_parent"
    android:layout_height="46dp">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BUTTON 1"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12dp"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/tv_subtitle"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="此处为文本占位符"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:id="@+id/line"
        android:background="@color/text_line_color_deputy_light_40"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

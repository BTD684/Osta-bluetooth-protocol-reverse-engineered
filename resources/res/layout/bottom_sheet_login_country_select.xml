<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:tag="layout/bottom_sheet_login_country_select_0"
    android:background="@drawable/corners_f5f6fa_color_background_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/area_select"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_back"
            android:padding="@dimen/dp_12"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/ic_back"
            android:layout_marginStart="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
        <com.yadea.widget.widget.ClearEditText
            android:textSize="@dimen/sp_17"
            android:textColor="#000000"
            android:textColorHint="#e6e6e6"
            android:gravity="center_vertical"
            android:id="@+id/cet_search"
            android:background="@drawable/corners_solid_white_radius_14"
            android:paddingLeft="@dimen/dp_10"
            android:paddingRight="@dimen/dp_10"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_24"
            android:hint="@string/search"
            android:drawableLeft="@mipmap/widget_ic_search"
            android:drawableRight="@mipmap/ic_20_black_close"
            android:drawablePadding="@dimen/dp_10"
            android:inputType="text"
            android:imeOptions="actionDone"
            android:textCursorDrawable="@drawable/color_black_cursor"
            android:drawableStart="@mipmap/widget_ic_search"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:paddingHorizontal="@dimen/dp_10"
            app:layout_constraintBottom_toTopOf="@+id/cd_search"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_back"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/cd_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/dp_14"
            app:cardElevation="@dimen/dp_4"
            app:layout_constraintBottom_toTopOf="@+id/tv_tips"
            app:layout_constraintTop_toBottomOf="@+id/cet_search">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </androidx.cardview.widget.CardView>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="#8c8c8e"
            android:id="@+id/tv_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_24"
            android:text="@string/login_please_select_region_tips"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintBottom_toTopOf="@+id/tv_title_location"
            app:layout_constraintTop_toBottomOf="@+id/cd_search"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/tv_title_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/current_location"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintBottom_toTopOf="@+id/ll_location"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/ll_location"
            android:background="@drawable/corners_solid_white_radius_14"
            android:padding="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintBottom_toTopOf="@+id/tv_title_country"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_location">
            <ImageView
                android:id="@+id/iv_country_location"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:src="@mipmap/ic_country_location"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="#000000"
                android:id="@+id/tv_location_country_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:text="@string/no_obtain_location"/>
            <ImageView
                android:id="@+id/iv_location_refresh"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:layout_marginLeft="@dimen/dp_8"
                android:src="@mipmap/ic_country_location_refresh"/>
            <View
                android:layout_width="0px"
                android:layout_height="0px"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/cb_location"
                android:visibility="gone"
                android:layout_width="@dimen/dp_16"
                android:layout_height="@dimen/dp_16"
                android:src="@mipmap/ic_grey_round"/>
        </LinearLayout>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/tv_title_country"
            android:visibility="invisible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:text="@string/country"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintBottom_toTopOf="@+id/refresh"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_location"/>
        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title_country">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:id="@+id/ll_network_error"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/dp_160"
                        android:layout_height="@dimen/dp_160"
                        android:layout_marginTop="@dimen/dp_16"
                        android:src="@mipmap/ic_country_emppty"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_8C8C8E_999999"
                        android:id="@+id/tv_network_error"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/no_network_please_refresh"/>
                </LinearLayout>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_country"
                    android:background="@drawable/corners_white_color_top_radius_14"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginRight="@dimen/dp_24"
                    android:layout_marginHorizontal="@dimen/dp_24"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </FrameLayout>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

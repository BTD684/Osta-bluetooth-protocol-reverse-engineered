<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/theme_ivi_common_title_ic_close"
        android:scaleType="centerInside"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_center"
        android:layout_width="320dp"
        android:layout_height="160dp"
        android:layout_marginTop="160dp"
        android:src="@drawable/theme_ivi_home_img_plugin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/T_6"
        android:textStyle="bold"
        android:textColor="@color/P_Text_Main"
        android:gravity="center"
        android:id="@+id/iv_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/install_tip_2"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_center"/>
    <TextView
        android:textSize="@dimen/T_2"
        android:textColor="@color/P_Text_scend"
        android:id="@+id/iv_desc_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_desc"/>
    <TextView
        android:textSize="@dimen/T_2"
        android:textColor="@color/P_Text_scend"
        android:id="@+id/iv_desc_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="【备案信息】 鄂ICP备2021000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_desc_2"/>
    <TextView
        android:textSize="@dimen/T_2"
        android:textStyle="bold"
        android:textColor="@color/P_Pop_Btn_Bg"
        android:gravity="center"
        android:id="@+id/iv_install"
        android:background="@drawable/selector_findcar_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/H_1"
        android:layout_marginBottom="90dp"
        android:text="开始安装"
        android:layout_marginStart="36dp"
        android:layout_marginEnd="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <TextView
        android:textSize="@dimen/T_3"
        android:textColor="@color/P_Text_Fade"
        android:id="@+id/iv_desc_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/install_tip_1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_install"/>
</androidx.constraintlayout.widget.ConstraintLayout>

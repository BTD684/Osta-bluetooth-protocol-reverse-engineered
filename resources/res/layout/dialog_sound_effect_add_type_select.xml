<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/dialog_sound_effect_add_type_select_0"
    android:background="@drawable/shape_effect_name_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/custom_add_audio_title"
        android:layout_marginHorizontal="@dimen/dp_22"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:gravity="center"
        android:id="@+id/tv_recording"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/custom_record_title"
        android:layout_marginHorizontal="@dimen/dp_22"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:gravity="center"
        android:id="@+id/tv_photo_album"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/custom_album_title"
        android:layout_marginHorizontal="@dimen/dp_22"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:gravity="center"
        android:id="@+id/tv_file"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_22"
        android:text="@string/custom_file_title"
        android:layout_marginHorizontal="@dimen/dp_22"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff_1e1e1e"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50"
        android:layout_marginLeft="@dimen/dp_22"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_22"
        android:layout_marginBottom="@dimen/dp_35"
        android:text="@string/Cancel"
        android:layout_marginHorizontal="@dimen/dp_22"/>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_middle54"
        android:textColor="#303030"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prompt_dialog_title_height"/>
    <View
        android:id="@+id/line_title"
        android:background="@color/one_pixel_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <TextView
        android:textSize="@dimen/text_size_normal"
        android:textColor="#4f4f4f"
        android:gravity="center"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <CheckBox
        android:textSize="@dimen/text_size_small"
        android:textColor="#90000000"
        android:gravity="center_vertical"
        android:id="@+id/cb_do_not_remind"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/x48"
        android:checked="false"
        android:text="@string/easyconn_syms_edit"/>
    <View
        android:id="@+id/line_content"
        android:background="@color/one_pixel_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_button_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prompt_dialog_title_height">
        <TextView
            android:id="@+id/tv_cancel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/auto_dialog_cancel"
            android:layout_weight="1"
            style="@style/dialog_ble_base_cancel_action"/>
        <View
            android:background="@color/one_pixel_divider"
            android:layout_width="1px"
            android:layout_height="match_parent"/>
        <TextView
            android:id="@+id/tv_enter"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/auto_dialog_ok"
            android:layout_weight="1"
            style="@style/dialog_ble_base_action"/>
    </LinearLayout>
</LinearLayout>

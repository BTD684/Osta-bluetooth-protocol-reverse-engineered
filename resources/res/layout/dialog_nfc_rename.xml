<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/corners_solid_block_color_main_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:layout_gravity="center_horizontal"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="24dp"
        android:text="@string/nfc_input_subnick"
        android:layout_marginHorizontal="24dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="28dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp">
        <com.yadea.widget.font.YadeaEditTextView
            android:textSize="14sp"
            android:textColor="@color/text_line_color_main"
            android:textColorHint="@color/text_line_color_deputy_light"
            android:gravity="center_vertical"
            android:id="@+id/et_name"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/daughter_card_name"
            android:maxLength="12"
            android:layout_marginEnd="20dp"/>
        <View
            android:id="@+id/v_clear"
            android:background="@mipmap/widget_ic_close"
            android:layout_width="20dp"
            android:layout_height="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintBottom_toBottomOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/tv_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/Cancel"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/v_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/tv_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/sure"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>

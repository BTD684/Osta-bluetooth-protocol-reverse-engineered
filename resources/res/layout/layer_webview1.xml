<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.mirror.LayerBorwseTitleView
        android:id="@+id/ly_title"
        android:layout_width="match_parent"
        android:layout_height="60dp"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_layout"
        android:background="@drawable/web_scale"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ly_title">
        <ImageView
            android:gravity="center"
            android:id="@+id/iv_red"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/theme_ivi_common_title_ic_reduce"
            app:layout_constraintStart_toStartOf="parent"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t1"
            android:gravity="center"
            android:id="@+id/tv_scale"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="100%"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/iv_red"/>
        <ImageView
            android:gravity="center"
            android:id="@+id/iv_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/theme_ivi_common_title_ic_enlarge"
            android:layout_marginStart="10dp"
            app:layout_constraintStart_toEndOf="@+id/tv_scale"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/wb_contain"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ly_title"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/mirror_full_container_web"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

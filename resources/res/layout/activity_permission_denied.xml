<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/activity_permission_denied_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/img_back"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@mipmap/widget_ic_left_action_bar_back"
            android:paddingHorizontal="16dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/common_permission_tips"/>
    </FrameLayout>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/txt_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="220dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/handle_turn_on"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="195dp"
        android:layout_height="46dp"
        android:layout_marginTop="32dp"
        android:text="@string/common_permission_open"/>
</androidx.appcompat.widget.LinearLayoutCompat>

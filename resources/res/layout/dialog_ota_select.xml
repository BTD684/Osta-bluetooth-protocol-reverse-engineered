<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/ota_select_dialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x144">
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/ota_dialog_title"/>
        <View
            android:background="@color/black_0.2"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_alignParentBottom="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/rl_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prompt_dialog_title_height"
        android:layout_alignParentBottom="true">
        <View
            android:id="@+id/view_divide"
            android:background="@color/black_0.5"
            android:layout_width="match_parent"
            android:layout_height="1px"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/view_divide">
            <TextView
                android:id="@+id/tv_cancel"
                android:background="@drawable/dialog_ble_base_cancel_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/auto_dialog_cancel"
                android:layout_weight="1"
                style="@style/dialog_ble_base_cancel_action"/>
            <View
                android:background="@color/one_pixel_divider"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:id="@+id/tv_enter"
                android:background="@drawable/dialog_ble_base_ensure_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/auto_dialog_ok"
                android:layout_weight="1"
                style="@style/dialog_ble_base_action"/>
        </LinearLayout>
    </RelativeLayout>
    <ListView
        android:id="@+id/lv_select"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:listSelector="@color/transparent"
        android:divider="@color/transparent"
        android:dividerHeight="0dp"
        android:layout_above="@+id/rl_bottom"
        android:layout_below="@+id/rl_title"
        android:fadeScrollbars="false"
        android:showDividers="none"/>
</RelativeLayout>

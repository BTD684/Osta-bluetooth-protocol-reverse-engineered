<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sl_type"
    android:tag="layout/item_nfc_manager_0"
    android:background="@drawable/corners_solid_block_color_main_14"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="8dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">
    <ImageView
        android:id="@+id/v_header"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="16dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="72dp"
        android:layout_marginEnd="38dp">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="子卡名称"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/text_line_color_deputy_dark"
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已启用"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <FrameLayout
        android:layout_gravity="end|center_vertical"
        android:id="@+id/v_more"
        android:padding="6dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp">
        <View
            android:background="@mipmap/ic_nfc_more"
            android:layout_width="16dp"
            android:layout_height="16dp"/>
    </FrameLayout>
</FrameLayout>

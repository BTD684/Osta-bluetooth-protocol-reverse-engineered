        android:layout_marginEnd="16dp"
        app:itemLeftIcon="@mipmap/ic_launcher"
        app:itemName="功能名称"
        app:itemNameBold="false"
        app:itemRightIcon="@mipmap/widget_ic_right_next"
        app:itemRightIconAppearance="@style/itemRightIcon_14dp"

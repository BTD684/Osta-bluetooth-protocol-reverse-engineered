<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_boot_sound_effects_0"
    android:background="@color/color_f5f6fa_0F1012"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="@string/boot_sound_effect"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nsv_sound"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/dp_20"
        app:layout_constraintBottom_toTopOf="@+id/view_custom_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/view_system_default"
                android:background="@drawable/shape_effect_tips_bg"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_16"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_default"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/custom_system_default_title"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/view_system_default"
                app:layout_constraintStart_toStartOf="@+id/view_system_default"
                app:layout_constraintTop_toTopOf="@+id/view_system_default"/>
            <androidx.appcompat.widget.AppCompatCheckBox
                android:id="@+id/iv_sound_default"
                android:background="@drawable/shape_music_selected"
                android:clickable="false"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:checked="false"
                android:button="@null"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/view_system_default"
                app:layout_constraintEnd_toEndOf="@+id/view_system_default"
                app:layout_constraintTop_toTopOf="@+id/view_system_default"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_20"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_official_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:text="@string/custom_yadea_title"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_system_default"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_official_sound"
                android:background="@drawable/shape_effect_tips_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_16"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_official_title"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:id="@+id/tv_mine_sound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginBottom="@dimen/dp_16"
                android:text="@string/custom_my_audio_title"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginEnd="30dp"
                app:layout_constraintBottom_toTopOf="@+id/rv_mine_sound"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/rv_official_sound"
                app:layout_goneMarginTop="@dimen/dp_24"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/colorCustomRight"
                android:gravity="center"
                android:id="@+id/tv_mine_sound_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_32"
                android:layout_marginStart="@dimen/dp_2"
                android:layout_marginEnd="30dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_mine_sound"
                app:layout_constraintStart_toEndOf="@+id/tv_mine_sound"
                app:layout_constraintTop_toBottomOf="@+id/rv_official_sound"
                app:layout_goneMarginTop="@dimen/dp_32"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_mine_sound_add"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginTop="@dimen/dp_2"
                android:src="@mipmap/icon_sound_add"
                android:layout_marginEnd="@dimen/dp_28"
                app:layout_constraintBottom_toBottomOf="@+id/tv_mine_sound"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_mine_sound"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_mine_sound"
                android:background="@drawable/shape_effect_tips_bg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_mine_sound"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
    <View
        android:id="@+id/view_custom_line"
        android:background="@color/colorCustomLine"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/btn_effect_apply"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nsv_sound"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/colorNext"
        android:gravity="center"
        android:id="@+id/btn_effect_apply"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:layout_width="0dp"
        android:layout_height="51dp"
        android:layout_marginBottom="@dimen/dp_32"
        android:text="@string/custom_apply_audio_title"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>

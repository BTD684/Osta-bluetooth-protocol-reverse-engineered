<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_manually_bind_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/ble_key_manually_add_parts"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/ble_key_input_mac"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="20sp"
        android:textColor="@color/text_line_color_main"
        android:textColorHint="@color/text_line_color_main"
        android:gravity="center_vertical"
        android:id="@+id/edit_mac"
        android:background="@drawable/edit_ble_key_bg"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_56"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_24"
        android:maxLength="17"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/ble_bind_parts_item_text_color"
        android:id="@+id/tv_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/ble_key_input_mac_tips"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_mac"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_ble_find"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:layout_marginTop="@dimen/dp_32"
        android:text="@string/ble_key_switch_ble_scan"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintEnd_toStartOf="@+id/tv_confirm_bind"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/block_color_main_cc"
        android:gravity="center"
        android:id="@+id/tv_confirm_bind"
        android:background="@drawable/drawable_scan_binding_btn"
        android:layout_width="0dp"
        android:layout_height="45dp"
        android:text="@string/ble_key_confirm_bind"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_ble_find"
        app:layout_constraintTop_toTopOf="@+id/tv_ble_find"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Switch
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:thumb="@drawable/drawable_switch_thumb"
        android:track="@drawable/drawable_switch_track"/>
    <androidx.appcompat.widget.SwitchCompat
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:thumb="@drawable/drawable_switch_thumb"
        app:track="@drawable/drawable_switch_track"/>
    <androidx.appcompat.widget.AppCompatSeekBar
        android:background="@null"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:thumb="@drawable/seek_bar_thumb_bg"
        android:thumbOffset="0dp"
        android:layout_marginHorizontal="24dp"/>
    <com.yadea.widget.switchItem.YadeaSwitchItemLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:switch_left_icon="@mipmap/ic_launcher"
        app:switch_title="告警音设置"/>
    <com.yadea.widget.switchItem.YadeaSwitchItemLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:switch_bottom_left_value="10m"
        app:switch_bottom_right_value="5000m"
        app:switch_bottom_seekbar="true"
        app:switch_left_icon="@mipmap/ic_launcher"
        app:switch_title="告警音设置"
        app:switch_top_left_value="11"/>
    <com.yadea.widget.switchItem.YadeaSwitchItemLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:switch_bottom_left_value="近"
        app:switch_bottom_radio_group="true"
        app:switch_bottom_right_value="远"
        app:switch_left_icon="@mipmap/ic_launcher"
        app:switch_title="告警音设置"
        app:switch_top_left_value="11"/>
    <com.yadea.widget.switchItem.YadeaSwitchItemLayout
        android:id="@+id/action_switch_"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp"
        app:isSwitchItemTop="true"
        app:switch_left_icon="@mipmap/ic_launcher"
        app:switch_title="告警音设置"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:id="@+id/test_bottom"
        android:background="@drawable/corners_solid_block_color_main_bottom_radius_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginHorizontal="24dp">
        <View
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginHorizontal="16dp"/>
        <com.yadea.widget.textItem.YadeaTextItemLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:itemLayoutBg="@color/transparent"
            app:itemName="功能名称"
            app:itemNameAppearance="@style/itemName"
            app:itemRightIcon="@mipmap/widget_ic_right_next"/>
        <com.yadea.widget.font.YadeaTextView
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="选择车辆，并开启被盗模式，该车辆下电后不可使用，车辆会发出声光电"
            android:layout_marginVertical="16dp"
            android:paddingHorizontal="16dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>

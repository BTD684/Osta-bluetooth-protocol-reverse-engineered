<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_dash_board_battery_view_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ProgressBar
        android:id="@+id/pb_battery_progressBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:max="100"
        android:progress="0"
        style="@style/battery_progressBar"/>
    <com.yadea.vehicle.view.widget.dashboard.VehicleDashboardLatticeBatteryView
        android:id="@+id/vl_battery_lattice_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="horizontal"
        android:id="@+id/cl_bluetooth"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/black"
            android:id="@+id/tv_bluetooth_tips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_obtain_battery_tip"
            android:layout_centerVertical="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_013ECC"
            android:gravity="center"
            android:id="@+id/tv_connect_bluetooth"
            android:background="@drawable/corners_solid_color_background_013ecc_10_radius_16"
            android:layout_width="89dp"
            android:layout_height="@dimen/dp_25"
            android:text="@string/connect_ble"
            android:drawablePadding="-8dp"
            android:paddingStart="@dimen/dp_8"
            app:drawableStartCompat="@mipmap/icon_blue_bluetooth"
            app:layout_constraintBottom_toBottomOf="@+id/tv_bluetooth_tips"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_bluetooth_tips"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/ll_battery_tips"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/tv_battery_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_battery"
            android:layout_marginStart="@dimen/dp_16"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/tv_battery_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:layout_marginStart="@dimen/dp_4"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/tv_distance_tip"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_range"
            android:layout_marginStart="@dimen/dp_16"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/tv_battery_distance"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0km"
            android:layout_marginStart="@dimen/dp_4"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

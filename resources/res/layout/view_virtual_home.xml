<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/virtual_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/music_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">
        <net.easyconn.carman.view.VirtualMusicNotice
            android:id="@+id/music_notice"
            android:background="@drawable/bg_virtual_music"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="208dp"
            android:layout_height="58dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="6dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/phone_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">
        <net.easyconn.carman.view.VirtualPhoneNotice
            android:id="@+id/phone_notice"
            android:background="@drawable/bg_virtual_phone"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="208dp"
            android:layout_height="58dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="6dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <RelativeLayout
        android:id="@+id/message_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">
        <net.easyconn.carman.view.VirtualMessageNotice
            android:id="@+id/message_notice"
            android:background="@drawable/bg_virtual_music"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingBottom="8dp"
            android:visibility="gone"
            android:layout_width="208dp"
            android:layout_height="58dp"
            android:layout_marginTop="5dp"
            android:layout_marginRight="6dp"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_track_finish"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginTop="13dp"
        android:src="@drawable/theme_ivi_offmap_tab_ic_finish"
        android:layout_alignParentTop="true"
        android:layout_marginStart="13dp"
        android:layout_alignParentStart="true"/>
    <net.easyconn.carman.common.dialog.VirtualToastLayer
        android:id="@+id/virtual_toast_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</RelativeLayout>

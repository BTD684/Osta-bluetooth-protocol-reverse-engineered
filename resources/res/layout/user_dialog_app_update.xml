<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/user_dialog_app_update_0"
    android:background="@drawable/corners_solid_white_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="36dp"
    android:layout_marginRight="36dp"
    android:layout_marginHorizontal="36dp">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/vehicle_update"/>
    <androidx.core.widget.NestedScrollView
        android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
        android:layout_width="match_parent"
        android:layout_height="126dp"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_24"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layout_marginHorizontal="@dimen/dp_24">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_8C"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:lineSpacingExtra="4dp"/>
    </androidx.core.widget.NestedScrollView>
    <CheckBox
        android:textSize="@dimen/sp_12"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/cb_forbid_dialog"
        android:background="@color/ps_color_transparent"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_6"
        android:button="@drawable/check_box_style"
        android:text="@string/ota_not_dialog"
        android:paddingStart="8dp"
        android:layout_marginStart="24dp"
        android:paddingVertical="@dimen/dp_10"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="32dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/v_close"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/wait"
            android:layout_weight="1"/>
        <View
            android:id="@+id/view_center_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="1dp"
            android:layout_height="56dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/tv_update"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ota_immediately_update"
            android:layout_weight="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="0dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="0dp">
    <View
        android:layout_gravity="end"
        android:id="@+id/view_top"
        android:background="@drawable/ic_baseline_arrow_drop_up_24"
        android:layout_width="15dp"
        android:layout_height="@dimen/dp_10"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="@+id/action_menu_presenter"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_menu_dynamic"
        app:layout_constraintEnd_toEndOf="@+id/action_menu_presenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_menu_presenter"/>
    <View
        android:id="@+id/action_user_page"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_menu_presenter"
        app:layout_constraintEnd_toEndOf="@+id/action_menu_presenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_menu_presenter"/>
    <View
        android:id="@+id/action_search_all"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_menu_search"
        app:layout_constraintEnd_toEndOf="@+id/action_menu_presenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_menu_search"/>
    <View
        android:id="@+id/action_dynamic"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_menu_dynamic"
        app:layout_constraintEnd_toEndOf="@+id/action_menu_dynamic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_menu_dynamic"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_personal"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/popwindow_ic_personal_24"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_menu_presenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_menu_presenter"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center_vertical"
        android:id="@+id/action_menu_presenter"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:text="个人主页"
        android:paddingEnd="26dp"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintStart_toEndOf="@+id/img_personal"
        app:layout_constraintTop_toBottomOf="@+id/view_top"/>
    <View
        android:id="@+id/view_line1"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="@+id/action_menu_presenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_menu_presenter"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_search"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/popwindow_ic_svg_search_24"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_menu_search"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_menu_search"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center_vertical"
        android:id="@+id/action_menu_search"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="搜索全部"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="@+id/action_menu_presenter"
        app:layout_constraintStart_toEndOf="@+id/img_search"
        app:layout_constraintTop_toBottomOf="@+id/view_line1"/>
    <View
        android:id="@+id/view_line2"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="@+id/action_menu_presenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_menu_search"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_dynamic"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/popwindow_ic_svg_dynamic_24"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_menu_dynamic"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_menu_dynamic"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center_vertical"
        android:id="@+id/action_menu_dynamic"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:text="发布动态"
        android:layout_marginStart="@dimen/dp_10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/img_dynamic"
        app:layout_constraintTop_toBottomOf="@+id/view_line2"/>
</androidx.constraintlayout.widget.ConstraintLayout>

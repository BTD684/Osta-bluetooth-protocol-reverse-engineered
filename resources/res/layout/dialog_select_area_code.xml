<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_select_area_code_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="@dimen/dp_14">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/corners_solid_white_14"
        android:layout_width="@dimen/dp_300"
        android:layout_height="wrap_content">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/check_tel_address"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_vie"
            android:background="@drawable/corners_check_tel_bg"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_main"
                android:gravity="center_vertical"
                android:id="@+id/country_vie"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/vietnamese"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textColor="#ff5e00"
                android:gravity="center_vertical"
                android:id="@+id/code_vie"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="+84"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/country_vie"/>
            <RadioButton
                android:id="@+id/rb_vie"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:button="@drawable/check_tel_style"
                android:layout_marginEnd="@dimen/dp_14"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_ind"
            android:background="@drawable/corners_check_tel_bg"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_vie">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_main"
                android:gravity="center_vertical"
                android:id="@+id/country_ind"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/indonesia"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textColor="#ff5e00"
                android:gravity="center_vertical"
                android:id="@+id/code_ind"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="+62"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toEndOf="@+id/country_ind"/>
            <RadioButton
                android:id="@+id/rb_ind"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:button="@drawable/check_tel_style"
                android:layout_marginEnd="@dimen/dp_14"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/view_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_ind"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/btn_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/Cancel"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
            app:layout_constraintEnd_toEndOf="@+id/view_center_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
        <View
            android:id="@+id/view_center_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="1dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/btn_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/sure"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/view_center_line"
            app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>

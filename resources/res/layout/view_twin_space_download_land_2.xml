<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@drawable/theme_ivi_virhome_img_horizontalbg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.base.mirror.LayerStandardTitleView
        android:id="@+id/title_view"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_introduce_img"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/cl_introduce_text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.56">
        <View
            android:id="@+id/v_blank"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_vm_image_bg"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.14"/>
        <ImageView
            android:id="@+id/iv_vm_image_bg"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/theme_ivi_virhome_download_img_application"
            android:scaleType="centerInside"
            android:adjustViewBounds="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/v_blank"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.86"/>
        <androidx.viewpager.widget.ViewPager
            android:id="@+id/view_pager"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_vm_image_bg"
            app:layout_constraintEnd_toEndOf="@+id/iv_vm_image_bg"
            app:layout_constraintStart_toStartOf="@+id/iv_vm_image_bg"
            app:layout_constraintTop_toTopOf="@+id/iv_vm_image_bg">
            <View
                android:id="@+id/view_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </androidx.viewpager.widget.ViewPager>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <net.easyconn.carman.view.DarkIndicatorView
        android:gravity="center_horizontal"
        android:id="@+id/indicator_view"
        android:layout_width="0dp"
        android:layout_height="8dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_introduce_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/cl_introduce_img"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.44">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tv_introduce"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/t_1"
                android:textStyle="bold"
                android:textColor="@color/c_t1"
                android:gravity="center_vertical"
                android:id="@+id/tv_introduce_step1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vm_introduce_step"
                android:layout_marginStart="30dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_introduce_step2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:gravity="center_vertical"
                android:id="@+id/tv_introduce_step2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vm_introduce_step_2"
                android:paddingEnd="14dp"
                android:layout_marginStart="30dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_introduce_step3"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_introduce_step1"/>
            <TextView
                android:textSize="@dimen/t_1"
                android:textColor="@color/c_t5"
                android:gravity="center_vertical"
                android:id="@+id/tv_introduce_step3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="1dp"
                android:text="@string/vm_introduce_step_3"
                android:layout_marginStart="30dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_desc"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_introduce_step2"/>
            <View
                android:id="@+id/v_blank_tv"
                android:layout_width="30dp"
                android:layout_height="30dp"
                app:layout_constraintBottom_toTopOf="@+id/tv_introduce_step1"
                app:layout_constraintStart_toStartOf="@+id/tv_introduce_step1"
                app:layout_constraintTop_toBottomOf="@+id/tv_introduce_step1"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textStyle="bold"
                android:textColor="@color/c_t17"
                android:id="@+id/tv_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/vm_introduce_step_4"
                android:layout_marginStart="30dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_introduce_step3"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

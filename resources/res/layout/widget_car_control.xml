<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/control_root"
    android:background="@drawable/bg_app_widget"
    android:layout_width="320dp"
    android:layout_height="160dp">
    <ImageView
        android:id="@+id/iv_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@mipmap/ic_bg_no_car"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_battery"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"/>
        <FrameLayout
            android:id="@+id/fl_battery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="16dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/ll_battery_double"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="10dp">
                    <ProgressBar
                        android:id="@+id/progress_a"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        style="@style/DoubleBatteryProgressBarWidget"/>
                    <ImageView
                        android:id="@+id/iv_battery_zero_a"
                        android:background="@mipmap/ic_double_battery_zero_fat"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tv_battery_a"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:layout_marginStart="4dp"/>
                <FrameLayout
                    android:layout_width="50dp"
                    android:layout_height="10dp"
                    android:layout_marginStart="4dp">
                    <ProgressBar
                        android:id="@+id/progress_b"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        style="@style/DoubleBatteryProgressBarWidget"/>
                    <ImageView
                        android:id="@+id/iv_battery_zero_b"
                        android:background="@mipmap/ic_double_battery_zero_fat"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tv_battery_b"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/ll_battery_single"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="10dp">
                    <ProgressBar
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:max="100"
                        style="@style/DoubleBatteryProgressBarWidget"/>
                    <ImageView
                        android:id="@+id/iv_battery_zero"
                        android:background="@mipmap/ic_double_battery_zero"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>
                </FrameLayout>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/tv_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>
        </FrameLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="12sp"
                android:textColor="#8c8c8e"
                android:id="@+id/tv_status_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="● "
                android:layout_marginStart="16dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#8c8c8e"
                android:id="@+id/tv_status_content"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="16dp"
            android:layout_marginHorizontal="16dp">
            <ImageView
                android:id="@+id/iv_find_car"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:src="@mipmap/ic_find_car"
                android:layout_marginEnd="16dp"/>
            <ImageView
                android:id="@+id/iv_switch_car"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="10dp"
                android:src="@mipmap/ic_switch_car"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12sp"
                android:textColor="#000000"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_location"
                android:background="@drawable/corners_corner_12_color_white50"
                android:paddingLeft="16dp"
                android:paddingTop="8dp"
                android:paddingRight="16dp"
                android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_width="140dp"
                android:layout_height="50dp"
                android:maxLines="2"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_car_normal"
        android:padding="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#8c8c8e"
            android:id="@+id/tv_name_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"/>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <TextView
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="center_vertical"
            android:layout_gravity="bottom"
            android:id="@+id/tv_detail_normal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:drawableEnd="@mipmap/ic_detail"/>
    </LinearLayout>
</FrameLayout>

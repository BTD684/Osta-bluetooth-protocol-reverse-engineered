<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/csl_root"
    android:background="@color/c_popup_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t3"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/mirror_dialog_title_height"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:text="@string/notice_cozy"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:theme="@style/Theme.MaterialComponents"
        android:textSize="@dimen/t_4"
        android:textColor="@color/c_t3"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginHorizontal="20dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_enter"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t_popup"
        android:gravity="center"
        android:id="@+id/tv_enter"
        android:background="@color/c_popup_btn"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="0dp"
        android:layout_height="@dimen/mirror_dialog_bottom_height"
        android:layout_marginLeft="20dp"
        android:layout_marginTop="@dimen/mirror_dialog_bottom_height"
        android:layout_marginRight="20dp"
        android:text="@string/function_i_know"
        android:layout_marginHorizontal="20dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <CheckBox
        android:textSize="@dimen/t_6"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:id="@+id/cb_do_not_remind"
        android:background="@null"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:checked="false"
        android:button="@null"
        android:text="@string/not_alert_next"
        android:drawablePadding="10dp"
        android:drawableStart="@drawable/theme_mp_common_ic_checkbox"
        app:layout_constraintBottom_toTopOf="@+id/tv_enter"
        app:layout_constraintStart_toStartOf="@+id/tv_content"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
</androidx.constraintlayout.widget.ConstraintLayout>

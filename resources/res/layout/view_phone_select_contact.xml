<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/main_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_psc_top"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="@dimen/all_layout_title_height">
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_psc_back"
            android:layout_width="@dimen/y200"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/img_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/common_back_selector"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/color_333"
                android:id="@+id/tv_psc_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="#9b9b9b"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_psc_size"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/x52"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_psc_save"
            android:background="@color/c_phone"
            android:visibility="gone"
            android:layout_width="@dimen/y250"
            android:layout_height="@dimen/x110"
            android:text="保存"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/y10"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_search"
        android:background="@drawable/search_header_bg"
        android:focusable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x120"
        android:layout_marginTop="@dimen/x12"
        android:layout_marginBottom="@dimen/x24"
        android:layout_below="@+id/rl_psc_top"
        android:layout_marginStart="@dimen/card_left_right_margin_54"
        android:layout_marginEnd="@dimen/card_left_right_margin_54">
        <EditText
            android:textSize="@dimen/text_size_middle54"
            android:textColor="@color/white"
            android:textColorHint="@color/white_0.6"
            android:id="@+id/et_search_contacts"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="@string/search_hint"
            android:maxLines="1"
            android:layout_weight="1"
            android:paddingStart="@dimen/card_left_right_margin_54"/>
        <View
            android:background="#55ffffff"
            android:visibility="gone"
            android:layout_width="@dimen/x1"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/x20"
            android:layout_marginBottom="@dimen/x20"/>
        <Button
            android:textSize="@dimen/text_size_middle54"
            android:textColor="@color/white"
            android:id="@+id/btn_search_contacts"
            android:background="@null"
            android:visibility="gone"
            android:layout_width="@dimen/x210"
            android:layout_height="match_parent"
            android:text="@string/search"
            android:layout_weight="0"/>
    </LinearLayout>
    <ListView
        android:id="@+id/lv_psc_contact"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@color/transparent"
        android:layout_below="@+id/ll_search"
        android:layout_marginStart="@dimen/card_left_right_margin_54"
        android:layout_marginEnd="@dimen/x100"/>
    <net.easyconn.carman.phone.view.VerPhoneContactSideView
        android:id="@+id/view_slide"
        android:clickable="true"
        android:layout_width="@dimen/x100"
        android:layout_height="match_parent"
        android:layout_below="@+id/ll_search"
        android:layout_alignParentEnd="true"/>
    <TextView
        android:id="@+id/tv_phone_slide_show"
        style="@style/phone_slide_show"/>
    <TextView
        android:id="@+id/tv_no_contact"
        android:visibility="gone"
        android:text="@string/phone_no_contact"
        style="@style/phone_textview_notice"/>
</RelativeLayout>

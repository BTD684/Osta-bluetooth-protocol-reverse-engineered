<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setting_password_graph"
    app:startDestination="@+id/change_password_fragment">
    <fragment
        android:label="fragment_change_password"
        android:name="com.yadea.login.view.setting.ChangePasswordFragment"
        android:id="@+id/change_password_fragment">
        <action
            android:id="@+id/change_mobile"
            app:destination="@+id/set_password_fragment"/>
    </fragment>
    <fragment
        android:label="fragment_set_password"
        android:name="com.yadea.login.view.setting.SetPasswordFragment"
        android:id="@+id/set_password_fragment">
        <argument
            android:name="user_email"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="user_mobile"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="verify_code"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="user_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
    </fragment>
</navigation>

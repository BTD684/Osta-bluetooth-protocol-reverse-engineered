<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/main"
    android:tag="layout/activity_password_unlock_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:orientation="vertical"
                android:id="@+id/cl_password_unlock"
                android:background="@drawable/corners_solid_block_color_main_radius_14"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toTopOf="parent">
                <FrameLayout
                    android:id="@+id/fl_password_unlock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="parent">
                    <com.yadea.widget.switchItem.YadeaSwitchItemLayout
                        android:id="@+id/action_password_unlock"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_64"
                        app:switch_left_icon="@mipmap/icon_password_unlock"/>
                </FrameLayout>
                <com.yadea.widget.font.YadeaTextView
                    android:textColor="@color/text_line_color_main"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_password_unlock_set_password"
                    android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
                    android:padding="@dimen/dp_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:text="@string/app_set_password"
                    android:drawableEnd="@mipmap/widget_ic_right_next"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/fl_password_unlock"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textColor="@color/text_line_color_main"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_password_unlock_change_password"
                    android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
                    android:padding="@dimen/dp_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:text="@string/change_password"
                    android:drawableEnd="@mipmap/widget_ic_right_next"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/fl_password_unlock"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textColor="@color/text_line_color_main"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_password_unlock_forget_password"
                    android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
                    android:padding="@dimen/dp_16"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="53dp"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:text="@string/login_forgot_password"
                    android:drawableEnd="@mipmap/widget_ic_right_next"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_password_unlock_change_password"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.yadea.widget.font.YadeaTextView
                android:id="@+id/tv_password_unlock"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/cl_password_unlock"
                app:layout_constraintEnd_toEndOf="@+id/cl_password_unlock"
                app:layout_constraintStart_toStartOf="@+id/cl_password_unlock"
                app:layout_constraintTop_toTopOf="@+id/cl_password_unlock"
                style="@style/CarSettingMask"/>
            <androidx.cardview.widget.CardView
                android:id="@+id/card_tip"
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:cardCornerRadius="@dimen/dp_12"
                app:cardElevation="@dimen/dp_0"
                app:layout_constraintTop_toBottomOf="@+id/cl_password_unlock">
                <org.libpag.PAGImageView
                    android:id="@+id/pag_img_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </androidx.cardview.widget.CardView>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_password_unlock_tip_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/app_password_tip_title"
                app:layout_constraintStart_toStartOf="@+id/card_tip"
                app:layout_constraintTop_toBottomOf="@+id/card_tip"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@drawable/corners_solid_block_color_main_radius_14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginBottom="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_password_unlock_tip_title">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/app_password_tip_content_title"
                    android:layout_marginStart="@dimen/dp_16"
                    app:layout_constraintStart_toStartOf="@+id/card_tip"
                    app:layout_constraintTop_toBottomOf="@+id/card_tip"/>
                <View
                    android:background="@color/text_line_color_deputy_light_40"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="12dp"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textColor="@color/colorCustomRight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_12"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginBottom="@dimen/dp_16"
                    android:text="@string/app_password_tip_content"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

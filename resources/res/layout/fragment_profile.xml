<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/fragment_profile_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/theme_bg_top"
        android:background="@mipmap/bg_profile_top"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="375dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        app:isLeftIcon="false"
        app:layout_constraintTop_toTopOf="parent"
        app:rightIcon="@mipmap/home_ic_not_msg_notify"
        app:title="@string/home_profile"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingBottom="100dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <View
                android:id="@+id/view_head"
                android:background="@drawable/corners_solid_block_color_main_radius_14"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:layout_constraintBottom_toBottomOf="@+id/img_head"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/img_head"/>
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/img_head"
                android:tag="binding_1"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginTop="36dp"
                android:layout_marginStart="43dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/header_next"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@mipmap/widget_ic_right_next"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/view_head"
                app:layout_constraintEnd_toEndOf="@+id/view_head"
                app:layout_constraintTop_toTopOf="@+id/view_head"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/iv_unread"
                android:background="@drawable/corners_solid_state_color_red"
                android:paddingLeft="6dp"
                android:paddingTop="1.5dp"
                android:paddingRight="6dp"
                android:paddingBottom="1.5dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1.5dp"
                app:layout_constraintBottom_toBottomOf="@+id/view_head"
                app:layout_constraintEnd_toStartOf="@+id/header_next"
                app:layout_constraintTop_toTopOf="@+id/view_head"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:ellipsize="end"
                android:id="@+id/txt_name"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:lines="1"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toTopOf="@+id/txt_desc"
                app:layout_constraintEnd_toStartOf="@+id/header_next"
                app:layout_constraintStart_toEndOf="@+id/img_head"
                app:layout_constraintTop_toTopOf="@+id/view_head"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:ellipsize="end"
                android:id="@+id/txt_desc"
                android:layout_width="0dp"
                android:layout_height="22dp"
                android:text="@string/home_profile_edit"
                android:lines="1"
                app:layout_constraintBottom_toBottomOf="@+id/view_head"
                app:layout_constraintEnd_toEndOf="@+id/txt_name"
                app:layout_constraintStart_toStartOf="@+id/txt_name"
                app:layout_constraintTop_toBottomOf="@+id/txt_name"
                app:layout_constraintVertical_chainStyle="packed"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_devices"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:itemLeftIcon="@mipmap/home_ic_scooter_color"
                app:itemName="@string/home_profile_device"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/view_head"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_feed_back"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:isItemTop="true"
                app:itemBottomLineAppearance="@style/itemLine_margin16_bg"
                app:itemLeftIcon="@mipmap/home_ic_feed_back_color"
                app:itemName="@string/user_contact_us"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/action_devices"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_help"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:itemBottomLineAppearance="@style/itemLine_margin16_bg"
                app:itemLayoutBg="@color/block_color_main"
                app:itemLeftIcon="@mipmap/home_ic_help_color"
                app:itemName="@string/siri_help"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/action_feed_back"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_language"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:itemBottomLineAppearance="@style/itemLine_margin16_bg"
                app:itemLayoutBg="@color/block_color_main"
                app:itemLeftIcon="@mipmap/home_ic_language_color"
                app:itemName="@string/home_profile_language"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/action_help"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_theme"
                android:tag="binding_5"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:itemBottomLineAppearance="@style/itemLine_margin16_bg"
                app:itemLayoutBg="@color/block_color_main"
                app:itemLeftIcon="@mipmap/home_ic_theme_color"
                app:itemName="@string/app_theme_mode"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/action_language"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_unit"
                android:tag="binding_6"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:isItemBottom="true"
                app:itemBottomLineAppearance="@style/itemLine_margin16_bg"
                app:itemLeftIcon="@mipmap/home_ic_user_unit_settings_color"
                app:itemName="@string/user_unit_settings"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/action_theme"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_use_helper"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginLeft="22dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:isItemBottom="true"
                app:itemLeftIcon="@mipmap/home_ic_use_help_color"
                app:itemName="@string/mine_use_guide"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/action_unit"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_about_yadea"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:itemLeftIcon="@mipmap/home_ic_about_yadea_color"
                app:itemName="@string/home_profile_about_yadea"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/action_use_helper"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/action_login_out"
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginLeft="22dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="22dp"
                android:layout_marginHorizontal="22dp"
                app:itemLeftIcon="@mipmap/home_ic_login_out_color"
                app:itemName="@string/home_profile_login_out"
                app:itemRightIcon="@mipmap/widget_ic_right_next"
                app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                app:layout_constraintTop_toBottomOf="@+id/action_about_yadea"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

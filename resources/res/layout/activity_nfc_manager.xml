<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_nfc_manager_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rightIconAppearance="@style/rightIconSize_24dp"
        app:title="@string/nfc_card_management"/>
    <androidx.core.widget.NestedScrollView
        android:orientation="vertical"
        android:id="@+id/sv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="14dp"
                android:layout_marginRight="24dp"
                android:text="@string/nfc_main_entity_card"
                android:layout_marginHorizontal="24dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="24dp"
                android:text="@string/nfc_main_card_desc"
                android:layout_marginHorizontal="24dp"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/ll_no_primary"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="16sp"
                    android:textColor="@color/text_line_color_main"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/nfc_main_info_null"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textColor="@color/brand_color_main"
                    android:id="@+id/tv_ble_help"
                    android:tag="binding_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="12dp"
                    android:text="@string/nfc_ble_assistant"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_primary"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/subcard"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="12sp"
                    android:textColor="@color/text_line_color_deputy_dark"
                    android:id="@+id/tv_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/5"
                    android:layout_marginStart="8dp"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="24dp"
                android:text="@string/nfc_sub_card_desc"
                android:layout_marginHorizontal="24dp"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_daughter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_safety"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/instructions_for_safe_use"
                android:drawableRight="@mipmap/ic_12_gray_right"
                android:drawablePadding="4dp"
                android:layout_marginVertical="8dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>

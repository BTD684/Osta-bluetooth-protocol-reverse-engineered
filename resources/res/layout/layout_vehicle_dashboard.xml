<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/layout_vehicle_dashboard_0"
    android:background="@drawable/corners_solid_block_color_main_radius_14"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/action_app_dashboard_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/scooter_dashboard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ly_state"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_app_dashboard_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_app_dashboard_title">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_8C8C8E_999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trip_navi_record"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@mipmap/ic_right_next"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_8"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ly_on_cycling"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/action_app_dashboard_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/action_app_dashboard_title">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_8C8C8E_999999"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/trip_loging_desc"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:background="@mipmap/ic_right_next"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:layout_marginStart="@dimen/dp_8"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/action_app_dashboard_title">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/ll_navi_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_go"
                android:background="@drawable/corners_solid_block_color_background_f5f6fa_14"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_6">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@mipmap/icon_dashboard_search"
                    android:layout_marginEnd="@dimen/dp_10"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_line_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_free_navi"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center"
                android:orientation="horizontal"
                android:id="@+id/ll_history"
                android:background="@drawable/corners_solid_block_color_background_f5f6fa_14"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_56"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_6">
                <androidx.appcompat.widget.AppCompatImageView
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="20dp"
                    android:src="@mipmap/icon_dashboard_go"
                    android:layout_marginEnd="@dimen/dp_10"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_line_color_main"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/trip_navi_record"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_drive"
            android:background="@drawable/corners_solid_block_color_background_f5f6fa_14"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_104">
            <com.yadea.vehicle.view.widget.dashboard.YadeaDashboardHomeSpeedView
                android:id="@+id/dashboard_speed1"
                android:layout_width="@dimen/dp_80"
                android:layout_height="@dimen/dp_80"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_cycling_distance"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_48"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/ll_cycling_time"
                app:layout_constraintStart_toEndOf="@+id/dashboard_speed1"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_distance"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/dp_30"
                        android:text="0"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        android:textColor="@color/text_line_color_main"
                        android:id="@+id/tv_distance_km"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_1"
                        android:layout_marginStart="@dimen/dp_2"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_8C8C8E_999999"
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_18"
                    android:text="@string/icon_dashboard_mileage"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_cycling_time"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_48"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ll_cycling_distance"
                app:layout_constraintTop_toTopOf="parent">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_20"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:layout_gravity="center"
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_30"
                    android:text="00:00:00"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_8C8C8E_999999"
                    android:layout_gravity="center"
                    android:id="@+id/tv_time_tip"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/dp_18"
                    android:text="@string/icon_dashboard_duration"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/ll_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="horizontal"
                android:id="@+id/ll_latest_history"
                android:background="@drawable/corners_solid_block_color_background_f5f6fa_14"
                android:paddingLeft="8dp"
                android:paddingTop="17dp"
                android:paddingRight="8dp"
                android:paddingBottom="17dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="17dp">
                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@mipmap/icon_vehicle_dashboard_history"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp">
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_12"
                        android:textColor="@color/color_8C8C8E_999999"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/icon_dashboard_latest_record"/>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp">
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_8C8C8E_999999"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_18"
                            android:text="@string/icon_dashboard_mileage"/>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            android:textColor="@color/text_line_color_main"
                            android:id="@+id/tv_distance_result"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_4"/>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            android:textColor="@color/text_line_color_main"
                            android:id="@+id/tv_distance_km1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>
                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp">
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/color_8C8C8E_999999"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/dp_18"
                            android:text="@string/icon_dashboard_duration"/>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textStyle="bold"
                            android:textColor="@color/text_line_color_main"
                            android:id="@+id/tv_result_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_4"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_go"
                android:background="@drawable/corners_solid_block_color_background_f5f6fa_14"
                android:paddingLeft="24dp"
                android:paddingTop="31dp"
                android:paddingRight="24dp"
                android:paddingBottom="31dp"
                android:layout_width="84dp"
                android:layout_height="match_parent"
                android:src="@mipmap/ic_cycling_go"
                android:paddingHorizontal="24dp"
                android:paddingVertical="31dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

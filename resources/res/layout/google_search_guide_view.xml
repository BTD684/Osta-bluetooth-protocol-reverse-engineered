<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/google_search_guide_view_0"
    android:background="@color/c_s_d_google"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/c_bg4_google"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_search_tab"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/t_3"
                android:textColor="@drawable/selector_search_tab_text"
                android:gravity="center"
                android:id="@+id/tv_search_history"
                android:tag="binding_1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/search_history"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_search_nearby"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:tag="binding_2"
                android:background="@color/c_google_btn"
                android:layout_width="16dp"
                android:layout_height="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_search_history"
                app:layout_constraintEnd_toEndOf="@+id/tv_search_history"
                app:layout_constraintStart_toStartOf="@+id/tv_search_history"/>
            <TextView
                android:textSize="@dimen/t_3"
                android:textColor="@drawable/selector_search_tab_text"
                android:gravity="center"
                android:id="@+id/tv_search_nearby"
                android:tag="binding_3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/search_nearby"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_search_favorites"
                app:layout_constraintStart_toEndOf="@+id/tv_search_history"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:tag="binding_4"
                android:background="@color/c_google_btn"
                android:layout_width="16dp"
                android:layout_height="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_search_nearby"
                app:layout_constraintEnd_toEndOf="@+id/tv_search_nearby"
                app:layout_constraintStart_toStartOf="@+id/tv_search_nearby"/>
            <TextView
                android:textSize="@dimen/t_3"
                android:textColor="@drawable/selector_search_tab_text"
                android:gravity="center"
                android:id="@+id/tv_search_favorites"
                android:tag="binding_5"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/search_favorite"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_search_nearby"
                app:layout_constraintTop_toTopOf="parent"/>
            <View
                android:tag="binding_6"
                android:background="@color/c_google_btn"
                android:layout_width="16dp"
                android:layout_height="2dp"
                app:layout_constraintBottom_toBottomOf="@+id/tv_search_favorites"
                app:layout_constraintEnd_toEndOf="@+id/tv_search_favorites"
                app:layout_constraintStart_toStartOf="@+id/tv_search_favorites"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/tab_line"
            android:background="@color/c_l_google"
            android:layout_width="0dp"
            android:layout_height="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cl_search_tab"/>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/vl_container"
            android:tag="binding_7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

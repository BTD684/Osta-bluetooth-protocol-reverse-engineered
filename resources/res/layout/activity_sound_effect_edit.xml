<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_sound_effect_edit_0"
    android:background="@color/colorSoundBg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/custom_add_new_audio_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/line_bottom"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <com.yadea.smartmoto.sound.effect.weight.waveview.AudioScrollWaveView
            android:id="@+id/audioWaveView"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:wv_can_scroll="true"
            app:wv_center_line_width="@dimen/dp_2"
            app:wv_cut_icon_size="@dimen/dp_25"
            app:wv_cut_line_width="@dimen/dp_1"
            app:wv_cut_time_text_size="@dimen/sp_12"
            app:wv_one_second_rect_size="25"
            app:wv_rect_corner_radius="@dimen/dp_5"
            app:wv_rect_level="10"
            app:wv_rect_right_color="#93b3ea"
            app:wv_rect_space="@dimen/dp_2"
            app:wv_rect_width="@dimen/dp_3"
            app:wv_show_center_line="false"
            app:wv_show_top_bottom_line="false"
            app:wv_time_progress_text_color="@color/black"
            app:wv_time_progress_text_size="@dimen/sp_12"/>
        <FrameLayout
            android:orientation="horizontal"
            android:id="@+id/fl_intercept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/audioWaveView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/audioWaveView">
            <View
                android:background="@drawable/sound_effect_seekbar_thumb"
                android:layout_width="@dimen/dp_4"
                android:layout_height="108dp"/>
            <com.yadea.smartmoto.sound.effect.weight.waveview.ThumbOnlySeekBar
                android:id="@+id/seekbar"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:progress="75"
                android:paddingStart="@dimen/dp_2"
                android:paddingEnd="@dimen/dp_2"
                style="@style/CustomSeekBar"/>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:id="@+id/ll_audition"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="108dp">
                <View
                    android:background="#fd8e50"
                    android:layout_width="@dimen/dp_1"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <View
                    android:background="@drawable/bg_fd8e50_r5"
                    android:layout_width="@dimen/dp_5"
                    android:layout_height="@dimen/dp_5"/>
            </LinearLayout>
        </FrameLayout>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_242942_FFFFFF"
            android:id="@+id/tv_time_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:layout_marginStart="@dimen/dp_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_time_divider"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/tv_time_divider"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:layout_marginBottom="@dimen/dp_12"
            android:text="/"
            android:layout_marginStart="@dimen/dp_5"
            android:layout_marginVertical="@dimen/dp_12"
            app:layout_constraintStart_toEndOf="@+id/tv_time_position"
            app:layout_constraintTop_toBottomOf="@+id/audioWaveView"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/tv_time_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0:00"
            android:layout_marginStart="@dimen/dp_5"
            app:layout_constraintStart_toEndOf="@+id/tv_time_divider"
            app:layout_constraintTop_toTopOf="@+id/tv_time_divider"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_28"
            android:textColor="@color/color_000000_ffffff"
            android:id="@+id/tv_cut_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="3.0S"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_time_divider"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_8C8C8E_999999"
            android:gravity="center"
            android:id="@+id/tv_tip"
            android:paddingLeft="@dimen/dp_12"
            android:paddingRight="@dimen/dp_12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/custom_choose_max_title"
            android:paddingHorizontal="@dimen/dp_12"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_cut_duration"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/line_bottom"
        android:background="@color/color_0D000000_0DFFFFFF"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="@dimen/dp_12"
        app:layout_constraintBottom_toTopOf="@+id/btn_next"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/colorNext"
        android:gravity="center"
        android:id="@+id/btn_next"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:layout_width="0dp"
        android:layout_height="51dp"
        android:layout_marginBottom="@dimen/dp_40"
        android:text="@string/login_bind_email_next"
        android:layout_marginStart="@dimen/dp_15"
        android:layout_marginEnd="@dimen/dp_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>

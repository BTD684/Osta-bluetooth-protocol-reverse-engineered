<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_stores_details_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/nearby_shop_detail"/>
    <View
        android:id="@+id/view_bg"
        android:background="@drawable/corners_solid_block_color_dialog_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_0"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_24"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/space"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_store_icon"
        android:layout_width="@dimen/dp_48"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_16"
        android:src="@mipmap/ic_nearby_store_details"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:ellipsize="end"
        android:id="@+id/txt_store_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toStartOf="@+id/txt_store_status"
        app:layout_constraintStart_toEndOf="@+id/img_store_icon"
        app:layout_constraintTop_toTopOf="@+id/img_store_icon"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_8C8C8E_999999"
        android:id="@+id/txt_store_distance"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/img_store_icon"
        app:layout_constraintStart_toEndOf="@+id/img_store_icon"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_nearby_store_tag"
        android:gravity="center"
        android:id="@+id/txt_store_status"
        android:background="@drawable/nearby_store_distance_tag_bg"
        android:paddingLeft="@dimen/dp_8"
        android:paddingRight="@dimen/dp_8"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_22"
        android:layout_marginEnd="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/img_store_icon"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_8C8C8E_999999"
        android:id="@+id/txt_store_address"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toBottomOf="@+id/img_store_icon"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_store_person"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:drawablePadding="@dimen/dp_8"
        android:drawableStart="@mipmap/ic_store_person"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toBottomOf="@+id/txt_store_address"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/text_line_color_deputy_light_40"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toBottomOf="@+id/txt_store_person"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_store_business_hours"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:drawablePadding="@dimen/dp_8"
        android:drawableStart="@mipmap/txt_store_business_hours"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_store_business_hours"/>
    <View
        android:id="@+id/action_contact_us"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_24"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintEnd_toStartOf="@+id/space1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_bg"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_contact_us"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/user_contact_us"
        android:drawablePadding="@dimen/dp_8"
        android:drawableStart="@mipmap/ic_store_contact_us"
        app:layout_constraintBottom_toBottomOf="@+id/action_contact_us"
        app:layout_constraintEnd_toEndOf="@+id/action_contact_us"
        app:layout_constraintStart_toStartOf="@+id/action_contact_us"
        app:layout_constraintTop_toTopOf="@+id/action_contact_us"/>
    <Space
        android:id="@+id/space1"
        android:visibility="gone"
        android:layout_width="@dimen/dp_16"
        android:layout_height="@dimen/dp_0"
        app:layout_constraintEnd_toStartOf="@+id/action_navigate_to_store"
        app:layout_constraintStart_toEndOf="@+id/action_contact_us"/>
    <View
        android:id="@+id/action_navigate_to_store"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:layout_width="0dp"
        android:layout_height="@dimen/dp_44"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_8"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/space1"
        app:layout_constraintTop_toBottomOf="@+id/view_bg"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_ffffff_1e1e1e"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/nearby_shop_go"
        android:drawablePadding="@dimen/dp_8"
        android:drawableStart="@mipmap/ic_store_navigate"
        app:layout_constraintBottom_toBottomOf="@+id/action_navigate_to_store"
        app:layout_constraintEnd_toEndOf="@+id/action_navigate_to_store"
        app:layout_constraintStart_toStartOf="@+id/action_navigate_to_store"
        app:layout_constraintTop_toTopOf="@+id/action_navigate_to_store"/>
</androidx.constraintlayout.widget.ConstraintLayout>

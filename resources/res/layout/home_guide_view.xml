<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_root"
    android:background="#99000000"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_frame"
        android:layout_width="@dimen/y180"
        android:layout_height="@dimen/x180"
        android:layout_marginLeft="@dimen/y10"
        android:layout_marginTop="@dimen/x85"/>
    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/y60"
        android:layout_marginTop="@dimen/x120"
        android:layout_toRightOf="@+id/iv_frame"/>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_slide_switch_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:title="滑动开关"/>
    <com.yadea.widget.switchLayout.YedeaVehicleControlSwitch
        android:id="@+id/slide_switch"
        android:layout_width="wrap_content"
        android:layout_height="72dp"
        app:scooter_color_mode="false"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_fail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="失败"/>
        <Button
            android:id="@+id/btn_success"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="成功"/>
        <Button
            android:id="@+id/btn_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开启"/>
        <Button
            android:id="@+id/btn_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关闭"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_call_back_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="周期报文开启"/>
        <Button
            android:id="@+id/btn_call_back_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="周期报文关闭"/>
        <Button
            android:id="@+id/btn_close_call_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关闭周期报文"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Button
            android:id="@+id/btn_ble_control"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="蓝牙控车"/>
        <Button
            android:id="@+id/btn_network_control"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="网络控车"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.yadea.widget.font.YadeaTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="123123"/>
</androidx.appcompat.widget.LinearLayoutCompat>

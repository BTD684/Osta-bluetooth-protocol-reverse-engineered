<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_parent"
    android:background="@drawable/corners_solid_block_color_dialog_14"
    android:layout_width="match_parent"
    android:layout_height="160dp"
    android:layout_marginLeft="22dp"
    android:layout_marginTop="16dp"
    android:layout_marginRight="22dp"
    android:layout_marginHorizontal="22dp">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_vehicle"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:ellipsize="end"
        android:gravity="bottom"
        android:id="@+id/txt_vehicle_name"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:lines="1"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintBottom_toTopOf="@+id/txt_vehicle_vin"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toEndOf="@+id/img_vehicle"
        app:layout_constraintTop_toTopOf="@+id/img_vehicle"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_main"
        android:ellipsize="end"
        android:id="@+id/txt_vehicle_vin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lines="1"
        app:layout_constraintBottom_toTopOf="@+id/txt_vehicle_mac"
        app:layout_constraintEnd_toEndOf="@+id/txt_vehicle_name"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="@+id/txt_vehicle_name"
        app:layout_constraintTop_toBottomOf="@+id/txt_vehicle_name"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_main"
        android:ellipsize="end"
        android:id="@+id/txt_vehicle_mac"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="@+id/img_vehicle"
        app:layout_constraintEnd_toEndOf="@+id/txt_vehicle_name"
        app:layout_constraintStart_toStartOf="@+id/txt_vehicle_name"
        app:layout_constraintTop_toBottomOf="@+id/txt_vehicle_vin"
        app:layout_constraintVertical_chainStyle="packed"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_dialog_bg_14"
        android:paddingTop="24dp"
        android:layout_width="303dp"
        android:layout_height="wrap_content">
        <View
            android:layout_gravity="center_horizontal"
            android:id="@+id/v_icon"
            android:background="@color/text_line_color_deputy_dark"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginBottom="24dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/tv_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:text="title"
            android:layout_marginHorizontal="24dp"/>
        <ScrollView
            android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="154dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="24dp"
            android:layout_marginBottom="24dp"
            android:overScrollMode="never"
            android:layout_marginHorizontal="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_line_color_deputy_dark"
                    android:gravity="left"
                    android:id="@+id/tv_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"/>
            </LinearLayout>
        </ScrollView>
        <View
            android:id="@+id/v_line_h"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_important_tips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:gravity="center"
                android:id="@+id/btn_left"
                android:background="@drawable/corners_stroke_text_line_color_deputy_dark"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="BUTTON 1"
                android:paddingHorizontal="24dp"/>
            <View
                android:id="@+id/v_padding"
                android:layout_width="16dp"
                android:layout_height="1dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_deputy_light"
                android:gravity="center"
                android:id="@+id/btn_right"
                android:background="@drawable/corners_solid_text_line_color_deputy_dark"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="BUTTON 2"
                android:paddingHorizontal="24dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/center_confirm_view"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:text="确认"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/ll_general_tips"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_color_999999"
                android:gravity="center"
                android:id="@+id/tv_left"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="BUTTON 1"
                android:layout_weight="1"
                android:paddingHorizontal="24dp"/>
            <View
                android:id="@+id/v_line_v"
                android:background="@color/text_line_color_deputy_light_40"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:id="@+id/tv_right"
                android:paddingLeft="24dp"
                android:paddingRight="24dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="BUTTON 2"
                android:layout_weight="1"
                android:paddingHorizontal="24dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <View
        android:layout_gravity="center_horizontal"
        android:id="@+id/v_close"
        android:background="@color/text_line_color_deputy_dark"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="24dp"/>
</LinearLayout>

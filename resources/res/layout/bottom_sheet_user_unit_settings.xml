<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/bottom_sheet_user_unit_settings_0"
    android:background="@drawable/corners_solid_block_color_main_radius_top_14"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:paddingTop="@dimen/dp_24"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/unit"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:gravity="center"
        android:id="@+id/tv_tip"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="23dp"
        android:layout_marginRight="23dp"
        android:text="@string/metric_setting_tip"
        android:layout_marginHorizontal="23dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <RadioGroup
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_24"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintTop_toBottomOf="@+id/tv_tip">
        <com.yadea.widget.font.YadeaRadioButton
            android:textColor="@color/color_unit_setting_selected"
            android:gravity="center"
            android:id="@+id/rb_km"
            android:background="@drawable/unit_setting_selected_shape"
            android:paddingLeft="@dimen/dp_20"
            android:paddingRight="@dimen/dp_20"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_37"
            android:button="@null"
            android:text="@string/metric"
            android:paddingHorizontal="@dimen/dp_20"/>
        <com.yadea.widget.font.YadeaRadioButton
            android:textColor="@color/color_unit_setting_selected"
            android:gravity="center"
            android:id="@+id/rb_mi"
            android:background="@drawable/unit_setting_selected_shape"
            android:paddingLeft="@dimen/dp_20"
            android:paddingRight="@dimen/dp_20"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_37"
            android:button="@null"
            android:text="@string/imperical"
            android:layout_marginStart="@dimen/dp_16"
            android:paddingHorizontal="@dimen/dp_20"/>
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>

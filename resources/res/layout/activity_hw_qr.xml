<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/c_bg"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/rim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <net.easyconn.carman.view.QrScanHintView
            android:id="@+id/qr_scan_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <net.easyconn.carman.qr.QrScanLine
            android:id="@+id/qr_scan_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <RelativeLayout
        android:id="@+id/rl_title"
        android:background="@color/c_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/L_t">
        <FrameLayout
            android:id="@+id/v_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_title_back">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_back"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/theme_ivi_common_title_ic_back"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/t_1"
            android:textColor="@color/c_t1"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
</FrameLayout>

            android:orientation="vertical"
            android:paddingLeft="@dimen/dp_16"
            android:paddingBottom="@dimen/dp_24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/ll_vehicle_shake"
                android:tag="binding_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_72"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginEnd="@dimen/dp_16"
                app:itemLeftIcon="@mipmap/vehicle_shake_icon"
                app:itemLeftIconAppearance="@style/itemLeftIcon"
                app:itemNameBold="true"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.switchItem.YedeaOldSwitch
                android:layout_gravity="center_vertical"
                android:id="@+id/switch_vehicle_shake"
                android:tag="binding_3"
                android:background="@null"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumb="@drawable/drawable_switch_thumb"
                android:track="@drawable/setting_switch_track_gray_green"
                android:switchMinWidth="1dp"
                android:thumbTextPadding="0dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="@+id/ll_vehicle_shake"
                app:layout_constraintEnd_toEndOf="@+id/ll_vehicle_shake"
                app:layout_constraintTop_toTopOf="@+id/ll_vehicle_shake"/>
            <com.yadea.widget.textItem.YadeaTextItemLayout
                android:id="@+id/ll_vehicle_wheeling"

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_top_root"
    android:tag="layout/activity_dash_cam_a223_0"
    android:background="@drawable/bg_dash_cam_a223_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rightIcon="@drawable/icon_dash_cam_setting_24"
        app:title="@string/dash_cam_device_home_page"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/rcv_live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:elevation="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="@dimen/dp_14"
        app:cardElevation="@dimen/dp_0"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_video_container"
            android:background="@drawable/bg_dash_cam_a223_video"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yadea.media.player.rtsp.widget.RtspPlayerView
                android:id="@+id/video_view"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_camera_switch"
                android:padding="@dimen/dp_10"
                android:visibility="invisible"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@mipmap/icon_camera_switching"
                android:contentDescription="@string/dash_cam_camera_switch"
                app:layout_constraintBottom_toBottomOf="@+id/video_view"
                app:layout_constraintStart_toStartOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_orientation"
                android:padding="@dimen/dp_10"
                android:visibility="invisible"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/icon_dash_cam_orientation"
                android:contentDescription="@string/dash_cam_full_screen"
                app:layout_constraintBottom_toBottomOf="@+id/video_view"
                app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_default_tips"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@mipmap/icon_dash_cam_default"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@+id/video_view"
                app:layout_constraintTop_toTopOf="@+id/video_view"/>
            <ProgressBar
                android:id="@+id/pb_connecting"
                android:visibility="gone"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/dash_cam_video_tips"
                app:layout_constraintBottom_toTopOf="@+id/txt_no_connect_wifi_tips"
                app:layout_constraintEnd_toEndOf="@+id/video_view"
                app:layout_constraintStart_toStartOf="@+id/video_view"
                app:layout_constraintTop_toTopOf="@+id/video_view"
                app:layout_constraintVertical_chainStyle="packed"
                style="?android:attr/progressBarStyle"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/dash_cam_video_tips"
                android:gravity="center"
                android:id="@+id/txt_no_connect_wifi_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="12dp"
                android:layout_marginRight="24dp"
                android:text="@string/no_connect_wifi_tips"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintBottom_toBottomOf="@+id/video_view"
                app:layout_constraintEnd_toEndOf="@+id/video_view"
                app:layout_constraintStart_toStartOf="@+id/video_view"
                app:layout_constraintTop_toBottomOf="@+id/pb_connecting"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/gp_tips"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="txt_no_connect_wifi_tips,img_default_tips"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_video_fun"
                android:paddingLeft="@dimen/dp_24"
                android:paddingTop="12dp"
                android:paddingRight="@dimen/dp_24"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp_24"
                app:layout_constraintTop_toBottomOf="@+id/video_view">
                <com.yadea.widget.font.YadeaTextView
                    android:gravity="center"
                    android:id="@+id/txt_playback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playback"
                    android:layout_weight="1"
                    app:drawableTopCompat="@mipmap/icon_playback"/>
                <com.yadea.widget.font.YadeaTextView
                    android:gravity="center"
                    android:id="@+id/txt_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record"
                    android:layout_weight="1"
                    app:drawableTopCompat="@mipmap/icon_record"/>
                <com.yadea.widget.font.YadeaTextView
                    android:gravity="center"
                    android:id="@+id/txt_downloaded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/downloaded"
                    android:layout_weight="1"
                    app:drawableTopCompat="@mipmap/icon_downloaded"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_12"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center_vertical"
        android:id="@+id/txt_time"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="26dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="@dimen/dp_28"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/rcv_live"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_bottom_tips"
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/rcv_live">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_242942_white"
            android:id="@+id/txt_tips_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tips"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="normal"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/txt_tips_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dash_cam_new_main_tips_content"
            android:lineSpacingExtra="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_tips_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

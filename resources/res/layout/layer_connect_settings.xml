<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.base.mirror.LayerStandardTitleView
        android:id="@+id/title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleName="@string/function_connect"/>
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_view">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/settings_view"
            android:background="@color/c_list_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/item_keep_screen_light"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/L_1">
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/keep_screen_light"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/screen_always_on"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <CheckBox
                    android:id="@+id/switch_keep_screen_light"
                    android:background="@drawable/theme_ivi_personal_ic_switch"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="20dp"
                    android:checked="false"
                    android:button="@null"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/item_set_touping_tips"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/L_1">
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/set_touping_tips"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/ec_set_touping_tips"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <CheckBox
                    android:id="@+id/switch_set_touping_tips"
                    android:background="@drawable/theme_ivi_personal_ic_switch"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:checked="false"
                    android:button="@null"
                    android:layout_marginStart="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/item_sher_net"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/L_1">
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/sher_net"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/setting_net_share"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <CheckBox
                    android:id="@+id/switch_setting_net_share"
                    android:background="@drawable/theme_ivi_personal_ic_switch"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="20dp"
                    android:checked="false"
                    android:button="@null"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/item_lock_loat_button"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/L_1">
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/lock_loat_button"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/lock_float_button_title"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <CheckBox
                    android:id="@+id/switch_lock_loat_button"
                    android:background="@drawable/theme_ivi_personal_ic_switch"
                    android:layout_width="40dp"
                    android:layout_height="20dp"
                    android:layout_marginLeft="20dp"
                    android:checked="false"
                    android:button="@null"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/item_codec_type"
                android:background="@drawable/theme_selector_mirror_setting_item"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/L_1">
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/codec_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ec_encrypt_title"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="20dp"
                    android:src="@drawable/theme_ivi_common_list_ic_enter"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
            <View
                android:id="@+id/v_divider"
                android:background="@color/c_l"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/item_project_quality_adjust"
                android:background="@drawable/theme_selector_mirror_setting_item"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="@dimen/L_1">
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/tv_project_quality_adjust"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/setting_quality_adjust"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="20dp"
                    android:src="@drawable/theme_ivi_common_list_ic_enter"/>
            </LinearLayout>
            <View
                android:background="@color/c_l"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/item_clear_pari"
                android:background="@drawable/theme_selector_mirror_setting_item"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="@dimen/L_1">
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/clear_pari"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/ec_cancel_wifi_conn_match"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="20dp"
                    android:src="@drawable/theme_ivi_common_list_ic_enter"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/item_ble_hud"
                android:background="@drawable/theme_selector_mirror_setting_item"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/L_1">
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:id="@+id/ble_hud"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="@string/setting_ble_hud"
                    android:maxLines="2"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="20dp"
                    android:src="@drawable/theme_ivi_common_list_ic_enter"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

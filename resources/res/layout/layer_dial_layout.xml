<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tv_phone_dial_num1"
        android:text="1"
        app:layout_constraintBottom_toTopOf="@+id/tv_phone_dial_num4"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/tv_phone_dial_num2"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/style_layer_phone_dial_num"/>
    <TextView
        android:id="@+id/tv_phone_dial_num2"
        android:layout_marginLeft="8dp"
        android:text="2"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_dial_num1"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@+id/tv_phone_dial_num1"
        app:layout_constraintRight_toLeftOf="@+id/tv_phone_dial_num3"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_dial_num1"
        style="@style/style_layer_phone_dial_num"/>
    <TextView
        android:id="@+id/tv_phone_dial_num3"
        android:layout_marginLeft="8dp"
        android:text="3"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_dial_num1"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintLeft_toRightOf="@+id/tv_phone_dial_num2"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_dial_num1"
        style="@style/style_layer_phone_dial_num"/>
    <TextView
        android:id="@+id/tv_phone_dial_num4"
        android:layout_marginTop="8dp"
        android:text="4"
        app:layout_constraintBottom_toTopOf="@+id/tv_phone_dial_num7"
        app:layout_constraintLeft_toLeftOf="@+id/tv_phone_dial_num1"
        app:layout_constraintRight_toRightOf="@+id/tv_phone_dial_num1"
        app:layout_constraintTop_toBottomOf="@+id/tv_phone_dial_num1"
        style="@style/style_layer_phone_dial_num"/>
    <TextView
        android:id="@+id/tv_phone_dial_num5"
        android:text="5"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_dial_num4"
        app:layout_constraintLeft_toLeftOf="@+id/tv_phone_dial_num2"
        app:layout_constraintRight_toRightOf="@+id/tv_phone_dial_num2"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_dial_num4"
        style="@style/style_layer_phone_dial_num"/>
    <TextView
        android:id="@+id/tv_phone_dial_num6"
        android:text="6"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_dial_num4"
        app:layout_constraintLeft_toLeftOf="@+id/tv_phone_dial_num3"
        app:layout_constraintRight_toRightOf="@+id/tv_phone_dial_num3"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_dial_num4"
        style="@style/style_layer_phone_dial_num"/>
    <TextView
        android:id="@+id/tv_phone_dial_num7"
        android:layout_marginTop="8dp"
        android:text="7"
        app:layout_constraintBottom_toTopOf="@+id/tv_phone_dial_numstar"
        app:layout_constraintLeft_toLeftOf="@+id/tv_phone_dial_num1"
        app:layout_constraintRight_toRightOf="@+id/tv_phone_dial_num1"
        app:layout_constraintTop_toBottomOf="@+id/tv_phone_dial_num4"
        style="@style/style_layer_phone_dial_num"/>
    <TextView
        android:id="@+id/tv_phone_dial_num8"
        android:text="8"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_dial_num7"
        app:layout_constraintLeft_toLeftOf="@+id/tv_phone_dial_num2"
        app:layout_constraintRight_toRightOf="@+id/tv_phone_dial_num2"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_dial_num7"
        style="@style/style_layer_phone_dial_num"/>
    <TextView
        android:id="@+id/tv_phone_dial_num9"
        android:text="9"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_dial_num7"
        app:layout_constraintLeft_toLeftOf="@+id/tv_phone_dial_num3"
        app:layout_constraintRight_toRightOf="@+id/tv_phone_dial_num3"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_dial_num7"
        style="@style/style_layer_phone_dial_num"/>
    <ImageView
        android:id="@+id/tv_phone_dial_numstar"
        android:layout_marginTop="8dp"
        android:src="@drawable/theme_ivi_tel_btn_ic_star"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toTopOf="@+id/rl_dail_button"
        app:layout_constraintLeft_toLeftOf="@+id/tv_phone_dial_num1"
        app:layout_constraintRight_toRightOf="@+id/tv_phone_dial_num1"
        app:layout_constraintTop_toBottomOf="@+id/tv_phone_dial_num7"
        style="@style/style_layer_phone_dial_num"/>
    <FrameLayout
        android:id="@+id/tv_phone_dial_numzero"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_dial_numstar"
        app:layout_constraintLeft_toLeftOf="@+id/tv_phone_dial_num2"
        app:layout_constraintRight_toRightOf="@+id/tv_phone_dial_num2"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_dial_numstar"
        style="@style/style_layer_phone_dial_num">
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/tv_phone_dial_num0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-5dp"
                android:layout_marginBottom="-4dp"
                android:minHeight="0dp"
                android:text="0"
                android:includeFontPadding="false"
                android:lineHeight="@dimen/t_5"
                style="@style/style_layer_phone_dial_num"/>
            <TextView
                android:textSize="12sp"
                android:gravity="bottom"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="-4dp"
                android:layout_marginBottom="-5dp"
                android:text="+"
                android:lineHeight="12sp"
                style="@style/style_layer_phone_dial_num"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:id="@+id/tv_phone_dial_numjing"
        android:text="#"
        app:layout_constraintBottom_toBottomOf="@+id/tv_phone_dial_numstar"
        app:layout_constraintLeft_toLeftOf="@+id/tv_phone_dial_num3"
        app:layout_constraintRight_toRightOf="@+id/tv_phone_dial_num3"
        app:layout_constraintTop_toTopOf="@+id/tv_phone_dial_numstar"
        style="@style/style_layer_phone_dial_num"/>
    <FrameLayout
        android:id="@+id/rl_dail_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_phone_dial_numstar">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_phone_dial_search_dial"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/theme_ivi_tel_btn_ic_dial"/>
    </FrameLayout>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/activity_binding_device_status_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="2"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:tag="binding_1"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginBottom="32dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/txt_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="30dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="30dp"
        android:lineSpacingExtra="4dp"
        android:layout_marginHorizontal="30dp"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="3.5"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/block_color_main"
        android:gravity="center"
        android:id="@+id/tv_rescan"
        android:tag="binding_2"
        android:background="@drawable/corners_text_line_color_main_radius_14"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="90dp"
        android:layout_marginRight="90dp"
        android:layout_marginBottom="16dp"
        android:text="@string/qr_bluetooth_rescan"
        android:layout_marginHorizontal="90dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:tag="binding_3"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="90dp"
        android:layout_marginRight="90dp"
        android:layout_marginBottom="35dp"
        android:layout_marginHorizontal="90dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>

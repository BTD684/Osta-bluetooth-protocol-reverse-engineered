<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/v_background_content"
        android:background="@drawable/theme_ivi_home_img_horizontalbg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.mirror.MirrorPalaceGridView
        android:id="@+id/card_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/navigation_bar_end"
        app:layout_constraintStart_toEndOf="@+id/navigation_bar_start"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.mirror.SplitMirrorManagerView
        android:id="@+id/split_mirror_manager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_background_content"
        app:layout_constraintTop_toTopOf="@+id/v_background_content"/>
    <net.easyconn.carman.mirror.SplitScreenNavigationLandBar
        android:id="@+id/navigation_bar_start"
        android:background="@color/c_dock"
        android:visibility="gone"
        android:layout_width="@dimen/L_d"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/v_background_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.mirror.SplitScreenNavigationLandBar
        android:id="@+id/navigation_bar_end"
        android:background="@color/c_dock"
        android:visibility="gone"
        android:layout_width="@dimen/L_d"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/v_background_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/v_bg_layer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_background_content"
        app:layout_constraintEnd_toStartOf="@+id/mirror_palace_holder_right"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="@+id/v_background_content"/>
    <FrameLayout
        android:id="@+id/mirror_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mirror_palace_holder_right"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/mirror_map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mirror_palace_holder_right"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_dot_start"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@+id/navigation_bar_start"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_dot_end"
        android:layout_width="1dp"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/navigation_bar_end"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/mirror_full_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mirror_palace_holder_right"
        app:layout_constraintStart_toStartOf="@+id/v_background_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.view.cover.CoverMaskView
        android:id="@+id/view_cover_mask"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mirror_palace_holder_right"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/mirror_palace_holder_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/navigation_bar_start"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/mirror_palace_holder_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/navigation_bar_end"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.mirror.SplitMirrorDisplayView
        android:id="@+id/split_mirror_display"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <FrameLayout
        android:id="@+id/mirror_permission_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.common.base.mirror.DialogContainer
        android:id="@+id/layer_dialog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/v_common_control_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/split_mirror_display"
        app:layout_constraintStart_toStartOf="@+id/navigation_bar_end"
        app:layout_constraintTop_toTopOf="parent">
        <net.easyconn.carman.mirror.CommonControlLayout
            android:orientation="vertical"
            android:id="@+id/v_common_control"
            android:background="#a0000000"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <net.easyconn.carman.common.base.mirror.ToastContainer
        android:id="@+id/layer_toast"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/navigation_bar_end"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_track_finish"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_track_finish"
            android:visibility="gone"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:src="@drawable/theme_ivi_offmap_tab_ic_finish"/>
    </FrameLayout>
    <net.easyconn.carman.view.cover.CoverDrivingView
        android:id="@+id/view_cover"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

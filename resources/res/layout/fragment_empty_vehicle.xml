<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_empty_vehicle_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/img_user_avatar"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="72dp"
        android:src="@mipmap/user_icon_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/txt_user_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@+id/img_user_avatar"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_deputy_dark"
        android:gravity="center"
        android:id="@+id/txt_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_vehicle_bind_scooter_tips"
        app:layout_constraintTop_toBottomOf="@+id/txt_user_name"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/block_color_main"
        android:gravity="center"
        android:id="@+id/action_scan_code"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="195dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="@string/home_vehicle_bind_scooter"
        android:paddingVertical="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_tips"/>
    <com.yadea.widget.textItem.YadeaTextItemLayout
        android:id="@+id/action_nearby_stores"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginRight="@dimen/dp_24"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:itemLeftIcon="@mipmap/ic_nearby_stores"
        app:itemLeftIconAppearance="@style/itemLeftIcon"
        app:itemName="@string/near_shops"
        app:itemNameAppearance="@style/txt14_text_line_color_main"
        app:itemRightIcon="@mipmap/widget_ic_right_next"
        app:itemRightIconAppearance="@style/itemRightIcon_14dp"
        app:layout_constraintTop_toBottomOf="@+id/action_scan_code"/>
    <com.google.android.material.card.MaterialCardView
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
        android:id="@+id/action_nearby_stores_container"
        android:background="@color/transparent"
        android:visibility="gone"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_72"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_40"
        android:layout_marginRight="@dimen/dp_24"
        android:elevation="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:cardBackgroundColor="@color/transparent"
        app:cardCornerRadius="@dimen/dp_14"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@+id/action_nearby_stores"
        app:rippleColor="@android:color/transparent"
        app:strokeColor="@color/color_ffffff_1e1e1e"
        app:strokeWidth="@dimen/dp_1">
        <com.yadea.widget.textItem.YadeaTextItemLayout
            android:id="@+id/action_nearby_stores_color"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_72"
            app:itemLayoutBg="@mipmap/ic_color_nearby_stores_bg"
            app:itemLeftIcon="@mipmap/ic_color_nearby_stores"
            app:itemLeftIconAppearance="@style/itemLeftIcon"
            app:itemName="@string/near_shops"
            app:itemNameAppearance="@style/txt14_text_line_color_main"
            app:itemRightIconAppearance="@style/itemRightIcon_14dp"
            app:layout_constraintTop_toBottomOf="@+id/linear_setting"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/white"
            android:gravity="center_vertical"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/corners_solid_nearby_store_bg"
            android:paddingLeft="@dimen/dp_12"
            android:paddingRight="@dimen/dp_12"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_30"
            android:text="@string/view_more"
            android:layout_marginEnd="@dimen/dp_16"
            android:paddingHorizontal="@dimen/dp_12"/>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>

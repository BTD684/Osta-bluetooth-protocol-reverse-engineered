<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@color/c_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guile_line_title"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="@dimen/x144"/>
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="@dimen/y200"
        android:layout_height="0dp"
        android:src="@drawable/common_back_selector"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="@+id/guile_line_title"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/color_333"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/search_hud"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/guile_line_title"
        app:layout_constraintLeft_toRightOf="@+id/iv_back"
        app:layout_constraintRight_toLeftOf="@+id/v_space_title_right"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/v_space_title_right"
        android:layout_width="@dimen/x120"
        android:layout_height="@dimen/x120"
        android:layout_marginEnd="@dimen/y30"
        app:layout_constraintBottom_toBottomOf="@+id/guile_line_title"
        app:layout_constraintLeft_toRightOf="@+id/tv_title"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/v_title_line"
        android:background="@color/c_l"
        android:layout_width="0dp"
        android:layout_height="@dimen/y1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/guile_line_title"/>
    <net.easyconn.carman.view.HudDeviceScanView
        android:id="@+id/device_scan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/x42"
        android:animateLayoutChanges="false"
        app:layout_constraintBottom_toTopOf="@+id/tv_start_scan"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_title_line"/>
    <net.easyconn.carman.view.HudScanHintView
        android:id="@+id/scan_hint"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/x42"
        app:layout_constraintBottom_toTopOf="@+id/tv_start_scan"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_title_line"/>
    <TextView
        android:textSize="@dimen/x54"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_start_scan"
        android:background="@drawable/im_join_room_enter_bg"
        android:layout_width="324dp"
        android:layout_height="50dp"
        android:layout_marginBottom="30dp"
        android:text="@string/search_hud"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <net.easyconn.carman.view.HudDeviceConnectedView
        android:id="@+id/device_connected"
        android:background="@color/c_bg"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_title_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_root"
    android:background="@color/c_s"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_space"
        android:background="@color/c_popup_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.78">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/v_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="@+id/view_space"
            app:layout_constraintStart_toStartOf="@+id/view_space"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed">
            <TextView
                android:textSize="@dimen/t_1"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mirror_dialog_title_height"
                android:text="@string/notice"
                app:layout_constraintBottom_toTopOf="@+id/tv_content"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:theme="@style/Theme.MaterialComponents"
                android:textSize="@dimen/t_2"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/v_bottom"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="50dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/view_space"
            app:layout_constraintStart_toStartOf="@+id/view_space"
            app:layout_constraintTop_toBottomOf="@+id/v_top"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/t_1"
            android:textColor="@color/all_text_blue"
            android:gravity="center"
            android:id="@+id/tv_center_enter"
            android:background="@drawable/selector_permission_bg"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/dialog_enter"
            app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
            app:layout_constraintEnd_toEndOf="@+id/v_bottom"
            app:layout_constraintStart_toStartOf="@+id/v_bottom"
            app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:gravity="center"
            android:id="@+id/tv_cancel"
            android:background="@drawable/selector_permission_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/ec_usb_cancel"
            app:layout_constraintBottom_toBottomOf="@+id/tv_enter"
            app:layout_constraintEnd_toStartOf="@+id/tv_enter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_enter"/>
        <View
            android:id="@+id/line_divider"
            android:visibility="gone"
            android:layout_width="1dp"
            android:layout_height="30dp"
            app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
            app:layout_constraintEnd_toStartOf="@+id/tv_enter"
            app:layout_constraintStart_toEndOf="@+id/tv_cancel"
            app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:gravity="center"
            android:id="@+id/tv_enter"
            android:background="@drawable/selector_permission_bg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="50dp"
            android:text="@string/dialog_enter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_cancel"
            app:layout_constraintTop_toBottomOf="@+id/v_top"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

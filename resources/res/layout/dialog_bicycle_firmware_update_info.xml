<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:tag="layout/dialog_bicycle_firmware_update_info_0"
    android:background="@drawable/corners_solid_white_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="36dp"
    android:layout_marginRight="36dp"
    android:layout_marginHorizontal="36dp">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/v_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="24dp"
        android:src="@mipmap/icon_firmware_update"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_dialog_firmware_update"/>
    <androidx.core.widget.NestedScrollView
        android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
        android:layout_width="match_parent"
        android:layout_height="116dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layout_marginHorizontal="24dp">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textColor="@color/color_8C"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="16dp"
            android:lineSpacingExtra="4dp"/>
    </androidx.core.widget.NestedScrollView>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/state_color_blue"
        android:gravity="start"
        android:id="@+id/tv_tips2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:text="@string/firmware_update_tips"
        android:lineSpacingExtra="4dp"
        android:layout_marginHorizontal="24dp"/>
    <CheckBox
        android:textSize="12sp"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/cb_forbid_dialog"
        android:background="@color/ps_color_transparent"
        android:paddingTop="@dimen/dp_10"
        android:paddingBottom="@dimen/dp_10"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:button="@null"
        android:text="@string/ota_not_dialog"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/check_box_style"
        android:layout_marginStart="24dp"
        android:paddingVertical="@dimen/dp_10"/>
    <Space
        android:id="@+id/space"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="16dp"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="56dp">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/v_close"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/user_bottom_sheet_cancel"
            android:layout_weight="1"/>
        <View
            android:id="@+id/view_center_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="1dp"
            android:layout_height="56dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/tv_update"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/ota_immediately_update"
            android:layout_weight="1"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_sound"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_edit_bg"
        android:background="@mipmap/icon_edit_sound_popup"
        android:layout_width="132dp"
        android:layout_height="122dp"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_edit_sound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_27"
        android:text="@string/custom_modify_title"
        android:drawablePadding="@dimen/dp_10"
        android:drawableStart="@mipmap/icon_effect_edit"
        app:layout_constraintEnd_toEndOf="@+id/view_edit_bg"
        app:layout_constraintStart_toStartOf="@+id/view_edit_bg"
        app:layout_constraintTop_toTopOf="@+id/view_edit_bg"/>
    <View
        android:id="@+id/view_edit_line"
        android:background="@color/color_0d_ffffff"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/dp_10"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/view_edit_bg"
        app:layout_constraintEnd_toEndOf="@+id/view_edit_bg"
        app:layout_constraintStart_toStartOf="@+id/view_edit_bg"
        app:layout_constraintTop_toTopOf="@+id/view_edit_bg"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_delete_sound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/custom_remove_audio_title"
        android:drawablePadding="@dimen/dp_10"
        android:drawableStart="@mipmap/icon_effect_sound_delete"
        app:layout_constraintBottom_toBottomOf="@+id/view_edit_bg"
        app:layout_constraintStart_toStartOf="@+id/tv_edit_sound"/>
</androidx.constraintlayout.widget.ConstraintLayout>

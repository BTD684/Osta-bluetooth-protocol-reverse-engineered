<?xml version="1.0" encoding="utf-8"?>
<layer-list>
    <item>
        <shape xmlns:android="http://schemas.android.com/apk/res/android"
            android:shape="oval"
            android:useLevel="false">
            <solid android:color="#e8eaed"/>
            <size
                android:height="58dp"
                android:width="58dp"/>
        </shape>
    </item>
    <item>
        <inset android:inset="2dp">
            <shape
                android:shape="oval"
                android:useLevel="false">
                <stroke
                    android:width="3dp"
                    android:color="#d93025"/>
                <solid android:color="#e8eaed"/>
                <size
                    android:height="58dp"
                    android:width="58dp"/>
            </shape>
        </inset>
    </item>
</layer-list>

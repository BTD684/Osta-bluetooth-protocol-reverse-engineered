<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_item_bg"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rl_item_main_holder"
        android:layout_width="@dimen/x453"
        android:layout_height="@dimen/x273"/>
    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@+id/rl_item_main_holder"
        android:layout_alignBottom="@+id/rl_item_main_holder"
        android:layout_alignStart="@+id/rl_item_main_holder"
        android:layout_alignEnd="@+id/rl_item_main_holder">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14dp"
                android:textColor="@color/color_333"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tv_item_name"
                style="@style/phone_main_contact_item_name"/>
            <TextView
                android:id="@+id/tv_item_number"
                android:visibility="gone"
                style="@style/phone_main_contact_item_number"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_centerVertical="true">
            <ImageView
                android:layout_gravity="bottom|center_horizontal"
                android:id="@+id/img_add"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/color_666"
                android:id="@+id/tv_item_desc"
                android:visibility="visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/iv_item_delete"
        android:visibility="visible"
        android:clickable="true"
        android:layout_width="@dimen/x80"
        android:layout_height="@dimen/x80"
        android:layout_margin="@dimen/x24"/>
</RelativeLayout>

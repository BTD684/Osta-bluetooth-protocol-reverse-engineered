<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.progress.YadeaRoundProgress
        android:layout_width="100dp"
        android:layout_height="100dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:yadea_cur_progress_with="10dp"
        app:yadea_extra_text="测试"
        app:yadea_extra_text_size="12dp"
        app:yadea_progress="80"
        app:yadea_progress_text_color="@color/black"
        app:yadea_progress_text_size="26dp"/>
</androidx.constraintlayout.widget.ConstraintLayout>

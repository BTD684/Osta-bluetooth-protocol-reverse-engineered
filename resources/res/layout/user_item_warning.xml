<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/user_item_warning_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_16">
    <View
        android:id="@+id/view_warning"
        android:background="@drawable/shape_effect_tips_bg"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/color_000000_ffffff"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/view_warning"
        app:layout_constraintEnd_toStartOf="@+id/cb_voice_select"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_warning"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:enabled="false"
        android:id="@+id/cb_voice_select"
        android:tag="binding_1"
        android:background="@drawable/shape_music_selected"
        android:clickable="false"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:button="@null"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/view_warning"
        app:layout_constraintEnd_toEndOf="@+id/view_warning"
        app:layout_constraintTop_toTopOf="@+id/view_warning"/>
</androidx.constraintlayout.widget.ConstraintLayout>

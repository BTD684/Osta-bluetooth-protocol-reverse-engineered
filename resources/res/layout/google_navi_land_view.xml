<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ct_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_navi_info"
        android:background="@drawable/bg_navi_top_light"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="64dp"
        android:layout_marginStart="10dp"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_next_cross_icon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/t_2"
            android:textColor="@color/c_t14_google"
            android:id="@+id/tv_next_cross_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:singleLine="true"
            android:textDirection="locale"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_next_road_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_next_cross_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/t_2"
            android:textStyle="bold"
            android:textColor="@color/c_t14_google"
            android:ellipsize="end"
            android:id="@+id/tv_next_road_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textDirection="locale"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_next_cross_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_next_cross_distance"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_way"
        android:background="@drawable/bg_navi_bottom_light"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginStart="10dp"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_navi_info">
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t14_google"
            android:gravity="center_vertical"
            android:id="@+id/tv_then"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/google_navi_then"
            android:textDirection="locale"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/im_way"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/im_way"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_then"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_distance_time"
        android:background="@drawable/bg_navi_top_info_light"
        android:layout_width="240dp"
        android:layout_height="64dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/ll_navi_info"
        app:layout_constraintStart_toStartOf="@+id/ll_navi_info">
        <TextView
            android:textSize="@dimen/t_2"
            android:textStyle="bold"
            android:textColor="@color/c_t1_google"
            android:gravity="center_vertical"
            android:id="@+id/tv_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textDirection="locale"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_distance"
            app:layout_constraintEnd_toStartOf="@+id/tv_end_navigation"
            app:layout_constraintStart_toStartOf="@+id/view_distance_time"
            app:layout_constraintTop_toTopOf="@+id/view_distance_time"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t2_google"
            android:id="@+id/tv_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textDirection="locale"
            android:layout_marginStart="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_end_navigation"
            app:layout_constraintStart_toStartOf="@+id/view_distance_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_time"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t2_google"
            android:id="@+id/tv_point"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="·"
            android:singleLine="true"
            android:textDirection="locale"
            app:layout_constraintBottom_toBottomOf="@+id/tv_distance"
            app:layout_constraintEnd_toStartOf="@+id/tv_distance_time"
            app:layout_constraintStart_toEndOf="@+id/tv_distance"
            app:layout_constraintTop_toTopOf="@+id/tv_distance"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t2_google"
            android:id="@+id/tv_distance_time"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:singleLine="true"
            android:textDirection="locale"
            app:layout_constraintBottom_toBottomOf="@+id/tv_distance"
            app:layout_constraintEnd_toStartOf="@+id/tv_end_navigation"
            app:layout_constraintStart_toEndOf="@+id/tv_point"
            app:layout_constraintTop_toTopOf="@+id/tv_distance"/>
        <ImageView
            android:id="@+id/tv_end_navigation"
            android:padding="14dp"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/theme_ivi_googlemap_ic_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/view_distance_time"
            app:layout_constraintTop_toTopOf="@+id/view_distance_time"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_direction"
        android:background="@drawable/theme_icon_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/theme_ivi_googlemap_ic_northup"
        android:layout_marginEnd="10dp"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_location"
        android:background="@drawable/theme_google_navi_center"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        android:elevation="4dp"
        app:layout_constraintStart_toEndOf="@+id/view_distance_time"
        app:layout_constraintTop_toTopOf="@+id/view_distance_time">
        <ImageView
            android:id="@+id/iv_center"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/theme_ivi_googlemap_ic_return"
            android:layout_marginStart="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_enter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textStyle="bold"
            android:textColor="@color/c_map_navi"
            android:id="@+id/tv_enter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/google_navi_center"
            android:textDirection="locale"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_center"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_set"
        android:background="@drawable/theme_icon_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/theme_ivi_googlemap_ic_set"
        android:layout_marginEnd="10dp"
        android:elevation="4dp"
        android:outlineProvider="background"
        app:layout_constraintBottom_toTopOf="@+id/iv_logo"
        app:layout_constraintEnd_toEndOf="parent"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toTopOf="@+id/iv_set"
        app:layout_constraintEnd_toEndOf="parent"
        layout="@layout/layout_zoom_map"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:background="@drawable/theme_ivi_googlemap_ic_logo"
        android:layout_width="76dp"
        android:layout_height="26dp"
        android:layout_marginBottom="4dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

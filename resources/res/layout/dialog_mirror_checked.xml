<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/root_dialog_view"
    android:background="@color/c_popup_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_title"
        android:paddingTop="18dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/notice"
        app:layout_constraintBottom_toTopOf="@+id/tv_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.common.view.AutoAlignCenterTextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:id="@+id/tv_content"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:minHeight="@dimen/mirror_dialog_title_height"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/v_checked"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/v_checked"
        android:paddingBottom="20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="0dp"
        app:layout_constraintBottom_toTopOf="@+id/v_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content">
        <ImageView
            android:id="@+id/iv_checked"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/theme_ivi_third_ic_select_box"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t1"
            android:id="@+id/tv_checked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/not_alert_next"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_checked"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/v_bottom"
        android:layout_width="0dp"
        android:layout_height="@dimen/mirror_dialog_title_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_checked"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t_popup"
        android:gravity="center"
        android:id="@+id/tv_center_enter"
        android:background="@drawable/theme_bg_dialog_button"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/dialog_sure"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toEndOf="@+id/v_bottom"
        app:layout_constraintStart_toStartOf="@+id/v_bottom"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/theme_bg_dialog_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/ec_usb_cancel"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toStartOf="@+id/tv_enter"
        app:layout_constraintStart_toStartOf="@+id/v_bottom"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_navy"
        android:gravity="center"
        android:id="@+id/tv_enter"
        android:background="@drawable/theme_bg_dialog_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/dialog_sure"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toEndOf="@+id/v_bottom"
        app:layout_constraintStart_toEndOf="@+id/tv_cancel"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/white"
        android:layout_gravity="end"
        android:id="@+id/tv_skip"
        android:background="@drawable/corners_solid_black_20_percent_corner"
        android:paddingLeft="16dp"
        android:paddingTop="@dimen/dp_4"
        android:paddingRight="16dp"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/guide_skip"
        android:layout_marginEnd="24dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/battery_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/battery_guide_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_10"
        android:src="@mipmap/battery_guide_menu_color"
        app:layout_constraintEnd_toStartOf="@+id/battery_view"
        app:layout_constraintTop_toTopOf="@+id/battery_view"/>
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/white"
        android:id="@+id/i_know"
        android:background="@drawable/stoke_round_white"
        android:paddingLeft="16dp"
        android:paddingTop="4dp"
        android:paddingRight="16dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/guide_i_know"
        android:layout_marginEnd="@dimen/dp_16"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="@+id/battery_guide_menu"
        app:layout_constraintStart_toStartOf="@+id/battery_guide_menu"
        app:layout_constraintTop_toBottomOf="@+id/battery_guide_menu"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/ic_user_guide_bottom"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="@dimen/dp_8"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_8"
        android:layout_width="212dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="@+id/i_know"
        app:layout_constraintStart_toStartOf="@+id/i_know"
        app:layout_constraintTop_toBottomOf="@+id/i_know">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/guide_battery"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_battery_detail"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ct_root"
    android:background="@color/c_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.base.mirror.LayerStandardTitleView
        android:id="@+id/lt_title"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ScrollView
        android:id="@+id/sv_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lt_title">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="@dimen/t_2"
                android:gravity="center"
                android:id="@+id/tv_text_type"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/upload_type_label"
                android:layout_marginStart="20dp"/>
            <net.easyconn.carman.view.FlowRadioGroup
                android:orientation="horizontal"
                android:id="@+id/rg_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:gravity="center"
                android:id="@+id/tv_text_probability"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="16dp"
                android:text="@string/upload_probability_label"
                android:layout_marginStart="20dp"/>
            <net.easyconn.carman.view.FlowRadioGroup
                android:orientation="horizontal"
                android:id="@+id/rg_probability"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:gravity="center"
                android:layout_gravity="center_horizontal"
                android:id="@+id/bt_submit"
                android:layout_width="288dp"
                android:layout_height="44dp"
                android:layout_marginTop="40dp"
                android:layout_marginBottom="20dp"
                android:text="@string/upload_button"/>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_top"
    android:background="@drawable/bg_navi_info_top_light"
    android:layout_width="280dp"
    android:layout_height="match_parent"
    android:layout_marginTop="10dp"
    android:elevation="5dp"
    app:layout_constraintStart_toStartOf="parent">
    <TextView
        android:textSize="@dimen/t_2"
        android:textColor="@color/c_t1_google"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:maxLines="1"
        android:textDirection="locale"
        android:paddingStart="16dp"
        android:paddingEnd="10dp"
        app:layout_constraintEnd_toStartOf="@+id/iv_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_back"
        android:background="@drawable/theme_ivi_googlemap_ic_close"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    <View
        android:id="@+id/v_line"
        android:background="@color/c_l_google"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/result_view"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_line"/>
    <net.easyconn.carman.google.map.view.MirrorGoogleLoadingView
        android:id="@+id/mg_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

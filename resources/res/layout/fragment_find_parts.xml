<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_find_parts_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/ble_key_seek_parts"/>
    <com.yadea.widget.circleView.YedeaDiffuseView
        android:layout_gravity="center_horizontal"
        android:id="@+id/animate_scan_devices"
        android:layout_width="320dp"
        android:layout_height="320dp"
        app:diffuse_core_circle_size="90"
        app:diffuse_count="3"
        app:diffuse_stroke_width="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_not_scan_devices"
        android:visibility="gone"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_marginTop="120dp"
        android:src="@mipmap/ic_result_fail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/animate_scan_devices"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_50"
        android:layout_marginTop="32dp"
        android:layout_marginRight="@dimen/dp_50"
        android:layout_marginHorizontal="@dimen/dp_50"
        app:layout_constraintTop_toBottomOf="@+id/img_not_scan_devices"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_vehicle"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_marginVertical="@dimen/dp_16"
        app:layout_constraintBottom_toTopOf="@+id/action_rescan"
        app:layout_constraintTop_toBottomOf="@+id/tv_tips"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/block_color_main_cc"
        android:gravity="center"
        android:id="@+id/action_rescan"
        android:background="@drawable/drawable_scan_binding_btn"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="90dp"
        android:layout_marginRight="90dp"
        android:layout_marginBottom="16dp"
        android:text="@string/qr_bluetooth_rescan"
        android:layout_marginHorizontal="90dp"
        app:layout_constraintBottom_toTopOf="@+id/action_manual_add"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/action_manual_add"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="90dp"
        android:layout_marginRight="90dp"
        android:layout_marginBottom="35dp"
        android:text="@string/ble_key_manually_add"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="90dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
    <include
        android:id="@+id/include_permissions"
        android:background="@color/block_color_background"
        layout="@layout/include_ble_location_permissions"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="16dp">
    <View
        android:id="@+id/view1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_left"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.33"/>
    <View
        android:id="@+id/view2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_middle"
        app:layout_constraintStart_toEndOf="@+id/view1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.34"/>
    <View
        android:id="@+id/view3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.33"/>
    <View
        android:id="@+id/bg_middle"
        android:background="@drawable/corners_solid_orange_bg"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_middle"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_middle"
        app:layout_constraintEnd_toEndOf="@+id/bg_middle"
        app:layout_constraintStart_toStartOf="@+id/bg_middle"
        app:layout_constraintTop_toTopOf="@+id/bg_middle"/>
    <org.libpag.PAGImageView
        android:id="@+id/iv_pag_middle"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintStart_toStartOf="@+id/iv_middle"
        app:layout_constraintTop_toTopOf="@+id/iv_middle"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/tv_middle"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minWidth="56dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintEnd_toEndOf="@+id/view2"
        app:layout_constraintStart_toStartOf="@+id/view2"
        app:layout_constraintTop_toBottomOf="@+id/bg_middle"/>
    <View
        android:id="@+id/bg_left"
        android:background="@drawable/corners_solid_green_bg"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_left"
        app:layout_constraintStart_toStartOf="@+id/tv_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_left"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_left"
        app:layout_constraintEnd_toEndOf="@+id/bg_left"
        app:layout_constraintStart_toStartOf="@+id/bg_left"
        app:layout_constraintTop_toTopOf="@+id/bg_left"/>
    <org.libpag.PAGImageView
        android:id="@+id/iv_pag_left"
        android:visibility="gone"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintStart_toStartOf="@+id/iv_left"
        app:layout_constraintTop_toTopOf="@+id/iv_left"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/tv_left"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:maxWidth="80dp"
        android:minWidth="56dp"
        android:layout_marginStart="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bg_left"/>
    <View
        android:id="@+id/bg_right"
        android:background="@drawable/corners_solid_blue_bg"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:layout_constraintEnd_toEndOf="@+id/tv_right"
        app:layout_constraintStart_toStartOf="@+id/tv_right"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_right"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintBottom_toBottomOf="@+id/bg_right"
        app:layout_constraintEnd_toEndOf="@+id/bg_right"
        app:layout_constraintStart_toStartOf="@+id/bg_right"
        app:layout_constraintTop_toTopOf="@+id/bg_right"/>
    <org.libpag.PAGImageView
        android:id="@+id/iv_pag_right"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:layout_constraintStart_toStartOf="@+id/iv_right"
        app:layout_constraintTop_toTopOf="@+id/iv_right"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/tv_right"
        android:layout_width="65dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxWidth="80dp"
        android:minWidth="56dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bg_right"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/dialog_ble_base_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/text_size_middle54"
        android:textColor="#303030"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/prompt_dialog_title_height"/>
    <View
        android:id="@+id/line_title"
        android:background="@color/one_pixel_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="#4f4f4f"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x50"
            android:layout_marginRight="@dimen/x50"/>
    </ScrollView>
    <View
        android:id="@+id/line_content"
        android:background="@color/one_pixel_divider"
        android:layout_width="match_parent"
        android:layout_height="1px"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/prompt_dialog_title_height">
        <TextView
            android:id="@+id/tv_center_enter"
            android:background="@drawable/dialog_ble_base_center_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/auto_dialog_ok"
            style="@style/dialog_ble_base_action"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_two_button_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/prompt_dialog_title_height">
            <TextView
                android:id="@+id/tv_cancel"
                android:background="@drawable/dialog_ble_base_cancel_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/auto_dialog_cancel"
                android:layout_weight="1"
                style="@style/dialog_ble_base_cancel_action"/>
            <View
                android:background="@color/one_pixel_divider"
                android:layout_width="1px"
                android:layout_height="match_parent"/>
            <TextView
                android:id="@+id/tv_enter"
                android:background="@drawable/dialog_ble_base_ensure_bg"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/auto_dialog_ok"
                android:layout_weight="1"
                style="@style/dialog_ble_base_action"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>

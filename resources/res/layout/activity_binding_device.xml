<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_binding_device_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Device Detected"/>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/block_color_main"
        android:gravity="center"
        android:id="@+id/action_connect"
        android:background="@drawable/corners_text_line_color_main_radius_14"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="90dp"
        android:layout_marginRight="90dp"
        android:layout_marginBottom="16dp"
        android:text="@string/vehicle_dialog_bluetooth_connect"
        android:layout_marginHorizontal="90dp"
        app:layout_constraintBottom_toTopOf="@+id/action_rescan"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/action_rescan"
        android:background="@drawable/corners_stroke_text_line_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="90dp"
        android:layout_marginRight="90dp"
        android:layout_marginBottom="35dp"
        android:text="@string/qr_bluetooth_rescan"
        android:layout_marginHorizontal="90dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

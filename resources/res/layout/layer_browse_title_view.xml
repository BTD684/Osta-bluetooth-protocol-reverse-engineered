<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/me_root"
    android:layout_width="match_parent"
    android:layout_height="60dp">
    <ImageView
        android:id="@+id/iv_back"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_common_title_ic_back"
        android:scaleType="centerInside"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_forward"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_common_title_ic_forward_invalid"
        android:scaleType="centerInside"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_back"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_home"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_common_title_ic_homepage"
        android:scaleType="centerInside"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_forward"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t2"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/et_input"
        android:background="@drawable/theme_bg_radius_button_browse_input"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:hint="@string/click_keybody"
        android:maxLines="1"
        android:singleLine="true"
        android:textDirection="locale"
        android:paddingStart="16dp"
        android:paddingEnd="50dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_resolution"
        app:layout_constraintStart_toEndOf="@+id/iv_home"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_collet"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="60dp"
        android:src="@drawable/theme_ivi_common_title_ic_collect"
        android:scaleType="centerInside"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/et_input"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_resolution"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_common_title_ic_resolution"
        android:scaleType="centerInside"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_keyboard"
        app:layout_constraintStart_toEndOf="@+id/et_input"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_keyboard"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/theme_ivi_common_title_ic_keyboard_browser"
        android:scaleType="centerInside"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_resolution"
        app:layout_constraintTop_toTopOf="parent"/>
</merge>

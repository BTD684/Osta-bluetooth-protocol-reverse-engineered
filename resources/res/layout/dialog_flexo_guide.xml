<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/dialog_flexo_guide_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_dialog_bg_14"
        android:layout_width="303dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:text="@string/user_car_flexo_guide"
            android:layout_marginHorizontal="24dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/txt_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:text="@string/user_car_flexo_info"
            android:layout_marginHorizontal="24dp"/>
        <ImageView
            android:id="@+id/img_gif"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"/>
        <ImageView
            android:background="@color/text_line_color_deputy_light_alpha"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/btn_right"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/user_dialog_i_see"/>
    </LinearLayout>
</RelativeLayout>

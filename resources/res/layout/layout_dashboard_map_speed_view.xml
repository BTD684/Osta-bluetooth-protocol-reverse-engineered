<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:background="@drawable/corners_solid_color_white_radius_80"
    android:paddingLeft="@dimen/dp_16"
    android:paddingTop="@dimen/dp_12"
    android:paddingRight="@dimen/dp_16"
    android:paddingBottom="@dimen/dp_12"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_16"
    android:paddingVertical="@dimen/dp_12">
    <com.yadea.vehicle.view.widget.dashboard.YadeaDashboardMapModeSpeedView
        android:id="@+id/yd_speed_view"
        android:layout_width="@dimen/dp_80"
        android:layout_height="@dimen/dp_80"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_cycling_distance"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_56"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_12">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                android:textColor="@color/color000C19"
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="@color/color000C19"
                android:id="@+id/tv_distance_km"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_1"
                android:layout_marginStart="@dimen/dp_2"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_80858C"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/icon_dashboard_mileage"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_cycling_time"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_56"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/dp_4">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/color000C19"
            android:layout_gravity="center"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_80858C"
            android:layout_gravity="center"
            android:id="@+id/tv_time_tip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/traveling_interval"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:orientation="vertical"
        android:id="@+id/ll_cycling_max_speed"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_56"
        android:layout_weight="1">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="bottom|center_horizontal"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_18"
                android:textStyle="bold"
                android:textColor="@color/color000C19"
                android:id="@+id/tv_max_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="@color/color000C19"
                android:id="@+id/tv_max_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_1"
                android:layout_marginStart="@dimen/dp_2"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_80858C"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/traveling_maxspeed"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/fragment_search_nearby_stores_0"
    android:background="@color/block_color_background"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/nearby_shop_search"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_line_color_main"
        android:textColorHint="@color/color_e6e6e6_333333"
        android:gravity="center_vertical"
        android:id="@+id/edit_search_nearby_store"
        android:background="@drawable/shape_dialog_bg_14"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_44"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_24"
        android:hint="@string/nearby_shop_search"
        android:maxLines="1"
        android:singleLine="true"
        android:drawablePadding="@dimen/dp_8"
        android:imeOptions="actionSearch"
        android:drawableStart="@mipmap/ic_search_nearby_store"
        android:paddingStart="@dimen/dp_16"
        android:paddingEnd="52dp"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/action_clear_search"
        android:visibility="gone"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:src="@mipmap/ic_search_store_close"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/edit_search_nearby_store"
        app:layout_constraintEnd_toEndOf="@+id/edit_search_nearby_store"
        app:layout_constraintTop_toTopOf="@+id/edit_search_nearby_store"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_search_result"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/nearby_shop_search_result"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_search_nearby_store"/>
    <com.scwang.smart.refresh.layout.SmartRefreshLayout
        android:id="@+id/refresh"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_search_result">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rl_search_result_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"/>
    </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_history"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/nearby_shop_history"
        android:layout_marginStart="@dimen/dp_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/edit_search_nearby_store"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/action_clear_history"
        android:visibility="gone"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:src="@mipmap/ic_clear_store_history"
        android:layout_marginEnd="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="@+id/txt_history"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_history"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rl_history_list"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_24"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_history"/>
</androidx.constraintlayout.widget.ConstraintLayout>

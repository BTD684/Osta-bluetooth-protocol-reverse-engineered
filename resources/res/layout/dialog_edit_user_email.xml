<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_edit_user_email_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="300dp"
        android:layout_height="wrap_content">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:text="@string/user_dialog_modify_email"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_email"
            android:tag="binding_1"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="32dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:hint_text="@string/user_dialog_enter_address"
            app:input_edit_clear="true"
            app:input_edit_max_length="50"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_margin_top="13dp"
            app:input_text_size="14sp"
            app:input_text_type="text_email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_title"
            app:name_text="@string/user_dialog_old_email"
            app:name_text_bold="true"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/txt_verify_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/login_register_verify_code"
            app:layout_constraintStart_toStartOf="@+id/edit_email"
            app:layout_constraintTop_toBottomOf="@+id/edit_email"/>
        <com.yadea.widget.input.YedeaVerifyCodeEditText
            android:gravity="center_vertical"
            android:id="@+id/edit_verify_code"
            android:tag="binding_2"
            android:focusableInTouchMode="true"
            android:longClickable="false"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:maxLength="4"
            android:inputType="number"
            android:layout_marginEnd="@dimen/dp_10"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/action_send_code"
            app:layout_constraintStart_toStartOf="@+id/txt_verify_code"
            app:layout_constraintTop_toBottomOf="@+id/txt_verify_code"
            app:verify_code_length="4"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/action_send_code"
            android:background="@drawable/corners_stroke_text_line_color_main"
            android:layout_width="72dp"
            android:layout_height="32dp"
            android:text="@string/user_dialog_verify_code_send"
            android:layout_marginEnd="24dp"
            app:layout_constraintBottom_toBottomOf="@+id/edit_verify_code"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/edit_verify_code"/>
        <View
            android:id="@+id/view_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="32dp"
            app:layout_constraintTop_toBottomOf="@+id/edit_verify_code"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/action_cancel"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/Cancel"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_center_view"
            app:layout_constraintEnd_toEndOf="@+id/bottom_center_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/bottom_center_view"/>
        <View
            android:id="@+id/bottom_center_view"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="1dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/action_Confirm"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/sure"
            app:layout_constraintBottom_toBottomOf="@+id/bottom_center_view"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/bottom_center_view"
            app:layout_constraintTop_toTopOf="@+id/bottom_center_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

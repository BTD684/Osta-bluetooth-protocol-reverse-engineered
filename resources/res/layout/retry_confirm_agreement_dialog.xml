<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/retry_confirm_agreement_dialog_0"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardCornerRadius="@dimen/dp_14">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@color/block_color_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/nfc_title_tip"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.protocol.YadeaProtocolLayout
            android:gravity="center"
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:protocol_check_margin_top="0dp"
            app:protocol_check_size="0dp"
            app:protocol_content="@string/user_agreement_tip_content_again"
            app:protocol_content_line_spacing="1.5"
            app:protocol_content_text_color="@color/text_line_color_deputy_dark"
            app:protocol_content_text_size="14sp"/>
        <View
            android:id="@+id/view_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/content"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/btn_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/home_agreement_disagree_again"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
            app:layout_constraintEnd_toEndOf="@+id/view_center_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
        <View
            android:id="@+id/view_center_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="1dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/btn_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/home_agreement_agree"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/view_center_line"
            app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_sound_effect_rename_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_effect_name"
        android:background="@drawable/shape_effect_name_bg"
        android:layout_width="0dp"
        android:layout_height="238dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:id="@+id/tv_effect_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/custom_rename_title"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_name"
        app:layout_constraintRight_toRightOf="@+id/view_effect_name"
        app:layout_constraintTop_toTopOf="@+id/view_effect_name"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorCustom"
        android:textColorHint="@color/text_line_color_deputy_dark"
        android:gravity="start|center_vertical"
        android:id="@+id/et_sound_effect"
        android:background="@drawable/shape_effect_name_edit_bg"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:layout_width="0dp"
        android:layout_height="53dp"
        android:layout_marginTop="15dp"
        android:button="@null"
        android:text=""
        android:hint="@string/custom_input_audio_title"
        android:singleLine="true"
        android:maxLength="30"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="20dp"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_name"
        app:layout_constraintRight_toRightOf="@+id/view_effect_name"
        app:layout_constraintTop_toBottomOf="@+id/tv_effect_title"/>
    <View
        android:id="@+id/view_et_line"
        android:background="#0d000000"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@+id/et_sound_effect"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="16sp"
        android:textColor="@color/colorNext"
        android:gravity="center"
        android:id="@+id/btn_save_effect_name"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/dp_20"
        android:text="@string/map_save"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintHorizontal_bias="0.533"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_name"
        app:layout_constraintRight_toRightOf="@+id/view_effect_name"
        app:layout_constraintTop_toBottomOf="@+id/view_et_line"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>

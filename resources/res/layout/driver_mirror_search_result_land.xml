<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_title"
        android:background="@drawable/theme_search_title_bg"
        android:layout_width="260dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t1_google"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:maxLines="1"
            android:textDirection="locale"
            android:paddingEnd="10dp"
            android:layout_marginStart="16dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_back"
            android:padding="10dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/theme_ivi_map_close"
            android:layout_marginEnd="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/tv_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_bottom"
        android:background="@drawable/bg_navi_info_top_light"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
            android:id="@+id/im_back"
            android:background="@drawable/theme_ivi_googlemap_ic_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/t_2"
            android:textColor="@color/c_t1_google"
            android:id="@+id/tv_address"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textDirection="locale"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/im_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t2_google"
            android:ellipsize="end"
            android:id="@+id/tv_district"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textDirection="locale"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/im_back"
            app:layout_constraintStart_toStartOf="@+id/tv_address"
            app:layout_constraintTop_toBottomOf="@+id/tv_address"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t2_google"
            android:ellipsize="end"
            android:id="@+id/tv_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textDirection="locale"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/im_back"
            app:layout_constraintStart_toStartOf="@+id/tv_address"
            app:layout_constraintTop_toBottomOf="@+id/tv_district"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ct_route"
            android:background="@drawable/theme_search_bg"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/iv_collect"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_distance"
            app:layout_constraintVertical_bias="1">
            <ImageView
                android:id="@+id/iv_route"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/theme_search_icon_bg"
                android:layout_marginEnd="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_route"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/t_4"
                android:textColor="@color/c_t3_google"
                android:gravity="center"
                android:id="@+id/tv_route"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/route_google"
                android:textDirection="locale"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_route"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <CheckBox
            android:id="@+id/iv_collect"
            android:background="@drawable/selector_collect_toggle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:checked="false"
            android:button="@null"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="@+id/ct_route"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ct_route"
            app:layout_constraintTop_toTopOf="@+id/ct_route"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <net.easyconn.carman.google.map.view.MirrorGoogleLoadingView
        android:id="@+id/mg_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

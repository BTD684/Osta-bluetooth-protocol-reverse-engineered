<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp">
    <include layout="@layout/include_neutral_home_card_port_guide"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toLeftOf="@+id/view_card_bg"
        app:layout_constraintRight_toLeftOf="@+id/line_port_title_begin"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/black"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/phonename"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_begin"
        app:layout_constraintRight_toLeftOf="@+id/line_port_title_end"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_add1"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_end"
        app:layout_constraintRight_toLeftOf="@+id/view_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/c_t3"
        android:gravity="center"
        android:id="@+id/tv_show1"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:singleLine="true"
        android:maxLength="3"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_end"
        app:layout_constraintRight_toLeftOf="@+id/view_line"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/c_t3"
        android:layout_width="1px"
        android:layout_height="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/iv_add1"
        app:layout_constraintRight_toLeftOf="@+id/iv_add2"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_add2"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:scaleType="center"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/view_line"
        app:layout_constraintRight_toRightOf="@+id/view_card_bg"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/c_t3"
        android:gravity="center"
        android:id="@+id/tv_show2"
        android:paddingLeft="10dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:singleLine="true"
        android:maxLength="3"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintDimensionRatio="H,1:1"
        app:layout_constraintLeft_toRightOf="@+id/view_line"
        app:layout_constraintRight_toRightOf="@+id/view_card_bg"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

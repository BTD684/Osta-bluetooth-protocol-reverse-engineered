<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fl_promote_plus"
    android:tag="layout/include_promote_plus_layout_0"
    android:background="@color/block_color_background"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16">
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/txt_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@mipmap/icon_help_promote_plus"
            android:layout_marginStart="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="@+id/promote_plus_switch"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/promote_plus_switch"/>
        <com.yadea.widget.switchItem.YedeaOldSwitch
            android:id="@+id/promote_plus_switch"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginEnd="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CarSettingSwitch"/>
        <androidx.appcompat.widget.AppCompatTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/txt_desc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginBottom="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            android:layout_marginVertical="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/promote_plus_switch"/>
        <FrameLayout
            android:id="@+id/fl_container"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_56"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_desc">
            <CheckBox
                android:gravity="center_vertical"
                android:id="@+id/check_box"
                android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:clickable="false"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:button="@null"
                android:drawableEnd="@drawable/check_tel_style"
                android:paddingHorizontal="@dimen/dp_16"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_line_color_main"
                android:layout_gravity="center_vertical"
                android:id="@+id/txt_auto_boot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/adaptive_mode"
                android:drawablePadding="@dimen/dp_2"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="@+id/action_custom"
                app:layout_constraintStart_toStartOf="@+id/action_custom"
                app:layout_constraintTop_toTopOf="@+id/action_custom"/>
        </FrameLayout>
        <View
            android:id="@+id/view_line"
            android:background="@color/color_F5F6FA_121212"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="2dp"
            app:layout_constraintBottom_toBottomOf="@+id/radio_group"
            app:layout_constraintEnd_toEndOf="@+id/radio_group"
            app:layout_constraintStart_toStartOf="@+id/radio_group"
            app:layout_constraintTop_toTopOf="@+id/radio_group"/>
        <RadioGroup
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/radio_group"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/fl_container">
            <RadioButton
                android:textColor="@drawable/widget_switch_radio_text_color"
                android:gravity="center"
                android:id="@+id/radio_button_1"
                android:background="@drawable/radio_button_thumb_bg"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:layout_marginTop="@dimen/dp_7"
                android:layout_marginBottom="@dimen/dp_7"
                android:button="@null"
                android:text="1"
                android:layout_marginVertical="@dimen/dp_7"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <RadioButton
                android:textColor="@drawable/widget_switch_radio_text_color"
                android:gravity="center"
                android:id="@+id/radio_button_2"
                android:background="@drawable/radio_button_thumb_bg"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:button="@null"
                android:text="2"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            <RadioButton
                android:textColor="@drawable/widget_switch_radio_text_color"
                android:gravity="center"
                android:id="@+id/radio_button_3"
                android:background="@drawable/radio_button_thumb_bg"
                android:layout_width="@dimen/dp_30"
                android:layout_height="@dimen/dp_30"
                android:button="@null"
                android:text="3"/>
        </RadioGroup>
        <Space
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/radio_group"/>
        <com.yadea.widget.font.YadeaTextView
            android:id="@+id/promote_plus_masks"
            android:background="@drawable/corners_solid_block_color_background_99_14"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/txt_setting_tip"
            android:visibility="gone"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@mipmap/ic_setting_question_mark"
            android:layout_marginStart="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="@+id/txt_title"
            app:layout_constraintStart_toEndOf="@+id/txt_title"
            app:layout_constraintTop_toTopOf="@+id/txt_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

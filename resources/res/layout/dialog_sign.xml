<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_sign_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="314dp"
        android:layout_marginLeft="28dp"
        android:layout_marginRight="28dp"
        android:layout_centerVertical="true"
        android:layout_marginHorizontal="28dp">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:background="@drawable/corners_solid_block_color_main_radius_14"
            android:layout_width="match_parent"
            android:layout_height="242dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginTop="24dp"
                android:src="@mipmap/widget_ic_task_sign"/>
            <com.yadea.widget.progress.MutiProgress
                android:id="@+id/mp_result"
                android:layout_width="match_parent"
                android:layout_height="16dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp"
                app:currNodeNO="0"
                app:currNodeState="0"
                app:nodeRadius="8dp"
                app:nodesNum="7"
                app:processingLineColor="@color/brand_color_main"
                app:progresFailDrawable="@drawable/corners_solid_brand_color_main"
                app:progresSuccDrawable="@drawable/corners_solid_brand_color_main"
                app:progressingDrawable="@drawable/corners_solid_brand_color_main"
                app:unprogressingDrawable="@drawable/corners_solid_block_color_deputy_gray"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/txt_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_deputy_dark"
                android:id="@+id/txt_inter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_cancel"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/widget_ic_circle_cancel"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</RelativeLayout>

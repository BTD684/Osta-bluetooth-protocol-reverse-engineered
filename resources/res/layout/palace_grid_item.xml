<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/iv_constraintLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/v_click"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_title"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.622"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/iv_icon"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_click"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/v_click"
        app:layout_constraintHeight_percent="0.562"
        app:layout_constraintStart_toStartOf="@+id/v_click"
        app:layout_constraintTop_toTopOf="@+id/v_click"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/iv_hint_point"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/v_click"
        app:layout_constraintHeight_percent="0.1"
        app:layout_constraintTop_toTopOf="@+id/v_click"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/iv_new_subscript"
        android:layout_width="35dp"
        android:layout_height="18dp"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
    <net.easyconn.custom.home.palace_grid.WaveProgressView
        android:id="@+id/iv_progress"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/iv_pause"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/theme_ivi_home_img_icmask_pause"
        app:layout_constraintBottom_toBottomOf="@+id/iv_icon"
        app:layout_constraintEnd_toEndOf="@+id/iv_icon"
        app:layout_constraintStart_toStartOf="@+id/iv_icon"
        app:layout_constraintTop_toTopOf="@+id/iv_icon"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/iv_subscript"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/v_click"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/v_click"
        app:layout_constraintHeight_percent="0.202"/>
    <TextView
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/v_click"/>
</androidx.constraintlayout.widget.ConstraintLayout>

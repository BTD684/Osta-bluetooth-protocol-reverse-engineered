<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/root_layout"
    android:tag="layout/activity_drive_directions_video_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:text="@string/drive_directions"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="23dp"
        android:text="@string/drive_directions_info"
        android:layout_marginHorizontal="23dp"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/video_card_view"
        android:layout_width="match_parent"
        android:layout_height="190dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="23dp"
        android:layout_marginHorizontal="23dp"
        app:cardCornerRadius="15dp">
        <com.yadea.media.player.video.view.ExoPlayerView
            android:id="@+id/player_view"
            android:background="@color/black"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </androidx.cardview.widget.CardView>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/color_ffffff_000000"
        android:gravity="center"
        android:id="@+id/activation_btn"
        android:background="@drawable/video_btn_background"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="48dp"
        android:layout_marginRight="22dp"
        android:text="@string/activation_look_before"
        android:layout_marginHorizontal="22dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>

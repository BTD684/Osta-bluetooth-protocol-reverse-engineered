<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/activity_heated_seats_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.legacy.widget.Space
        android:id="@+id/v_top_space"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_bg"
        android:tag="binding_1"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/hv_head"
        android:tag="binding_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:isRightIconVisibility="true"
        app:itemRightIconAppearance="@style/itemRightIcon_24dp"
        app:layout_constraintTop_toBottomOf="@+id/v_top_space"
        app:rightIcon="@mipmap/vehicle_notification_right_icon"/>
    <com.yadea.widget.lihang.ShadowLayout
        android:paddingLeft="@dimen/dp_12"
        android:paddingRight="@dimen/dp_12"
        android:layout_width="125dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:paddingHorizontal="@dimen/dp_12"
        app:hl_cornerRadius="@dimen/dp_8"
        app:hl_shadowHiddenLeft="true"
        app:hl_shadowHiddenRight="true"
        app:hl_shadowHiddenTop="true"
        app:hl_shadowLimit="@dimen/dp_12"
        app:hl_shadowOffsetX="@dimen/dp_4"
        app:hl_shadowOffsetY="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hv_head">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:id="@+id/ll_switch"
            android:tag="binding_3"
            android:paddingTop="@dimen/dp_8"
            android:paddingBottom="@dimen/dp_8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingVertical="@dimen/dp_8">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/iv_switch"
                android:tag="binding_4"
                android:layout_width="@dimen/dp_20"
                android:layout_height="@dimen/dp_20"
                android:src="@mipmap/icon_heated_seats_open_btn_bg"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/tv_switch"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_switch"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_marginStart="@dimen/dp_4"
                app:layout_constraintBottom_toBottomOf="@+id/iv_switch"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/iv_switch"
                app:layout_constraintTop_toTopOf="@+id/iv_switch"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </com.yadea.widget.lihang.ShadowLayout>
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_view"
        android:background="@color/white"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="195dp"
        android:layout_marginEnd="@dimen/dp_16"
        android:elevation="@dimen/dp_8"
        app:cardCornerRadius="@dimen/dp_8"
        app:cardElevation="@dimen/dp_8"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hv_head">
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/rb_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <com.yadea.widget.font.YadeaRadioButton
                android:textSize="12sp"
                android:textColor="@color/color_select_heated_seats_text"
                android:gravity="center"
                android:id="@+id/rb_low"
                android:background="@drawable/select_heated_seats_background"
                android:layout_width="38dp"
                android:layout_height="29dp"
                android:checked="false"
                android:button="@null"
                android:text="@string/car_small"/>
            <View
                android:background="#f7f7f7"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.yadea.widget.font.YadeaRadioButton
                android:textSize="12sp"
                android:textColor="@color/color_select_heated_seats_text"
                android:gravity="center"
                android:id="@+id/rb_middle"
                android:background="@drawable/select_heated_seats_background"
                android:layout_width="38dp"
                android:layout_height="29dp"
                android:checked="false"
                android:button="@null"
                android:text="@string/car_center"/>
            <View
                android:background="#f7f7f7"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.yadea.widget.font.YadeaRadioButton
                android:textSize="12sp"
                android:textColor="@color/color_select_heated_seats_text"
                android:gravity="center"
                android:id="@+id/rb_high"
                android:background="@drawable/select_heated_seats_background"
                android:layout_width="38dp"
                android:layout_height="29dp"
                android:checked="false"
                android:button="@null"
                android:text="@string/car_top"/>
        </RadioGroup>
    </androidx.cardview.widget.CardView>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:background="@drawable/shape_radio_button_unit_uncheck"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/dp_18"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cv_view">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_iot_expired"
                android:tag="binding_6"
                android:background="@drawable/corners_solid_stroke_color_white_1b1c20_radius_12"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="@dimen/dp_24"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                android:paddingHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toTopOf="parent">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_242942_white"
                    android:id="@+id/tv_iot_title"
                    android:tag="binding_7"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_8C8C8E_999999"
                    android:id="@+id/tv_iot_content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_8"
                    android:text="@string/heated_seats_iot_expired_rule_desc"
                    app:layout_constraintTop_toBottomOf="@+id/tv_iot_title"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_16"
                    android:textColor="@color/color_4075FF_4A7BF6"
                    android:gravity="center"
                    android:id="@+id/tv_iot_services"
                    android:tag="binding_8"
                    android:background="@drawable/corners_solid_color_4075ff_5_4a7bf6_5_radius_8"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_iot_content"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:tag="binding_9"
                android:background="@drawable/corners_solid_stroke_color_white_1b1c20_radius_12"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintTop_toBottomOf="@+id/cl_iot_expired">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/color_242942_white"
                    android:gravity="center"
                    android:id="@+id/tv_heated_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_16"
                    android:text="@string/heat_regular_intervals"
                    android:drawablePadding="@dimen/dp_8"
                    android:layout_marginStart="@dimen/dp_16"
                    app:drawableStartCompat="@mipmap/icon_heated_seats_24"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_4075FF_4A7BF6"
                    android:gravity="center"
                    android:id="@+id/tv_add_task1"
                    android:tag="binding_10"
                    android:background="@drawable/corners_solid_f5f6fa_121212_radius_12"
                    android:paddingTop="@dimen/dp_14"
                    android:paddingBottom="@dimen/dp_14"
                    android:layout_width="match_parent"
                    android:layout_height="85dp"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:text="@string/add_time_slot"
                    android:drawablePadding="@dimen/dp_8"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    android:paddingVertical="@dimen/dp_14"
                    app:drawableTopCompat="@mipmap/icon_add_blue_28"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_heated_title"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/color_4075FF_4A7BF6"
                    android:gravity="center"
                    android:id="@+id/tv_add_task"
                    android:tag="binding_11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_time_slot"
                    android:drawablePadding="@dimen/dp_8"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:drawableStartCompat="@mipmap/icon_add_blue_16"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_heated_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_heated_title"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_12"
                    android:textColor="@color/color_8C"
                    android:gravity="center"
                    android:id="@+id/tv_task_desc"
                    android:tag="binding_12"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_task_desc"
                    android:layout_marginEnd="@dimen/dp_16"
                    app:layout_constraintBottom_toBottomOf="@+id/tv_heated_title"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/tv_heated_title"/>
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_heated"
                    android:tag="binding_13"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"
                    app:layout_constraintTop_toBottomOf="@+id/tv_heated_title"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/color_8C8C8E_999999"
                android:id="@+id/tv_heated_desc"
                android:tag="binding_14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/shape_virtual_car_dialog_bg"
    android:paddingTop="@dimen/dp_28"
    android:paddingBottom="@dimen/dp_20"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="@dimen/dp_28"
    android:paddingEnd="@dimen/dp_28">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="提示"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_deputy_dark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_12"
        android:text="请输入虚拟车辆 MAC 地址"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/sp_18"
        android:textColor="@color/text_line_color_main"
        android:textColorHint="@color/text_line_color_deputy_dark"
        android:gravity="center_vertical"
        android:id="@+id/edit_virtual_car_mac"
        android:background="@drawable/shape_virtual_car_input_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_20"
        android:text="BC:7A:BF:49:5F:C3"
        android:singleLine="true"
        android:maxLength="17"
        android:inputType="textCapCharacters"
        android:paddingStart="@dimen/dp_24"
        android:paddingEnd="@dimen/dp_24"/>
    <androidx.appcompat.widget.SwitchCompat
        android:theme="@style/SwitchCompatStyle"
        android:textColor="@color/text_line_color_deputy_dark"
        android:layout_gravity="center_horizontal"
        android:id="@+id/switch_virtual_car"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_40"
        android:layout_marginTop="@dimen/dp_12"
        android:textOn="开"
        android:textOff="关"
        android:text="虚拟车模式"
        app:showText="true"
        app:switchMinWidth="@dimen/dp_55"
        app:switchPadding="@dimen/dp_8"
        app:switchTextAppearance="@style/SwitchCompatFontStyle"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="@dimen/dp_14">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/action_cancel"
            android:background="@drawable/shape_virtual_car_button_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="取消"
            android:layout_weight="1"/>
        <Space
            android:layout_width="@dimen/dp_14"
            android:layout_height="match_parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/action_confirm"
            android:background="@drawable/shape_virtual_car_button_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="确定"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>

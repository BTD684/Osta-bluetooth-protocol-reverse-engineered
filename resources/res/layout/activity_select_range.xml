<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:tag="layout/activity_select_range_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <RelativeLayout
            android:id="@+id/mv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="bottom"
            android:background="@drawable/corners_solid_block_color_background_f5f6fa_14"
            android:layout_width="match_parent"
            android:layout_height="135dp"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_24"
            android:layout_marginBottom="@dimen/dp_40"
            android:layout_marginHorizontal="@dimen/dp_24">
            <com.yadea.widget.font.YadeaTextView
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_select_range"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16"
                android:text="@string/select_range"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="@color/brand_color_main"
                android:layout_gravity="bottom"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/tv_select_range"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/sb"
                android:background="@null"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="match_parent"
                android:layout_height="31dp"
                android:layout_marginTop="60dp"
                android:maxHeight="30dp"
                android:progressDrawable="@drawable/battery_seekbar_progress_select"
                android:minHeight="30dp"
                android:thumb="@drawable/widget_ic_seekbar_thumb_bg"
                android:thumbOffset="@dimen/dp_0"
                android:paddingHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_16"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.yadea.widget.actionBar.YadeaActionBar
            android:id="@+id/action_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/dp_40"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:rightTitle="@string/map_save"
            app:rightTitleAppearance="@style/rightTitleSize16"
            app:title="@string/user_car_setting_rail"/>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

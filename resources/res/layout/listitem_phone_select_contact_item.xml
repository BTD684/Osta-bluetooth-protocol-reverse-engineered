<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/card_bg_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/x192"
        android:layout_centerVertical="true">
        <LinearLayout
            android:id="@+id/ll_contact_avtor"
            android:background="@drawable/first_name_shape"
            android:layout_width="@dimen/x84"
            android:layout_height="@dimen/x84"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_contact_avtor"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/x40"
            android:layout_toEndOf="@+id/ll_contact_avtor">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_333"
                android:ellipsize="end"
                android:id="@+id/tv_psci_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/color_666"
                android:ellipsize="end"
                android:id="@+id/tv_psci_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:layout_centerVertical="true"/>
        </LinearLayout>
        <ImageView
            android:id="@+id/iv_psci_check"
            android:visibility="gone"
            android:layout_width="@dimen/x86"
            android:layout_height="@dimen/x86"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/y146"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
</RelativeLayout>

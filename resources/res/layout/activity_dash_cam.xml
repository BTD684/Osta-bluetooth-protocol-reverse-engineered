<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_top_root"
    android:tag="layout/activity_dash_cam_0"
    android:background="@color/color_F5F6FA_121212"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rightIcon="@drawable/icon_dash_cam_setting_24"
        app:title="@string/dash_cam_device_home_page"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/rcv_live"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:elevation="@dimen/dp_0"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:cardCornerRadius="@dimen/dp_12"
        app:cardElevation="@dimen/dp_0"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_video_container"
            android:background="@drawable/corners_solid_block_color_main_radius_14"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yadea.media.player.rtsp.widget.RtspPlayerView
                android:id="@+id/video_view"
                android:background="@color/black"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_fullscreen_back"
                android:padding="12dp"
                android:visibility="gone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:src="@drawable/ic_back"
                android:layout_marginStart="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_full_screen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_10"
                android:src="@mipmap/video_full_screen_icon"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@+id/video_view"
                app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_shrink"
                android:background="@mipmap/video_full_screen_icon"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_10"
                android:layout_marginEnd="@dimen/dp_10"
                app:layout_constraintBottom_toBottomOf="@+id/video_view"
                app:layout_constraintEnd_toEndOf="parent"/>
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_default_tips"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:src="@mipmap/icon_dash_cam_default"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@+id/video_view"
                app:layout_constraintTop_toTopOf="@+id/video_view"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:textColor="#e6e6e6"
                android:gravity="center"
                android:id="@+id/txt_no_connect_wifi_tips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_connect_wifi_tips"
                app:layout_constraintBottom_toBottomOf="@+id/video_view"
                app:layout_constraintTop_toTopOf="@+id/video_view"/>
            <androidx.constraintlayout.widget.Group
                android:id="@+id/gp_tips"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="txt_no_connect_wifi_tips,img_default_tips"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:paddingLeft="@dimen/dp_24"
                android:paddingTop="12dp"
                android:paddingRight="@dimen/dp_24"
                android:paddingBottom="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/dp_24"
                app:layout_constraintTop_toBottomOf="@+id/video_view">
                <com.yadea.widget.font.YadeaTextView
                    android:gravity="center"
                    android:id="@+id/txt_playback"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/playback"
                    android:layout_weight="1"
                    app:drawableTopCompat="@mipmap/icon_playback"/>
                <com.yadea.widget.font.YadeaTextView
                    android:gravity="center"
                    android:id="@+id/txt_record"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/record"
                    android:layout_weight="1"
                    app:drawableTopCompat="@mipmap/icon_record"/>
                <com.yadea.widget.font.YadeaTextView
                    android:gravity="center"
                    android:id="@+id/txt_downloaded"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/downloaded"
                    android:layout_weight="1"
                    app:drawableTopCompat="@mipmap/icon_downloaded"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:padding="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_16"
        android:layout_marginHorizontal="@dimen/dp_16"
        app:layout_constraintTop_toBottomOf="@+id/rcv_live">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/dp_16"
            android:textStyle="bold"
            android:textColor="@color/color_242942_white"
            android:id="@+id/txt_tips_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tips"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="normal"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/txt_tips_content"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dash_cam_tips_content"
            android:lineSpacingExtra="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_tips_title"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="normal"
            android:textColor="@color/color_242942_white"
            android:id="@+id/txt_wifi_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/dash_cam_initial_name"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_tips_content"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="normal"
            android:textColor="@color/color_242942_white"
            android:gravity="center"
            android:id="@+id/txt_wifi_pwd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dash_cam_initial_password"
            android:drawablePadding="6dp"
            android:drawableEnd="@mipmap/icon_dash_cam_copy_16"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_wifi_name"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/txt_wifi_pwd">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="@color/color_black_white_60"
                android:gravity="center"
                android:id="@+id/txt_reset_wifi"
                android:background="@drawable/corners_solid_f5f6fa_121212_radius_12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/reset_wifi"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="@color/color_black_white_60"
                android:gravity="center"
                android:id="@+id/txt_go_wifi"
                android:background="@drawable/corners_solid_f5f6fa_121212_radius_12"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/go_to_wifi_settings"
                android:layout_weight="1"
                android:layout_marginStart="8dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

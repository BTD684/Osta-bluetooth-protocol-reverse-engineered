<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:background="@drawable/corners_solid_top_block_color_background_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/txt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/home_dialog_bluetooth_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.circleView.YedeaDiffuseView
        android:id="@+id/view_bluetooth_scan"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        app:diffuse_core_circle_size="90"
        app:diffuse_count="3"
        app:diffuse_stroke_width="1dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_title"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/txt_tips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/home_dialog_bluetooth_content"
        app:layout_constraintTop_toBottomOf="@+id/view_bluetooth_scan"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_deputy_dark"
        android:gravity="center"
        android:id="@+id/action_unbind_vehicle"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:layout_marginLeft="23dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="23dp"
        android:layout_marginBottom="16dp"
        android:text="@string/home_dialog_bluetooth_cancel"
        android:layout_marginHorizontal="23dp"
        android:layout_marginVertical="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_tips"/>
</androidx.constraintlayout.widget.ConstraintLayout>

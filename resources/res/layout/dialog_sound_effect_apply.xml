<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:tag="layout/dialog_sound_effect_apply_0"
    android:background="@drawable/shape_effect_back_bg"
    android:layout_width="303dp"
    android:layout_height="wrap_content">
    <org.libpag.PAGImageView
        android:id="@+id/iv_export_sound_effect"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_margin="@dimen/dp_24"
        android:src="@mipmap/icon_export_sound"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:gravity="center"
        android:id="@+id/tv_export_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:text="@string/custom_audio_applying_title"
        android:layout_marginHorizontal="24dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorCustomRight"
        android:gravity="center"
        android:id="@+id/tv_export_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="24dp"
        android:text="@string/custom_audio_applying_wait_title"
        android:layout_marginHorizontal="24dp"/>
</androidx.appcompat.widget.LinearLayoutCompat>

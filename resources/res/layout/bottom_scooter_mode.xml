<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:tag="layout/bottom_scooter_mode_0"
    android:background="@drawable/corners_solid_top_block_color_background_14"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/scooter_config_list"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginLeft="14dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="14dp"
        android:overScrollMode="never"
        android:layout_marginHorizontal="14dp"
        app:layout_constraintTop_toBottomOf="@+id/txt_title"/>
</androidx.constraintlayout.widget.ConstraintLayout>

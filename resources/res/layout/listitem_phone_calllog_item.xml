<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ll_calllog_bg"
    android:background="@drawable/card_bg_selector"
    android:paddingLeft="18dp"
    android:paddingRight="18dp"
    android:layout_width="match_parent"
    android:layout_height="@dimen/x192">
    <LinearLayout
        android:layout_gravity="center"
        android:id="@+id/ll_calllog_avtor_bg"
        android:background="@drawable/first_name_shape"
        android:layout_width="@dimen/x84"
        android:layout_height="@dimen/x84">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tv_calllog_avtor"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </LinearLayout>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/color_333"
        android:ellipsize="end"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_calllog_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/x40"
        android:layout_marginEnd="@dimen/x40"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/color_666"
        android:layout_gravity="center_vertical"
        android:id="@+id/tv_calllog_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00"/>
</LinearLayout>

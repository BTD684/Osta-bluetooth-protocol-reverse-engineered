<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_agg_main"
    android:background="@color/c_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="@dimen/x24"
    android:paddingEnd="@dimen/x24">
    <net.easyconn.carman.view.home.HomeNaviView
        android:id="@+id/hmv_navi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <net.easyconn.carman.view.home.HomeMusicView
        android:id="@+id/hmv_music"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"/>
    <net.easyconn.carman.view.home.HomeMoreView
        android:id="@+id/hmv_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_alignParentEnd="true"/>
</RelativeLayout>

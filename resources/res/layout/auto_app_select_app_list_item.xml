<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/rl_app_top"
    android:background="@drawable/third_app_list_item_selector"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:layout_width="@dimen/y294"
        android:layout_height="@dimen/y294">
        <RelativeLayout
            android:gravity="center"
            android:paddingTop="@dimen/x20"
            android:paddingBottom="@dimen/x20"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <ImageView
                android:id="@+id/iv_app_icon"
                android:layout_width="@dimen/y150"
                android:layout_height="@dimen/y150"
                android:layout_marginTop="@dimen/x22"
                android:scaleType="fitCenter"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/x48"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/x24"
                android:layout_marginRight="@dimen/x24"
                android:layout_marginBottom="@dimen/x10"
                android:text="@string/select_app_name"
                android:singleLine="true"
                android:layout_below="@+id/iv_app_icon"/>
        </RelativeLayout>
        <ImageView
            android:id="@+id/iv_app_select"
            android:visibility="invisible"
            android:layout_width="@dimen/x108"
            android:layout_height="@dimen/x108"/>
    </RelativeLayout>
</RelativeLayout>

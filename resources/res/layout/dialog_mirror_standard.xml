<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/root_dialog_view"
    android:background="@color/c_popup_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_end="@dimen/mirror_dialog_title_height"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:ellipsize="end"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_title"
        android:paddingTop="18dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/notice"
        android:lines="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <net.easyconn.carman.common.view.AutoAlignCenterTextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t1"
            android:layout_gravity="center"
            android:id="@+id/tv_content"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/mirror_dialog_title_height"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"/>
        <net.easyconn.carman.view.RatingBar
            android:layout_gravity="center"
            android:id="@+id/rating_rate"
            android:visibility="gone"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:allStarsCount="5"
            app:curSelectValue="0"
            app:layout_constraintBottom_toTopOf="@+id/v_bottom"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title"
            app:starEmpty="@drawable/ic_star_off"
            app:starFill="@drawable/ic_star_on"
            app:starHalf="@drawable/ic_star_half"
            app:starImageSize="32dp"
            app:starPadding="8dp"
            app:stepSize="Half"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/theme_bg_dialog_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="@string/ec_usb_cancel"
        app:layout_constraintEnd_toStartOf="@+id/tv_enter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_enter"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t_popup"
        android:gravity="center"
        android:id="@+id/tv_enter"
        android:background="@drawable/theme_bg_dialog_button"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="12dp"
        android:text="@string/dialog_sure"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_cancel"
        app:layout_constraintTop_toBottomOf="@+id/fl_content"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t_popup"
        android:gravity="center"
        android:id="@+id/tv_center_enter"
        android:background="@drawable/theme_bg_dialog_button"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="@string/dialog_sure"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tv_enter"/>
</androidx.constraintlayout.widget.ConstraintLayout>

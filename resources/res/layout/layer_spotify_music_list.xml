<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/c_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RadioGroup
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/tab_title"
        android:visibility="invisible"
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:tabBackground="@color/transparent">
        <RadioButton
            android:textSize="@dimen/t_4"
            android:textColor="@color/music_select_title_text"
            android:gravity="center"
            android:id="@+id/inspired"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:button="@null"
            android:text="@string/inspired"
            android:singleLine="true"
            android:drawableTop="@drawable/theme_ivi_music_tab_ic_love"
            android:drawablePadding="8dp"
            android:layout_weight="1"/>
        <RadioButton
            android:textSize="@dimen/t_4"
            android:textColor="@color/music_select_title_text"
            android:gravity="center"
            android:id="@+id/recently"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:button="@null"
            android:text="@string/spotify_daily"
            android:singleLine="true"
            android:drawableTop="@drawable/theme_ivi_music_tab_ic_history"
            android:drawablePadding="8dp"
            android:layout_weight="1"/>
        <RadioButton
            android:textSize="@dimen/t_4"
            android:textColor="@color/music_select_title_text"
            android:gravity="center"
            android:id="@+id/other"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:button="@null"
            android:text="@string/other"
            android:singleLine="true"
            android:drawableTop="@drawable/theme_ivi_music_tab_ic_recommend"
            android:drawablePadding="8dp"
            android:layout_weight="1"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/player"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:src="@drawable/theme_ivi_music_list_ic_quick_play"/>
    </RadioGroup>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tab_title"/>
    <RelativeLayout
        android:id="@+id/notice_view"
        android:background="@color/c_bg"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="36sp"
            android:textColor="#e6ffffff"
            android:id="@+id/title_spotify"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spotify"
            android:layout_marginStart="24dp"/>
        <ImageView
            android:id="@+id/back_up"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/common_back_selector"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/btn_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/t_0"
                android:textColor="@color/c_t1"
                android:gravity="center"
                android:id="@+id/notices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/please_open_spotify_sync"
                android:layout_centerInParent="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t3"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/retry"
                android:background="@drawable/btn_sync_selector"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:text="@string/sync"
                android:lines="1"
                android:layout_below="@+id/notices"
                android:layout_centerInParent="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/notices"
                app:layout_constraintWidth_percent="0.8"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

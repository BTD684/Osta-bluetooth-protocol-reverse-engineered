<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/ll_bg"
        android:background="@drawable/theme_google_search_bg"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center_vertical"
            android:id="@+id/iv_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/theme_ivi_googlemap_ic_searchlogo"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2_google"
            android:layout_gravity="center_vertical"
            android:id="@+id/tv_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/search_hear"
            android:textDirection="locale"
            android:layout_marginEnd="20dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/iv_direction"
        android:background="@drawable/theme_icon_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/theme_ivi_googlemap_ic_northup"
        android:layout_marginEnd="10dp"
        android:elevation="5dp"
        android:outlineProvider="background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_bg"/>
    <ImageView
        android:id="@+id/iv_home"
        android:background="@drawable/theme_icon_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/theme_map_go_home"
        android:layout_marginEnd="10dp"
        android:elevation="5dp"
        android:outlineProvider="background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_direction"/>
    <ImageView
        android:id="@+id/iv_set"
        android:background="@drawable/theme_icon_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/theme_ivi_googlemap_ic_set"
        android:layout_marginEnd="10dp"
        android:elevation="5dp"
        android:outlineProvider="background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/iv_location"
        app:layout_constraintEnd_toEndOf="parent"/>
    <ImageView
        android:id="@+id/iv_location"
        android:background="@drawable/theme_icon_bg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginBottom="10dp"
        android:src="@drawable/theme_ivi_map_locate"
        android:layout_marginEnd="10dp"
        android:elevation="5dp"
        android:outlineProvider="background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
    <include
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        app:layout_constraintBottom_toTopOf="@+id/iv_set"
        app:layout_constraintEnd_toEndOf="@+id/iv_set"
        layout="@layout/layout_zoom_map"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:background="@drawable/theme_ivi_googlemap_ic_logo"
        android:layout_width="76dp"
        android:layout_height="26dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

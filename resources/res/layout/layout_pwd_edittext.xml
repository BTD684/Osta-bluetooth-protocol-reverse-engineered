<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_pwd_edittext_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/color_242942_white"
        android:id="@+id/txt_pwd_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/Button_16_Regular"/>
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/color_FF3535_FF455D"
        android:id="@+id/txt_error_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_pwd_title"
        style="@style/Text_14_Regular"/>
    <androidx.appcompat.widget.AppCompatEditText
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_242942_white"
        android:textColorHint="@color/color_8C8C8E_999999"
        android:gravity="center_vertical"
        android:id="@+id/et_input"
        android:background="@drawable/corners_solid_stroke_color_white_1b1c20_radius_12"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_48"
        android:layout_marginTop="12dp"
        android:maxLength="20"
        android:inputType="textPassword"
        android:paddingStart="@dimen/dp_16"
        app:layout_constraintEnd_toStartOf="@+id/img_check_pwd"
        app:layout_constraintTop_toBottomOf="@+id/txt_pwd_title"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_check_pwd"
        android:paddingLeft="@dimen/dp_4"
        android:paddingRight="@dimen/dp_4"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:src="@mipmap/icon_check_pwd"
        android:layout_marginEnd="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/et_input"
        app:layout_constraintEnd_toEndOf="@+id/et_input"
        app:layout_constraintTop_toTopOf="@+id/et_input"/>
</androidx.constraintlayout.widget.ConstraintLayout>

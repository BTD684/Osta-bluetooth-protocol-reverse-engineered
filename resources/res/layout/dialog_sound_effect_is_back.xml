<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_sound_effect_is_back_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_effect_back"
        android:background="@drawable/shape_effect_back_bg"
        android:layout_width="303dp"
        android:layout_height="156dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:id="@+id/tv_effect_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/hint"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_back"
        app:layout_constraintRight_toRightOf="@+id/view_effect_back"
        app:layout_constraintTop_toTopOf="@+id/view_effect_back"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/colorCustomRight"
        android:gravity="center"
        android:id="@+id/tv_effect_back_desc"
        android:layout_width="303dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/custom_back_alert_title"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_back"
        app:layout_constraintRight_toRightOf="@+id/view_effect_back"
        app:layout_constraintTop_toBottomOf="@+id/tv_effect_back"/>
    <View
        android:id="@+id/view_back_line"
        android:background="@color/colorCustomLine"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_back"
        app:layout_constraintRight_toRightOf="@+id/view_effect_back"
        app:layout_constraintTop_toBottomOf="@+id/tv_effect_back_desc"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/colorCustomRight"
        android:gravity="center"
        android:id="@+id/btn_not_back"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:text="@string/custom_back_sure_title"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@+id/view_effect_back"
        app:layout_constraintLeft_toLeftOf="@+id/view_effect_back"
        app:layout_constraintRight_toLeftOf="@+id/view_bottom_line"
        app:layout_constraintTop_toBottomOf="@+id/view_back_line"/>
    <View
        android:id="@+id/view_bottom_line"
        android:background="@color/colorCustomLine"
        android:layout_width="1px"
        android:layout_height="@dimen/dp_80"
        app:layout_constraintBottom_toBottomOf="@+id/view_effect_back"
        app:layout_constraintLeft_toRightOf="@+id/btn_not_back"
        app:layout_constraintRight_toLeftOf="@+id/btn_back"
        app:layout_constraintTop_toBottomOf="@+id/view_back_line"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_000000_ffffff"
        android:gravity="center"
        android:id="@+id/btn_back"
        android:background="@color/transparent"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:text="@string/not_yet"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@+id/view_effect_back"
        app:layout_constraintLeft_toRightOf="@+id/view_bottom_line"
        app:layout_constraintRight_toRightOf="@+id/view_effect_back"
        app:layout_constraintTop_toBottomOf="@+id/view_back_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>

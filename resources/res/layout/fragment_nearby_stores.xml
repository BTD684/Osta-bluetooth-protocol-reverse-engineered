<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:tag="layout/fragment_nearby_stores_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_top_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="@drawable/nearby_store_top_bg"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.actionBar.YadeaActionBar
            android:id="@+id/action_bar"
            android:fitsSystemWindows="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:title="@string/near_shops"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_18"
            android:textColor="@color/color_e6e6e6_333333"
            android:gravity="center_vertical"
            android:id="@+id/action_search"
            android:background="@drawable/shape_dialog_bg_14"
            android:paddingLeft="@dimen/dp_16"
            android:paddingRight="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_44"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_24"
            android:text="@string/nearby_shop_search"
            android:drawablePadding="@dimen/dp_8"
            android:drawableStart="@mipmap/ic_search_nearby_store"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:paddingHorizontal="@dimen/dp_16"
            app:layout_constraintTop_toBottomOf="@+id/action_bar"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:behavior_hideable="false"
        app:behavior_peekHeight="356dp"
        app:layout_behavior="@string/bottom_sheet_behavior">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/img_nearby_store_scroll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_24"
            android:src="@mipmap/ic_nearby_store_scroll"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:background="@drawable/corners_solid_block_color_bg_f5f6fa_top_radius_14"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_8"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toTopOf="@+id/space"/>
        <Space
            android:id="@+id/space"
            android:layout_width="0dp"
            android:layout_height="@dimen/dp_24"
            app:layout_constraintTop_toBottomOf="@+id/img_nearby_store_scroll"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/txt_nearby_store"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nearby_shop_recommend"
            android:layout_marginStart="@dimen/dp_24"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/action_re_recommend"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="@dimen/dp_10"
            app:layout_constraintBottom_toBottomOf="@+id/txt_nearby_store"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/space"
            app:layout_constraintTop_toTopOf="@+id/txt_nearby_store">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_re_recommend"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/ic_refresh_nearby_store"
                app:layout_constraintBottom_toBottomOf="@+id/txt_nearby_store"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/space"
                app:layout_constraintTop_toTopOf="@+id/txt_nearby_store"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_line_color_main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/nearby_shop_rerecommend"
                android:layout_marginStart="@dimen/dp_4"
                android:layout_marginEnd="@dimen/dp_24"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/txt_nearby_store">
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycler_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp_24"
                android:layout_marginRight="@dimen/dp_24"
                android:layout_marginHorizontal="@dimen/dp_24"/>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.mirror.SplitMirrorManagerView
        android:id="@+id/split_mirror_manager"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/v_bg_layer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mirror_palace_holder_right"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/mirror_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mirror_palace_holder_right"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/mirror_map_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mirror_palace_holder_right"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/mirror_full_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/mirror_palace_holder_right"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/mirror_palace_holder_left"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/mirror_palace_holder_right"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.mirror.SplitMirrorDisplayView
        android:id="@+id/split_mirror_display"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <net.easyconn.carman.common.base.mirror.DialogContainer
        android:id="@+id/layer_dialog"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/v_common_control_root"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/split_mirror_display"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <net.easyconn.carman.mirror.CommonControlLayout
            android:orientation="vertical"
            android:id="@+id/v_common_control"
            android:background="#a0000000"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
    <net.easyconn.carman.common.base.mirror.ToastContainer
        android:id="@+id/layer_toast"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/mirror_palace_holder_left"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_top_background_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <net.easyconn.carman.view.HomeTopButtonLinearLayout
            android:layout_gravity="bottom"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </FrameLayout>
    <net.easyconn.carman.view.HomeNestedScrollView
        android:id="@+id/scroll_view"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/fl_placeholder_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/ll_card_container"
                android:background="@drawable/bg_home_card_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <View
                android:id="@+id/blank_block"
                android:layout_width="match_parent"
                android:layout_height="0dp"/>
        </LinearLayout>
    </net.easyconn.carman.view.HomeNestedScrollView>
    <FrameLayout
        android:id="@+id/fl_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</FrameLayout>

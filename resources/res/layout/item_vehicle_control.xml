<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/control_container"
    android:layout_width="80dp"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/img_view_bg"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_marginLeft="5dp"
        android:layout_marginTop="-12dp"
        android:layout_marginRight="5dp"
        android:layout_marginHorizontal="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/img_close"/>
    <com.yadea.widget.progress.RoundCornerProgressBar
        android:id="@+id/progress_bar"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="71dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:progress="95"
        android:layout_marginHorizontal="5dp"
        app:backgroundColor="@color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/img_view_bg"
        app:pathWidth="1dp"
        app:progressColor="@color/brand_color_main"
        app:radius="14dp"
        app:startOffset="0.1"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_control_icon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:layout_constraintBottom_toBottomOf="@+id/img_view_bg"
        app:layout_constraintEnd_toEndOf="@+id/img_view_bg"
        app:layout_constraintStart_toStartOf="@+id/img_view_bg"
        app:layout_constraintTop_toTopOf="@+id/img_view_bg"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/txt_bluetooth_control_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintEnd_toEndOf="@+id/img_view_bg"
        app:layout_constraintStart_toStartOf="@+id/img_view_bg"
        app:layout_constraintTop_toBottomOf="@+id/img_view_bg"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_close"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginTop="8dp"
        android:src="@mipmap/home_ic_close"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

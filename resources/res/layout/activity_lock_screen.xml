<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_lock_screen_0"
    android:background="@mipmap/bg_lock"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="108dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_22"
            android:textStyle="bold"
            android:textColor="@color/color_white_80"
            android:id="@+id/tv_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="106sp"
            android:textStyle="bold"
            android:textColor="@color/color_white_80"
            android:id="@+id/tv_date_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:background="@drawable/corners_solid_block_color_white_80_radius_16"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginRight="@dimen/dp_24"
        android:layout_marginBottom="128dp"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:paddingHorizontal="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:id="@+id/ll_recording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.appcompat.widget.LinearLayoutCompat
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_16">
                <androidx.appcompat.widget.AppCompatImageView
                    android:background="@mipmap/lock_yadea_icon"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_track_recording"
                    android:layout_marginStart="@dimen/dp_8"/>
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/iv_lock_router"
                    android:background="@mipmap/icon_lock_screen_recording"
                    android:layout_width="@dimen/dp_16"
                    android:layout_height="@dimen/dp_16"
                    android:layout_marginStart="@dimen/dp_4"/>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <View
                android:background="#14000000"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="@dimen/dp_12"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/tv_distance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/black"
                            android:id="@+id/tv_distance_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/km"
                            android:layout_marginStart="@dimen/dp_2"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_8C"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/icon_dashboard_mileage"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_20"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:id="@+id/tv_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00:00"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_8C"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/traveling_interval"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_8"
                android:layout_marginBottom="16dp">
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/tv_avg_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_12"
                            android:textColor="@color/black"
                            android:id="@+id/tv_avg_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vehicle_speed_km_h"
                            android:layout_marginStart="@dimen/dp_2"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_8C"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_4"
                        android:text="@string/avg_speed"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:gravity="center"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <androidx.appcompat.widget.LinearLayoutCompat
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_20"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:id="@+id/tv_max_speed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"/>
                        <com.yadea.widget.font.YadeaTextView
                            android:textSize="@dimen/sp_14"
                            android:textColor="@color/black"
                            android:id="@+id/tv_max_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/vehicle_speed_km_h"
                            android:layout_marginStart="@dimen/dp_2"/>
                    </androidx.appcompat.widget.LinearLayoutCompat>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="@dimen/sp_14"
                        android:textColor="@color/color_8C"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="@string/traveling_maxspeed"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.yadea.vehicle.view.widget.dashboard.SlidingFinishLayout
        android:gravity="center"
        android:id="@+id/sl_lock"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <org.libpag.PAGImageView
            android:id="@+id/pag_lock"
            android:layout_width="114dp"
            android:layout_height="27dp"/>
    </com.yadea.vehicle.view.widget.dashboard.SlidingFinishLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_container"
    android:tag="layout/item_mine_sound_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/view_official"
        android:background="@drawable/shape_effect_tips_bg"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/text_line_color_main"
        android:ellipsize="end"
        android:id="@+id/tv_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_10"
        app:layout_constraintBottom_toTopOf="@+id/view_official"
        app:layout_constraintEnd_toStartOf="@+id/iv_mine_play"
        app:layout_constraintStart_toStartOf="@+id/view_official"
        app:layout_constraintTop_toBottomOf="@+id/view_official"/>
    <org.libpag.PAGImageView
        android:id="@+id/iv_mine_play"
        android:visibility="invisible"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/view_official"
        app:layout_constraintEnd_toStartOf="@+id/iv_sound_more"
        app:layout_constraintTop_toTopOf="@+id/view_official"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_sound_more"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:src="@mipmap/icon_effect_more"
        android:layout_marginEnd="@dimen/dp_8"
        app:layout_constraintBottom_toBottomOf="@+id/view_official"
        app:layout_constraintEnd_toStartOf="@+id/iv_music_check"
        app:layout_constraintTop_toTopOf="@+id/view_official"/>
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/iv_music_check"
        android:background="@drawable/shape_music_selected"
        android:layout_width="@dimen/dp_20"
        android:layout_height="@dimen/dp_20"
        android:button="@null"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="@+id/view_official"
        app:layout_constraintEnd_toEndOf="@+id/view_official"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/color_0D000000_0DFFFFFF"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rl_short_press"
    android:layout_marginLeft="16dp"
    android:layout_marginTop="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginHorizontal="16dp"
    style="@style/CarSettingRl">
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_item_flexo"
        android:src="@mipmap/icon_auto_lock"
        android:layout_centerVertical="true"
        style="@style/CarSettingBtn32"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/img_select_item_flexo"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/img_non_inductive_boot_select"
        android:layout_alignParentRight="true"
        android:layout_centerInParent="true"/>
    <com.yadea.widget.font.YadeaTextView
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_title_item_flexo"
        android:text="@string/user_car_short_press_set"
        android:layout_toLeftOf="@+id/img_select_item_flexo"
        android:layout_toRightOf="@+id/img_item_flexo"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        style="@style/CarSettingTxt"/>
    <com.yadea.widget.font.YadeaTextView
        android:id="@+id/txt_info_item_flexo"
        android:text="@string/user_car_lights_vehicle_flashed_double"
        android:layout_toLeftOf="@+id/img_select_item_flexo"
        android:layout_toRightOf="@+id/img_item_flexo"
        android:layout_below="@+id/txt_title_item_flexo"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        style="@style/CarSettingContext"/>
</RelativeLayout>

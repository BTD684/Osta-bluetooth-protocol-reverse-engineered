<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_mail_subscription_vehicle_location_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title=""/>
    <include
        android:id="@+id/vehicle_notification_empty"
        android:visibility="gone"
        layout="@layout/loadsir_empty_layout"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/vehicle_notification_scroll"
        android:visibility="visible"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.scwang.smart.refresh.layout.SmartRefreshLayout
            android:id="@+id/refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:background="@color/block_color_background"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <com.yadea.widget.textItem.YadeaTextItemLayout
                    android:id="@+id/mail_location_text"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_64"
                    android:layout_marginLeft="@dimen/dp_22"
                    android:layout_marginTop="@dimen/dp_24"
                    android:layout_marginRight="@dimen/dp_22"
                    android:layout_marginHorizontal="@dimen/dp_22"
                    app:itemName="@string/user_about_yadea_privacy_policy_permission"
                    app:itemNameAppearance="@style/itemName"
                    app:itemRightIconAppearance="@style/itemRightIcon_14dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.switchItem.YedeaOldSwitch
                    android:id="@+id/mail_location_switch"
                    android:layout_marginRight="@dimen/dp_40"
                    android:checked="false"
                    app:layout_constraintBottom_toBottomOf="@+id/mail_location_text"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintLeft_toLeftOf="@+id/mail_location_text"
                    app:layout_constraintRight_toRightOf="@+id/mail_location_text"
                    app:layout_constraintTop_toTopOf="@+id/mail_location_text"
                    style="@style/CarSettingSwitch"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="@dimen/sp_14"
                    android:textColor="@color/text_line_color_deputy_dark"
                    android:id="@+id/mail_location_msg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_24"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_24"
                    android:layout_marginHorizontal="@dimen/dp_24"
                    app:layout_constraintTop_toBottomOf="@+id/mail_location_text"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.scwang.smart.refresh.layout.SmartRefreshLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>

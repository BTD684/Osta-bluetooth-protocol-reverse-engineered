<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_root"
    android:tag="layout/user_activity_open_off_0"
    android:background="@color/color_f5f6fa_0F1012"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/hv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/vehicle_setting_sound_setting"/>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_16"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hv"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_title"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rv">
        <com.yadea.widget.font.YadeaTextView
            android:enabled="false"
            android:textSize="@dimen/sp_22"
            android:textStyle="bold"
            android:textColor="@color/colorCustom"
            android:id="@+id/tv_custom_sound_title"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="false"
            android:text="@string/custom_selected_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="horizontal"
            android:id="@+id/ll_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_custom_sound_title">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/colorCustomRight"
                android:id="@+id/tv_sound_count_pre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/sound_effect_setting_max_times_pre"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/colorCustomRight"
                android:id="@+id/tv_sound_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="0"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/colorCustomRight"
                android:id="@+id/tv_sound_count_center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/sound_effect_setting_max_times_center"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_FD8E50_FF9659"
                android:id="@+id/tv_sound_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="0"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/colorCustomRight"
                android:id="@+id/tv_sound_count_after"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:text="@string/only_time"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCustomSound"
        android:background="@drawable/shape_effect_tips_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_title"/>
    <View
        android:id="@+id/view_car_line"
        android:background="@color/colorCustomLine"
        android:layout_width="0dp"
        android:layout_height="1px"
        android:layout_marginBottom="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btn_sound_apply"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textColor="@color/colorNext"
        android:gravity="center"
        android:id="@+id/btn_sound_apply"
        android:background="@drawable/corners_solid_text_line_color_main_14"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="51dp"
        android:layout_marginBottom="@dimen/dp_30"
        android:text="@string/custom_apply_audio_title"
        android:textAllCaps="false"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        style="?android:attr/borderlessButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>

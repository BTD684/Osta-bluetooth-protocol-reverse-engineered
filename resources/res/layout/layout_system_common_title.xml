<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/c_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_root_title"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/ll_back"
            android:layout_width="@dimen/y200"
            android:layout_height="match_parent"
            android:layout_alignParentStart="true">
            <ImageView
                android:id="@+id/iv_back"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/theme_ivi_common_title_ic_back"
                android:scaleType="centerInside"
                android:layout_marginStart="25dp"/>
        </LinearLayout>
        <TextView
            android:textSize="@dimen/text_size_middle54"
            android:textColor="@color/c_t1"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="this is title"
            android:layout_centerInParent="true"/>
        <RelativeLayout
            android:id="@+id/rl_right"
            android:visibility="gone"
            android:layout_width="@dimen/y200"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true">
            <ImageView
                android:id="@+id/iv_right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:scaleType="center"
                android:layout_centerInParent="true"/>
            <TextView
                android:textSize="@dimen/font_size_42"
                android:textColor="@drawable/all_text_seletor"
                android:id="@+id/tv_right"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"/>
        </RelativeLayout>
    </RelativeLayout>
    <View
        android:background="@color/white_0.4"
        android:layout_alignParentBottom="true"
        style="@style/general_land_line_1px"/>
</RelativeLayout>

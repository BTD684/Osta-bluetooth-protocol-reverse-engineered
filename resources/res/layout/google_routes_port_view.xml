<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bg_port_title"
        android:background="@drawable/bg_navi_info_top_light"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t1_google"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:id="@+id/mirror_detail_title"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:maxLines="1"
            android:textDirection="locale"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/iv_back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_back"
            android:padding="8dp"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/theme_ivi_googlemap_ic_close"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/mirror_detail_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/mirror_detail_title"
            app:layout_goneMarginEnd="16dp"/>
        <View
            android:id="@+id/v_line"
            android:background="@color/c_l_google"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/mirror_detail_title"/>
        <TextView
            android:textSize="@dimen/t_2"
            android:textColor="@color/c_t1_google"
            android:gravity="center_vertical"
            android:id="@+id/tv_distance"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:textDirection="locale"
            app:layout_constraintStart_toStartOf="@+id/mirror_detail_title"
            app:layout_constraintTop_toBottomOf="@+id/v_line"/>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/ll_start"
            android:background="@drawable/theme_start_navi_bg"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="6dp"
            android:layout_marginRight="16dp"
            android:layout_marginBottom="8dp"
            android:layout_marginHorizontal="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_distance">
            <ImageView
                android:id="@+id/iv_start"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/theme_ivi_googlemap_ic_start"/>
            <TextView
                android:textSize="@dimen/t_4"
                android:textColor="@color/c_t3_google"
                android:id="@+id/tv_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="1dp"
                android:text="@string/google_navi_start"
                android:includeFontPadding="false"
                android:textDirection="locale"
                android:layout_marginStart="4dp"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_type_tabs"
        android:background="@drawable/bg_google_route_tabs_container"
        android:padding="4dp"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginBottom="8dp"
        android:elevation="4dp"
        app:layout_constraintBottom_toTopOf="@+id/bg_port_title"
        app:layout_constraintEnd_toEndOf="@+id/bg_port_title"
        app:layout_constraintStart_toStartOf="@+id/bg_port_title">
        <LinearLayout
            android:gravity="center"
            android:id="@+id/tv_type_two_wheel"
            android:background="@drawable/selector_google_route_type_btn_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_type_bicycle"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:duplicateParentState="true"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/selector_google_route_type_moto"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/tv_type_bicycle"
            android:background="@drawable/selector_google_route_type_btn_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/tv_type_car"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/tv_type_two_wheel"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:duplicateParentState="true"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/selector_google_route_type_bicycle"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:id="@+id/tv_type_car"
            android:background="@drawable/selector_google_route_type_btn_bg"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/tv_type_bicycle"
            app:layout_constraintTop_toTopOf="parent">
            <ImageView
                android:duplicateParentState="true"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/selector_google_route_type_car"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <net.easyconn.carman.google.map.view.MirrorGoogleLoadingView
        android:id="@+id/mg_loading"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="110dp">
    <include layout="@layout/include_neutral_home_card_port_guide"/>
    <ImageView
        android:id="@+id/iv_toc_bg"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toLeftOf="@+id/view_card_bg"
        app:layout_constraintRight_toLeftOf="@+id/line_port_title_begin"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="18dp"
        android:textColor="@color/white"
        android:id="@+id/tv_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_begin"
        app:layout_constraintRight_toLeftOf="@+id/line_port_title_end"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

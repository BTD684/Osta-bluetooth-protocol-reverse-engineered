<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/root_dialog_view"
    android:background="@color/c_popup_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:gravity="bottom|center_horizontal"
        android:id="@+id/tv_title"
        android:paddingTop="18dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/notice"
        app:layout_constraintBottom_toTopOf="@+id/tv_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.common.view.AutoAlignCenterTextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:id="@+id/tv_content"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/mirror_dialog_title_height"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/v_bottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    <View
        android:id="@+id/v_bottom"
        android:layout_width="0dp"
        android:layout_height="@dimen/mirror_dialog_title_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t1"
        android:gravity="center"
        android:id="@+id/tv_cancel"
        android:background="@drawable/theme_bg_dialog_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/ec_usb_cancel"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toStartOf="@+id/tv_enter"
        app:layout_constraintStart_toStartOf="@+id/v_bottom"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_navy"
        android:gravity="center"
        android:id="@+id/tv_enter"
        android:background="@drawable/theme_bg_dialog_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/dialog_sure"
        app:layout_constraintBottom_toBottomOf="@+id/v_bottom"
        app:layout_constraintEnd_toEndOf="@+id/v_bottom"
        app:layout_constraintStart_toEndOf="@+id/tv_cancel"
        app:layout_constraintTop_toTopOf="@+id/v_bottom"/>
</androidx.constraintlayout.widget.ConstraintLayout>

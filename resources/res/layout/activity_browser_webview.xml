<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@color/c_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.mirror.LayerBorwseTitleView
        android:id="@+id/ly_title"
        android:layout_width="match_parent"
        android:layout_height="60dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/wb_contain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/et_input_ac"/>
    <EditText
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t2"
        android:ellipsize="end"
        android:gravity="start|center_vertical"
        android:id="@+id/et_input_ac"
        android:background="@drawable/theme_bg_radius_button_browse_input"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:hint="@string/ec_please_input"
        android:singleLine="true"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ly_title"/>
    <Button
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t3"
        android:id="@+id/bt_complete"
        android:background="@drawable/selector_i_check_button"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:maxWidth="128dp"
        android:minWidth="88dp"
        android:text="@string/finish"
        android:maxLines="1"
        android:textAllCaps="false"
        android:paddingStart="2dp"
        android:paddingEnd="2dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="@+id/ly_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ly_title"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/mirror_full_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

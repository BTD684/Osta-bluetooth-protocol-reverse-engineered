<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.custom.home.CornerRadiusImageView
        android:id="@+id/iv_mapbox"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/theme_ivi_home_ic_back_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_menu"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="@dimen/r_3"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:id="@+id/iv_menu"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/theme_ivi_home_ic_back_home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_mirror"
        app:layout_constraintStart_toEndOf="@+id/iv_mapbox"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="@dimen/r_3"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:id="@+id/iv_mirror"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_twin_space"
        app:layout_constraintStart_toEndOf="@+id/iv_menu"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="@dimen/r_3"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:id="@+id/iv_twin_space"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/theme_ivi_home_ic_virhome"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/iv_speech"
        app:layout_constraintStart_toEndOf="@+id/iv_mirror"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="@dimen/r_3"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/iv_twin_space_vip"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="-5dp"
        android:src="@drawable/theme_ivi_home_ic_vip_subscript"
        android:layout_marginEnd="-5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_twin_space"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/iv_twin_space"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:id="@+id/iv_speech"
        android:visibility="gone"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:src="@drawable/theme_ivi_common_dock_ic_voice_normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/iv_twin_space"
        app:layout_constraintTop_toTopOf="parent"
        app:radius="@dimen/r_3"/>
    <net.easyconn.custom.home.CornerRadiusImageView
        android:theme="@style/Theme.MaterialComponents"
        android:id="@+id/iv_speech_vip"
        android:visibility="gone"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginBottom="-5dp"
        android:src="@drawable/theme_ivi_home_ic_vip_subscript"
        android:layout_marginEnd="-5dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_speech"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/iv_speech"/>
</merge>

<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:background="@color/c_bg3"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/tv_help"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:layout_marginRight="20dp"
        android:src="@drawable/selector_cover_help"
        android:scaleType="centerInside"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
    <FrameLayout
        android:id="@+id/fl_back"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/t_6"
            android:textColor="@color/c_t14"
            android:gravity="center"
            android:background="@drawable/shape_backhome_bg"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="@string/back_to_home"
            android:drawablePadding="6dp"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:layout_marginStart="16dp"
            app:drawableStartCompat="@drawable/shape_backhome_dot"/>
    </FrameLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/ll_mirror_parent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <ImageView
            android:layout_gravity="center_horizontal"
            android:id="@+id/iv_cover_logo"
            android:layout_width="80dp"
            android:layout_height="230dp"
            android:src="@drawable/lock_upper"/>
        <RelativeLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_connect_success"
            android:visibility="visible"
            android:layout_width="240dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="50dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:textSize="20sp"
                android:textColor="#e6ffffff"
                android:id="@+id/tv_connect"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/connect_success"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="14sp"
                android:textColor="#999999"
                android:id="@+id/tv_connect_desc"
                android:focusable="false"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/connect_success_desc"
                android:layout_below="@+id/tv_connect"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_gravity="center_horizontal"
            android:id="@+id/rl_mirror"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_screen_mirror"
                android:background="@drawable/selector_cover_button_bg"
                android:padding="8dp"
                android:focusable="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:maxHeight="@dimen/L_y"
                android:minHeight="@dimen/b_3"
                android:text="@string/phone_mirror_projection"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_screen_disconnect"
                android:background="@drawable/selector_cover_button_bg"
                android:padding="8dp"
                android:focusable="false"
                android:visibility="gone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:maxHeight="@dimen/L_y"
                android:minHeight="@dimen/b_3"
                android:text="@string/disconnect"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16sp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tv_anti_abnormal"
                android:background="@drawable/selector_cover_button_bg"
                android:padding="8dp"
                android:focusable="false"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:maxHeight="@dimen/L_y"
                android:minHeight="@dimen/b_3"
                android:text="@string/anti_abnormal"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_screen_disconnect"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/fl_vm_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutNavi"
        app:layout_constraintTop_toTopOf="parent"/>
    <net.easyconn.carman.view.TwinSpaceBootingView
        android:id="@+id/booting_view"
        android:background="@color/easy_conn_black"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/layoutNavi"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutNavi"
        android:background="@color/c_bg"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="@dimen/vm_custom_navibar_height_land"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_goneMarginBottom="0dp">
        <ImageView
            android:id="@+id/btn_back"
            android:background="@drawable/btn_vm_navi_bar_bg"
            android:padding="5dp"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:src="@drawable/icon_vm_back"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_home"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_home"
            android:background="@drawable/btn_vm_navi_bar_bg"
            android:padding="5dp"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:src="@drawable/icon_vm_home"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/btn_menu"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/btn_back"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/btn_menu"
            android:background="@drawable/btn_vm_navi_bar_bg"
            android:padding="5dp"
            android:layout_width="100dp"
            android:layout_height="match_parent"
            android:src="@drawable/icon_vm_recent"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/btn_home"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

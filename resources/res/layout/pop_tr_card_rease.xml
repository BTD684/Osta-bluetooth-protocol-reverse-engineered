<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/ll_root"
    android:tag="layout/pop_tr_card_rease_0"
    android:background="@drawable/shape_tf_card_reset"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_16"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/iv_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:src="@drawable/icon_tf_card_reset_tip"
        android:contentDescription="@string/tf_card_reset_title"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_242942_white"
        android:gravity="center_vertical"
        android:layout_gravity="center_horizontal"
        android:id="@+id/txt_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/tf_card_reset_title"
        android:layout_marginHorizontal="@dimen/dp_24"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_8C8C8E_999999"
        android:id="@+id/tv_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_24"
        android:layout_marginBottom="@dimen/dp_16"
        android:text="@string/tf_card_reset_content"
        android:layout_marginHorizontal="@dimen/dp_24"/>
    <View
        android:background="@color/color_0D000000_0DFFFFFF"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_64">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_80242424_999999"
            android:gravity="center"
            android:id="@+id/tv_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/vehicle_manual_cancel"
            android:layout_weight="1"/>
        <View
            android:layout_gravity="center_vertical"
            android:id="@+id/v_line"
            android:background="@color/color_0D000000_0DFFFFFF"
            android:layout_width="1dp"
            android:layout_height="match_parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/color_FF3C53_F15468"
            android:gravity="center"
            android:id="@+id/tv_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:text="@string/confirm"
            android:layout_weight="1"/>
    </LinearLayout>
</LinearLayout>

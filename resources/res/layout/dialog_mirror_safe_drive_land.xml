<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/c_root"
    android:background="@color/c_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_tittle"
        android:layout_width="0dp"
        android:layout_height="60dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:id="@+id/ll_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp">
            <ImageView
                android:id="@+id/iv_close"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/theme_ivi_common_title_ic_closure"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/t_1"
            android:textColor="@color/c_t1"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/safe_drive_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_i_known"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_tittle">
        <ImageView
            android:id="@+id/iv_pic"
            android:layout_width="240dp"
            android:layout_height="177dp"
            android:src="@drawable/theme_ivi_third_img_tips"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/view_gap"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/view_gap"
            android:layout_width="0dp"
            android:layout_height="1dp"
            app:layout_constraintEnd_toStartOf="@+id/sv_text"
            app:layout_constraintStart_toEndOf="@+id/iv_pic"
            app:layout_constraintWidth_percent="0.06"/>
        <ScrollView
            android:id="@+id/sv_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/view_gap"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.46">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:id="@+id/ll_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="@dimen/t_4"
                    android:textColor="@color/c_t1"
                    android:id="@+id/tv_desc_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/safe_drive_mode_text_1"
                    android:lineSpacingExtra="3dp"/>
                <TextView
                    android:textSize="@dimen/t_4"
                    android:textColor="@color/c_t1"
                    android:id="@+id/tv_desc_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/safe_drive_mode_text_2"
                    android:lineSpacingExtra="3dp"/>
                <TextView
                    android:textSize="@dimen/t_4"
                    android:textColor="@color/c_t1"
                    android:id="@+id/tv_desc_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/safe_drive_mode_text_3"
                    android:lineSpacingExtra="3dp"/>
                <TextView
                    android:textSize="@dimen/t_4"
                    android:textColor="@color/c_t1"
                    android:id="@+id/tv_desc_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/safe_drive_mode_text_4"
                    android:lineSpacingExtra="3dp"/>
                <TextView
                    android:textSize="@dimen/t_4"
                    android:textColor="@color/c_t1"
                    android:id="@+id/tv_desc_5"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/safe_drive_mode_text_5"
                    android:lineSpacingExtra="3dp"/>
                <TextView
                    android:textSize="@dimen/t_4"
                    android:textColor="@color/c_t1"
                    android:id="@+id/tv_desc_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/safe_drive_mode_text_6"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>
        </ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <TextView
        android:textSize="@dimen/t_3"
        android:textColor="@color/c_t3"
        android:gravity="center"
        android:id="@+id/tv_i_known"
        android:background="@drawable/theme_bg_blue_button"
        android:layout_width="160dp"
        android:layout_height="41dp"
        android:layout_marginBottom="14dp"
        android:text="@string/function_i_know"
        app:layout_constraintBottom_toTopOf="@+id/rl_mirror_type"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <net.easyconn.carman.view.InterceptRelativeLayout
        android:id="@+id/rl_mirror_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <CheckBox
            android:gravity="center_vertical"
            android:id="@+id/cb_mirror_type"
            android:background="@drawable/theme_ivi_third_ic_checkbox"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:button="@null"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/t_6"
            android:textColor="@color/c_t2"
            android:id="@+id/tv_not_notify"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="7dp"
            android:text="@string/not_alert_next"
            android:layout_centerVertical="true"
            android:layout_marginStart="11dp"
            android:layout_toEndOf="@+id/cb_mirror_type"/>
    </net.easyconn.carman.view.InterceptRelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

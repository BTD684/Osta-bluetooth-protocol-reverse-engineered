<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="100dp"/>
            <gradient
                android:startColor="@color/color_ffffff_5A5A5A_50"
                android:endColor="@color/color_ffffff_5A5A5A_50"
                android:angle="270"
                android:centerColor="@color/color_ffffff_5A5A5A_50"/>
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape>
                <corners android:radius="100dp"/>
                <gradient
                    android:startColor="#1dd15e"
                    android:endColor="#1dd15e"
                    android:angle="270"
                    android:centerColor="#1dd15e"/>
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape>
                <corners android:radius="100dp"/>
                <gradient
                    android:startColor="#1dd15e"
                    android:endColor="#1dd15e"
                    android:angle="270"
                    android:centerColor="#1dd15e"/>
            </shape>
        </scale>
    </item>
</layer-list>

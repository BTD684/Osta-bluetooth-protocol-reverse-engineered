<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_ble_ota_update_confirm_dialog_0"
    android:background="@drawable/corners_solid_block_color_main_14"
    android:layout_width="303dp"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/txt_title"
        android:paddingLeft="@dimen/dp_24"
        android:paddingRight="@dimen/dp_24"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/ota_upgrade_confirmation"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/dp_24"
        android:paddingHorizontal="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_deputy_dark"
        android:id="@+id/txt_sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/ota_upgrade_confirmation_title"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_title"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/dp_24"
        android:layout_marginTop="@dimen/dp_8"
        android:layout_marginRight="@dimen/dp_24"
        android:text="@string/ota_upgrade_confirmation_desc"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/dp_24"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_sub_title"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_1"
        android:layout_marginTop="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_content"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_deputy_dark"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:text="@string/ota_not_yet"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
        app:layout_constraintEnd_toEndOf="@+id/view_center_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
    <View
        android:id="@+id/view_center_line"
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="@dimen/dp_1"
        android:layout_height="@dimen/dp_56"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/btn_confirm"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_0"
        android:text="@string/ota_confirm_upgrade"
        android:layout_weight="1"
        app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/view_center_line"
        app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>

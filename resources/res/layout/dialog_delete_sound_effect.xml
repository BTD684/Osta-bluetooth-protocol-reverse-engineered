<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_delete_sound_effect_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_effect_back_bg"
        android:layout_width="303dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_back_bg"
            android:layout_width="wrap_content"
            android:layout_height="66dp"
            android:layout_marginTop="@dimen/dp_30"
            android:src="@mipmap/icon_effect_delete"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/color_000000_ffffff"
            android:id="@+id/tv_effect_delete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/custom_remove_audio_title"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colorCustomRight"
            android:gravity="center"
            android:id="@+id/tv_effect_back_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/dp_12"
            android:text="@string/after_deleting_the_sound_effect_it_cannot_be_restored_do_you_confirm_the_deletion"/>
        <View
            android:id="@+id/view_back_line"
            android:background="@color/colorCustomLine"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="20dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/colorCustomRight"
                android:gravity="center"
                android:id="@+id/btn_cancel"
                android:background="@color/transparent"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:text="@string/Cancel"
                android:layout_weight="1"/>
            <View
                android:id="@+id/view_delete_line"
                android:background="@color/colorCustomLine"
                android:layout_width="1px"
                android:layout_height="58dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/colorCustom"
                android:gravity="center"
                android:id="@+id/btn_delete"
                android:background="@color/transparent"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:text="@string/user_message_dialog_confirm_delete"
                android:layout_weight="1"/>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

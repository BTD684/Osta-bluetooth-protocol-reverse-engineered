<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_emergency_contact_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/user_car_emergency_contact"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yadea.widget.switchItem.YadeaSwitchItemLayout
                android:id="@+id/action_contact_switch"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:switchLeftIconAppearance="@style/itemLeftIconMargin_8dp"
                app:switch_left_icon="@mipmap/ic_emergency_contact"/>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:background="@drawable/corners_solid_block_color_main_radius_14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="16dp"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textColor="@color/color_242942_white"
                    android:id="@+id/txt_owner_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_16"
                    android:text="@string/app_owner_info"
                    android:maxLines="1"/>
                <View
                    android:background="@color/text_line_color_deputy_light_alpha_50"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <com.yadea.widget.font.YadeaTextView
                    android:id="@+id/txt_owner_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:text="@string/app_use_help_info"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/img_owner_mobile"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/ic_contact_owner_mobile"
                        android:layout_marginStart="@dimen/dp_8"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/color_8C8C8E_333333"
                        android:ellipsize="end"
                        android:id="@+id/txt_owner_mobile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginBottom="@dimen/dp_16"
                        android:text="@string/app_bind_emergency_phone_email"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_marginVertical="@dimen/dp_16"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/color_242942_white"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/action_owner_info"
                        android:background="@drawable/corners_stroke_circle_8c8c8e"
                        android:paddingLeft="@dimen/dp_12"
                        android:paddingTop="4dp"
                        android:paddingRight="@dimen/dp_12"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_add"
                        android:layout_marginEnd="@dimen/dp_16"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="4dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
            <androidx.appcompat.widget.LinearLayoutCompat
                android:orientation="vertical"
                android:background="@drawable/corners_solid_block_color_main_radius_14"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginTop="16dp"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textColor="@color/color_242942_white"
                    android:id="@+id/txt_contact_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/dp_16"
                    android:text="@string/app_emergency_info"
                    android:maxLines="1"/>
                <View
                    android:background="@color/text_line_color_deputy_light_alpha_50"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <com.yadea.widget.font.YadeaTextView
                    android:id="@+id/txt_contact_title"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginTop="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_16"
                    android:text="@string/app_use_receive_info"
                    android:layout_marginHorizontal="@dimen/dp_16"/>
                <androidx.appcompat.widget.LinearLayoutCompat
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <Space
                        android:layout_width="8dp"
                        android:layout_height="0dp"/>
                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/img_contact_mobile"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@mipmap/ic_contact_mobile"
                        android:layout_marginStart="@dimen/dp_8"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/color_8C8C8E_333333"
                        android:ellipsize="end"
                        android:id="@+id/txt_contact_mobile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_16"
                        android:layout_marginBottom="@dimen/dp_16"
                        android:text="@string/app_bind_emergency_phone_email"
                        android:maxLines="1"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/dp_8"
                        android:layout_marginVertical="@dimen/dp_16"/>
                    <com.yadea.widget.font.YadeaTextView
                        android:textSize="12sp"
                        android:textColor="@color/color_242942_white"
                        android:layout_gravity="center_vertical"
                        android:id="@+id/action_contact_info"
                        android:background="@drawable/corners_stroke_circle_8c8c8e"
                        android:paddingLeft="@dimen/dp_12"
                        android:paddingTop="4dp"
                        android:paddingRight="@dimen/dp_12"
                        android:paddingBottom="4dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/common_add"
                        android:layout_marginEnd="@dimen/dp_16"
                        android:paddingHorizontal="@dimen/dp_12"
                        android:paddingVertical="4dp"/>
                </androidx.appcompat.widget.LinearLayoutCompat>
            </androidx.appcompat.widget.LinearLayoutCompat>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </FrameLayout>
</androidx.appcompat.widget.LinearLayoutCompat>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/corners_add_parts_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="@dimen/dp_16">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_add_parst"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_27"
            android:src="@mipmap/add_parts"/>
        <com.yadea.widget.font.YadeaTextView
            android:textColor="@color/ble_key_add_parts"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginBottom="@dimen/dp_24"
            android:text="@string/ble_key_add_parts"/>
    </LinearLayout>
</LinearLayout>

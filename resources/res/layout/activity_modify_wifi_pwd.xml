<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_modify_wifi_pwd_0"
    android:background="@color/color_F5F6FA_121212"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/hv_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title=""/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_28"
        android:textStyle="bold"
        android:textColor="@color/color_242942_white"
        android:paddingLeft="@dimen/dp_32"
        android:paddingRight="@dimen/dp_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="@string/wifi_password_change"
        android:paddingHorizontal="@dimen/dp_32"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="normal"
        android:textColor="@color/color_8C8C8E_999999"
        android:paddingLeft="@dimen/dp_32"
        android:paddingRight="@dimen/dp_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/new_and_old_password_both_are_8_characters"
        android:paddingHorizontal="@dimen/dp_32"/>
    <com.yadea.smartmoto.dvr.widget.PwdEditText
        android:id="@+id/et_old_pwd"
        android:paddingLeft="@dimen/dp_32"
        android:paddingRight="@dimen/dp_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:paddingHorizontal="@dimen/dp_32"
        app:pwd_hint="@string/input_old_password"
        app:pwd_title="@string/old_passwords"/>
    <com.yadea.smartmoto.dvr.widget.PwdEditText
        android:id="@+id/et_new_pwd"
        android:paddingLeft="@dimen/dp_32"
        android:paddingRight="@dimen/dp_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="@dimen/dp_32"
        app:pwd_hint="@string/input_new_password"
        app:pwd_title="@string/new_passwords"/>
    <com.yadea.smartmoto.dvr.widget.PwdEditText
        android:id="@+id/et_confirm_new_pwd"
        android:paddingLeft="@dimen/dp_32"
        android:paddingRight="@dimen/dp_32"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:paddingHorizontal="@dimen/dp_32"
        app:pwd_hint="@string/confirm_input_new_password"
        app:pwd_title="@string/confirm_new_password"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_ffffff_000000"
        android:gravity="center"
        android:layout_gravity="center_vertical"
        android:id="@+id/txt_update_pwd"
        android:background="@drawable/corners_gradient_solid_color_1d1d1d_e2e2e2_12"
        android:layout_width="match_parent"
        android:layout_height="51dp"
        android:layout_marginLeft="@dimen/dp_32"
        android:layout_marginTop="@dimen/dp_64"
        android:layout_marginRight="@dimen/dp_32"
        android:text="@string/update_password"
        android:layout_marginHorizontal="@dimen/dp_32"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.appcompat.widget.LinearLayoutCompat>

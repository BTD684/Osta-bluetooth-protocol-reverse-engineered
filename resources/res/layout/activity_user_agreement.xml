<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_user_agreement_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_gravity="center"
        android:id="@+id/txt_user_agreement"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="30dp"
        android:src="@mipmap/home_ic_agreement"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/txt_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="@string/app_name"
        app:layout_constraintTop_toBottomOf="@+id/txt_user_agreement"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/txt_subtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/home_agreement_subtitle"
        app:layout_constraintTop_toBottomOf="@+id/txt_title"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_protocol_content"
        android:background="@drawable/corners_stroke_text_line_color_deputy_light_solid_white_14"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:text="@string/home_agreement_desc"
        android:layout_weight="8"
        android:lineSpacingMultiplier="1.6"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@+id/txt_subtitle"/>
    <Space
        android:id="@+id/space"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/protocol_layout"/>
    <com.yadea.widget.protocol.YadeaProtocolLayout
        android:id="@+id/protocol_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="22dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintBottom_toTopOf="@+id/action_disagree"
        app:protocol_check_margin_top="0dp"
        app:protocol_check_size="0dp"
        app:protocol_content="@string/user_agreement_privacy_agreement_tips"
        app:protocol_content_line_spacing="1.5"
        app:protocol_content_text_color="@color/text_line_color_main"
        app:protocol_content_text_size="12sp"/>
    <Space
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:layout_constraintBottom_toTopOf="@+id/protocol_layout"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="34dp">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/action_disagree"
            android:background="@drawable/corners_stroke_text_line_color_main_14"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:text="@string/home_agreement_disagree"
            android:layout_weight="1"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="8dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/block_color_main"
            android:gravity="center"
            android:id="@+id/action_agree"
            android:background="@drawable/corners_solid_text_line_color_main_14"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:text="@string/home_agreement_agree"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="22dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_root"
    android:background="@color/C_Main_BG"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/rl_title"
        android:background="@color/c_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/L_t">
        <FrameLayout
            android:id="@+id/v_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/margin_title_back">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_back"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/theme_ivi_common_title_ic_back"
                android:scaleType="centerInside"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/t_1"
            android:textColor="@color/c_t1"
            android:gravity="center_vertical"
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ble_connect_error_title"
            android:layout_centerInParent="true"/>
    </RelativeLayout>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rl_title">
        <ImageView
            android:id="@+id/iv_scan_img"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/theme_ivi_common_img_pay"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/C_Text_Scend"
            android:gravity="start"
            android:id="@+id/tv_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/C_Text_Main"
            android:gravity="center"
            android:id="@+id/tv_button"
            android:background="@drawable/selector_button_bg_phone"
            android:visibility="visible"
            android:layout_width="160dp"
            android:layout_height="50dp"
            android:layout_marginTop="45dp"
            android:text="@string/qr_re_scan"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

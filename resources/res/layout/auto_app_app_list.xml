<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:background="@color/c_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingLeft="@dimen/y30"
        android:layout_width="match_parent"
        android:layout_height="@dimen/all_layout_title_height"> &gt; 
        <ImageView
            android:id="@+id/iv_back"
            android:background="@drawable/common_back_selector"
            android:layout_width="@dimen/x120"
            android:layout_height="@dimen/x120"
            android:layout_marginLeft="25dp"
            android:layout_centerVertical="true"/>
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="@drawable/app_list_tab_color"
            android:gravity="center"
            android:id="@+id/tv_auto_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/setting_auto_title"
            android:layout_centerInParent="true"
            android:layout_marginEnd="@dimen/x40"/>
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/gray"
            android:gravity="center"
            android:id="@+id/tv_select"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_save"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/x40"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>
    <View
        android:layout_alignParentBottom="true"
        style="@style/general_land_line_1px"/>
    <GridView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/gv_app_list"
        android:layout_width="@dimen/y1556"
        android:layout_height="match_parent"
        android:listSelector="@color/transparent"
        android:horizontalSpacing="@dimen/x24"
        android:verticalSpacing="@dimen/x24"
        android:numColumns="5"/>
</LinearLayout>

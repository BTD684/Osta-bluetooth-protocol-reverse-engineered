<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_forget_graph"
    app:startDestination="@+id/forget_password_fragment">
    <fragment
        android:label="Forget Password Fragment"
        android:name="com.yadea.login.view.forget.ForgetPasswordFragment"
        android:id="@+id/forget_password_fragment">
        <argument
            android:name="user_email"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="user_mobile"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/forget_password_confirm"
            app:destination="@+id/forget_password_confirm_fragment"/>
    </fragment>
    <fragment
        android:label="Setting Password Fragment"
        android:name="com.yadea.login.view.forget.SettingPasswordFragment"
        android:id="@+id/forget_password_confirm_fragment">
        <argument
            android:name="user_email"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="user_mobile"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="verify_code"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <argument
            android:name="user_id"
            android:defaultValue="@null"
            app:argType="string"
            app:nullable="true"/>
        <action
            android:id="@+id/forget_password"
            app:destination="@+id/forget_password_fragment"/>
    </fragment>
</navigation>

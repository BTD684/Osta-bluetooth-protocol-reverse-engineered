<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/dialog_debug_tool_0"
    android:background="@drawable/corners_solid_block_color_main_14"
    android:layout_width="300dp"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:gravity="center"
        android:id="@+id/action_debug"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="测试环境-欧洲"/>
    <View
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:gravity="center"
        android:id="@+id/action_release1"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="生产环境欧洲、美国"/>
    <View
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:gravity="center"
        android:id="@+id/action_release2"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="生产环境日本、韩国"/>
    <View
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_50">
        <androidx.appcompat.widget.SwitchCompat
            android:theme="@style/SwitchCompatStyle"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/switch_mock"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:checked="false"
            android:textOn="开"
            android:textOff="关"
            android:text="Mock数据"
            app:showText="true"
            app:switchMinWidth="@dimen/dp_55"
            app:switchPadding="@dimen/dp_8"
            app:switchTextAppearance="@style/SwitchCompatFontStyle"/>
    </FrameLayout>
    <View
        android:background="@color/text_line_color_deputy_light_40"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:gravity="center"
        android:id="@+id/action_virtual_car"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="虚拟车模式"/>
</androidx.appcompat.widget.LinearLayoutCompat>

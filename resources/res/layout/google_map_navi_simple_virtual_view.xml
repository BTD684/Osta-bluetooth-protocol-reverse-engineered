<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/google_map_navi_virtual_view"
    android:background="@color/c_bg4_google"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.libraries.navigation.NavigationView
        android:id="@+id/map_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_top_hud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/c_google_map"
        app:cardCornerRadius="46dp"
        app:cardElevation="5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/v_top_content"
            android:layout_width="400dp"
            android:layout_height="92dp">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ll_navi_info"
                android:background="@drawable/bg_navi_top_light"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/v_top_content_right"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.67">
                <ImageView
                    android:id="@+id/iv_next_cross_icon"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scaleType="centerCrop"
                    android:layout_marginStart="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintHeight_percent="0.7"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <TextView
                    android:textSize="@dimen/t_0"
                    android:textStyle="bold"
                    android:textColor="@color/c_t14_google"
                    android:id="@+id/tv_next_cross_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/tv_next_road_name"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_next_cross_icon"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <TextView
                    android:textSize="@dimen/t_5"
                    android:textColor="@color/c_t14_google"
                    android:ellipsize="end"
                    android:id="@+id/tv_next_road_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/iv_next_cross_icon"
                    app:layout_constraintTop_toBottomOf="@+id/tv_next_cross_distance"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/v_top_content_right"
                android:background="@color/c_t14_google"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ll_navi_info"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_percent="0.33">
                <net.easyconn.carman.google.map.view.AutoSizeTextView
                    android:textSize="26sp"
                    android:textColor="@color/c_t9_google"
                    android:gravity="start"
                    android:id="@+id/tv_remaining_distance"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toTopOf="@+id/tv_arrival_time"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintVertical_chainStyle="packed"/>
                <net.easyconn.carman.google.map.view.AutoSizeTextView
                    android:textSize="26sp"
                    android:textColor="@color/c_t9_google"
                    android:gravity="start"
                    android:id="@+id/tv_arrival_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_remaining_distance"
                    app:layout_constraintVertical_chainStyle="packed"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_way"
        android:background="@drawable/bg_navi_simple_bg"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_marginTop="2dp"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="@+id/cv_top_hud"
        app:layout_constraintTop_toBottomOf="@+id/cv_top_hud">
        <TextView
            android:textSize="@dimen/t_5"
            android:textColor="@color/c_t14_google"
            android:gravity="center_vertical"
            android:id="@+id/tv_then"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="@string/google_navi_then"
            android:textDirection="locale"
            android:layout_marginStart="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/im_way"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/im_way"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_then"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/iv_direction"
        android:background="@drawable/theme_icon_bg"
        android:visibility="gone"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:src="@drawable/theme_ivi_googlemap_ic_compass"
        android:layout_marginEnd="16dp"
        android:elevation="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_logo"
        android:background="@drawable/theme_ivi_googlemap_ic_logo"
        android:visibility="gone"
        android:layout_width="76dp"
        android:layout_height="26dp"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

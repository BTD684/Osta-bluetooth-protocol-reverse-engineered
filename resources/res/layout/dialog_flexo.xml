<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:tag="layout/dialog_flexo_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_dialog_bg_14"
        android:layout_width="303dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/txt_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="24dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <ImageView
            android:background="@color/text_line_color_deputy_light_alpha"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="56dp">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_deputy_dark"
                android:gravity="center"
                android:id="@+id/btn_left"
                android:tag="binding_1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/Cancel"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/img_line"
                android:background="@color/text_line_color_deputy_light_alpha"
                android:layout_width="1dp"
                android:layout_height="match_parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:id="@+id/btn_right"
                android:tag="binding_2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="@string/sure"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</RelativeLayout>

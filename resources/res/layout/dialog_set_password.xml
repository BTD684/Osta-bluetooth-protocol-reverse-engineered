<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_set_password_0"
    android:background="@drawable/corners_solid_block_color_main_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_242942_white"
        android:gravity="center"
        android:id="@+id/tv_lock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/app_input_origin_password"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/community_search_hint_text_new"
        android:gravity="center"
        android:id="@+id/tv_safety_verification_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        android:text="@string/app_input_right_four_number"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_lock_title"/>
    <com.yadea.vehicle.widget.DotEditTextView
        android:gravity="start|center_vertical"
        android:id="@+id/et_phone_number"
        android:background="@null"
        android:layout_width="176dp"
        android:layout_height="52dp"
        android:layout_marginTop="@dimen/dp_16"
        android:cursorVisible="false"
        android:maxLines="1"
        android:maxLength="4"
        android:inputType="number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_safety_verification_name"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_sub"
        android:gravity="center"
        android:id="@+id/tvForget"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/login_forgot_password"
        app:layout_constraintLeft_toLeftOf="@+id/et_phone_number"
        app:layout_constraintRight_toRightOf="@+id/et_phone_number"
        app:layout_constraintTop_toBottomOf="@+id/et_phone_number"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/text_sub"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="@string/vehicle_manual_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/view_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/viewLine2"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/btn_send_code"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="@string/sure"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_line"
        app:layout_constraintTop_toBottomOf="@+id/viewLine2"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/color_0D000000_0DFFFFFF"
        android:layout_width="1dp"
        android:layout_height="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btn_cancel"
        app:layout_constraintStart_toEndOf="@+id/btn_send_code"/>
    <View
        android:id="@+id/viewLine2"
        android:background="@color/color_0D000000_0DFFFFFF"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_cancel"
        app:layout_constraintStart_toEndOf="@+id/btn_send_code"
        app:layout_constraintTop_toBottomOf="@+id/tvForget"/>
</androidx.constraintlayout.widget.ConstraintLayout>

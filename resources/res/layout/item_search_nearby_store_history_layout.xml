<?xml version="1.0" encoding="utf-8"?>
<com.mcxtzhang.swipemenulib.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/item_search_nearby_store_history_layout_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:ios="false"
    app:swipeEnable="true">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/action_store_details"
            android:background="@drawable/corners_solid_block_color_dialog_14"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/img_store_icon"
                android:layout_width="@dimen/dp_40"
                android:layout_height="@dimen/dp_40"
                android:layout_marginTop="@dimen/dp_16"
                android:src="@mipmap/ic_nearby_store_search"
                android:layout_marginStart="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_16"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/txt_store_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_16"
                android:layout_marginRight="@dimen/dp_16"
                android:layout_marginHorizontal="@dimen/dp_16"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/img_store_icon"
                app:layout_constraintTop_toTopOf="@+id/img_store_icon"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_12"
                android:textColor="@color/color_8C8C8E_999999"
                android:ellipsize="end"
                android:id="@+id/txt_store_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_4"
                android:maxLines="1"
                app:layout_constraintEnd_toEndOf="@+id/txt_store_name"
                app:layout_constraintStart_toStartOf="@+id/txt_store_name"
                app:layout_constraintTop_toBottomOf="@+id/txt_store_name"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/dp_16"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txt_store_address"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <Space
        android:layout_width="16dp"
        android:layout_height="0dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textStyle="bold"
        android:textColor="@color/state_color_red"
        android:gravity="center"
        android:id="@+id/action_delete_history"
        android:background="@drawable/corners_stroke_state_color_red_14"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_46"
        android:text="@string/nfc_delete"
        android:paddingHorizontal="16dp"/>
</com.mcxtzhang.swipemenulib.SwipeMenuLayout>

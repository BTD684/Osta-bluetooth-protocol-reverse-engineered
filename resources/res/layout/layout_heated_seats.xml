<?xml version="1.0" encoding="utf-8"?>
<com.mcxtzhang.swipemenulib.SwipeMenuLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_heated_seats_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/dp_16"
    app:ios="false"
    app:swipeEnable="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/action_vehicle_container"
        android:background="@drawable/shape_radio_button_unit_uncheck"
        android:paddingLeft="@dimen/dp_16"
        android:paddingTop="@dimen/dp_12"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_12"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/dp_16"
        android:paddingVertical="@dimen/dp_12">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_22"
            android:textColor="@color/color_242942_white"
            android:ellipsize="end"
            android:id="@+id/txt_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lines="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/txt_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_4"
            app:layout_constraintStart_toStartOf="@+id/txt_time"
            app:layout_constraintTop_toBottomOf="@+id/txt_time"/>
        <com.yadea.widget.switchItem.YedeaOldSwitch
            android:id="@+id/sw_oen_key"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/CarSettingSwitch"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.legacy.widget.Space
        android:layout_width="8dp"
        android:layout_height="0dp"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_FF3535_FF455D"
        android:gravity="center"
        android:id="@+id/action_delete"
        android:background="@drawable/corners_solid_ff3535_5_ff455d_5_radius_12"
        android:paddingLeft="16dp"
        android:paddingTop="@dimen/dp_13"
        android:paddingRight="16dp"
        android:paddingBottom="@dimen/dp_13"
        android:layout_width="61dp"
        android:layout_height="match_parent"
        android:text="@string/nfc_delete"
        android:drawablePadding="@dimen/dp_6"
        android:paddingHorizontal="16dp"
        android:paddingVertical="@dimen/dp_13"
        app:drawableTopCompat="@mipmap/icon_red_delete_20"/>
</com.mcxtzhang.swipemenulib.SwipeMenuLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/container"
    android:tag="layout/activity_intercept_login_0"
    android:background="@mipmap/home_ic_login_not_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="100dp"
        android:src="@mipmap/home_ic_login_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/action_europe"
        android:background="@drawable/corners_solid_block_color_main_text_line_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="68dp"
        android:layout_marginRight="68dp"
        android:layout_marginBottom="19dp"
        android:layout_marginHorizontal="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/action_login"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:gravity="center"
        android:id="@+id/txt_europe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/login_please_select_region"
        android:drawablePadding="12dp"
        android:drawableEnd="@mipmap/login_ic_next"
        app:layout_constraintBottom_toBottomOf="@+id/action_europe"
        app:layout_constraintEnd_toEndOf="@+id/action_europe"
        app:layout_constraintStart_toStartOf="@+id/action_europe"
        app:layout_constraintTop_toTopOf="@+id/action_europe"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:gravity="center"
        android:id="@+id/action_login"
        android:background="@drawable/corners_solid_text_line_color_main_text_line_color_deputy_dark_14"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginLeft="68dp"
        android:layout_marginRight="68dp"
        android:layout_marginBottom="195dp"
        android:text="@string/login"
        android:layout_marginHorizontal="68dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

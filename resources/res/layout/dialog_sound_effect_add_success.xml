<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_sound_effect_add_success_0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_effect_back_bg"
        android:layout_width="303dp"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_effect_add"
            android:layout_width="69dp"
            android:layout_height="69dp"
            android:layout_marginTop="31dp"
            android:src="@mipmap/icon_effect_add_bg"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_18"
            android:textStyle="bold"
            android:textColor="@color/color_000000_ffffff"
            android:gravity="center"
            android:id="@+id/tv_effect_add_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="15dp"
            android:layout_marginRight="@dimen/dp_12"
            android:text="@string/custom_audio_success_title"
            android:layout_marginHorizontal="@dimen/dp_12"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/colorCustomRight"
            android:gravity="center"
            android:id="@+id/tv_add_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_12"
            android:layout_marginTop="10dp"
            android:layout_marginRight="@dimen/dp_12"
            android:text="@string/custom_audio_apply_success_title"
            android:layout_marginHorizontal="@dimen/dp_12"/>
        <View
            android:id="@+id/view_success_line"
            android:background="@color/colorCustomLine"
            android:layout_width="match_parent"
            android:layout_height="1px"
            android:layout_marginTop="@dimen/dp_16"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_16"
            android:textStyle="bold"
            android:textColor="@color/colorCustom"
            android:gravity="center"
            android:id="@+id/btn_save_effect"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/user_dialog_i_see"
            android:textAllCaps="false"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_scooter_battery_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/vehicle_scooter_battery_detail"/>
    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cl_battery"
                android:background="@drawable/corners_solid_block_color_main_14"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintTop_toTopOf="parent">
                <ImageView
                    android:id="@+id/v_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@mipmap/ic_scooter_battery_detail"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_line_color_deputy_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/vehicle_scooter_battery_remaining_capacity"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/v_icon"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_battery"
                    android:tag="binding_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cl_voltage"
                android:background="@drawable/corners_solid_block_color_main_top_radius_14"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintTop_toBottomOf="@+id/cl_battery">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_line_color_deputy_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/vehicle_scooter_battery_voltage"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_voltage"
                    android:tag="binding_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <View
                android:background="@color/text_line_color_deputy_light"
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:layout_marginLeft="24dp"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintTop_toBottomOf="@+id/cl_voltage"/>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/cl_temperature"
                android:background="@drawable/corners_solid_block_color_main_bottom_radius_14"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="1px"
                android:layout_marginRight="24dp"
                android:layout_marginHorizontal="24dp"
                app:layout_constraintTop_toBottomOf="@+id/cl_voltage">
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_line_color_deputy_dark"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/vehicle_scooter_battery_temperature"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <com.yadea.widget.font.YadeaTextView
                    android:textSize="14sp"
                    android:textColor="@color/text_line_color_main"
                    android:id="@+id/tv_temperature"
                    android:tag="binding_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:gravity="center"
                android:id="@+id/tv_times"
                android:tag="binding_4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@+id/cl_temperature"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.appcompat.widget.LinearLayoutCompat>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_verification_code_0"
    android:background="@drawable/corners_solid_block_color_main_14"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/color_242942_white"
        android:id="@+id/tv_safety_verification_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/loss_safe_verify"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/tv_safety_verification_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="24dp"
        android:text="@string/app_safe_verify_first"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_safety_verification_title"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/color_FF3535_FF455D"
        android:gravity="center"
        android:id="@+id/tv_desc"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/dp_16"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_safety_verification_name"/>
    <com.yadea.widget.input.YedeaVerifyCodeEditText
        android:gravity="center_vertical"
        android:id="@+id/edit_verify_code"
        android:focusableInTouchMode="true"
        android:longClickable="false"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="16dp"
        android:cursorVisible="false"
        android:maxLength="4"
        android:inputType="number"
        android:layout_marginEnd="@dimen/dp_10"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_desc"
        app:layout_constraintWidth_percent="0.8"
        app:verify_code_length="4"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_8C8C8E_999999"
        android:gravity="center"
        android:id="@+id/btn_cancel"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:text="@string/vehicle_manual_cancel"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/view_line"
        app:layout_constraintStart_toStartOf="parent"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/color_0D000000_0DFFFFFF"
        android:layout_width="1dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        app:layout_constraintEnd_toStartOf="@+id/btn_cancel"
        app:layout_constraintStart_toEndOf="@+id/btn_send_code"
        app:layout_constraintTop_toBottomOf="@+id/edit_verify_code"/>
    <View
        android:background="@color/color_0D000000_0DFFFFFF"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/view_line"
        app:layout_constraintEnd_toStartOf="@+id/btn_cancel"
        app:layout_constraintStart_toEndOf="@+id/btn_send_code"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_16"
        android:textStyle="bold"
        android:textColor="@color/color_242942_white"
        android:gravity="center"
        android:id="@+id/btn_send_code"
        android:layout_width="0dp"
        android:layout_height="65dp"
        android:text="@string/loss_send_verify_code"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/view_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>

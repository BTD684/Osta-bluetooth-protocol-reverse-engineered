<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_main_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.tabBottom.tab.YadeaTabBottomLayout
        android:id="@+id/tab_bottom_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yadea.widget.tabBottom.FragmentTabView
                android:id="@+id/fragment_tab_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </FrameLayout>
    </com.yadea.widget.tabBottom.tab.YadeaTabBottomLayout>
    <View
        android:id="@+id/line"
        android:background="@color/text_line_color_deputy_light"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toTopOf="@+id/rg_item"/>
    <RadioGroup
        android:orientation="horizontal"
        android:id="@+id/rg_item"
        android:background="@color/block_color_background"
        android:paddingTop="@dimen/dp_8"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="1dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <com.yadea.widget.font.YadeaRadioButton
            android:textSize="12sp"
            android:textColor="@color/selector_bottom_tab_text"
            android:gravity="center"
            android:id="@+id/rb_product_station"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:button="@null"
            android:text="@string/home_station"
            android:drawableTop="@drawable/selector_product_station"
            android:layout_weight="1"/>
        <com.yadea.widget.font.YadeaRadioButton
            android:textSize="12sp"
            android:textColor="@color/selector_bottom_tab_text"
            android:gravity="center"
            android:id="@+id/rb_scooter"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:button="@null"
            android:text="@string/home_love_car"
            android:drawableTop="@drawable/selector_scooter"
            android:layout_weight="1"/>
        <com.yadea.widget.font.YadeaRadioButton
            android:textSize="12sp"
            android:textColor="@color/selector_bottom_tab_text"
            android:gravity="center"
            android:id="@+id/rb_profile"
            android:background="@color/transparent"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:button="@null"
            android:text="@string/home_my_profile"
            android:drawableTop="@drawable/selector_profile"
            android:layout_weight="1"/>
    </RadioGroup>
</androidx.constraintlayout.widget.ConstraintLayout>

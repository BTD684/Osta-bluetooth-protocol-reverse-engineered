<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/c_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/sl_content"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_disagree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/t_1"
                android:textColor="@color/c_t1"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/permission_title"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:id="@+id/tv_title_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/permission_title_sub_1"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:id="@+id/tv_content1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/permission_content_1"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:id="@+id/tv_contacts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/permission_content_2"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:id="@+id/tv_phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/permission_content_3"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:id="@+id/tv_file"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/permission_content_4"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"/>
        </LinearLayout>
    </ScrollView>
    <TextView
        android:textSize="@dimen/t_2"
        android:textColor="@color/c_navy"
        android:gravity="center"
        android:id="@+id/btn_disagree"
        android:background="@drawable/theme_bg_gray_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="@string/permission_disagree"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_agree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sl_content"/>
    <TextView
        android:textSize="@dimen/t_2"
        android:textColor="@color/c_t3"
        android:gravity="center"
        android:id="@+id/btn_agree"
        android:background="@drawable/theme_bg_blue_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/permission_agree_continue"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_disagree"/>
</androidx.constraintlayout.widget.ConstraintLayout>

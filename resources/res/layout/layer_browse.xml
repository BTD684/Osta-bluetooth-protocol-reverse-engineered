<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.mirror.LayerBorwseTitleView
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="60dp"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/ll_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_title"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_dialog"
        android:background="#b3000000"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/shape_id"
            android:background="@drawable/shape_reverse_triangle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="42dp"
            android:layout_marginEnd="13dp"
            app:layout_constraintBottom_toTopOf="@+id/v_top"
            app:layout_constraintEnd_toEndOf="@+id/v_top"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/v_top"
            android:background="@color/c_popup_bg"
            android:layout_width="224dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/shape_id">
            <TextView
                android:textSize="@dimen/t_1"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="@dimen/mirror_dialog_title_height"
                android:text="@string/notice"
                app:layout_constraintBottom_toTopOf="@+id/tv_content"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:theme="@style/Theme.MaterialComponents"
                android:textSize="@dimen/t_2"
                android:id="@+id/tv_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginBottom="16dp"
                android:text="@string/use_keyword"
                app:layout_constraintBottom_toTopOf="@+id/enter_button"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t3"
                android:gravity="center"
                android:id="@+id/enter_button"
                android:background="@drawable/selector_i_check_button"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginBottom="16dp"
                android:text="@string/i_know"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_content"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

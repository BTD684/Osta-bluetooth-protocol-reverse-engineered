<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_emergency_contact_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="303dp"
        android:layout_height="wrap_content">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_24"
            android:layout_marginRight="@dimen/dp_16"
            android:layout_marginHorizontal="@dimen/dp_16"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textColor="@color/text_line_color_main"
            android:ellipsize="end"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_24"/>
        <com.yadea.widget.font.YadeaEditTextView
            android:textSize="14sp"
            android:textColor="@color/color_242942_white"
            android:ellipsize="end"
            android:id="@+id/ed_name"
            android:background="@drawable/corners_stroke_color_e6e6e6_333333_14"
            android:paddingLeft="@dimen/dp_16"
            android:paddingRight="@dimen/dp_16"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/dp_24"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:paddingHorizontal="@dimen/dp_16"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textColor="@color/text_line_color_main"
            android:ellipsize="end"
            android:id="@+id/tv_mobile"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:maxLines="1"
            android:layout_marginStart="@dimen/dp_24"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/ll_mobile"
            android:background="@drawable/corners_stroke_color_e6e6e6_333333_14"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/dp_24"
            android:layout_marginHorizontal="@dimen/dp_24">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="@dimen/sp_14"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:id="@+id/tv_area_code"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/dp_16"/>
            <View
                android:background="@color/color_242942_white"
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/dp_14"
                android:layout_marginBottom="@dimen/dp_14"
                android:layout_marginStart="@dimen/dp_16"
                android:layout_marginVertical="@dimen/dp_14"/>
            <com.yadea.widget.font.YadeaEditTextView
                android:textSize="14sp"
                android:textColor="@color/color_242942_white"
                android:ellipsize="end"
                android:id="@+id/ed_mobile"
                android:background="@color/transparent"
                android:paddingLeft="@dimen/dp_16"
                android:paddingRight="@dimen/dp_16"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:maxLines="1"
                android:inputType="number"
                android:paddingHorizontal="@dimen/dp_16"/>
        </LinearLayout>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_email"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_12"
            android:text="@string/app_owner_email"
            android:layout_marginStart="@dimen/dp_24"/>
        <com.yadea.widget.font.YadeaEditTextView
            android:textSize="14sp"
            android:textColor="@color/color_242942_white"
            android:ellipsize="end"
            android:id="@+id/ed_email"
            android:background="@drawable/corners_stroke_color_e6e6e6_333333_14"
            android:paddingLeft="@dimen/dp_16"
            android:paddingRight="@dimen/dp_16"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginLeft="@dimen/dp_24"
            android:layout_marginTop="8dp"
            android:layout_marginRight="@dimen/dp_24"
            android:hint="@string/app_please_input_owner_email"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/dp_24"
            android:paddingHorizontal="@dimen/dp_16"/>
        <View
            android:id="@+id/view_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_email"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_deputy_dark"
                android:gravity="center"
                android:id="@+id/action_cancel"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/Cancel"
                android:layout_weight="1"
                app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
                app:layout_constraintEnd_toEndOf="@+id/view_center_line"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
            <View
                android:id="@+id/view_center_line"
                android:background="@color/text_line_color_deputy_light_40"
                android:layout_width="1dp"
                android:layout_height="56dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:id="@+id/action_confirm"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:text="@string/sure"
                android:layout_weight="1"
                app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/view_center_line"
                app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</FrameLayout>

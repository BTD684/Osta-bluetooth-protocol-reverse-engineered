<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.base.mirror.LayerStandardTitleView
        android:id="@+id/title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:titleName="@string/setting_quality_adjust"/>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        app:layout_constraintTop_toBottomOf="@+id/title_view">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/item_project_quality_high"
            android:background="@drawable/theme_selector_mirror_setting_item"
            android:layout_width="match_parent"
            android:layout_height="@dimen/L_1"
            android:paddingStart="20dp">
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_project_quality_high"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/project_quality_default"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/switch_project_quality_high"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/theme_ivi_common_ic_selected"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/item_project_quality_smoothly"
            android:background="@drawable/theme_selector_mirror_setting_item"
            android:layout_width="match_parent"
            android:layout_height="@dimen/L_1"
            android:layout_marginTop="10dp"
            android:paddingStart="20dp">
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/tv_project_quality_smoothly"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/project_quality_smoothly"
                android:singleLine="true"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/switch_project_quality_smoothly"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/theme_ivi_common_ic_selected"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/c_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ScrollView
        android:id="@+id/sl_content"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_disagree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/t_1"
                android:textColor="@color/c_t1"
                android:gravity="center"
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:text="@string/permission_explain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textStyle="bold"
                android:textColor="@color/c_t1"
                android:id="@+id/tv_content_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="50dp"
                android:text="@string/apply_app_manager_list_title"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:id="@+id/tv_content_1_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="50dp"
                android:text="@string/apply_app_manager_list_content"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_content_1"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textStyle="bold"
                android:textColor="@color/c_t1"
                android:id="@+id/tv_content_2"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/apply_call_log_title"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:layout_constraintEnd_toEndOf="@+id/tv_content_1"
                app:layout_constraintStart_toStartOf="@+id/tv_content_1"
                app:layout_constraintTop_toBottomOf="@+id/tv_content_1_1"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t1"
                android:id="@+id/tv_content_2_1"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/apply_call_log_title_content"
                android:lineSpacingMultiplier="1.2"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                app:layout_constraintEnd_toEndOf="@+id/tv_content_1"
                app:layout_constraintStart_toStartOf="@+id/tv_content_1"
                app:layout_constraintTop_toBottomOf="@+id/tv_content_2"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
    <TextView
        android:textSize="@dimen/t_2"
        android:textColor="@color/c_navy"
        android:gravity="center"
        android:id="@+id/btn_disagree"
        android:background="@drawable/theme_bg_gray_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:text="@string/permission_disagree"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toTopOf="@+id/btn_agree"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sl_content"/>
    <TextView
        android:textSize="@dimen/t_2"
        android:textColor="@color/c_t3"
        android:gravity="center"
        android:id="@+id/btn_agree"
        android:background="@drawable/theme_bg_blue_button"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/permission_agree_continue"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btn_disagree"/>
</androidx.constraintlayout.widget.ConstraintLayout>

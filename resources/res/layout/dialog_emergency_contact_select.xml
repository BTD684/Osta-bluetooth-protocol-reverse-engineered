<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/dialog_emergency_contact_select_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@drawable/corners_solid_white_14"
        android:layout_width="303dp"
        android:layout_height="wrap_content">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="24dp"
            android:layout_marginRight="@dimen/dp_16"
            android:text="@string/app_add_owner_info"
            android:layout_marginHorizontal="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_phone"
            android:background="@drawable/corners_check_tel_bg"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_main"
                android:gravity="center_vertical"
                android:id="@+id/tv_phone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/phone_number"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <RadioButton
                android:id="@+id/rb_phone"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:checked="true"
                android:button="@drawable/check_tel_style"
                android:layout_marginEnd="@dimen/dp_14"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ll_email"
            android:background="@drawable/corners_check_tel_bg"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/ll_phone">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textColor="@color/text_line_color_main"
                android:gravity="center_vertical"
                android:id="@+id/tv_email"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="@string/user_personal_mail"
                android:layout_marginStart="16dp"
                app:layout_constraintStart_toStartOf="parent"/>
            <RadioButton
                android:id="@+id/rb_email"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:button="@drawable/check_tel_style"
                android:layout_marginEnd="@dimen/dp_14"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <View
            android:id="@+id/view_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_email"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_deputy_dark"
            android:gravity="center"
            android:id="@+id/btn_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/Cancel"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
            app:layout_constraintEnd_toEndOf="@+id/view_center_line"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
        <View
            android:id="@+id/view_center_line"
            android:background="@color/text_line_color_deputy_light_40"
            android:layout_width="1dp"
            android:layout_height="56dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/btn_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="@string/login_bind_email_next"
            android:layout_weight="1"
            app:layout_constraintBottom_toBottomOf="@+id/view_center_line"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/view_center_line"
            app:layout_constraintTop_toTopOf="@+id/view_center_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>

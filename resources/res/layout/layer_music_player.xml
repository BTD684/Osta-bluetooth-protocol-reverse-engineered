<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <net.easyconn.carman.common.base.mirror.LayerPlayingTitleView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"
        app:titleName="@string/spotify"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:id="@+id/info_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintEnd_toEndOf="@+id/contral_view"
        app:layout_constraintStart_toStartOf="@+id/contral_view"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:layout_constraintVertical_chainStyle="spread_inside">
        <TextView
            android:textSize="@dimen/t_1"
            android:textColor="@color/c_t1"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_audio_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxWidth="200dp"
            android:lines="1"
            app:layout_constraintEnd_toEndOf="@+id/tv_author"
            app:layout_constraintStart_toStartOf="@+id/tv_author"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2"
            android:gravity="center"
            android:id="@+id/tv_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_time"
            app:layout_constraintStart_toStartOf="@+id/tv_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_audio_name"/>
        <TextView
            android:textSize="@dimen/t_3"
            android:textColor="@color/c_t2"
            android:id="@+id/tv_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/tv_author"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/collected_1"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/contral_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_area"
        app:layout_constraintVertical_chainStyle="spread">
        <ImageView
            android:id="@+id/iv_favorite"
            android:visibility="invisible"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/theme_ivi_music_player_ic_collect"
            android:layout_marginEnd="16dp"/>
        <ImageView
            android:id="@+id/play_mode"
            android:visibility="invisible"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/theme_ivi_music_player_ic_sequence"
            android:layout_marginEnd="16dp"/>
        <ImageView
            android:id="@+id/back_15s"
            android:visibility="invisible"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/theme_ivi_music_player_ic_reduce"
            android:layout_marginEnd="16dp"/>
        <ImageView
            android:id="@+id/forward_15s"
            android:visibility="invisible"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/theme_ivi_music_player_ic_add"/>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/contral_view"
        android:layout_width="0dp"
        android:layout_height="56dp"
        app:layout_constraintBottom_toBottomOf="@+id/bottom"
        app:layout_constraintEnd_toStartOf="@+id/rl_cover"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/info_area"
        app:layout_constraintVertical_chainStyle="spread"
        app:layout_constraintWidth_percent="0.52">
        <ImageView
            android:id="@+id/img_music_prev"
            android:background="@drawable/music_ctrl_button_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/music_ic_pre_selector"
            android:scaleType="centerInside"
            android:layout_weight="1"
            app:layout_constraintEnd_toStartOf="@+id/img_music_playpause"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toStartOf="parent"/>
        <ImageView
            android:id="@+id/img_music_playpause"
            android:background="@drawable/music_ctrl_button_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/music_playing_play_land_selector"
            android:scaleType="centerInside"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintEnd_toStartOf="@+id/img_music_next"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toEndOf="@+id/img_music_prev"/>
        <ImageView
            android:id="@+id/img_music_next"
            android:background="@drawable/music_ctrl_button_bg"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:src="@drawable/music_ic_next_selector"
            android:scaleType="centerInside"
            android:layout_weight="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_chainStyle="spread"
            app:layout_constraintStart_toEndOf="@+id/img_music_playpause"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <net.easyconn.carman.music.view.SquareLayout
        android:id="@+id/rl_cover"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/contral_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toEndOf="@+id/contral_view"
        app:layout_constraintTop_toBottomOf="@+id/title">
        <ImageView
            android:id="@+id/img_music_cover_forceground"
            android:visibility="gone"
            android:layout_width="@dimen/x504"
            android:layout_height="@dimen/x504"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/img_music_cover_cicle"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/theme_ivi_music_player_projection"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
        <ImageView
            android:id="@+id/img_music_cover"
            android:layout_width="@dimen/x504"
            android:layout_height="@dimen/x504"
            android:scaleType="centerCrop"
            android:layout_centerInParent="true"/>
    </net.easyconn.carman.music.view.SquareLayout>
    <RelativeLayout
        android:id="@+id/notice_view"
        android:background="@color/c_bg"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="36sp"
            android:textColor="#e6ffffff"
            android:id="@+id/title_spotify"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/spotify"
            android:layout_marginStart="24dp"/>
        <ImageView
            android:id="@+id/back_up"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/common_back_selector"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/btn_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="@dimen/t_0"
                android:textColor="@color/c_t1"
                android:gravity="center"
                android:id="@+id/notices"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/please_open_spotify_sync"
                android:layout_centerInParent="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/t_2"
                android:textColor="@color/c_t15"
                android:gravity="center"
                android:id="@+id/retry"
                android:background="@drawable/btn_sync_selector"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:visibility="visible"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginTop="36dp"
                android:text="@string/sync"
                android:layout_below="@+id/notices"
                android:layout_centerInParent="true"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/notices"
                app:layout_constraintWidth_percent="0.8"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </RelativeLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vip_notices_view"
        android:background="@drawable/toc_tag_bg"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/title">
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_t14"
            android:id="@+id/time_flag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="试用剩余0“"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/vip_notices"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/t_4"
            android:textColor="@color/c_navy"
            android:ellipsize="end"
            android:id="@+id/vip_notices"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="开通VIP，播放不暂停“"
            android:singleLine="true"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/arrow"
            app:layout_constraintStart_toEndOf="@+id/time_flag"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/arrow"
            android:layout_width="18dp"
            android:layout_height="26dp"
            android:src="@drawable/theme_ivi_common_list_ic_enter"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/vip_notices"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

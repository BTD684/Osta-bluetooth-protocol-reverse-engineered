    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/vehicle_notification_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:rightIcon="@mipmap/vehicle_notification_right_icon"
        app:title="@string/vehicle_notifications_settings"/>
    <include
        android:id="@+id/vehicle_notification_empty"
        layout="@layout/loadsir_empty_layout"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/vehicle_notification_scroll"
        android:tag="binding_1"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

<?xml version="1.0" encoding="utf-8"?>
<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="16dp">
    <com.yadea.widget.font.YadeaRadioButton
        android:textColor="@drawable/button_navigation_setting_text_color"
        android:gravity="center"
        android:id="@+id/radio_theme_light"
        android:background="@drawable/button_navigation_setting_bg"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:checked="true"
        android:button="@null"
        android:text="@string/theme_light"
        android:layout_weight="1"/>
    <Space
        android:layout_width="12dp"
        android:layout_height="0dp"/>
    <com.yadea.widget.font.YadeaRadioButton
        android:textColor="@drawable/button_navigation_setting_text_color"
        android:gravity="center"
        android:id="@+id/radio_theme_dark"
        android:background="@drawable/button_navigation_setting_bg"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:button="@null"
        android:text="@string/theme_dark"
        android:layout_weight="1"/>
    <Space
        android:visibility="gone"
        android:layout_width="12dp"
        android:layout_height="0dp"/>
    <com.yadea.widget.font.YadeaRadioButton
        android:textColor="@drawable/button_navigation_setting_text_color"
        android:gravity="center"
        android:id="@+id/radio_theme_system"
        android:background="@drawable/button_navigation_setting_bg"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:button="@null"
        android:text="@string/common_theme_auto"
        android:layout_weight="1"/>
</RadioGroup>

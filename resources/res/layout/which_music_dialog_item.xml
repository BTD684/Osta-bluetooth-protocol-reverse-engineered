<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/which_map_item_selector"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/black_0.2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x1"/>
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/ll_which_map_item"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x214">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/img_map_icon"
            android:layout_width="@dimen/x150"
            android:layout_height="@dimen/x150"
            android:layout_margin="@dimen/x48"/>
        <TextView
            android:textSize="@dimen/text_size_normal"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:id="@+id/tv_map_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:tag="layout/activity_bluetooth_scan_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:leftIcon="@mipmap/widget_ic_close"
        app:title="@string/qr_bluetooth_device_detected"/>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_deputy_light"
            android:gravity="center"
            android:id="@+id/tv_rescan"
            android:tag="binding_1"
            android:background="@drawable/drawable_scan_binding_btn"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="90dp"
            android:layout_marginRight="90dp"
            android:layout_marginBottom="16dp"
            android:text="@string/qr_bluetooth_rescan"
            android:layout_above="@+id/tv_qr_scan"
            android:layout_marginHorizontal="90dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:id="@+id/tv_qr_scan"
            android:tag="binding_2"
            android:background="@drawable/corners_stroke_text_line_color_main_14"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginLeft="90dp"
            android:layout_marginRight="90dp"
            android:layout_marginBottom="35dp"
            android:layout_alignParentBottom="true"
            android:layout_marginHorizontal="90dp"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/tv_rescan">
            <com.yadea.widget.circleView.YedeaDiffuseView
                android:layout_gravity="center_horizontal"
                android:id="@+id/diffuse_view"
                android:layout_width="320dp"
                android:layout_height="320dp"
                app:diffuse_core_circle_size="90"
                app:diffuse_count="3"
                app:diffuse_stroke_width="1dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:id="@+id/tv_tips"
                android:tag="binding_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_bluetooth_scan_nearby_vehicle"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_vehicle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/ll_result"
            android:tag="binding_4"
            android:background="@color/block_color_background"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/tv_rescan">
            <ImageView
                android:tag="binding_5"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="120dp"
                android:layout_marginBottom="32dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:tag="binding_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="@string/qr_bluetooth_scan_no_found_device"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_main"
                android:gravity="center"
                android:tag="binding_7"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="4dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_main"
                android:tag="binding_8"
                android:background="@drawable/corners_stroke_text_line_color_deputy_light_14"
                android:padding="16dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="24dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="24dp"
                android:lineSpacingExtra="4dp"
                android:layout_marginHorizontal="24dp"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_ble"
            android:tag="binding_9"
            android:background="@color/block_color_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_bluetooth_permission_no_enable"
                android:lineSpacingExtra="3dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_open_ble"
                android:background="@drawable/corners_stroke_black_14"
                android:layout_width="195dp"
                android:layout_height="46dp"
                android:layout_marginTop="30dp"
                android:text="@string/common_permission_open"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:id="@+id/ll_location"
            android:tag="binding_10"
            android:background="@color/block_color_background"
            android:clickable="true"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/qr_bluetooth_location_permission_no_enable"
                android:lineSpacingExtra="3dp"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:gravity="center"
                android:id="@+id/tv_open_location"
                android:background="@drawable/corners_stroke_black_14"
                android:layout_width="195dp"
                android:layout_height="46dp"
                android:layout_marginTop="30dp"
                android:text="@string/common_permission_open"/>
        </LinearLayout>
    </RelativeLayout>
</LinearLayout>

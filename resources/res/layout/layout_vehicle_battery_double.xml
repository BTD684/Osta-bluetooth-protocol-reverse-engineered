<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/layout_vehicle_battery_double_0"
    android:paddingLeft="@dimen/dp_16"
    android:paddingRight="@dimen/dp_16"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_160"
    android:paddingHorizontal="@dimen/dp_16">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_14"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/tv_mode"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:text="@string/home_batter_double_battery_mode"
        android:drawableEnd="@mipmap/ic_14_gray_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_10"
        android:textColor="@color/color_8C8C8E_999999"
        android:id="@+id/tv_update_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="@+id/tv_mode"
        app:layout_constraintStart_toStartOf="@+id/tv_mode"
        app:layout_constraintTop_toBottomOf="@+id/tv_mode"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_soc_a"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_update_time"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_deputy_dark"
        android:id="@+id/txt_label_a"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_batter_battery_a"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/txt_soc_a"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_soc_a"/>
    <org.libpag.PAGImageView
        android:id="@+id/anim_bg_a"
        android:background="@drawable/battery_progressbar1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_soc_a"/>
    <org.libpag.PAGImageView
        android:id="@+id/anim_progress_a"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_soc_a"/>
    <ProgressBar
        android:id="@+id/progress_a"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/dp_4"
        android:max="100"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_soc_a"
        style="@style/BatteryProgressBar1"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_soc_b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/progress_a"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_deputy_dark"
        android:id="@+id/txt_label_b"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/home_batter_battery_b"
        android:layout_marginStart="4dp"
        app:layout_constraintBottom_toBottomOf="@+id/txt_soc_b"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/txt_soc_b"/>
    <org.libpag.PAGImageView
        android:id="@+id/anim_bg_b"
        android:background="@drawable/battery_progressbar1"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_soc_b"/>
    <org.libpag.PAGImageView
        android:id="@+id/anim_progress_b"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_soc_b"/>
    <ProgressBar
        android:id="@+id/progress_b"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginBottom="16dp"
        android:max="100"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txt_soc_b"
        style="@style/BatteryProgressBar1"/>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_navi_info"
        android:background="@drawable/custom_google_nav_virtual_info"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="275dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:minHeight="93dp"
        android:layout_marginStart="15dp"
        android:elevation="6dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_next_cross_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="29sp"
            android:textStyle="bold"
            android:textColor="@color/c_t14_google"
            android:id="@+id/tv_next_cross_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="3dp"
            android:singleLine="true"
            android:textDirection="locale"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_next_road_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_next_cross_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#d8d8d8"
            android:ellipsize="end"
            android:id="@+id/tv_next_road_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textDirection="locale"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_next_cross_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_next_cross_distance"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_way"
        android:background="@drawable/custom_navi_next_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:elevation="6dp"
        android:paddingVertical="6dp"
        app:layout_constraintEnd_toEndOf="@+id/ll_navi_info"
        app:layout_constraintTop_toTopOf="@+id/ll_navi_info">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/c_t14_google"
            android:gravity="center_vertical"
            android:id="@+id/tv_then"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/google_navi_then"
            android:textDirection="locale"
            android:layout_marginStart="6dp"
            app:layout_constraintEnd_toStartOf="@+id/im_way"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/im_way"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_then"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/view_distance_time"
        android:background="@drawable/custom_google_nav_virtual_info"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clickable="true"
        android:layout_width="275dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="14dp"
        android:layout_marginStart="15dp"
        android:elevation="7dp"
        android:paddingVertical="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_navi_info">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="@color/c_t14_google"
                android:ellipsize="end"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tv_remaining_distance"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:lines="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_999"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginBottom="2dp"
                android:layout_marginStart="3dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/c_t14_google"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_remaining_time"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            android:layout_weight="1.2"/>
        <TextView
            android:textSize="17sp"
            android:textColor="@color/color_999"
            android:gravity="center"
            android:id="@+id/tv_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="23sp"
                android:textStyle="bold"
                android:textColor="@color/c_t14_google"
                android:ellipsize="end"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tv_arrival_time"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:lines="1"/>
            <TextView
                android:textSize="13sp"
                android:textColor="@color/color_999"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tv_arrival_time_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginBottom="2dp"
                android:text="@string/arrive_time_label_map"
                android:layout_marginStart="3dp"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

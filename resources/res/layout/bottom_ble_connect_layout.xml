<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="bottom"
    android:tag="layout/bottom_ble_connect_layout_0"
    android:background="@drawable/corners_solid_top_block_color_background_14"
    android:paddingBottom="18dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/home_dialog_bluetooth_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/fl_center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">
        <View
            android:layout_gravity="center"
            android:id="@+id/v_blue"
            android:background="@mipmap/ic_result_fail"
            android:layout_width="80dp"
            android:layout_height="80dp"/>
        <com.yadea.widget.circleView.YedeaDiffuseView
            android:layout_gravity="center"
            android:id="@+id/diffuse_view"
            android:visibility="gone"
            android:layout_width="244dp"
            android:layout_height="244dp"
            app:diffuse_core_circle_size="90"
            app:diffuse_count="3"
            app:diffuse_stroke_width="1dp"/>
    </FrameLayout>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/vehicle_dialog_bluetooth_please_connect_device"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_connect"
        app:layout_constraintTop_toBottomOf="@+id/fl_center"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_connect"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/vehicle_dialog_bluetooth_connect"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_connect_cancel"/>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/text_line_color_deputy_dark"
        android:gravity="center"
        android:id="@+id/tv_connect_cancel"
        android:background="@drawable/corners_solid_block_color_main_14"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginLeft="24dp"
        android:layout_marginTop="16dp"
        android:layout_marginRight="24dp"
        android:layout_marginBottom="16dp"
        android:text="@string/home_dialog_bluetooth_cancel"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

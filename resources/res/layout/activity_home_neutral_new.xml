<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/c_bg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tv_focus"
        android:focusable="true"
        android:layout_width="@dimen/x1"
        android:layout_height="@dimen/x1"/>
    <net.easyconn.carman.view.HomeLayout
        android:id="@+id/layout_home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <net.easyconn.carman.view.HomeNavigationHintView
        android:id="@+id/navi_hint_view"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="@dimen/x186"/>
    <net.easyconn.carman.common.dialog.VirtualDialogLayer
        android:id="@+id/virtual_dialog_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <net.easyconn.carman.common.dialog.VirtualToastLayer
        android:id="@+id/virtual_toast_layer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <TextView
        android:textSize="16dp"
        android:gravity="bottom|right"
        android:id="@+id/txt_clock"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:focusable="false"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="00:00:00 000"/>
    <net.easyconn.carman.common.view.NiLockFloatLayout
        android:id="@+id/ni_float_layout"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>

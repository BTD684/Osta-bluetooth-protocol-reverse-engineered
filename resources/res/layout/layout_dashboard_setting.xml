<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/cl_root"
    android:tag="layout/layout_dashboard_setting_0"
    android:background="@drawable/corners_solid_block_color_bg_f5f6fa_top_radius_14"
    android:paddingLeft="@dimen/dp_24"
    android:paddingRight="@dimen/dp_24"
    android:paddingBottom="34dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/dp_24">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="@dimen/sp_18"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_24"
        android:text="@string/dashboard_settings"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:padding="@dimen/dp_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_default_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_default_view"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <RadioGroup
            android:orientation="horizontal"
            android:id="@+id/gp_default_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:layout_below="@+id/tv_default_view"
            app:layout_constraintTop_toBottomOf="@+id/tv_default_view">
            <com.yadea.widget.font.YadeaRadioButton
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="@color/color_ff5e00_000000_selector"
                android:gravity="center"
                android:id="@+id/rb_dashboard_mode"
                android:background="@drawable/dashboard_setting_pop_shape"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:checked="true"
                android:button="@null"
                android:text="@string/dashboard_instrument_mode"
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/dp_4"/>
            <com.yadea.widget.font.YadeaRadioButton
                android:textSize="@dimen/sp_12"
                android:textStyle="bold"
                android:textColor="@color/color_ff5e00_000000_selector"
                android:gravity="center"
                android:id="@+id/rb_map_mode"
                android:background="@drawable/dashboard_setting_pop_shape"
                android:layout_width="match_parent"
                android:layout_height="49dp"
                android:button="@null"
                android:text="@string/dashboard_map_mode"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/dp_4"/>
        </RadioGroup>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_auto"
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:layout_below="@+id/tv_title"
        android:paddingHorizontal="@dimen/dp_16">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_auto_track"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/dashboard_auto_recording"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.switchItem.YedeaSwitch
            android:id="@+id/swi_auto_track"
            app:layout_constraintBottom_toBottomOf="@+id/tv_auto_track"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_auto_track"
            style="@style/DashboardSettingSwitch"/>
        <View
            android:id="@+id/v_auto_line"
            android:background="@color/text_line_color_deputy_light"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintTop_toBottomOf="@+id/tv_auto_track"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/text_line_color_deputy_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/dashboard_auto_recording_tip"
            app:layout_constraintTop_toBottomOf="@+id/v_auto_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_lock_screen"
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_16">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_lock_screen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/dashboard_lock_screen_display"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.switchItem.YedeaSwitch
            android:id="@+id/swi_lock_screen"
            app:layout_constraintBottom_toBottomOf="@+id/tv_lock_screen"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_lock_screen"
            style="@style/DashboardSettingSwitch"/>
        <View
            android:id="@+id/v_lock_screen_line"
            android:background="@color/text_line_color_deputy_light"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintTop_toBottomOf="@+id/tv_lock_screen"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/text_line_color_deputy_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/dashboard_lock_screen_display_tip"
            app:layout_constraintTop_toBottomOf="@+id/v_lock_screen_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/corners_solid_block_color_main_radius_14"
        android:paddingLeft="@dimen/dp_16"
        android:paddingRight="@dimen/dp_16"
        android:paddingBottom="@dimen/dp_16"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_16"
        android:paddingHorizontal="@dimen/dp_16">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/tv_key"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            android:text="@string/icon_dashboard_compass"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.switchItem.YedeaSwitch
            android:id="@+id/sw_key"
            app:layout_constraintBottom_toBottomOf="@+id/tv_key"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_key"
            style="@style/DashboardSettingSwitch"/>
        <View
            android:id="@+id/v_key_line"
            android:background="@color/text_line_color_deputy_light"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/dp_10"
            app:layout_constraintTop_toBottomOf="@+id/tv_key"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/text_line_color_deputy_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_8"
            android:text="@string/icon_dashboard_compass_tip"
            app:layout_constraintTop_toBottomOf="@+id/v_key_line"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.appcompat.widget.LinearLayoutCompat>

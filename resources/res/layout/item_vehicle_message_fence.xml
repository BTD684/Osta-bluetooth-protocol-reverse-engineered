<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/text_line_color_deputy_dark"
        android:gravity="center"
        android:id="@+id/txt_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/view_bg"
        android:background="@drawable/corners_solid_block_color_dialog_14"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="22dp"
        android:layout_marginTop="13dp"
        android:layout_marginRight="22dp"
        android:layout_marginHorizontal="22dp"
        app:layout_constraintBottom_toBottomOf="@+id/txt_content"
        app:layout_constraintTop_toBottomOf="@+id/txt_date"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_line_color_main"
        android:ellipsize="end"
        android:id="@+id/txt_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:lines="1"
        android:layout_marginStart="16dp"
        app:layout_constraintEnd_toStartOf="@+id/txt_location"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/view_bg"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="12sp"
        android:textColor="@color/color_see_location"
        android:id="@+id/txt_location"
        android:background="@drawable/corners_see_location_bg"
        android:paddingLeft="@dimen/dp_12"
        android:paddingTop="@dimen/dp_4"
        android:paddingRight="@dimen/dp_12"
        android:paddingBottom="@dimen/dp_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/vehicle_setting_see_location"
        android:layout_marginEnd="16dp"
        android:paddingHorizontal="@dimen/dp_12"
        android:paddingVertical="@dimen/dp_4"
        app:layout_constraintBottom_toBottomOf="@+id/txt_title"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintTop_toTopOf="@+id/txt_title"/>
    <View
        android:id="@+id/view_line"
        android:background="@color/text_line_color_deputy_light"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginLeft="16dp"
        android:layout_marginTop="8dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toBottomOf="@+id/txt_title"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/text_line_color_main"
        android:id="@+id/txt_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="@+id/view_bg"
        app:layout_constraintStart_toStartOf="@+id/view_bg"
        app:layout_constraintTop_toBottomOf="@+id/view_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>

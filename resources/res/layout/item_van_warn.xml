<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/line_port_begin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/line_port_title_begin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="100dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/line_port_title_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="136dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/line_port_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="16dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/line_land_begin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_begin="@dimen/x30"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/line_land_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_end="@dimen/x30"/>
    <View
        android:id="@+id/view_card_bg"
        android:layout_width="0dp"
        android:layout_height="@dimen/y240"
        app:layout_constraintBottom_toTopOf="@+id/line_land_end"
        app:layout_constraintLeft_toRightOf="@+id/line_port_begin"
        app:layout_constraintRight_toLeftOf="@+id/line_port_end"
        app:layout_constraintTop_toTopOf="@+id/line_land_begin"
        style="@style/bg_style_home_card_warn"/>
    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="@dimen/x90"
        android:layout_height="@dimen/y90"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toLeftOf="@+id/view_card_bg"
        app:layout_constraintRight_toLeftOf="@+id/line_port_title_begin"
        app:layout_constraintTop_toTopOf="@+id/view_card_bg"/>
    <TextView
        android:textSize="@dimen/x60"
        android:textColor="@color/white"
        android:id="@+id/tv_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_begin"
        app:layout_constraintRight_toLeftOf="@+id/line_port_title_end"
        app:layout_constraintTop_toTopOf="@+id/view_card_bg"/>
    <TextView
        android:textSize="@dimen/x54"
        android:textColor="@color/white"
        android:gravity="end|center_vertical"
        android:id="@+id/tv_info"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingEnd="@dimen/x72"
        app:layout_constraintBottom_toBottomOf="@+id/view_card_bg"
        app:layout_constraintLeft_toRightOf="@+id/line_port_title_end"
        app:layout_constraintRight_toRightOf="@+id/view_card_bg"
        app:layout_constraintTop_toTopOf="@+id/view_card_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>

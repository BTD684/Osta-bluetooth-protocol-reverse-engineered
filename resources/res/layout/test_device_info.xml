<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_test"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="测试开关"
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toStartOf="parent"/>
    <CheckBox
        android:id="@+id/test_switch"
        android:background="@drawable/theme_ivi_personal_ic_switch"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="25dp"
        android:layout_marginLeft="20dp"
        android:checked="false"
        android:button="@null"
        android:layout_marginEnd="30dp"
        app:layout_constraintEnd_toEndOf="parent"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_device"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="手机ID："
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_test"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_device_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_device"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_device"
        app:layout_constraintTop_toTopOf="@+id/tv_device"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_statu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="车机SN："
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_device"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_statu_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_statu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_statu"
        app:layout_constraintTop_toTopOf="@+id/tv_statu"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_statu_psn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="状态："
        android:layout_marginStart="28dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_statu"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_statu_result_psn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="@+id/tv_statu_psn"
        app:layout_constraintStart_toEndOf="@+id/tv_statu_psn"
        app:layout_constraintTop_toTopOf="@+id/tv_statu_psn"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_psn_statu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:text="车机权益状态："
        android:layout_marginStart="30dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_statu_psn"/>
    <TextView
        android:textSize="20dp"
        android:id="@+id/tv_psn_statu_result"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_psn_statu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/tv_psn_statu"
        app:layout_constraintTop_toTopOf="@+id/tv_psn_statu"/>
</androidx.constraintlayout.widget.ConstraintLayout>

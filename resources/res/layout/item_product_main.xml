<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_product"
    android:tag="layout/item_product_main_0"
    android:background="@null"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_203"
    android:layout_marginLeft="8dp"
    android:layout_marginRight="8dp"
    android:layout_marginBottom="@dimen/dp_10"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="@dimen/dp_14"
    app:cardElevation="0dp">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/linear_product"
        android:background="@color/color_product_item_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/iv_product"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_140"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textStyle="bold"
            android:textColor="@color/color_product_title"
            android:ellipsize="end"
            android:id="@+id/tv_product_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_16"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/dp_16"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_12"
            android:textColor="@color/color_8C8C8E"
            android:ellipsize="end"
            android:id="@+id/tv_product_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_16"
            android:layout_marginTop="@dimen/dp_8"
            android:layout_marginRight="@dimen/dp_16"
            android:maxLines="1"
            android:layout_marginHorizontal="@dimen/dp_16"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

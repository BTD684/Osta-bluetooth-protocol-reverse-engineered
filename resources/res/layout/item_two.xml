<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/view1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/bg_left"
                android:background="@drawable/corners_solid_green_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_left"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <org.libpag.PAGImageView
                android:layout_gravity="center"
                android:id="@+id/iv_pag_left"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </FrameLayout>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/tv_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/bg_left"
            app:layout_constraintTop_toTopOf="parent"/>
    </LinearLayout>
    <View
        android:layout_gravity="center"
        android:id="@+id/view"
        android:background="@color/color_14000000_333333"
        android:layout_width="1dp"
        android:layout_height="32dp"/>
    <LinearLayout
        android:gravity="center"
        android:id="@+id/view2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <View
                android:id="@+id/bg_right"
                android:background="@drawable/corners_solid_orange_bg"
                android:layout_width="48dp"
                android:layout_height="48dp"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/iv_right"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
            <org.libpag.PAGImageView
                android:layout_gravity="center"
                android:id="@+id/iv_pag_right"
                android:visibility="gone"
                android:layout_width="32dp"
                android:layout_height="32dp"/>
        </FrameLayout>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="12sp"
            android:textColor="@color/color_8C8C8E_999999"
            android:id="@+id/tv_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"/>
    </LinearLayout>
</LinearLayout>

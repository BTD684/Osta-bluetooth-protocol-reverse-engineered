<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:expandableTextView="http://schemas.android.com/apk/res-auto"
    android:background="#1a1b25"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/rl_top"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x54"
            android:layout_marginStart="@dimen/x54"
            android:layout_marginEnd="@dimen/x54">
            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="@dimen/x180"
                android:layout_height="@dimen/x180"
                android:scaleType="fitXY"
                android:layout_centerVertical="true"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/x54"
                android:layout_toEndOf="@+id/iv_icon">
                <TextView
                    android:textSize="@dimen/x42"
                    android:textColor="@color/white_0.9"
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/x36"
                    android:textColor="@color/white_0.5"
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <TextView
                    android:textSize="@dimen/x36"
                    android:textColor="@color/white_0.5"
                    android:id="@+id/tv_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
            <net.easyconn.server.view.OtaDownloadView
                android:id="@+id/view_download"
                android:layout_width="@dimen/x180"
                android:layout_height="@dimen/x180"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"/>
        </RelativeLayout>
        <TextView
            android:textSize="@dimen/x36"
            android:textColor="@color/white_0.5"
            android:id="@+id/tv_versionName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x54"
            android:layout_below="@+id/rl_top"
            android:layout_marginStart="@dimen/x54"/>
        <com.ms.square.android.expandabletextview.ExpandableTextView
            android:id="@+id/expand_text_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x10"
            android:layout_marginBottom="@dimen/x54"
            android:layout_below="@+id/tv_versionName"
            android:layout_marginStart="@dimen/x54"
            android:layout_marginEnd="@dimen/x54"
            expandableTextView:animDuration="200"
            expandableTextView:collapseDrawable="@drawable/transparent"
            expandableTextView:maxCollapsedLines="1">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="@dimen/x36"
                    android:textColor="@color/white_0.5"
                    android:id="@+id/expandable_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/x200"/>
                <ImageButton
                    android:id="@+id/expand_collapse"
                    android:background="@null"
                    android:layout_width="@dimen/x200"
                    android:layout_height="@dimen/x48"
                    android:layout_marginTop="@dimen/x4"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </com.ms.square.android.expandabletextview.ExpandableTextView>
        <View
            android:background="#0e0e19"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x24"
            android:layout_below="@+id/expand_text_view"/>
    </RelativeLayout>
</RelativeLayout>

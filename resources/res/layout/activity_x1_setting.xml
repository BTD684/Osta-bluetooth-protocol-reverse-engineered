<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_x1_setting_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/home_dialog_vehicle_setting"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="vertical"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_gravity="center"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:layout_marginTop="110dp"
            android:src="@mipmap/loadsir_empty_icon"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="@dimen/sp_14"
            android:textColor="@color/text_line_color_main"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/loadsir_empty_tips"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollview"
        android:visibility="gone"
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:orientation="vertical"
            android:background="@color/block_color_background"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="80dp">
            <FrameLayout
                android:id="@+id/ll_action_close_to_power_on"
                android:tag="binding_1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yadea.widget.switchItem.YadeaSwitchItemLayout
                    android:id="@+id/action_close_to_power_on"
                    android:tag="binding_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:switchLeftIconAppearance="@style/itemLeftIconMargin_8dp"
                    app:switch_bottom_left_value="@string/v_near"
                    app:switch_bottom_radio_button_size="3"
                    app:switch_bottom_radio_group="true"
                    app:switch_bottom_radio_visible="true"
                    app:switch_bottom_right_value="@string/v_far"
                    app:switch_left_icon="@mipmap/home_ic_bluetooth"/>
                <com.yadea.widget.font.YadeaTextView
                    android:tag="binding_3"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    style="@style/CarSettingMask"/>
                <com.yadea.widget.switchItem.YadeaIconView
                    android:tag="binding_4"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:child_id="@+id/id_switch_item_title"
                    app:icon_drawable="@mipmap/ic_setting_question_mark"
                    app:icon_margin_start="8dp"
                    app:parent_id="@+id/action_close_to_power_on"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/ll_action_imperial_system"
                android:tag="binding_5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yadea.widget.switchItem.YadeaSwitchItemLayout
                    android:id="@+id/action_imperial_system"
                    android:tag="binding_6"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:switchHide="true"
                    app:switchLeftIconAppearance="@style/itemLeftIconMargin_8dp"
                    app:switch_check_radio_button_size="2"
                    app:switch_check_radio_group="true"
                    app:switch_check_radio_visible="true"
                    app:switch_is_check="true"
                    app:switch_left_icon="@mipmap/icon_imperial_system"/>
                <com.yadea.widget.font.YadeaTextView
                    android:tag="binding_7"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    style="@style/CarSettingMask"/>
                <com.yadea.widget.switchItem.YadeaIconView
                    android:tag="binding_8"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:child_id="@+id/id_switch_item_title"
                    app:icon_drawable="@mipmap/ic_setting_question_mark"
                    app:icon_margin_start="8dp"
                    app:parent_id="@+id/action_imperial_system"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/ll_vehicle_setting_tcs"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yadea.widget.switchItem.YadeaSwitchItemLayout
                    android:id="@+id/action_body_stability"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:switchLeftIconAppearance="@style/itemLeftIconMargin_8dp"
                    app:switch_left_icon="@mipmap/icon_tcs_body_stability"/>
                <com.yadea.widget.font.YadeaTextView
                    android:id="@+id/tv_vehicle_tcs"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    style="@style/CarSettingMask"/>
                <com.yadea.widget.switchItem.YadeaIconView
                    android:id="@+id/vehicle_tcs_tip"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:child_id="@+id/id_switch_item_title"
                    app:icon_drawable="@mipmap/ic_setting_question_mark"
                    app:icon_margin_start="8dp"
                    app:parent_id="@+id/action_body_stability"/>
            </FrameLayout>
            <FrameLayout
                android:id="@+id/ll_action_energy_recovery"
                android:tag="binding_9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <com.yadea.widget.switchItem.YadeaSwitchItemLayout
                    android:id="@+id/action_energy_recovery"
                    android:tag="binding_10"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    app:switchBottomLeftValueAppearance="@style/switch_bottom_left_value_text_color_dark"
                    app:switchLeftIconAppearance="@style/itemLeftIconMargin_8dp"
                    app:switch_bottom_radio_button_size="3"
                    app:switch_bottom_radio_group="true"
                    app:switch_left_icon="@mipmap/icon_energy_recovery"/>
                <com.yadea.widget.font.YadeaTextView
                    android:tag="binding_11"
                    android:layout_marginLeft="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginRight="16dp"
                    android:layout_marginHorizontal="16dp"
                    style="@style/CarSettingMask"/>
                <com.yadea.widget.switchItem.YadeaIconView
                    android:tag="binding_12"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:child_id="@+id/id_switch_item_title"
                    app:icon_drawable="@mipmap/ic_setting_question_mark"
                    app:icon_margin_start="8dp"
                    app:parent_id="@+id/action_energy_recovery"/>
            </FrameLayout>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.appcompat.widget.AppCompatImageView
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="100dp"
        android:src="@mipmap/empty_history"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/text_line_color_main"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/loadsir_empty_tips"/>
    <com.yadea.widget.font.YadeaTextView
        android:textSize="14sp"
        android:textColor="@color/color_8c8c8e"
        android:gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/loadsir_no_firmware"/>
</androidx.appcompat.widget.LinearLayoutCompat>

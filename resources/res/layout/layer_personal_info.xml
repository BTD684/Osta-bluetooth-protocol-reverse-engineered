<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/c_bg"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <net.easyconn.carman.common.base.mirror.LayerStandardTitleView
            android:id="@+id/system_title"
            android:layout_width="match_parent"
            android:layout_height="@dimen/L_t"
            app:layout_constraintTop_toTopOf="parent"
            app:titleName="@string/personal_info"/>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/shape_persion_info_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user_name"
                    android:singleLine="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"/>
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t2"
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:background="@color/c_bg"
                android:visibility="gone"
                style="@style/system_item_layout">
                <View
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="@dimen/card_left_right_margin_54"
                    android:layout_marginEnd="@dimen/card_left_right_margin_54"
                    style="@style/general_land_line_1px"/>
                <TextView
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    style="@style/system_item_tv"/>
                <TextView
                    android:textSize="@dimen/text_size_small"
                    android:textColor="@color/color_666"
                    android:id="@+id/tv_mail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/x24"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
            <RelativeLayout
                android:id="@+id/item_mapbox"
                android:layout_width="match_parent"
                android:layout_height="64dp">
                <View
                    android:background="@color/c_l"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mapbox_vip_label"
                    android:singleLine="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="16dp"/>
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t2"
                    android:ellipsize="end"
                    android:id="@+id/tv_vip_status"
                    android:visibility="invisible"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/mapbox_not_pay"
                    android:singleLine="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="32dp"
                    android:layout_marginEnd="16dp"
                    android:layout_alignParentEnd="true"/>
            </RelativeLayout>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/t_3"
                android:textColor="@color/c_w_r"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/tv_logout"
                android:background="@drawable/system_logout_selector"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginBottom="24dp"
                android:text="@string/logout"
                android:singleLine="true"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
            <TextView
                android:textSize="@dimen/t_6"
                android:textColor="@color/c_t2"
                android:id="@+id/tv_logoff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/logoff_account"
                android:layout_above="@+id/tv_logout"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_start"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintGuide_begin="0dp"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guide_end"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        app:layout_constraintGuide_end="0dp"/>
    <net.easyconn.carman.common.base.mirror.LayerLargeTitleView
        android:id="@+id/title_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/L_t"
        app:layout_constraintTop_toTopOf="parent"
        app:titleName="@string/easyconn_syms_set"/>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_view">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_root"
            android:background="@color/c_list_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintLeft_toLeftOf="@+id/guide_start"
            app:layout_constraintRight_toRightOf="@+id/guide_end"
            app:layout_constraintTop_toBottomOf="@+id/title_view">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/user_area"
                android:background="@drawable/theme_mirror_card_bg"
                android:paddingLeft="20dp"
                android:paddingRight="20dp"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginLeft="20dp"
                android:layout_marginTop="10dp"
                android:layout_marginRight="20dp"
                app:layout_constraintTop_toTopOf="parent">
                <net.easyconn.carman.common.view.RoundImageView
                    android:id="@+id/iv_user_icon"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:src="@color/all_text_blue"
                    app:radius="25dp"/>
                <TextView
                    android:textSize="@dimen/t_2"
                    android:textColor="@color/c_t1"
                    android:ellipsize="end"
                    android:id="@+id/user_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/login_by_google"
                    android:singleLine="true"
                    android:layout_marginStart="20dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/settings_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/user_area">
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_vip"
                    android:background="@drawable/theme_selector_mirror_setting_item"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/L_1">
                    <TextView
                        android:textSize="@dimen/t_2"
                        android:textColor="@color/c_t1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/vip"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/member_center"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:src="@drawable/theme_ivi_common_list_ic_enter"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_twin_space"
                    android:background="@drawable/theme_selector_mirror_setting_item"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/L_1">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/t_2"
                            android:textColor="@color/c_t1"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/twin_space"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/setting_item_twin_space"
                            android:singleLine="true"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/twin_space_red_dot"
                            android:visibility="gone"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:src="@color/c_navy_w"
                            android:layout_marginStart="4dp"
                            app:layout_constraintStart_toEndOf="@+id/twin_space"
                            app:layout_constraintTop_toTopOf="@+id/twin_space"
                            app:shapeAppearance="@style/imageViewRoundStyle"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:src="@drawable/theme_ivi_common_list_ic_enter"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_anti_abnormal"
                    android:background="@drawable/theme_selector_mirror_setting_item"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/L_2">
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <TextView
                            android:textSize="@dimen/t_2"
                            android:textColor="@color/c_t1"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/anti_abnormal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/anti_abnormal"
                            android:singleLine="true"
                            android:layout_weight="1"/>
                        <TextView
                            android:textSize="@dimen/t_4"
                            android:textColor="@color/c_t2"
                            android:ellipsize="end"
                            android:gravity="center_vertical"
                            android:id="@+id/anti_abnormal_tips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/anti_abnormal_tips"
                            android:singleLine="true"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:src="@drawable/theme_ivi_common_list_ic_enter"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_conn"
                    android:background="@drawable/theme_selector_mirror_setting_item"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/L_1">
                    <TextView
                        android:textSize="@dimen/t_2"
                        android:textColor="@color/c_t1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/conn"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/function_connect"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:src="@drawable/theme_ivi_common_list_ic_enter"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_user_help"
                    android:background="@drawable/theme_selector_mirror_setting_item"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/L_1">
                    <TextView
                        android:textSize="@dimen/t_2"
                        android:textColor="@color/c_t1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/user_help"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/user_help"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:src="@drawable/theme_ivi_common_list_ic_enter"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_contact_us"
                    android:background="@drawable/theme_selector_mirror_setting_item"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/L_1">
                    <TextView
                        android:textSize="@dimen/t_2"
                        android:textColor="@color/c_t1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/contact_us"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/system_contact_us"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:src="@drawable/theme_ivi_common_list_ic_enter"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:id="@+id/item_about"
                    android:background="@drawable/theme_selector_mirror_setting_item"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/L_1">
                    <TextView
                        android:textSize="@dimen/t_2"
                        android:textColor="@color/c_t1"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:id="@+id/about"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/about"
                        android:singleLine="true"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="20dp"
                        android:src="@drawable/theme_ivi_common_list_ic_enter"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

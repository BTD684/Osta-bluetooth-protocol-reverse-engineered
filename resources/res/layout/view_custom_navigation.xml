<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_navi_info"
        android:background="@drawable/custom_google_nav_virtual_info"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="64dp"
        android:layout_marginStart="10dp"
        android:elevation="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.4">
        <ImageView
            android:id="@+id/iv_next_cross_icon"
            android:layout_width="33dp"
            android:layout_height="33dp"
            android:layout_marginStart="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="@dimen/t_8"
            android:textStyle="bold"
            android:textColor="@color/c_t14_google"
            android:id="@+id/tv_next_cross_distance"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:singleLine="true"
            android:textDirection="locale"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_next_road_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_next_cross_icon"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"/>
        <TextView
            android:textSize="@dimen/t_6"
            android:textStyle="bold"
            android:textColor="#d8d8d8"
            android:ellipsize="end"
            android:id="@+id/tv_next_road_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textDirection="locale"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/iv_next_cross_icon"
            app:layout_constraintTop_toBottomOf="@+id/tv_next_cross_distance"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ct_way"
        android:background="@drawable/custom_navi_next_bg"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:elevation="4dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="@+id/ll_navi_info"
        app:layout_constraintTop_toTopOf="@+id/ll_navi_info">
        <TextView
            android:textSize="@dimen/t_11"
            android:textColor="@color/c_t14_google"
            android:gravity="center_vertical"
            android:id="@+id/tv_then"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/google_navi_then"
            android:textDirection="locale"
            android:layout_marginStart="4dp"
            app:layout_constraintEnd_toStartOf="@+id/im_way"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/im_way"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_then"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:orientation="horizontal"
        android:id="@+id/view_distance_time"
        android:background="@drawable/custom_google_nav_virtual_info"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clickable="true"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="10dp"
        android:elevation="5dp"
        android:paddingVertical="8dp"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ll_navi_info">
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            app:layout_constraintHorizontal_weight="1">
            <TextView
                android:textSize="@dimen/t_3"
                android:textStyle="bold"
                android:textColor="@color/c_t14_google"
                android:ellipsize="end"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tv_arrival_time"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:lines="1"
                app:layout_constraintEnd_toStartOf="@+id/tv_remaining_time"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/guideline"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/color_999"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tv_arrival_time_label"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginBottom="1.5dp"
                android:text="@string/arrive_time_label_map"
                android:layout_marginStart="2dp"
                app:layout_constraintEnd_toEndOf="@+id/tv_arrival_time"
                app:layout_constraintStart_toStartOf="@+id/tv_arrival_time"
                app:layout_constraintTop_toBottomOf="@+id/tv_arrival_time"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <TextView
            android:textSize="@dimen/t_2"
            android:textStyle="bold"
            android:textColor="@color/c_t14_google"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/tv_remaining_time"
            android:visibility="gone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:lines="1"
            app:layout_constraintEnd_toStartOf="@+id/tv_remaining_distance"
            app:layout_constraintHorizontal_weight="1.2"
            app:layout_constraintStart_toEndOf="@+id/tv_arrival_time"
            app:layout_constraintTop_toBottomOf="@+id/guideline"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/color_999"
            android:gravity="center"
            android:id="@+id/tv_time"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@+id/tv_remaining_time"
            app:layout_constraintStart_toStartOf="@+id/tv_remaining_time"
            app:layout_constraintTop_toBottomOf="@+id/tv_remaining_time"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/t_3"
                android:textStyle="bold"
                android:textColor="@color/c_t14_google"
                android:ellipsize="end"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tv_remaining_distance"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:lines="1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toEndOf="@+id/tv_remaining_time"
                app:layout_constraintTop_toBottomOf="@+id/guideline"/>
            <TextView
                android:textSize="9sp"
                android:textColor="@color/color_999"
                android:gravity="bottom|center_horizontal"
                android:id="@+id/tv_distance"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginBottom="1.5dp"
                android:layout_marginStart="2dp"
                app:layout_constraintEnd_toEndOf="@+id/tv_remaining_distance"
                app:layout_constraintStart_toStartOf="@+id/tv_remaining_distance"
                app:layout_constraintTop_toBottomOf="@+id/tv_remaining_distance"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.constraintlayout.widget.ConstraintLayout>

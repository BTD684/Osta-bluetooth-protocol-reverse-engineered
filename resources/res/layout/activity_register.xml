<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_register_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:rightTitle="  "
        app:rightTitleAppearance="@style/loginRightTitleSize18"
        app:subTitle="@string/register_email"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_register"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_email"
            android:tag="binding_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="@dimen/dp_40"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/login_enter_email"
            app:input_edit_clear="true"
            app:input_edit_max_length="50"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:name_text="@string/user_personal_mail"
            app:name_text_bold="true"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_verify_code"
            android:tag="binding_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/user_dialog_enter_verification_code"
            app:input_edit_max_length="4"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_verify_code"
            app:layout_constraintTop_toBottomOf="@+id/edit_email"
            app:name_text="@string/login_register_verify_code"
            app:name_text_bold="true"
            app:send_text="@string/user_dialog_verify_code_send"
            app:send_text_bold="true"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_password"
            android:tag="binding_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/login_enter_password"
            app:input_edit_clear="true"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_password"
            app:layout_constraintTop_toBottomOf="@+id/edit_verify_code"
            app:name_text="@string/login_password"
            app:name_text_bold="true"/>
        <com.yadea.widget.protocol.YadeaProtocolLayout
            android:gravity="start"
            android:id="@+id/protocol_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_16"
            app:layout_constraintEnd_toEndOf="@+id/action_login"
            app:layout_constraintStart_toStartOf="@+id/action_login"
            app:layout_constraintTop_toBottomOf="@+id/action_login"
            app:protocol_check_size="0dp"
            app:protocol_content="@string/login_protocol_continue"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/block_color_main"
            android:gravity="center"
            android:id="@+id/action_login"
            android:tag="binding_4"
            android:background="@drawable/corners_text_line_color_main_radius_14"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_password"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_forgetPwd_email"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_password_email"
            android:tag="binding_5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/enter_six_password"
            app:input_edit_clear="true"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_password"
            app:layout_constraintTop_toTopOf="parent"
            app:name_text="@string/enter_password"
            app:name_text_bold="true"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_password_email_again"
            android:tag="binding_6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/enter_password_again"
            app:input_edit_clear="true"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_password"
            app:layout_constraintTop_toBottomOf="@+id/edit_password_email"
            app:name_text="@string/enter_password_affirm"
            app:name_text_bold="true"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/block_color_main"
            android:gravity="center"
            android:id="@+id/action_confirm_email"
            android:tag="binding_7"
            android:background="@drawable/corners_text_line_color_main_radius_14"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="22dp"
            android:text="@string/sure"
            android:layout_marginHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_password_email_again"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_forgetPwd_tel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_password_tel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/input_six_password"
            app:input_edit_clear="true"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_password"
            app:layout_constraintTop_toTopOf="parent"
            app:name_text="@string/enter_password"
            app:name_text_bold="true"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_password_tel_again"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/enter_password_again"
            app:input_edit_clear="true"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_password"
            app:layout_constraintTop_toBottomOf="@+id/edit_password_tel"
            app:name_text="@string/enter_password_affirm"
            app:name_text_bold="true"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/block_color_main"
            android:gravity="center"
            android:id="@+id/action_confirm_tel"
            android:background="@drawable/corners_text_line_color_main_radius_14"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="22dp"
            android:text="@string/login_register_confirm"
            android:layout_marginHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_password_tel_again"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_change_tel"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_tel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="40dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:area_code_text="+84"
            app:area_code_text_color="@color/colorFF5E00"
            app:area_code_text_size="@dimen/sp_14"
            app:hint_text="@string/cell_phone_number"
            app:input_edit_clear="true"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_phone"
            app:layout_constraintTop_toTopOf="parent"
            app:name_text="@string/phone_number"
            app:name_text_bold="true"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_gravity="hint_center"
            app:hint_text="@string/user_dialog_enter_verification_code"
            app:input_edit_max_length="4"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_size="14sp"
            app:input_text_type="text_verify_code"
            app:layout_constraintTop_toBottomOf="@+id/edit_tel"
            app:name_text="@string/login_register_verify_code"
            app:name_text_bold="true"
            app:send_text="@string/user_dialog_verify_code_send"
            app:send_text_bold="true"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/block_color_main"
            android:gravity="center"
            android:id="@+id/action_confirm_tel_change"
            android:background="@drawable/corners_text_line_color_main_radius_14"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="48dp"
            android:layout_marginRight="22dp"
            android:text="@string/login_register_confirm"
            android:layout_marginHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_code"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_forgetPwd_other"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <com.yadea.widget.font.YadeaTextView
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_line_color_main"
            android:id="@+id/txt_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/login_register_set_new_password"
            android:layout_marginStart="22dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_email_other"
            android:tag="binding_8"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="54dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/login_enter_email"
            app:input_edit_clear="true"
            app:input_edit_max_length="50"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_email"
            app:layout_constraintStart_toStartOf="@+id/txt_label"
            app:layout_constraintTop_toBottomOf="@+id/txt_label"
            app:name_text="@string/user_personal_mail"
            app:name_text_bold="true"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_verify_code_other"
            android:tag="binding_9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/user_dialog_enter_verification_code"
            app:input_edit_max_length="4"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_verify_code"
            app:layout_constraintTop_toBottomOf="@+id/edit_email_other"
            app:name_text="@string/login_register_verify_code"
            app:name_text_bold="true"
            app:send_text="@string/user_dialog_verify_code_send"
            app:send_text_bold="true"/>
        <com.yadea.widget.input.YadeaInputEditLayout
            android:id="@+id/edit_password_other"
            android:tag="binding_10"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="22dp"
            android:layout_marginHorizontal="22dp"
            app:hint_text="@string/login_enter_password"
            app:input_edit_clear="true"
            app:input_line_background="@color/color_8C8C8E_333333"
            app:input_text_margin_right="@dimen/dp_0"
            app:input_text_size="14sp"
            app:input_text_type="text_password"
            app:layout_constraintTop_toBottomOf="@+id/edit_verify_code_other"
            app:name_text="@string/login_password"
            app:name_text_bold="true"/>
        <com.yadea.widget.font.YadeaTextView
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/block_color_main"
            android:gravity="center"
            android:id="@+id/action_login_other"
            android:tag="binding_11"
            android:background="@drawable/corners_text_line_color_main_radius_14"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginLeft="22dp"
            android:layout_marginTop="30dp"
            android:layout_marginRight="22dp"
            android:text="@string/login_register_confirm"
            android:layout_marginHorizontal="22dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/edit_password_other"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

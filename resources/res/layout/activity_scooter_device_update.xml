<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_scooter_device_update_0"
    android:background="@color/block_color_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.widget.actionBar.YadeaActionBar
        android:id="@+id/action_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/home_dialog_firmware_update"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/action_bar">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_container"
            android:background="@drawable/corners_solid_block_color_main_14"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:minHeight="101dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toTopOf="parent">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_controller_name"
                android:tag="binding_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_controller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vehicle_update_controller"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_controller_name"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_controller_version"
                android:tag="binding_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_controller"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/home_device_update_color"
                android:gravity="center"
                android:id="@+id/tv_controller_update"
                android:tag="binding_3"
                android:background="@drawable/home_device_update_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/vehicle_update"
                android:paddingHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:tag="binding_4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vehicle_update_version_new"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_controller_version"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_dashboard"
            android:background="@drawable/corners_solid_block_color_main_14"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:minHeight="101dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/cl_container">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_dashboard_name"
                android:tag="binding_5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_dashboard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vehicle_update_dashboard"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_dashboard_name"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_dashboard_version"
                android:tag="binding_6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_dashboard"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/home_device_update_color"
                android:gravity="center"
                android:id="@+id/tv_dashboard_update"
                android:tag="binding_7"
                android:background="@drawable/home_device_update_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/vehicle_update"
                android:paddingHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:tag="binding_8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vehicle_update_version_new"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_dashboard_version"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:background="@drawable/corners_solid_block_color_main_14"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="24dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="24dp"
            android:minHeight="101dp"
            android:layout_marginHorizontal="24dp"
            app:layout_constraintTop_toBottomOf="@+id/cl_dashboard">
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_battery_name"
                android:tag="binding_9"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vehicle_update_battery"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_battery_name"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_main"
                android:id="@+id/tv_battery_version"
                android:tag="binding_10"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_battery"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/home_device_update_color"
                android:gravity="center"
                android:id="@+id/tv_battery_update"
                android:tag="binding_11"
                android:background="@drawable/home_device_update_background"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:text="@string/vehicle_update"
                android:paddingHorizontal="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <com.yadea.widget.font.YadeaTextView
                android:textSize="12sp"
                android:textColor="@color/text_line_color_deputy_dark"
                android:tag="binding_12"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/vehicle_update_version_new"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_battery_version"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>

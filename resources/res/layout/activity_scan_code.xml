<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:tag="layout/activity_scan_code_0"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.yadea.smartmoto.qrscan.qrCode.YadeaScanCodeView
        android:id="@+id/scan_code"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true"/>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/dismiss"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="44dp"
        android:src="@mipmap/scan_ic_colse"
        android:layout_marginStart="23dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <androidx.appcompat.widget.LinearLayoutCompat
        android:gravity="center"
        android:id="@+id/action_photo"
        android:background="@drawable/corners_stroke_block_color_main_14"
        android:layout_width="200dp"
        android:layout_height="45dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/action_bluetooth"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <androidx.appcompat.widget.AppCompatImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/scan_ic_photo"
            android:layout_marginEnd="5dp"/>
        <com.yadea.widget.font.YadeaTextView
            android:textStyle="bold"
            android:textColor="@color/white"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/qr_scan_code_photos"
            android:layout_marginStart="5dp"/>
    </androidx.appcompat.widget.LinearLayoutCompat>
    <com.yadea.widget.font.YadeaTextView
        android:textStyle="bold"
        android:textColor="@color/black"
        android:gravity="center"
        android:id="@+id/action_bluetooth"
        android:background="@drawable/corners_solid_stroke_block_color_main_radius_14"
        android:layout_width="200dp"
        android:layout_height="45dp"
        android:layout_marginBottom="40dp"
        android:text="@string/qr_scan_code_switch_bluetooth_search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>

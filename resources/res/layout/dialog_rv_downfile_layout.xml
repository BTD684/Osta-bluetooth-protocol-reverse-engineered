<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/dialog_ble_base_bg"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/layout_send"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageView
            android:id="@+id/update_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentRight="true"
            android:layout_alignParentEnd="true"/>
        <TextView
            android:id="@+id/update_title"
            android:background="@drawable/dialog_ble_base_bg"
            android:layout_width="match_parent"
            android:layout_height="@dimen/all_layout_title_height"
            android:text="@string/ec_rv_down_title"
            android:layout_toLeftOf="@+id/update_cancel"
            android:layout_toStartOf="@+id/update_cancel"
            style="@style/prompt_dialog_title_font"/>
        <View
            android:id="@+id/update_seperator"
            android:background="@color/one_pixel_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x1"
            android:layout_below="@+id/update_title"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/ll_sure"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/all_layout_title_height"
            android:layout_alignParentBottom="true">
            <View
                android:id="@+id/sure_sperator"
                android:background="@color/one_pixel_divider"
                android:layout_width="match_parent"
                android:layout_height="@dimen/x1"
                android:layout_below="@+id/update_title"/>
            <TextView
                android:textSize="@dimen/text_size_normal"
                android:textColor="#1ea0ff"
                android:gravity="center"
                android:id="@+id/update_enter"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/ec_update_ok"/>
        </LinearLayout>
        <ScrollView
            android:id="@+id/update_content_scrollview"
            android:visibility="gone"
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/update_seperator"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true">
            <TextView
                android:textSize="@dimen/text_size_small"
                android:textColor="@color/black_0.8"
                android:id="@+id/update_content"
                android:paddingLeft="@dimen/x48"
                android:paddingTop="@dimen/x18"
                android:paddingRight="@dimen/x48"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/ec_update_tips"
                android:paddingStart="@dimen/x48"
                android:paddingEnd="@dimen/x48"/>
        </ScrollView>
        <ProgressBar
            android:id="@+id/progressBarSend"
            android:background="@drawable/shape_progressbar_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/x48"
            android:layout_marginTop="@dimen/x254"
            android:layout_marginRight="@dimen/x48"
            android:layout_centerHorizontal="true"
            android:layout_marginStart="@dimen/x48"
            android:layout_marginEnd="@dimen/x48"
            style="@style/StyleProgressBarMini"/>
        <TextView
            android:textSize="@dimen/x30"
            android:textColor="@color/black"
            android:id="@+id/tv_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x6"
            android:layout_below="@+id/progressBarSend"
            android:layout_alignLeft="@+id/progressBarSend"
            android:layout_alignStart="@+id/progressBarSend"/>
        <TextView
            android:textSize="@dimen/x30"
            android:textColor="@color/black"
            android:id="@+id/tv_per"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/x6"
            android:layout_below="@+id/progressBarSend"
            android:layout_alignRight="@+id/progressBarSend"
            android:layout_alignEnd="@+id/progressBarSend"/>
    </RelativeLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/layout_show"
        android:background="@drawable/dialog_ble_base_bg"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="@dimen/x48"
            android:textColor="@color/black"
            android:gravity="center"
            android:id="@+id/text_show"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x240"
            android:text="@string/ec_down_fail"/>
        <View
            android:background="@color/one_pixel_divider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x1"
            android:layout_below="@+id/update_title"/>
        <TextView
            android:textSize="@dimen/x48"
            android:textColor="#1ea0ff"
            android:gravity="center"
            android:id="@+id/text_confirm"
            android:layout_width="match_parent"
            android:layout_height="@dimen/x142"
            android:text="@string/auto_dialog_ok"/>
    </LinearLayout>
</RelativeLayout>

<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/L_y">
    <FrameLayout
        android:id="@+id/v_back"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="@dimen/margin_title_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/iv_back"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/theme_ivi_common_title_ic_back"/>
    </FrameLayout>
    <TextView
        android:textSize="@dimen/t_1"
        android:textColor="@color/c_t1"
        android:ellipsize="marquee"
        android:gravity="center"
        android:id="@+id/tv_title"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:scrollHorizontally="true"
        android:singleLine="true"
        android:includeFontPadding="false"
        android:marqueeRepeatLimit="marquee_forever"
        android:layout_marginStart="80dp"
        android:layout_marginEnd="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="@dimen/t_2"
        android:textColor="@color/white"
        android:ellipsize="end"
        android:id="@+id/tv_right_text"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        android:singleLine="true"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/iv_action"
        android:visibility="gone"
        android:layout_width="@dimen/L_y"
        android:layout_height="@dimen/L_y"
        android:scaleType="centerInside"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="@dimen/t_s5"
        app:layout_constraintEnd_toEndOf="parent"/>
</merge>
